// [MỚI — "múi giờ của toàn bộ phải theo GIỜ VIỆT NAM"] Trước đây ~30 chỗ lấy múi giờ từ cài đặt DỰ ÁN Apps Script
// (Session.getScriptTimeZone) và ~25 chỗ cắt ngày bằng getHours()/setHours() — tức theo múi giờ dự án. Nếu cài đặt
// dự án khác Việt Nam thì mọi mốc "hôm nay", "N ngày trước", giờ chạy trigger đều lệch mà không báo lỗi. Nay mọi
// định dạng ngày giờ dùng HẰNG SỐ SPX_TZ; mốc ngày dùng 2 hàm bên dưới; trigger đặt giờ có .inTimezone(SPX_TZ).
// (Việt Nam không có giờ mùa hè nên 1 ngày luôn đúng 86.400.000 ms.)
var SPX_TZ = 'Asia/Ho_Chi_Minh';
/** 'yyyy-MM-dd' của (hôm nay + offsetDays) THEO GIỜ VIỆT NAM. */
function _spxVnDateStr_(offsetDays) {
  return Utilities.formatDate(new Date(Date.now() + (offsetDays || 0) * 86400000), SPX_TZ, 'yyyy-MM-dd');
}
/** Thời điểm 00:00 GIỜ VIỆT NAM của (hôm nay + offsetDays) — dùng làm mốc cắt so với Date thật. */
function _spxVnMidnight_(offsetDays) {
  return new Date(_spxVnDateStr_(offsetDays) + 'T00:00:00+07:00');
}

/**

 * ============================================================

 * BACKEND MASTER V5.0 - SPX HUB KRÔNG PẮC 02

 * Tác giả: Admin Xuân - Krông Pắc 02

 * Cập nhật: Tích hợp Module Báo Cáo Phân Tích (từ Bổ Sung)

 * ============================================================

 */

var DB_FEE_URL  = 'https://docs.google.com/spreadsheets/d/1zGRw8ClXQ5QldxCMXtM7RbY-xlHAt2iJsXdolwzyvrM/edit';

const ADMIN_DB_ID = '145-rfoh-hLPPa5o8Uoy1SFl04ryh9N4x5Roi2ByxwPY';

// ============================================================
// QUẢN LÝ ADMIN 2 CẤP — Admin_Roles sheet (trong ADMIN_DB_ID)
// Cột: A=Email | B=Cấp(1/2) | C=Ghi chú | D=Người thêm | E=Ngày thêm
//
// Cấp 1: thấy & thêm/xoá được admin cấp 2 qua UI. Cấp 2: quyền admin đầy đủ
// (thấy hết mọi hub/module) giống cấp 1, chỉ khác không quản lý được admin khác.
//
// FAILSAFE: email dưới đây LUÔN LUÔN được coi là admin cấp 1, kể cả khi sheet
// Admin_Roles bị lỗi, rỗng, hoặc bị xoá nhầm hết dòng — để tránh bị khoá hoàn
// toàn khỏi hệ thống. Chỉ thêm/sửa mảng này trực tiếp trong code khi thực sự
// cần thiết (ví dụ người giữ tài khoản duy nhất nghỉ việc).
// ============================================================
var ADMIN_ROLES_SHEET   = 'Admin_Roles';
var ADMIN_FAILSAFE_EMAIL = [
  'xuan.nguyenthanh01@spxexpress.com'
];

// ============================================================
// ⚙️ PERFORMANCE INFRASTRUCTURE (thêm mới — không đổi logic nghiệp vụ)
// Bao gồm 4 phần theo yêu cầu tối ưu:
//   1. _DS      — Data Session Manager (memoize theo 1 lần thực thi)
//   2. CacheMgr — Cache Manager chuẩn hóa CacheService
//   3. _LOG     — Logger Manager (DEBUG / PRODUCTION)
//   4. SystemManager — "Refresh System" 1 nút duy nhất
// ============================================================

// ── 1) DATA SESSION MANAGER ──────────────────────────────────────────────
// "Data Session" = phạm vi 1 lần thực thi function (1 lượt gọi từ client
// qua google.script.run, hoặc 1 lượt doGet). Apps Script khởi tạo lại toàn
// bộ biến global mỗi lần thực thi mới, nên bộ nhớ đệm dưới đây KHÔNG rò rỉ
// sang các phiên khác và KHÔNG cần lo dữ liệu cũ/stale giữa các lượt gọi —
// chỉ tránh việc trong CÙNG 1 lượt gọi, nhiều hàm con lỡ mở lại cùng 1
// Spreadsheet hoặc đọc lại cùng 1 sheet nhiều lần.
// Chỉ đọc lại (bypass cache) khi chính code gọi _DS.invalidate()/_DS.reset()
// — ví dụ sau khi Upload/Save/Load hoặc khi bấm "Refresh System".
var _DS = (function () {
  var ssCache    = {};   // id -> Spreadsheet
  var sheetCache = {};   // ssId + '::' + sheetName -> Sheet
  var valuesCache = {};  // sheetKey + '::' + rangeKey -> values (getDataRange/getValues)

  return {
    // Mở Spreadsheet theo ID — chỉ openById() thật sự 1 lần / phiên cho mỗi ID.
    ss: function (id, forceRefresh) {
      if (!id) return null;
      if (forceRefresh || !ssCache[id]) {
        ssCache[id] = SpreadsheetApp.openById(id);
      }
      return ssCache[id];
    },
    // Lấy Sheet theo tên — memoize theo (spreadsheetId + tên sheet).
    sheet: function (ss, name, forceRefresh) {
      if (!ss || !name) return null;
      var key = ss.getId() + '::' + name;
      if (forceRefresh || !(key in sheetCache)) {
        sheetCache[key] = ss.getSheetByName(name);
      }
      return sheetCache[key];
    },
    // Đọc getDataRange().getValues() 1 lần / phiên cho mỗi sheet. Dùng
    // rangeKey khi cần phân biệt nhiều kiểu đọc khác nhau trên cùng sheet
    // (ví dụ đọc full range vs đọc range con) — mặc định 'full'.
    values: function (sheet, rangeKey, forceRefresh) {
      if (!sheet) return [];
      rangeKey = rangeKey || 'full';
      var key = sheet.getParent().getId() + '::' + sheet.getSheetId() + '::' + rangeKey;
      if (forceRefresh || !(key in valuesCache)) {
        valuesCache[key] = sheet.getDataRange().getValues();
      }
      return valuesCache[key];
    },
    // Xoá cache của 1 spreadsheet ID cụ thể (và mọi sheet/values liên quan),
    // gọi sau khi Upload/Save/Load thay đổi dữ liệu và cần đọc lại ngay
    // trong cùng phiên.
    invalidate: function (id) {
      if (id) delete ssCache[id];
      Object.keys(sheetCache).forEach(function (k) {
        if (id && k.indexOf(id + '::') === 0) delete sheetCache[k];
      });
      Object.keys(valuesCache).forEach(function (k) {
        if (id && k.indexOf(id + '::') === 0) delete valuesCache[k];
      });
    },
    // Reset toàn bộ Data Session — dùng trong SystemManager.refreshSystem().
    reset: function () {
      ssCache = {};
      sheetCache = {};
      valuesCache = {};
    }
  };
})();

// ── 2) CACHE MANAGER ─────────────────────────────────────────────────────
// Chuẩn hóa việc dùng CacheService cho các dữ liệu ít thay đổi: Permission,
// Admin, Hub, Mail, Mapping, SA. Các cache "nghiệp vụ" đặc thù (aging,
// kpifail, fms_live…) đã có cơ chế riêng ở đúng module của chúng — CacheMgr
// không thay thế các cơ chế đó, chỉ cung cấp API dùng chung, nhất quán cho
// những chỗ cache đơn giản (get/set theo TTL).
var CacheMgr = (function () {
  var NAMESPACES = ['PERMISSION', 'ADMIN', 'HUB', 'MAIL', 'MAPPING', 'SA', 'ANALYTICS'];
  var DEFAULT_TTL = 300; // giây — giống TTL đang dùng cho admin roles map

  function keyOf(ns, key) { return 'cm_' + ns + '_' + key; }

  return {
    NAMESPACES: NAMESPACES,
    // Đọc cache, trả về null nếu chưa có / lỗi parse.
    get: function (ns, key) {
      try {
        var raw = CacheService.getScriptCache().get(keyOf(ns, key));
        return raw ? JSON.parse(raw) : null;
      } catch (e) { return null; }
    },
    // Ghi cache (mặc định TTL 300s, tối đa cho phép của CacheService là 21600s).
    set: function (ns, key, value, ttlSeconds) {
      try {
        CacheService.getScriptCache().put(
          keyOf(ns, key), JSON.stringify(value), ttlSeconds || DEFAULT_TTL
        );
        return true;
      } catch (e) { return false; }
    },
    // Xoá 1 key cụ thể trong 1 namespace.
    invalidate: function (ns, key) {
      try { CacheService.getScriptCache().remove(keyOf(ns, key)); } catch (e) {}
    },
    // Xoá toàn bộ key đã biết của 1 namespace (cần truyền danh sách key vì
    // ScriptCache không hỗ trợ liệt kê theo prefix).
    invalidateAll: function (ns, keys) {
      try {
        var full = (keys || []).map(function (k) { return keyOf(ns, k); });
        if (full.length) CacheService.getScriptCache().removeAll(full);
      } catch (e) {}
    },
    // Xoá sạch cache CacheMgr của TẤT CẢ namespace đã biết (dùng trong
    // Refresh System) — cần truyền map { ns: [keys] } vì lý do nêu trên.
    clearAll: function (keysByNs) {
      var self = this;
      NAMESPACES.forEach(function (ns) {
        self.invalidateAll(ns, (keysByNs && keysByNs[ns]) || []);
      });
    },
    // ── CHUNKED CACHE (2026-07) ──────────────────────────────────────────
    // Gộp pattern "cắt JSON lớn thành nhiều entry CacheService" — trước đây
    // bị viết tay lặp lại độc lập ở nhiều module (aging_getMasterData,
    // kpifail_getIndexSummary, rider-plan forecast...), mỗi nơi tự implement
    // lại y hệt thuật toán (giới hạn 100KB/entry của CacheService buộc phải
    // chunk). Dùng chung API này cho MỌI cache "nghiệp vụ" cỡ lớn từ nay.
    // Best-effort tuyệt đối: mọi lỗi (quá lớn, cache service lỗi, JSON hỏng,
    // thiếu chunk do lệch TTL) đều trả về false/null, KHÔNG BAO GIỜ throw —
    // để cache lỗi không thể làm hỏng luồng đọc dữ liệu chính ở nơi gọi.
    setChunked: function (ns, key, value, ttlSeconds) {
      try {
        var raw = JSON.stringify(value);
        var CHUNK = 90000; // an toàn dưới giới hạn 100KB/entry của CacheService
        var chunks = [];
        for (var i = 0; i < raw.length; i += CHUNK) chunks.push(raw.slice(i, i + CHUNK));
        if (chunks.length > 40) return false; // dữ liệu quá lớn bất thường → bỏ qua, không rủi ro
        var base = keyOf(ns, key);
        var payload = {};
        payload[base + '_meta'] = JSON.stringify({ chunks: chunks.length });
        chunks.forEach(function (c, idx) { payload[base + '_c' + idx] = c; });
        CacheService.getScriptCache().putAll(payload, ttlSeconds || DEFAULT_TTL);
        return true;
      } catch (e) { return false; }
    },
    getChunked: function (ns, key) {
      try {
        var base = keyOf(ns, key);
        var sc = CacheService.getScriptCache();
        var metaStr = sc.get(base + '_meta');
        if (!metaStr) return null;
        var meta = JSON.parse(metaStr);
        var n = meta.chunks;
        if (!n || n <= 0 || n > 40) return null;
        var keys = [];
        for (var i = 0; i < n; i++) keys.push(base + '_c' + i);
        var got = sc.getAll(keys);
        var parts = [];
        for (var j = 0; j < n; j++) {
          var part = got[base + '_c' + j];
          if (part === null || part === undefined) return null; // thiếu chunk (lệch TTL) → coi như miss
          parts.push(part);
        }
        return JSON.parse(parts.join(''));
      } catch (e) { return null; }
    },
    invalidateChunked: function (ns, key) {
      try {
        var base = keyOf(ns, key);
        var sc = CacheService.getScriptCache();
        var metaStr = sc.get(base + '_meta');
        if (!metaStr) return;
        var meta = JSON.parse(metaStr);
        var keys = [base + '_meta'];
        for (var i = 0; i < meta.chunks; i++) keys.push(base + '_c' + i);
        sc.removeAll(keys);
      } catch (e) {}
    }
  };
})();

// ── 3) LOGGER MANAGER ────────────────────────────────────────────────────
// Tách DEBUG / PRODUCTION: PRODUCTION không ghi log không cần thiết (giảm
// overhead ghi Stackdriver log khi hệ thống chạy ở tần suất cao). Đổi
// DEBUG_MODE = true khi cần xem lại toàn bộ log để chẩn đoán lỗi.
var _LOG = (function () {
  var DEBUG_MODE = false; // đổi thành true khi cần debug production
  var ERROR_LOG_CACHE_KEY = 'sys_recent_errors_v1';
  var MAX_RECENT_ERRORS = 50;

  return {
    setDebugMode: function (on) { DEBUG_MODE = !!on; },
    isDebugMode: function () { return DEBUG_MODE; },
    // Log thông thường (debug) — chỉ ghi khi DEBUG_MODE = true.
    d: function (msg) { if (DEBUG_MODE) Logger.log(msg); },
    // Log lỗi — LUÔN ghi bất kể DEBUG_MODE, vì cần cho chẩn đoán sự cố.
    // [MỚI — tab "Tuỳ chọn nâng cao"] Logger.log() gốc CHỈ hiện trong Execution
    // log của ĐÚNG lần chạy đó, KHÔNG persist giữa các lần gọi khác nhau —
    // không thể "xem lại lỗi gần đây" bằng cách đó. Thêm buffer nhẹ qua
    // CacheService (không phải Sheet, tránh làm chậm hàm dùng chung này — nó
    // được gọi ở RẤT nhiều nơi trong toàn bộ file) — bọc try/catch kỹ, không
    // bao giờ được phép làm hỏng hành vi log gốc hay ném lỗi ngược lên caller.
    e: function (msg) {
      Logger.log(msg);
      try {
        var cache = CacheService.getScriptCache();
        var raw = cache.get(ERROR_LOG_CACHE_KEY);
        var list = raw ? JSON.parse(raw) : [];
        list.unshift({ ts: new Date().toISOString(), msg: String(msg).substring(0, 500) });
        if (list.length > MAX_RECENT_ERRORS) list.length = MAX_RECENT_ERRORS;
        cache.put(ERROR_LOG_CACHE_KEY, JSON.stringify(list), 21600); // 6 tiếng — TTL tối đa CacheService
      } catch (eCacheLog) {}
    },
    getRecentErrors: function () {
      try {
        var raw = CacheService.getScriptCache().get(ERROR_LOG_CACHE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) { return []; }
    }
  };
})();

// ── 4) SYSTEM MANAGER — "Refresh System" 1 nút duy nhất ─────────────────
// Gộp lại toàn bộ cơ chế clear cache/invalidate đã có sẵn trong hệ thống
// (không viết lại logic của chúng) + reset Data Session + clear CacheMgr,
// để người dùng chỉ cần bấm 1 nút. Hàm này KHÔNG đổi kết quả trả về của
// các hàm invalidate hiện có — chỉ gọi tuần tự và gộp báo cáo.
function spx_refreshSystem() {
  // [FIX LỖI BẢO MẬT THẬT — phát hiện khi tách 2 luồng dọn dẹp theo yêu cầu
  // trực tiếp] Hàm này TRƯỚC ĐÂY hoàn toàn KHÔNG kiểm tra quyền — bất kỳ ai
  // (kể cả gọi thẳng qua console trình duyệt) đều có thể xoá cache SERVER-WIDE
  // ảnh hưởng mọi user khác. Giờ đây đây là hành động CHỈ ADMIN mới nên làm
  // (đã tách khỏi luồng dọn dẹp cá nhân của user thường) — thêm đúng guard
  // chuẩn đã dùng nhất quán cho mọi hàm admin-only khác trong file này.
  // [SỬA — theo yêu cầu trực tiếp "loại bỏ Dọn dẹp hệ thống khỏi admin cấp 2"]
  // Nâng từ _requireAdmin_(2) lên (1) — chỉ cấp 1 gọi được.
  _requireAdmin_(1);
  var report = { steps: [], errors: [] };

  function run(label, fn) {
    try {
      var r = fn();
      report.steps.push({ step: label, result: r || 'ok' });
    } catch (e) {
      report.errors.push({ step: label, error: e.message });
    }
  }

  // 1. Clear Runtime — reset Data Session Manager (memoize theo phiên)
  run('data_session_reset', function () { _DS.reset(); return 'reset'; });

  // 2. Clear Cache — dùng lại toàn bộ cơ chế invalidate cache nghiệp vụ
  //    đã có sẵn (permission, admin, aging, kpifail, luong, fms_live…)
  run('permission_and_business_cache', function () { return spx_invalidateAllCache(); });
  if (typeof aging_clearCache === 'function') {
    run('aging_cache', function () { return aging_clearCache(); });
  }
  if (typeof kpifail_clearCache === 'function') {
    run('kpifail_cache', function () { return kpifail_clearCache(); });
  }
  if (typeof fms_live_clearCache === 'function') {
    run('fms_live_cache', function () { return fms_live_clearCache(); });
  }
  if (typeof _admin_invalidateCache === 'function') {
    run('admin_roles_cache', function () { return _admin_invalidateCache(); });
  }

  // 3. Clear CacheMgr namespaces chuẩn hóa (Permission/Admin/Hub/Mail/Mapping/SA)
  run('cache_manager_clear', function () { CacheMgr.clearAll(); return 'cleared'; });

  _LOG.e('[spx_refreshSystem] ' + JSON.stringify(report));
  return JSON.stringify({ success: report.errors.length === 0, report: report, ts: new Date().toISOString() });
}

// ── 4b) LẤY URL WEB APP THẬT — dùng để client reload chính xác frame TOP ──
// Client không thể tin cậy document.referrer để biết URL /exec hay /dev thật
// (GAS lồng nhiều lớp iframe khác origin, referrer có thể trỏ tới domain nội
// bộ khác của Google tuỳ ngữ cảnh mở app → điều hướng sai, ra trang lỗi).
// ScriptApp.getService().getUrl() luôn trả về đúng URL deployment hiện tại
// (tự động đúng cho cả /exec production và /dev testing), lấy 1 lần và
// cache phía client — an toàn, không đụng logic nào khác.
function spx_getWebAppUrl() {
  try {
    return ScriptApp.getService().getUrl() || '';
  } catch (e) {
    _LOG.e('[spx_getWebAppUrl] ' + e.message);
    return '';
  }
}

/**
 * _admin_getAdminMap()
 * Đọc sheet Admin_Roles → { email: level(1|2) }. Cache 300s (ScriptCache)
 * để tránh mở spreadsheet mỗi lần check quyền.
 */
// ═══════════════════════════════════════════════════════════════════════
// [MỚI — theo yêu cầu trực tiếp] PHÂN CẤP ROM: ROM > AOM > SUP > Lead/Staff
//
// BỐI CẢNH: sheet nguồn 'Khu vực quản lý (AOMSup)' (do đội khác quản) chỉ có
// cột AOM_Email và Sup_Email — KHÔNG có cột nào cho ROM. Vì vậy ROM trước đây
// hoàn toàn không tồn tại trong dữ liệu: giao diện có nút xem thử "L1-ROM"
// nhưng không tài khoản thật nào được nhận cấp này.
//
// CÁCH LÀM: KHÔNG sửa sheet nguồn (không thuộc quyền mình, sửa vào dễ bị ghi
// đè khi đội kia cập nhật). Thay vào đó lưu cấu hình ROM trong DB quản trị của
// chính hệ thống, quản qua màn Admin — cùng cách đã làm với Admin_Roles.
//
// CẤU TRÚC sheet 'ROM_Roles' (tự tạo khi cần):
//   A: rom_email   B: aom_email   C: ghi chú/ngày cấp
// Mỗi dòng = 1 quan hệ "ROM này quản AOM kia". 1 ROM nhiều AOM -> nhiều dòng.
// Phạm vi trạm của ROM = hợp của phạm vi tất cả AOM mà ROM đó quản, suy ra
// động từ sheet nguồn -> AOM thay trạm thì ROM tự cập nhật theo, không phải
// sửa 2 nơi.
// ═══════════════════════════════════════════════════════════════════════
var ROM_ROLES_SHEET = 'ROM_Roles';

/** Bảng ROM -> danh sách AOM_Email. Cache 5 phút (đổi rất ít). */
function _rom_getRomMap() {
  var CK = 'rom_roles_map_v1';
  var sc = CacheService.getScriptCache();
  try { var hit = sc.get(CK); if (hit) return JSON.parse(hit); } catch (e) {}

  var map = {};
  var _romOk = true;
  try {
    var ss = _DS.ss(ADMIN_DB_ID);
    var sheet = ss.getSheetByName(ROM_ROLES_SHEET);
    if (sheet && sheet.getLastRow() > 1) {
      var data = sheet.getRange(2, 1, sheet.getLastRow() - 1, 2).getValues();
      for (var i = 0; i < data.length; i++) {
        var rom = String(data[i][0] || '').toLowerCase().trim();
        var aom = String(data[i][1] || '').toLowerCase().trim();
        if (!rom || !aom) continue;
        if (!map[rom]) map[rom] = [];
        if (map[rom].indexOf(aom) < 0) map[rom].push(aom);
      }
    }
  } catch (e) {
    _LOG.d('[_rom_getRomMap] ERROR: ' + e.message);
    _romOk = false;
  }
  // [SỬA] KHÔNG lưu cache khi đọc lỗi/rỗng: trước đây một lần Sheets lỗi thoáng qua làm kết quả rỗng bị giữ trong cache tới hết TTL.
  if (_romOk) { try { sc.put(CK, JSON.stringify(map), 300); } catch (e) {} }
  return map;
}

/** Xoá cache sau khi Admin thay đổi cấu hình ROM. */
function _rom_invalidateCache() {
  try { CacheService.getScriptCache().remove('rom_roles_map_v1'); } catch (e) {}
}

/**
 * _rom_getScope(email)
 * Trả { isRom, aomEmails, stations } — phạm vi THẬT của 1 ROM.
 * stations suy ra ĐỘNG từ sheet nguồn theo các AOM mà ROM quản.
 */
/**
 * rom_getScopeForPreview(romEmail) — phạm vi trạm của 1 ROM, dùng cho chế độ Xem thử.
 * [MỚI — rà soát: ROM đã cấu hình thật nhưng giao diện vẫn coi như "chưa có dữ liệu
 * phân vùng"] Trả về danh sách AOM và danh sách trạm mà ROM đó quản, để Xem thử cấp
 * ROM lọc đúng phạm vi thay vì hiện số toàn hệ thống.
 * Chỉ Admin gọi được (Xem thử là công cụ của Admin).
 */
/**
 * spx_getHubOrgDirectory() — danh bạ TRẠM -> {AOM, SUP} lấy thẳng từ cây tổ chức.
 * [MỚI — theo yêu cầu: "toàn bộ module phải phân cấp đúng, số liệu đúng của họ"]
 * Trước đây việc "SUP/AOM này quản những trạm nào" được suy ra từ allData — tức dữ
 * liệu của module Kiểm soát Giao hàng. Hệ quả: khi dữ liệu đó chưa tải xong (hoặc
 * người dùng chưa vào module đó), phạm vi ra RỖNG -> không lọc -> mọi cấp đều thấy
 * số toàn hệ thống. Đó là gốc rễ của việc "SUP A lại xem được toàn bộ".
 * Danh bạ này lấy thẳng từ nguồn tổ chức nên luôn có, không phụ thuộc module nào.
 * Nhẹ (1 dòng / trạm) và đệm 1 giờ.
 */
function spx_getHubOrgDirectory() {
  var CK = 'spx_hub_org_dir_v1';
  try {
    var hit = CacheMgr.getChunked('ACCESS', CK);
    if (hit && hit.byHub) return JSON.stringify(hit);
  } catch (e) {}
  var out = { byHub: {}, supNames: [], aomNames: [] };
  try {
    var ss = SpreadsheetApp.openById(ORG_SOURCE_SPREADSHEET_ID);
    var sh = ss.getSheetByName('Khu vực quản lý (AOMSup)');
    if (sh && sh.getLastRow() > 1) {
      var vals = sh.getDataRange().getValues();
      var head = vals[0].map(function (x) { return String(x || '').trim().toLowerCase(); });
      var iHub = head.indexOf('hub'), iAom = head.indexOf('aom'), iSup = head.indexOf('sup_name');
      var seenS = {}, seenA = {};
      if (iHub >= 0) {
        for (var i = 1; i < vals.length; i++) {
          var hub = String(vals[i][iHub] || '').trim();
          if (!hub) continue;
          var aom = iAom >= 0 ? String(vals[i][iAom] || '').trim() : '';
          var sup = iSup >= 0 ? String(vals[i][iSup] || '').trim() : '';
          out.byHub[_normStationKey_(hub)] = { hub: hub, aom: aom, sup: sup };
          if (sup && !seenS[sup]) { seenS[sup] = 1; out.supNames.push(sup); }
          if (aom && !seenA[aom]) { seenA[aom] = 1; out.aomNames.push(aom); }
        }
      }
    }
    out.supNames.sort(); out.aomNames.sort();
    if (Object.keys(out.byHub).length > 0) { try { CacheMgr.setChunked('ACCESS', CK, out, 3600); } catch (e2) {} } // [SỬA] không lưu cache danh bạ rỗng
  } catch (e) { out.error = e.message; }
  return JSON.stringify(out);
}

function rom_getScopeForPreview(romEmail) {
  try {
    _requireAdmin_(2);
    var sc = _rom_getScope(romEmail);
    return JSON.stringify({
      success: true,
      isRom: !!sc.isRom,
      email: String(romEmail || '').toLowerCase().trim(),
      aomEmails: sc.aomEmails || [],
      hubs: sc.stations || [],
      nguon: sc.nguon || 'legacy'
    });
  } catch (e) { return JSON.stringify({ success: false, error: e.message }); }
}

function _rom_getScope(email) {
  var em = String(email || '').toLowerCase().trim();
  var romMap = _rom_getRomMap();
  var aomList = romMap[em];
  if (!aomList || !aomList.length) return { isRom: false, aomEmails: [], stations: [] };

  var want = {};
  aomList.forEach(function (a) { want[a] = true; });


  // [SỬA — rà soát: ROM đã được cấu hình thật nhưng phạm vi lại tra ở NGUỒN CŨ]
  // Phần bên dưới đọc sheet 'AOM SUP' trong file 1Tqy2J — nguồn đã bỏ. Các đường
  // phân quyền khác đã chuyển sang file tổ chức chính thức, riêng ROM còn sót lại
  // -> ROM mới cấu hình có thể ra 0 trạm, và đó là lý do phần Xem thử cấp ROM bị
  // coi là "chưa có dữ liệu phân vùng thật".
  // Nay lấy trạm từ chính cây tổ chức: gom trạm của từng AOM mà ROM này quản.
  // Không thấy gì thì mới lùi về nguồn cũ (giữ nguyên bên dưới).
  try {
    var _orgRom = _spxBuildOrgAccessMap_();
    if (_orgRom && _orgRom.byEmail) {
      var _stOrg = [], _seenOrg = {};
      Object.keys(want).forEach(function (aomEmail) {
        var _aom = _orgRom.byEmail[aomEmail];
        if (_aom && _aom.stations && _aom.stations.length) {
          _aom.stations.forEach(function (h) { if (h && !_seenOrg[h]) { _seenOrg[h] = true; _stOrg.push(h); } });
        }
      });
      if (_stOrg.length) return { isRom: true, aomEmails: aomList, stations: _stOrg.sort(), nguon: 'org' };
    }
  } catch (eOrgRom) {}

  var stations = [], seen = {};
  try {
    var srcSS = _DS.ss(RP_SOURCE_ID);
    // [SỬA] RP_SA_SHEET là biến KHÔNG TỒN TẠI -> ReferenceError, hàm ném lỗi
    // và dropdown AOM luôn rỗng. Tên sheet đúng là 'AOM SUP' (khớp 3 nơi khác
    // trong file đang dùng).
    var sh = srcSS.getSheetByName('AOM SUP') || srcSS.getSheets()[0];
    var data = sh.getDataRange().getValues();
    for (var i = 1; i < data.length; i++) {
      var aomE = String(data[i][RP_SA_COL_AOM_EMAIL] || '').toLowerCase().trim();
      if (!aomE || !want[aomE]) continue;
      var hub = String(data[i][RP_SA_COL_HUB] || '').trim();
      if (hub && !seen[hub]) { seen[hub] = true; stations.push(hub); }
    }
  } catch (e) {
    _LOG.d('[_rom_getScope] ERROR: ' + e.message);
  }
  return { isRom: true, aomEmails: aomList, stations: stations.sort() };
}

/** [Admin] Đọc toàn bộ cấu hình ROM để hiển thị ở màn quản trị. */
function rom_listConfig() {
  try {
    _requireAdmin_(1);
    var map = _rom_getRomMap();
    var out = [];
    Object.keys(map).sort().forEach(function (rom) {
      var sc = _rom_getScope(rom);
      out.push({ romEmail: rom, aomEmails: map[rom], stationCount: sc.stations.length });
    });
    return JSON.stringify({ success: true, data: out });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/** [Admin] Gán 1 AOM cho 1 ROM. */
function rom_assignAom(romEmail, aomEmail) {
  try {
    _requireAdmin_(1);
    var rom = String(romEmail || '').toLowerCase().trim();
    var aom = String(aomEmail || '').toLowerCase().trim();
    if (!rom || rom.indexOf('@') < 0) return JSON.stringify({ success: false, error: 'Email ROM không hợp lệ.' });
    if (!aom || aom.indexOf('@') < 0) return JSON.stringify({ success: false, error: 'Email AOM không hợp lệ.' });

    if (!_anaAcquireNamedLock('rom_roles_write_lock_v1', 10000, 15000)) {
      return JSON.stringify({ success: false, error: 'Hệ thống đang bận, thử lại sau vài giây.' });
    }
    try {
      var ss = _DS.ss(ADMIN_DB_ID);
      var sheet = ss.getSheetByName(ROM_ROLES_SHEET);
      if (!sheet) {
        sheet = ss.insertSheet(ROM_ROLES_SHEET);
        sheet.getRange(1, 1, 1, 3).setValues([['rom_email', 'aom_email', 'ghi_chu']]);
      }
      // Chống trùng
      if (sheet.getLastRow() > 1) {
        var d = sheet.getRange(2, 1, sheet.getLastRow() - 1, 2).getValues();
        for (var i = 0; i < d.length; i++) {
          if (String(d[i][0] || '').toLowerCase().trim() === rom &&
              String(d[i][1] || '').toLowerCase().trim() === aom) {
            return JSON.stringify({ success: false, error: 'Cặp ROM–AOM này đã có rồi.' });
          }
        }
      }
      sheet.appendRow([rom, aom, 'Cấp bởi ' + Session.getActiveUser().getEmail() + ' lúc ' + _anaVNNow()]);
    } finally {
      _anaReleaseNamedLock('rom_roles_write_lock_v1');
    }
    _rom_invalidateCache();
    var scope = _rom_getScope(rom);
    return JSON.stringify({ success: true, stationCount: scope.stations.length });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/** [Admin] Gỡ 1 AOM khỏi 1 ROM. */
function rom_revokeAom(romEmail, aomEmail) {
  try {
    _requireAdmin_(1);
    var rom = String(romEmail || '').toLowerCase().trim();
    var aom = String(aomEmail || '').toLowerCase().trim();
    if (!_anaAcquireNamedLock('rom_roles_write_lock_v1', 10000, 15000)) {
      return JSON.stringify({ success: false, error: 'Hệ thống đang bận, thử lại sau vài giây.' });
    }
    try {
      var ss = _DS.ss(ADMIN_DB_ID);
      var sheet = ss.getSheetByName(ROM_ROLES_SHEET);
      if (!sheet || sheet.getLastRow() < 2) return JSON.stringify({ success: false, error: 'Chưa có cấu hình ROM nào.' });
      var d = sheet.getRange(2, 1, sheet.getLastRow() - 1, 2).getValues();
      for (var i = d.length - 1; i >= 0; i--) {
        if (String(d[i][0] || '').toLowerCase().trim() === rom &&
            String(d[i][1] || '').toLowerCase().trim() === aom) {
          sheet.deleteRow(i + 2);
          break;
        }
      }
    } finally {
      _anaReleaseNamedLock('rom_roles_write_lock_v1');
    }
    _rom_invalidateCache();
    return JSON.stringify({ success: true });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/** [Admin] Danh sách AOM có thật trong sheet nguồn — để chọn khi gán. */
function rom_listAvailableAoms() {
  try {
    _requireAdmin_(1);
    var out = [], seen = {};
    var srcSS = _DS.ss(RP_SOURCE_ID);
    // [SỬA] RP_SA_SHEET là biến KHÔNG TỒN TẠI -> ReferenceError, hàm ném lỗi
    // và dropdown AOM luôn rỗng. Tên sheet đúng là 'AOM SUP' (khớp 3 nơi khác
    // trong file đang dùng).
    var sh = srcSS.getSheetByName('AOM SUP') || srcSS.getSheets()[0];
    var data = sh.getDataRange().getValues();
    for (var i = 1; i < data.length; i++) {
      var em = String(data[i][RP_SA_COL_AOM_EMAIL] || '').toLowerCase().trim();
      if (!em || seen[em]) continue;
      seen[em] = true;
      out.push({ email: em, name: String(data[i][2] || '').trim() });
    }
    out.sort(function (a, b) { return a.email < b.email ? -1 : 1; });
    return JSON.stringify({ success: true, data: out });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

function _admin_getAdminMap() {
  var CACHE_KEY = 'admin_roles_map_v1';
  var sc = CacheService.getScriptCache();
  try {
    var cached = sc.get(CACHE_KEY);
    if (cached) return JSON.parse(cached);
  } catch(ce) {}

  var map = {};
  var _adminOk = true;
  try {
    var ss = _DS.ss(ADMIN_DB_ID);
    var sheet = ss.getSheetByName(ADMIN_ROLES_SHEET);
    if (sheet) {
      var data = sheet.getDataRange().getValues();
      for (var i = 1; i < data.length; i++) {
        var email = data[i][0] ? data[i][0].toString().toLowerCase().trim() : '';
        var level = parseInt(data[i][1], 10);
        if (email && (level === 1 || level === 2)) map[email] = level;
      }
    }
  } catch(e) {
    _LOG.d('[_admin_getAdminMap] ERROR: ' + e.message);
    _adminOk = false;
  }

  // Failsafe: đảm bảo luôn có ít nhất email gốc là cấp 1
  ADMIN_FAILSAFE_EMAIL.forEach(function(e) {
    var em = e.toLowerCase().trim();
    if (em && !map[em]) map[em] = 1;
  });

  // [SỬA] KHÔNG lưu cache khi đọc lỗi/rỗng: trước đây một lần Sheets lỗi thoáng qua làm kết quả rỗng bị giữ trong cache tới hết TTL. Với bản đồ quyền admin, lỗi đọc làm mất quyền admin (chỉ còn email dự phòng) trong cả 5 phút.
  if (_adminOk) { try { sc.put(CACHE_KEY, JSON.stringify(map), 300); } catch(ce) {} }
  return map;
}

/** Xoá cache map admin — gọi sau khi thêm/xoá admin trong sheet */
function _admin_invalidateCache() {
  try { CacheService.getScriptCache().remove('admin_roles_map_v1'); } catch(e) {}
}

// ============================================================
// [SECURITY HARDENING 2026-08] GUARD DÙNG CHUNG
// ------------------------------------------------------------
// Lý do thêm: trong Apps Script, MỌI hàm top-level (kể cả không được
// bất kỳ file HTML nào của ta gọi tới) đều có thể bị gọi trực tiếp từ
// console trình duyệt qua google.script.run.tenHam(...) — bởi BẤT KỲ
// ai đã load được 1 trang bất kỳ của web app này, kể cả người CHƯA
// được duyệt (trang UI_RequestAccess vẫn dùng chung cầu nối này).
// doGet() chỉ quyết định trang HTML nào được trả, KHÔNG chặn được
// từng lệnh gọi RPC riêng lẻ. Vì vậy các hàm quản trị/di trú/xoá dữ
// liệu PHẢI tự kiểm tra quyền ngay trong thân hàm — không được dựa
// vào việc "không ai biết tên hàm này" hay "chỉ được include ở UI admin".
// Dùng 2 hàm dưới đây ở ĐẦU mọi hàm public có khả năng đọc/ghi dữ liệu
// nhạy cảm hoặc phá huỷ dữ liệu.
// ============================================================

/**
 * _requireAdmin_(maxLevel)
 * Ném lỗi nếu người gọi hiện tại không phải admin cấp <= maxLevel (mặc định 2,
 * tức admin cấp 1 hoặc cấp 2 đều qua). Dùng maxLevel=1 cho thao tác chỉ admin
 * cấp 1 mới được làm (xoá sheet permission gốc, seed lại admin...).
 * Trả về email người gọi (đã chuẩn hoá) nếu hợp lệ, để hàm gọi tiếp có thể dùng
 * ngay (ví dụ ghi vào cột "resolvedBy"/"addedBy" thay vì tin chuỗi client gửi lên).
 */
/**
 * _requireAdminIfInteractive_(maxLevel)
 * [SỬA LỖI THẬT — báo cáo: "tần suất sử dụng = 0 dù user dùng rất nhiều"]
 * Các job NỀN gọi _requireAdmin_() ở dòng đầu. Nhưng job nền chạy theo lịch thì
 * KHÔNG có người đăng nhập -> Session.getActiveUser().getEmail() rỗng -> hàm đó
 * NÉM LỖI ngay, job chết trước khi làm gì.
 * Hệ quả đo được: spx_usageStats_flushBuffer lỗi 86 lượt -> dữ liệu tần suất nằm
 * mãi trong bộ đệm, không bao giờ ghi xuống sheet -> thống kê hiện 0.
 * Ba job khác (archive / crawl trạm / dọn Trend) lỗi 33 lượt cũng CÙNG nguyên nhân.
 * Nay: có người dùng thật -> kiểm tra quyền như cũ (chặn người ngoài gọi thẳng);
 * chạy nền (không có email) -> cho chạy, vì chính hệ thống gọi chứ không phải ai đó.
 */
function _requireAdminIfInteractive_(maxLevel) {
  var email = '';
  try { email = Session.getActiveUser().getEmail(); } catch (e) { email = ''; }
  if (!email) return '';           // chạy nền theo lịch — không có ai để kiểm tra
  return _requireAdmin_(maxLevel);
}

function _requireAdmin_(maxLevel) {
  maxLevel = maxLevel || 2;
  var email = Session.getActiveUser().getEmail().toLowerCase().trim();
  var map = _admin_getAdminMap();
  var level = map[email];
  if (!level || level > maxLevel) {
    throw new Error('Không có quyền thực hiện thao tác này (yêu cầu admin cấp ' + maxLevel + ' trở lên).');
  }
  return email;
}

/**
 * _requireApproved_()
 * Ném lỗi nếu người gọi hiện tại chưa được duyệt đăng nhập (cột B Admin_Access
 * khác "Duyệt"). Dùng cho các RPC đọc dữ liệu vận hành/lịch sử — không cần
 * phân quyền theo hub cụ thể nhưng vẫn phải là user đã được công ty duyệt.
 * Trả về email đã chuẩn hoá.
 *
 * [PERF FIX 2026-08] checkUserAccess() bên dưới KHÔNG có cache — đọc thẳng
 * getDataRange() của cả sheet Admin_Access mỗi lần gọi (chấp nhận được khi trước
 * đây chỉ gọi ĐÚNG 1 LẦN/trang trong doGet()). Sau khi thêm _requireApproved_()
 * vào include() (chặn đọc mã nguồn khi chưa duyệt — xem include() bên dưới),
 * 1 lần tải trang giờ gọi include() nhiều lần (mỗi <?!= include('...') ?> trong
 * index.html), nên nếu không nhớ lại kết quả trong PHẠM VI 1 LẦN THỰC THI, sheet
 * Admin_Access sẽ bị đọc lặp lại nhiều lần/trang thay vì 1 lần như trước — chậm
 * trang + tốn quota Sheets API vô ích. Biến _approvedMemo dưới đây là biến cấp
 * script (tồn tại suốt 1 lần thực thi doGet(), KHÔNG phải cache liên-request) —
 * chỉ đọc sheet đúng 1 lần cho mỗi user/thực thi, các lần gọi include() sau dùng
 * lại kết quả đã nhớ, không đọc lại sheet.
 */
var _approvedMemo = null; // { email, ok } — chỉ sống trong phạm vi 1 lần thực thi hiện tại
function _requireApproved_() {
  var email = Session.getActiveUser().getEmail();
  if (_approvedMemo && _approvedMemo.email === email) {
    if (!_approvedMemo.ok) throw new Error('Tài khoản chưa được duyệt truy cập hệ thống.');
    return email.toLowerCase().trim();
  }
  var ok = !!email && checkUserAccess(email);
  // [SỬA LỖI THẬT — truy từ báo cáo "ẩn module nhưng vẫn hiện đầy đủ",
  // kiểm chứng bằng Console: window.SPX_MODULE_STATUS = {} trong khi tab Quản
  // lý Module (cùng nguồn dữ liệu) vẫn thấy module ĐANG ẨN]
  // checkUserAccess() CHỈ tra sheet Admin_Access, KHÔNG có ngoại lệ cho admin.
  // Admin nào không có dòng "Duyệt" trong sheet đó -> bị coi là CHƯA DUYỆT ->
  // mọi hàm dùng _requireApproved_ đều từ chối. Riêng hàm đọc trạng thái
  // module lại "fail-open" (trả rỗng im lặng) -> không module nào bị ẩn.
  // Trong khi đó _requireAdmin_() tra bảng admin -> tab Quản lý Module vẫn
  // chạy đúng, tạo ra đúng hiện tượng "admin thấy đang ẩn, menu vẫn hiện đủ".
  // Admin (mọi cấp) hiển nhiên là đã được duyệt truy cập.
  if (!ok && email) {
    try {
      var _am = _admin_getAdminMap();
      if (_am[String(email).toLowerCase().trim()]) ok = true;
    } catch (eAm) {}
  }
  _approvedMemo = { email: email, ok: ok };
  if (!ok) throw new Error('Tài khoản chưa được duyệt truy cập hệ thống.');
  return email.toLowerCase().trim();
}

/**
 * admin_seedInitialAdmins()
 * CHẠY THỦ CÔNG 1 LẦN DUY NHẤT từ Apps Script Editor để khởi tạo sheet
 * Admin_Roles từ danh sách RP_ADMIN_EMAIL cũ (toàn bộ → cấp 1, giữ nguyên
 * quyền hiện có, không ai bị mất quyền admin sau khi migrate).
 * Sau khi chạy xong, việc thêm admin cấp 2 mới sẽ dùng UI thay vì sửa code.
 */
function admin_seedInitialAdmins() {
  // [SECURITY FIX 2026-08] Trước đây không kiểm tra quyền. An toàn khi thêm
  // _requireAdmin_() vì ADMIN_FAILSAFE_EMAIL luôn được _admin_getAdminMap() coi là
  // admin cấp 1 kể cả khi sheet Admin_Roles còn trống — không lo tự khoá mình khỏi
  // lần chạy khởi tạo đầu tiên.
  _requireAdmin_(1);
  var ss = _DS.ss(ADMIN_DB_ID);
  var sheet = ss.getSheetByName(ADMIN_ROLES_SHEET);
  if (!sheet) {
    sheet = ss.insertSheet(ADMIN_ROLES_SHEET);
    sheet.appendRow(['Email', 'Cấp (1/2)', 'Ghi chú', 'Người thêm', 'Ngày thêm']);
  }
  var existingData = sheet.getDataRange().getValues();
  var existing = [];
  for (var i = 1; i < existingData.length; i++) {
    if (existingData[i][0]) existing.push(existingData[i][0].toString().toLowerCase().trim());
  }
  var added = 0;
  (RP_ADMIN_EMAIL || []).forEach(function(raw) {
    var email = raw.toLowerCase().trim();
    if (email && existing.indexOf(email) < 0) {
      sheet.appendRow([email, 1, 'Migrated từ RP_ADMIN_EMAIL', 'system', new Date()]);
      existing.push(email);
      added++;
    }
  });
  _admin_invalidateCache();
  return 'Đã thêm ' + added + ' admin (cấp 1) vào sheet ' + ADMIN_ROLES_SHEET + '. Tổng hiện có: ' + existing.length;
}

/**
 * spx_getAdminList()
 * Public wrapper — chỉ trả về danh sách nếu người gọi là admin cấp 1.
 */
function spx_getAdminList() {
  try {
    var email = Session.getActiveUser().getEmail().toLowerCase().trim();
    var map = _admin_getAdminMap();
    if (map[email] !== 1) {
      return JSON.stringify({ success: false, error: 'Chỉ admin cấp 1 mới được xem danh sách này.' });
    }
    // [MỚI — theo quyết định trực tiếp "chỉ tính khi thực sự tải dữ liệu"]
    var ss = _DS.ss(ADMIN_DB_ID);
    var sheet = ss.getSheetByName(ADMIN_ROLES_SHEET);
    var list = [];
    if (sheet) {
      var data = sheet.getDataRange().getValues();
      for (var i = 1; i < data.length; i++) {
        if (!data[i][0]) continue;
        list.push({
          row: i + 1,
          email: data[i][0].toString().trim(),
          level: parseInt(data[i][1], 10) || 2,
          note: data[i][2] ? data[i][2].toString() : '',
          addedBy: data[i][3] ? data[i][3].toString() : '',
          addedDate: data[i][4] ? data[i][4].toString() : '',
          isFailsafe: ADMIN_FAILSAFE_EMAIL.map(function(e){return e.toLowerCase().trim();}).indexOf(data[i][0].toString().toLowerCase().trim()) >= 0
        });
      }
    }
    return JSON.stringify({ success: true, list: list, myEmail: email });
  } catch(e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_addAdmin(newEmail, note)
 * Thêm 1 admin CẤP 2 mới. Chỉ admin cấp 1 mới gọi được (kiểm tra server-side).
 * Admin cấp 2 có quyền y hệt cấp 1 (thấy hết mọi hub/module), chỉ khác là
 * không tự thêm/xoá được admin khác qua UI này.
 */
function spx_addAdmin(newEmail, note) {
  try {
    var caller = Session.getActiveUser().getEmail().toLowerCase().trim();
    var map = _admin_getAdminMap();
    if (map[caller] !== 1) {
      return JSON.stringify({ success: false, error: 'Chỉ admin cấp 1 mới được thêm admin.' });
    }

    newEmail = (newEmail || '').toString().toLowerCase().trim();
    if (!newEmail || newEmail.indexOf('@') < 0) {
      return JSON.stringify({ success: false, error: 'Email không hợp lệ.' });
    }
    if (map[newEmail]) {
      return JSON.stringify({ success: false, error: 'Email này đã là admin (cấp ' + map[newEmail] + ').' });
    }

    // [FIX NGHẼN LOCK 2026-07-24] TRƯỚC ĐÂY dùng thẳng LockService.getScriptLock() —
    // khoá TOÀN CỤC của cả script, cùng hàng đợi với Rider Plan/KPIFail Notes/Analytics...
    // (xem giải thích đầy đủ ở saveRiderPlan()). Đổi sang named lock riêng cho
    // Admin_Roles qua _anaAcquireNamedLock() (đã có sẵn, dùng chung) — chỉ chặn lẫn
    // nhau giữa các thao tác thêm/xoá admin, không kéo cả hệ thống chờ.
    if (!_anaAcquireNamedLock('admin_roles_write_lock_v1', 10000, 15000)) {
      return JSON.stringify({ success: false, error: 'Hệ thống đang bận, vui lòng thử lại sau ít giây.' });
    }
    try {
      var ss = _DS.ss(ADMIN_DB_ID);
      var sheet = ss.getSheetByName(ADMIN_ROLES_SHEET);
      if (!sheet) {
        sheet = ss.insertSheet(ADMIN_ROLES_SHEET);
        sheet.appendRow(['Email', 'Cấp (1/2)', 'Ghi chú', 'Người thêm', 'Ngày thêm']);
      }
      // Check lại 1 lần nữa trong lock để tránh race condition 2 người thêm cùng lúc
      var data = sheet.getDataRange().getValues();
      for (var i = 1; i < data.length; i++) {
        var existed = data[i][0] ? data[i][0].toString().toLowerCase().trim() : '';
        if (existed === newEmail) {
          return JSON.stringify({ success: false, error: 'Email này đã có trong danh sách.' });
        }
      }
      sheet.appendRow([newEmail, 2, note || '', caller, new Date()]);
    } finally {
      _anaReleaseNamedLock('admin_roles_write_lock_v1');
    }

    _admin_invalidateCache();
    getModuleAccess_invalidate(newEmail);
    try { CacheService.getScriptCache().remove('luong_access_v1_' + newEmail.replace(/[^a-z0-9]/g, '_')); } catch(ce) {}
    return JSON.stringify({ success: true });
  } catch(e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_removeAdmin(targetEmail)
 * Xoá 1 admin cấp 2 khỏi danh sách. Chỉ admin cấp 1 mới gọi được.
 * Không cho xoá email failsafe, và không cho tự xoá chính mình.
 */
function spx_removeAdmin(targetEmail) {
  try {
    var caller = Session.getActiveUser().getEmail().toLowerCase().trim();
    var map = _admin_getAdminMap();
    if (map[caller] !== 1) {
      return JSON.stringify({ success: false, error: 'Chỉ admin cấp 1 mới được xoá admin.' });
    }

    targetEmail = (targetEmail || '').toString().toLowerCase().trim();
    if (ADMIN_FAILSAFE_EMAIL.map(function(e){ return e.toLowerCase().trim(); }).indexOf(targetEmail) >= 0) {
      return JSON.stringify({ success: false, error: 'Không thể xoá admin failsafe (được bảo vệ trong code).' });
    }
    if (targetEmail === caller) {
      return JSON.stringify({ success: false, error: 'Không thể tự xoá chính mình. Nhờ 1 admin cấp 1 khác xoá giúp.' });
    }

    // [FIX NGHẼN LOCK 2026-07-24] Đổi sang named lock riêng cho Admin_Roles — xem giải
    // thích đầy đủ ở spx_addAdmin() / saveRiderPlan().
    if (!_anaAcquireNamedLock('admin_roles_write_lock_v1', 10000, 15000)) {
      return JSON.stringify({ success: false, error: 'Hệ thống đang bận, vui lòng thử lại sau ít giây.' });
    }
    var rowToDelete = -1;
    try {
      var ss = _DS.ss(ADMIN_DB_ID);
      var sheet = ss.getSheetByName(ADMIN_ROLES_SHEET);
      if (!sheet) return JSON.stringify({ success: false, error: 'Chưa có sheet Admin_Roles.' });

      var data = sheet.getDataRange().getValues();
      for (var i = 1; i < data.length; i++) {
        var email = data[i][0] ? data[i][0].toString().toLowerCase().trim() : '';
        if (email === targetEmail) { rowToDelete = i + 1; break; }
      }
      if (rowToDelete < 0) {
        return JSON.stringify({ success: false, error: 'Không tìm thấy email này trong danh sách.' });
      }
      sheet.deleteRow(rowToDelete);
    } finally {
      _anaReleaseNamedLock('admin_roles_write_lock_v1');
    }

    _admin_invalidateCache();
    getModuleAccess_invalidate(targetEmail);
    try { CacheService.getScriptCache().remove('luong_access_v1_' + targetEmail.replace(/[^a-z0-9]/g, '_')); } catch(ce) {}
    return JSON.stringify({ success: true });
  } catch(e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

// ============================================================
// DUYỆT ĐĂNG NHẬP TRỰC TIẾP TRÊN INDEX — Admin_Access sheet
// Cột: A=Email | B=Trạng thái đăng nhập (Duyệt/Chờ/Từ chối) | C=Ngày yêu cầu | D=Trạng thái quyền Lương
//
// Cho phép admin cấp 1 HOẶC cấp 2 duyệt/từ chối/thu hồi quyền đăng nhập ngay
// trên UI index, thay vì phải mở Google Sheet Admin_Access và sửa tay cột B.
// checkUserAccess() trong doGet() đọc trực tiếp cột B mỗi lần load trang nên
// không cần invalidate cache — cập nhật có hiệu lực ngay ở lần load kế tiếp.
// ============================================================

/**
 * spx_getPendingAccessList()
 * Trả về toàn bộ danh sách trong Admin_Access để hiển thị modal "Duyệt đăng nhập".
 * Chỉ admin (cấp 1 hoặc cấp 2) mới gọi được.
 * Cột F (tự tạo, không có trong sheet gốc) lưu "thời điểm admin thao tác gần nhất"
 * (duyệt/thu hồi đăng nhập hoặc Lương) — dùng để sắp xếp tab "Đã duyệt" theo thời
 * gian mới nhất lên đầu, thay vì A-Z, giúp tìm ngay tài khoản vừa mới duyệt.
 */
function spx_getPendingAccessList() {
  try {
    var caller = Session.getActiveUser().getEmail().toLowerCase().trim();
    var adminMap = _admin_getAdminMap();
    if (!adminMap[caller]) {
      return JSON.stringify({ success: false, error: 'Chỉ admin mới được xem danh sách duyệt đăng nhập.' });
    }
    // [MỚI — theo quyết định trực tiếp "chỉ tính khi thực sự tải dữ liệu"]

    var ss = _DS.ss(ADMIN_DB_ID);
    var sheet = ss.getSheetByName('Admin_Access');
    if (!sheet) return JSON.stringify({ success: false, error: 'Không tìm thấy sheet Admin_Access.' });

    var data = sheet.getDataRange().getValues();
    var list = [];
    for (var i = 1; i < data.length; i++) {
      if (!data[i][0]) continue;
      // Cột C dùng CHUNG cho cả 2 mục đích: lúc dòng mới tạo (submitAccessRequest)
      // nó là "thời điểm yêu cầu"; sau khi admin duyệt/thu hồi bất kỳ thao tác nào
      // (spx_setAccessLoginStatus / spx_setAccessLuongStatus / spx_setLoginAndLuongStatus)
      // nó bị ghi đè thành "thời điểm thao tác gần nhất" — không dùng cột F riêng nữa.
      var tsRaw = data[i][2]; // cột C
      var tsVal = tsRaw ? tsRaw.toString() : '';
      var tsMs  = tsRaw ? (tsRaw instanceof Date ? tsRaw.getTime() : (new Date(tsRaw)).getTime() || 0) : 0;
      list.push({
        row: i + 1,
        email: data[i][0].toString().trim(),
        statusLogin: data[i][1] ? data[i][1].toString().trim() : '',
        requestedDate: tsVal,
        requestedTs: tsMs,
        statusLuong: data[i][3] ? data[i][3].toString().trim() : '',
        assignedHub: data[i][4] ? data[i][4].toString().trim() : '',
        lastActionDate: tsVal,
        lastActionTs: tsMs
      });
    }
    return JSON.stringify({ success: true, list: list, myEmail: caller, myLevel: adminMap[caller] });
  } catch(e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_setAccessLoginStatus(email, status)
 * Cập nhật cột B (trạng thái đăng nhập) trong Admin_Access cho 1 email.
 * status hợp lệ: 'Duyệt' | 'Chờ' (đúng 2 giá trị của dropdown trong sheet thật).
 * Nếu email chưa có trong sheet (admin muốn cấp quyền trước cho ai đó chưa
 * từng đăng nhập lần nào) → tự thêm dòng mới luôn (upsert), để admin không
 * cần chờ user bấm "Gửi yêu cầu" trước.
 * Cũng ghi lại thời điểm thao tác vào cột C (dùng chung với thời điểm yêu cầu ban đầu) để tab "Đã duyệt" sắp mới nhất lên đầu.
 * Admin cấp 1 HOẶC cấp 2 đều gọi được (kiểm tra server-side).
 */
function spx_setAccessLoginStatus(email, status) {
  try {
    var caller = Session.getActiveUser().getEmail().toLowerCase().trim();
    var adminMap = _admin_getAdminMap();
    if (!adminMap[caller]) {
      return JSON.stringify({ success: false, error: 'Chỉ admin mới được duyệt đăng nhập.' });
    }

    var validStatus = ['Duyệt', 'Chờ'];
    if (validStatus.indexOf(status) < 0) {
      return JSON.stringify({ success: false, error: 'Trạng thái không hợp lệ.' });
    }

    email = (email || '').toString().toLowerCase().trim();
    if (!email || email.indexOf('@') < 0) {
      return JSON.stringify({ success: false, error: 'Email không hợp lệ.' });
    }

    // [FIX NGHẼN LOCK 2026-07-24] TRƯỚC ĐÂY dùng thẳng LockService.getScriptLock() —
    // đây chính là nguyên nhân nút "Duyệt"/"+ Lương" ở modal "Duyệt đăng nhập" phải
    // bấm nhiều lần mới ăn: khoá toàn cục này bị 15+ hàm khác dùng chung (Rider Plan,
    // KPIFail Notes, Analytics snapshot...) nên mỗi cú Duyệt phải xếp hàng sau các thao
    // tác nặng không liên quan, dễ vượt quá 10s chờ và lỗi âm thầm. Đổi sang named lock
    // riêng cho Admin_Access qua _anaAcquireNamedLock() (đã có sẵn, dùng chung).
    if (!_anaAcquireNamedLock('admin_access_write_lock_v1', 10000, 15000)) {
      return JSON.stringify({ success: false, error: 'Hệ thống đang bận, vui lòng thử lại sau ít giây.' });
    }
    var wasNew = false;
    var now = new Date();
    try {
      var ss = _DS.ss(ADMIN_DB_ID);
      var sheet = ss.getSheetByName('Admin_Access');
      if (!sheet) return JSON.stringify({ success: false, error: 'Không tìm thấy sheet Admin_Access.' });

      var data = sheet.getDataRange().getValues();
      var found = false;
      for (var i = 1; i < data.length; i++) {
        var e = data[i][0] ? data[i][0].toString().toLowerCase().trim() : '';
        if (e === email) {
          sheet.getRange(i + 1, 2, 1, 2).setValues([[status, now]]); // cột B, C (gộp 1 lần ghi thay vì 2)
          found = true;
          break;
        }
      }
      if (!found) {
        sheet.appendRow([email, status, now]); // cột C (vị trí 3) đã là now, không cần ghi thêm
        wasNew = true;
      }
    } finally {
      try { _accInvalidate_(); } catch (eAccInv) {}
      _anaReleaseNamedLock('admin_access_write_lock_v1');
    }

    return JSON.stringify({ success: true, email: email, status: status, wasNew: wasNew, approvedBy: caller });
  } catch(e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_setAccessLuongStatus(email, status)
 * Cập nhật cột D (trạng thái duyệt truy cập Lương) trong Admin_Access cho 1 email.
 * status hợp lệ: 'Duyệt' | 'Chờ'. Chỉ tác động lên dòng đã tồn tại (không upsert,
 * vì quyền Lương chỉ có ý nghĩa với user đã có trong hệ thống — nếu chưa có dòng
 * thì phải duyệt đăng nhập trước bằng spx_setAccessLoginStatus).
 * Cũng ghi lại thời điểm thao tác vào cột C (dùng chung với thời điểm yêu cầu ban đầu) để tab "Đã duyệt" sắp mới nhất lên đầu.
 * Admin cấp 1 HOẶC cấp 2 đều gọi được (kiểm tra server-side).
 */
function spx_setAccessLuongStatus(email, status) {
  try {
    var caller = Session.getActiveUser().getEmail().toLowerCase().trim();
    var adminMap = _admin_getAdminMap();
    if (!adminMap[caller]) {
      return JSON.stringify({ success: false, error: 'Chỉ admin mới được duyệt quyền Lương.' });
    }

    var validStatus = ['Duyệt', 'Chờ'];
    if (validStatus.indexOf(status) < 0) {
      return JSON.stringify({ success: false, error: 'Trạng thái không hợp lệ.' });
    }

    email = (email || '').toString().toLowerCase().trim();
    if (!email || email.indexOf('@') < 0) {
      return JSON.stringify({ success: false, error: 'Email không hợp lệ.' });
    }

    // [FIX NGHẼN LOCK 2026-07-24] Đổi sang named lock riêng cho Admin_Access — xem giải
    // thích đầy đủ ở spx_setAccessLoginStatus() / saveRiderPlan().
    if (!_anaAcquireNamedLock('admin_access_write_lock_v1', 10000, 15000)) {
      return JSON.stringify({ success: false, error: 'Hệ thống đang bận, vui lòng thử lại sau ít giây.' });
    }
    var found = false;
    try {
      var ss = _DS.ss(ADMIN_DB_ID);
      var sheet = ss.getSheetByName('Admin_Access');
      if (!sheet) return JSON.stringify({ success: false, error: 'Không tìm thấy sheet Admin_Access.' });

      var data = sheet.getDataRange().getValues();
      for (var i = 1; i < data.length; i++) {
        var e = data[i][0] ? data[i][0].toString().toLowerCase().trim() : '';
        if (e === email) {
          sheet.getRange(i + 1, 3, 1, 2).setValues([[new Date(), status]]); // cột C, D (gộp 1 lần ghi thay vì 2)
          found = true;
          break;
        }
      }
    } finally {
      try { _accInvalidate_(); } catch (eAccInv) {}
      _anaReleaseNamedLock('admin_access_write_lock_v1');
    }
    if (!found) return JSON.stringify({ success: false, error: 'Không tìm thấy email này — cần duyệt đăng nhập trước.' });

    // Xoá cache quyền Lương của user này (spx_checkLuongAccess dùng ScriptCache 300s)
    try {
      CacheService.getScriptCache().remove('luong_access_v1_' + email.replace(/[^a-z0-9]/g, '_'));
    } catch(ce) {}

    return JSON.stringify({ success: true, email: email, status: status, approvedBy: caller });
  } catch(e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_setLoginAndLuongStatus(email)
 * Duyệt CÙNG LÚC cột B (đăng nhập) VÀ cột D (Lương) = 'Duyệt' cho 1 email,
 * trong 1 lần lock + 1 lần đọc/ghi sheet — dùng cho nút "Duyệt + Lương" ở tab
 * "Chờ duyệt", để admin không cần bấm 2 lần (duyệt đăng nhập xong lại phải
 * qua tab "Đã duyệt" tìm email đó lần nữa để bấm duyệt Lương).
 * Nếu email chưa có dòng (cấp quyền trước cho người chưa từng gửi yêu cầu)
 * thì upsert luôn, giống spx_setAccessLoginStatus.
 * Admin cấp 1 HOẶC cấp 2 đều gọi được (kiểm tra server-side).
 */
function spx_setLoginAndLuongStatus(email) {
  try {
    var caller = Session.getActiveUser().getEmail().toLowerCase().trim();
    var adminMap = _admin_getAdminMap();
    if (!adminMap[caller]) {
      return JSON.stringify({ success: false, error: 'Chỉ admin mới được duyệt quyền.' });
    }

    email = (email || '').toString().toLowerCase().trim();
    if (!email || email.indexOf('@') < 0) {
      return JSON.stringify({ success: false, error: 'Email không hợp lệ.' });
    }

    // [FIX NGHẼN LOCK 2026-07-24] Đổi sang named lock riêng cho Admin_Access — xem giải
    // thích đầy đủ ở spx_setAccessLoginStatus() / saveRiderPlan(). Đây chính là nút
    // "+ Lương" ở tab "Chờ duyệt" mà user báo phải bấm nhiều lần mới ăn.
    if (!_anaAcquireNamedLock('admin_access_write_lock_v1', 10000, 15000)) {
      return JSON.stringify({ success: false, error: 'Hệ thống đang bận, vui lòng thử lại sau ít giây.' });
    }
    var wasNew = false;
    var now = new Date();
    try {
      var ss = _DS.ss(ADMIN_DB_ID);
      var sheet = ss.getSheetByName('Admin_Access');
      if (!sheet) return JSON.stringify({ success: false, error: 'Không tìm thấy sheet Admin_Access.' });

      var data = sheet.getDataRange().getValues();
      var found = false;
      for (var i = 1; i < data.length; i++) {
        var e = data[i][0] ? data[i][0].toString().toLowerCase().trim() : '';
        if (e === email) {
          sheet.getRange(i + 1, 2, 1, 3).setValues([['Duyệt', now, 'Duyệt']]); // cột B,C,D (gộp 1 lần ghi thay vì 3)
          found = true;
          break;
        }
      }
      if (!found) {
        // Cấp trước cho email chưa từng gửi yêu cầu: appendRow rồi set thêm cột D
        sheet.appendRow([email, 'Duyệt', now]); // cột C (vị trí 3) đã là now
        sheet.getRange(sheet.getLastRow(), 4).setValue('Duyệt'); // cột D
        wasNew = true;
      }
    } finally {
      try { _accInvalidate_(); } catch (eAccInv) {}
      _anaReleaseNamedLock('admin_access_write_lock_v1');
    }

    try { CacheService.getScriptCache().remove('luong_access_v1_' + email.replace(/[^a-z0-9]/g, '_')); } catch(ce) {}

    return JSON.stringify({ success: true, email: email, wasNew: wasNew, approvedBy: caller });
  } catch(e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

// ============================================================

// --- ĐIỀU HƯỚNG & BẢO MẬT (DOGET) ---

// ============================================================

function doGet(e) {

  // [RESILIENCE FIX 2026-08] Trước đây nếu checkUserAccess() ném lỗi (VD sheet
  // Admin_Access tạm thời không mở được, quota Sheets API hết tạm thời, v.v.) thì
  // toàn bộ doGet() crash — nghĩa là MỌI người dùng, không chỉ 1 người, đều thấy
  // trang lỗi Apps Script xấu xí thay vì app, cho tới khi lỗi tự hết. Bọc try/catch
  // để lỗi tạm thời chỉ hiển thị 1 trang thông báo dễ hiểu + không văng traceback kỹ
  // thuật ra cho end-user, thay vì làm cả hệ thống "sập" theo đúng nghĩa đen.
  var userEmail = '';
  var isApproved = false;
  try {
    userEmail  = Session.getActiveUser().getEmail();
    isApproved = checkUserAccess(userEmail);
  } catch (eAuth) {
    _LOG && _LOG.d && _LOG.d('[doGet] Lỗi kiểm tra quyền truy cập: ' + eAuth.message);
    return HtmlService.createHtmlOutput(
      '<div style="font-family:sans-serif;max-width:480px;margin:80px auto;text-align:center;color:#334155">' +
      '<h2 style="color:#dc2626">Hệ thống đang bận</h2>' +
      '<p>Không thể xác thực quyền truy cập lúc này (có thể do đang tải cao điểm). ' +
      'Vui lòng tải lại trang sau ít phút. Nếu vẫn lỗi, liên hệ quản trị viên.</p></div>'
    ).setTitle('SPX HUB · FLM Assistant — Đang bận');
  }

  if (!isApproved) {

    var template = HtmlService.createTemplateFromFile('UI_RequestAccess');

    template.userEmail = userEmail;

    try {
      return template.evaluate()
        .setTitle('SPX HUB · FLM Assistant — Yêu cầu truy cập')
        .addMetaTag('viewport', 'width=device-width, initial-scale=1')
        .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
    } catch (eEval1) {
      // [RESILIENCE FIX 2026-08] template.evaluate() thực thi các scriptlet <?= ?> —
      // nếu lỗi giữa chừng (hiếm, nhưng có thể xảy ra), trả về thông báo thay vì để
      // lỗi Apps Script mặc định hiển thị cho người dùng.
      _LOG && _LOG.d && _LOG.d('[doGet] Lỗi render UI_RequestAccess: ' + eEval1.message);
      return HtmlService.createHtmlOutput(
        '<div style="font-family:sans-serif;max-width:480px;margin:80px auto;text-align:center;color:#334155">' +
        '<h2 style="color:#dc2626">Hệ thống đang bận</h2><p>Vui lòng tải lại trang sau ít phút.</p></div>'
      ).setTitle('SPX HUB · FLM Assistant — Đang bận');
    }

  }

  var page        = e.parameter.page || 'index';

  // [FIX 2026-08] Trước đây switch-case này trỏ tới nhiều tên file KHÔNG khớp file
  // thật trong project ('UI_Pick', 'UI_TonDong', 'UI_QuaHan', 'tinhluong', 'UI_DoiSoat'
  // đều không tồn tại; 'JS_Rider_Plan'/'Index' sai case so với 'JS_Rider_plan'/'index'
  // thật) — bấm các link ?page=pick/tondong/salary/doisoat/riderplan (hoặc cả link mặc
  // định nếu tên file thật đúng là chữ thường) sẽ làm HtmlService ném lỗi "file không
  // tồn tại trong project", tức là link chết. Các module đó nay đều đã chuyển hẳn sang
  // kiến trúc SPA (include tĩnh trong index, hoặc lazy-load qua getModuleHtml) nên
  // không còn cần trang riêng — nay mọi case không khớp file thật đều fallback an toàn
  // về SPA chính thay vì crash. Chỉ giữ 2 case còn thật sự có file riêng.
  var htmlTemplate = 'index';

  switch (page.toLowerCase()) {

    case 'tracuu':   htmlTemplate = 'JS_Tracuu'; break;

    case 'tailieu':  htmlTemplate = 'JS_TaiLieu'; break;

    case 'kpifail':  htmlTemplate = 'JS_KPIFail';  break;

    // [FIX 2026-08-16] Trang THỬ NGHIỆM giao diện tái cấu trúc theo phân cấp mới
    // (Admin>ROM>AOM>SUP>Lead>Staff) — HOÀN TOÀN TÁCH BIỆT khỏi index.html thật,
    // chỉ truy cập được khi gõ đúng ?page=uitest, không ảnh hưởng bất kỳ user nào
    // đang dùng hệ thống bình thường. Nếu file UI_Rebuild_Test chưa tồn tại (chưa
    // deploy bản thử), cơ chế fallback ở dưới tự động quay về index thật, không lỗi.
    case 'uitest':   htmlTemplate = 'UI_Rebuild_Test'; break;

    // Mọi giá trị khác (kể cả 'pick','tondong','quahan','salary','doisoat','riderplan',
    // hoặc không truyền 'page') → dùng Index SPA, các module đó nay tải qua include()
    // tĩnh hoặc getModuleHtml() lazy-load bên trong SPA, không tách trang riêng nữa.
    default:         htmlTemplate = 'index';      break;

  }

  var template;
  try {
    template = HtmlService.createTemplateFromFile(htmlTemplate);
  } catch (eTpl) {
    // [RESILIENCE FIX] Nếu tên file bị gõ sai / bị xoá trong tương lai, đừng để cả
    // trang trắng xoá — fallback về SPA chính thay vì crash toàn bộ.
    _LOG && _LOG.d && _LOG.d('[doGet] Không tải được template "' + htmlTemplate + '": ' + eTpl.message + ' — fallback về index.');
    template = HtmlService.createTemplateFromFile('index');
  }

  template.userName = userEmail.split('@')[0].toUpperCase();

  try {
    return template.evaluate()
      // [ĐỔI TÊN — theo yêu cầu] Trước đây: 'SPX HUB SYSTEM - INDEX' (tên từ bản rất
      // cũ, lộ cả tên file kỹ thuật 'INDEX'). Nay dùng đúng tên in dưới logo.
      .setTitle((!page || String(page).toLowerCase() === 'index') ? 'SPX HUB · FLM Assistant' : ('SPX HUB · FLM Assistant — ' + page))
      .addMetaTag('viewport', 'width=device-width, initial-scale=1')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  } catch (eEval2) {
    // [RESILIENCE FIX 2026-08] Cùng lý do như nhánh UI_RequestAccess ở trên — lỗi
    // giữa lúc render (kể cả lỗi từ include() bên trong template) không nên làm
    // trang trắng xoá hoàn toàn.
    _LOG && _LOG.d && _LOG.d('[doGet] Lỗi render template "' + htmlTemplate + '": ' + eEval2.message);
    return HtmlService.createHtmlOutput(
      '<div style="font-family:sans-serif;max-width:480px;margin:80px auto;text-align:center;color:#334155">' +
      '<h2 style="color:#dc2626">Không tải được trang</h2>' +
      '<p>Đã có lỗi khi hiển thị trang. Vui lòng tải lại. Nếu vẫn lỗi, liên hệ quản trị viên.</p></div>'
    ).setTitle('SPX HUB · FLM Assistant — Lỗi tải trang');
  }

}

// ============================================================

// --- MODULE 2: QUẢN LÝ TỒN ĐỌNG ---

// ============================================================

function onhold_processFMSInMemory(csvString) {

  if (!csvString) return { error: "Dữ liệu trống." };

  try {

    const data    = Utilities.parseCsv(csvString);

    const headers = data[0].map(h => h.trim());

    const findIdx = (name) => headers.findIndex(h => h.toLowerCase() === name.toLowerCase());

    const c = {

      id: findIdx('Order ID'), ward: findIdx('Ward Name'), reason: findIdx('OnHoldReason'),

      status: findIdx('Status'), cur: findIdx('Current Station'), dest: findIdx('Destination Station'),

      attempts: findIdx('Delivery Attempts'), recTime: findIdx('Current Station Received Time'),

      // [MỚI — theo yêu cầu trực tiếp] Tổng số LƯỢT GIAO của đơn, để theo dõi
      // trực quan đơn nào đã đi giao nhiều lần mà vẫn chưa xong.
      holdTimes: findIdx('Total of On Hold Times')

    };

    // [FIX 2026-06] ĐIỀU KIỆN ĐÚNG: một đơn chỉ thật sự là "tồn đọng của trạm X" khi
    // Current Station === Destination Station === X — tức đơn đã VỀ ĐÚNG trạm chịu
    // trách nhiệm xử lý. Nếu Current Station khác Destination Station, đơn đang ở
    // trạm trung gian (vd trạm cha/FM "Krông Pắk Hub" chưa chuyển xuống trạm con/LM
    // "Krông Pắk 02 Hub") hoặc lạc tuyến thật sự — KHÔNG được tính là backlog của bất
    // kỳ trạm nào lúc này (gộp vào trạm đích sẽ tạo backlog ảo cho trạm chưa nhận hàng;
    // gộp vào trạm hiện tại thì sai trách nhiệm xử lý). Các đơn này bị loại khỏi thống
    // kê chính, gom riêng vào danh sách `inTransitExceptions` để soi nếu cần.
    // (Trước đó gom theo Current Station đơn thuần → bị tách 1 trạm thật thành 5 "hub"
    // ảo do đơn lạc tuyến/transit; sau đó cân nhắc đổi sang Destination Station đơn
    // thuần → lại đếm nhầm backlog cho trạm chưa thực nhận hàng. Cả hai đều sai.)

    let apptIdx = findIdx('Reschedule Time');

    if (apptIdx === -1) apptIdx = 26;

    // [SỬA — theo yêu cầu trực tiếp "kiểm tra đủ cột cần thiết, báo rõ thiếu cột
    // gì"] Trước đây chỉ kiểm tra 2 cột (Order ID, Status) — mọi cột khác thiếu
    // thì KHÔNG báo lỗi, chỉ âm thầm đọc ra undefined/rỗng, số liệu sai nhưng
    // trông vẫn chạy "thành công" bình thường. Nay chia 2 mức:
    //
    // (A) BẮT BUỘC — thiếu thì DỪNG HẲN, báo lỗi rõ tên cột: Order ID, Status, và
    //     Current Station. Current Station thêm vào danh sách bắt buộc vì nó quyết
    //     định TOÀN BỘ cơ chế gom theo trạm (hub) — thiếu cột này thì mọi dòng đều
    //     có hub=undefined, bị lọc sạch ở dòng "if (!hub ...) return;" bên dưới,
    //     kết quả trả về sẽ là "thành công" nhưng 0 đơn — trông như "không có tồn
    //     đọng nào" trong khi thực ra là FILE SAI, cực kỳ dễ gây hiểu nhầm nguy
    //     hiểm nếu không chặn ngay từ đầu.
    //
    // (B) MỀM — thiếu thì VẪN CHẠY (giữ hành vi cũ, không phá luồng xử lý bình
    //     thường), nhưng gom lại thành danh sách trả về cho giao diện tự quyết định
    //     hiển thị cảnh báo hay không — đúng tinh thần đã làm với destColMissing
    //     (xem ngay bên dưới), nay áp dụng thống nhất cho các cột còn lại.
    const REQUIRED_HARD = [['Order ID', 'id'], ['Status', 'status'], ['Current Station', 'cur']];
    const missingHardCols = REQUIRED_HARD.filter(function(p){ return c[p[1]] === -1; }).map(function(p){ return p[0]; });
    if (missingHardCols.length) {
      return { error: 'File FMS thiếu cột bắt buộc: ' + missingHardCols.join(', ') + '. Không thể xử lý — kiểm tra lại file export.' };
    }
    const REQUIRED_SOFT = [
      ['Ward Name', 'ward'], ['OnHoldReason', 'reason'], ['Delivery Attempts', 'attempts'],
      ['Current Station Received Time', 'recTime'], ['Total of On Hold Times', 'holdTimes']
    ];
    const missingSoftCols = REQUIRED_SOFT.filter(function(p){ return c[p[1]] === -1; }).map(function(p){ return p[0]; });

    let hubData = {};
    const inTransitExceptions = []; // đơn Current != Destination — chưa về đúng trạm
    // [DEBUG 2026-06] Nếu không tìm thấy cột Destination Station, hàm sẽ fallback về
    // hành vi cũ (không lọc gì) để không crash — nhưng phải BÁO RÕ ra ngoài thay vì
    // âm thầm fallback, để dễ truy khi dropdown vẫn hiện nhiều hub sau khi đã fix.
    const destColMissing = (c.dest === -1);
    if (destColMissing) {
      _LOG.d('[FMS WARNING] Không tìm thấy cột "Destination Station" trong file CSV. Headers thực tế: ' + JSON.stringify(headers));
    }

    const validRows = data.slice(1).filter(r => c.dest === -1 || r[c.cur] === r[c.dest]);

    const hubs  = [...new Set(validRows.map(r => r[c.cur]))].filter(h => h);

    hubs.forEach(h => { hubData[h] = { stats: [0,0,0,0,0,0,0,0], details: [[],[],[],[],[],[],[]] }; });

    // [SỬA — theo câu hỏi trực tiếp "sai lệch số liệu giữa các lần upload"]
    // TRƯỚC: "now" lấy theo ĐỒNG HỒ LÚC BẤM UPLOAD (new Date()) — upload ĐÚNG 1
    // file CSV lúc 9h sáng và 5h chiều cùng ngày sẽ ra diffDays khác nhau cho MỌI
    // đơn, có thể đẩy đơn đang ở sát ranh giới 3 ngày / 5 ngày sang nhóm "Tồn"
    // khác giữa 2 lần upload. Luồng Live không bị lỗi này vì nó đọc thẳng bucket
    // aging_leadtime có sẵn từ nguồn — nhưng file tải tay KHÔNG có cột tương
    // đương (đã xác nhận bằng chính file CSV mẫu được cung cấp, chỉ có "Current
    // Station Received Time", không có "Aging Leadtime"). NAY: neo "now" vào
    // chính mốc THỜI GIAN MỚI NHẤT xuất hiện TRONG DỮ LIỆU (giá trị lớn nhất của
    // cột "Current Station Received Time" trên toàn file) thay vì đồng hồ xử lý —
    // mốc này nằm SẴN TRONG FILE, nên upload lại ĐÚNG file đó bất kỳ lúc nào
    // cũng luôn ra CÙNG 1 kết quả. Chỉ rơi về đồng hồ thật nếu file không có nổi
    // 1 giá trị hợp lệ (vd thiếu cột, hoặc toàn bộ ô trống/sai định dạng).
    let now = null;
    data.slice(1).forEach(function(r){
      if (c.recTime === -1) return;
      var t = new Date(r[c.recTime]);
      if (!isNaN(t.getTime()) && (!now || t.getTime() > now.getTime())) now = t;
    });
    var _nowIsFromData = !!now;
    if (!now) now = new Date(); // dự phòng — không có mốc nào trong file thì mới dùng đồng hồ thật

    data.slice(1).forEach(r => {

      // Đơn chưa về đúng trạm đích → không tính vào backlog của trạm nào, chỉ ghi nhận riêng
      if (c.dest !== -1 && r[c.cur] !== r[c.dest]) {
        if (r[c.id]) inTransitExceptions.push({ id: r[c.id], current: r[c.cur], destination: r[c.dest] });
        return;
      }

      const hub    = r[c.cur];

      const status = (r[c.status] || "").toString().trim();

      if (!hub || !hubData[hub] || !status.includes('Received')) return;

      const reason   = (r[c.reason] || "").toString().trim().toLowerCase();

      const attempts = parseInt(r[c.attempts]) || 0;

      const target   = hubData[hub];

      const zoneId  = (r.length > 37 && r[37]) ? r[37].toString().trim() : "N/A";

      const account = (r.length > 22 && r[22]) ? r[22].toString().trim() : "N/A";

      let appointmentDate = "/";

      if (apptIdx !== -1 && r.length > apptIdx && r[apptIdx]) {

        let rawDate = r[apptIdx].toString().trim();

        if (rawDate !== "0" && rawDate !== "" && rawDate.toLowerCase() !== "null" && rawDate.toLowerCase() !== "n/a") {

          let match = rawDate.match(/^(\d{4})-(\d{2})-(\d{2})/);

          appointmentDate = match ? match[3]+"/"+match[2]+"/"+match[1] : rawDate.substring(0,10);

        }

      }

      // [FIX] Tính recTime TRƯỚC khi build rowData để có thể đính kèm "Ngày Nhập Kho"
      // (r[6], định dạng ISO yyyy-MM-dd) vào cả rowData lẫn agingRow — trước đây
      // frontend (renderTableFMS trong JS_FMS.html) đã đọc r[6] cho cột "Ngày Nhập
      // Kho" và cho filter dropdown tương ứng, nhưng backend chưa từng gửi phần tử
      // này xuống nên cột đó luôn hiện "—" và bộ lọc luôn trống.
      const recTime = new Date(r[c.recTime]);
      const recTimeValid = !isNaN(recTime.getTime());
      const recTimeIso = recTimeValid ? Utilities.formatDate(recTime, "GMT+7", "yyyy-MM-dd") : "";

      // [MỚI] Thêm số lượt giao vào CUỐI mảng (index 7) — cố ý thêm ở cuối để
      // KHÔNG làm lệch index của 7 trường cũ, mọi nơi đang đọc row[0..6] vẫn
      // chạy y nguyên, không phải sửa theo.
      const holdTimes = parseInt(r[c.holdTimes], 10) || 0;
      const rowData = [r[c.id], zoneId, r[c.ward], account, r[c.reason], appointmentDate, recTimeIso, holdTimes];

      // [SỬA — đồng bộ với _fmsLive_classifyByAction_ theo yêu cầu trực tiếp]
      // Luồng TẢI FILE này phân loại theo VĂN BẢN lý do (không có mã như luồng
      // Live), nên phải áp cùng 2 quy tắc, nếu không 2 chế độ cho số KHÁC NHAU
      // trên cùng 1 trạm — đúng loại sai lệch khó phát hiện nhất.
      //
      // Quy tắc 1: "Buyer Never Place" -> HOÀN HÀNG (nhóm 4).
      //   Trước đây chuỗi này không khớp 'reject'/'cancel' nên rơi xuống nhánh
      //   cuối = Delay Khác. Nay bắt riêng, khớp đúng luồng Live (mã 13).
      //   Đơn VẪN được tính vào tổng tồn tại hub như mọi nhóm khác.
      //
      // Quy tắc 2: đơn đã 3+ lần giao NHƯNG lý do cuối là "Insufficient time"
      //   -> DELAY KHÁC (nhóm 2), không phải Quá 3 Ca. Lý do nghiệp vụ: giao
      //   không kịp ca, ca sau vẫn đi giao — chưa thể cập nhật hoàn hàng.
      //   Phải đặt TRƯỚC nhánh 'attempts >= 3' thì mới có tác dụng.
      //
      // Quy tắc 3: [MỚI — theo yêu cầu trực tiếp "Unable to Deliver vô phần
      //   hoàn hàng, không tính vào phần đơn hàng cần giao"] Đồng bộ với mã
      //   182 vừa thêm vào FMS_REASON_CODE_MAP ở luồng Live — luồng TẢI FILE
      //   này không có mã, chỉ có văn bản, nên bắt riêng theo chuỗi.
      if (reason.includes('buyer never place')) { target.stats[4]++; target.details[4].push(rowData); }

      else if (reason.includes('unable to deliver')) { target.stats[4]++; target.details[4].push(rowData); }

      else if (reason.includes('reject') || reason.includes('cancel')) { target.stats[4]++; target.details[4].push(rowData); }

      else if (attempts >= 3 && reason.includes('insufficient time')) { target.stats[2]++; target.details[2].push(rowData); }

      else if (attempts >= 3)            { target.stats[3]++; target.details[3].push(rowData); }

      else if (reason.includes('reschedule')) { target.stats[1]++; target.details[1].push(rowData); }

      else if (reason === 'normal' || reason === "") { target.stats[0]++; target.details[0].push(rowData); }

      else                               { target.stats[2]++; target.details[2].push(rowData); }

      if (recTimeValid) {

        const diffDays = (now.getTime() - recTime.getTime()) / 86400000;

        const agingRow = [r[c.id], zoneId, r[c.ward], account, r[c.reason], diffDays.toFixed(1)+" ngày", recTimeIso];

        if (diffDays >= 3 && diffDays <= 5) { target.stats[5]++; target.details[5].push(agingRow); }

        else if (diffDays > 5)              { target.stats[6]++; target.details[6].push(agingRow); }

      }

      target.stats[7]++;

    });

    // ── ALERT HOOK: push cảnh báo FMS vào Alert_Aggregate theo từng hub ──
    // stats[idx]: [0]Đơn Mới [1]Hẹn Giao [2]Delay Khác [3]Quá 3 Ca [4]Hoàn Hàng [5]Tồn3-5N [6]Tồn>5N [7]Total
    // [MỚI — "Top On-hold Reason" cho Manual, đồng bộ với Live] Live
    // (fms_live_getSnapshot) đã có exceptions.reasonTop từ lâu — Manual dùng
    // CHUNG cấu trúc stats[]/details[] (đã xác nhận qua comment trên: cùng 8
    // category y hệt Live) nên tái dùng ĐÚNG logic đó: chỉ đếm reason ở các
    // nhóm "ngoại lệ thật" — Hẹn giao/Delay khác/Quá 3 ca/Hoàn hàng (1-4) và
    // Tồn >5N (6) — KHÔNG tính nhóm "Đơn mới bình thường" (0) hay Tồn 3-5N (5,
    // chưa đủ nghiêm trọng). reason lấy ở ĐÚNG vị trí index 4 của rowData/
    // agingRow — cùng vị trí Live đang đọc (row[4]) — không phải suy đoán.
    // Tính RIÊNG theo từng hub (không gộp toàn bộ) vì Manual vốn duyệt dữ liệu
    // theo từng hub một qua dropdown, khác Live (có thể xem gộp nhiều hub).
    hubs.forEach(function(h) {
      var hd = hubData[h];
      if (!hd) return;
      var reasonCounts = {};
      [1, 2, 3, 4, 6].forEach(function(catIdx) {
        (hd.details[catIdx] || []).forEach(function(row) {
          var reasonKey = (row[4] || 'N/A').toString();
          reasonCounts[reasonKey] = (reasonCounts[reasonKey] || 0) + 1;
        });
      });
      hd.reasonTop = Object.keys(reasonCounts).map(function(k) { return { reason: k, count: reasonCounts[k] }; })
        .sort(function(a, b) { return b.count - a.count; }).slice(0, 8);
    });
    hubs.forEach(function(h) {
      var stats = hubData[h] ? hubData[h].stats : null;
      if (!stats) return;
      var qua3ca   = stats[3] || 0;
      var ton5n    = stats[6] || 0;
      var total    = stats[7] || 0;
      if (total === 0) return;
      var sev = (qua3ca > 0 || ton5n > 0) ? 3 : 2;
      _pushAlert_({
        stationName: h,
        source:      'fms',
        severity:    sev,
        entityRef:   '',
        message:     'FMS tổng hợp: ' + total + ' đơn tồn' +
                     (qua3ca > 0 ? ', ' + qua3ca + ' quá 3 ca' : '') +
                     (ton5n  > 0 ? ', ' + ton5n  + ' tồn >5N'  : '')
      });
    });

    // [MỚI] Trả kèm mốc "now" đã dùng để tính Tồn 3-5N/Tồn >5N — để giao diện có
    // thể hiện rõ "tính theo thời điểm nào", tránh thắc mắc khi 2 lần upload cùng
    // 1 file ra số khác nhau (trường hợp hiếm, file không có mốc hợp lệ nào).
    return { success: true, hubs: hubs.sort(), data: hubData, inTransitExceptions: inTransitExceptions, destColMissing: destColMissing, _debugHeaders: destColMissing ? headers : undefined, asOfTime: now.toISOString(), asOfFromData: _nowIsFromData, missingColumns: missingSoftCols };

  } catch (e) { return { error: e.message }; }

}

/**
 * ============================================================
 * BACKEND - MODULE 3: TRA CỨU (CẬP NHẬT MỚI)
 * Thay thế 3 hàm cũ: tracuu_getAllWards, tracuu_getAllHubs, search_searchSortCode
 * ============================================================
 *
 * LOGIC MỚI:
 *
 * 1) tracuu_getAllWards()
 *    → Trả về mảng {ward, station} từ sheet Data (cột C = Sort Code/Ward, cột L = Delivery Station1)
 *    → Frontend dùng để gợi ý autocomplete theo xã/phường khi user gõ từng chữ
 *
 * 2) tracuu_getAllHubs()
 *    → Trả về mảng {name, code} từ sheet Mail (cột B = HUB Name FMS, cột C = HUB Code)
 *    → Frontend dùng để gợi ý autocomplete theo tên/mã HUB
 *
 * 3) search_searchSortCode(query, mode)
 *    → mode = 'hub'  : Tìm theo HUB Name (FMS) hoặc HUB Code trong sheet Mail → trả email
 *    → mode = 'ward' : Tìm theo Sort Code/Xã/Phường trong sheet Data → lấy Delivery Station1
 *                      → dùng Delivery Station1 lookup sang sheet Mail → lấy email
 * ============================================================
 */

const TRACUU_SHEET_ID = '1r1jLZNHxbz8xFHJ5C8bne5YMVGXRR_k41i_NU_1TxxU';

// [FIX 2026-07-29] Đọc CHUNG sheet Mail/Data qua cache — trước đây 4 hàm
// (tracuu_getAllWards, tracuu_getAllHubs, search_searchSortCode,
// search_searchSortCode_v2) mỗi hàm tự đọc lại TOÀN BỘ 2 sheet này một cách
// ĐỘC LẬP, dù cùng đọc y hệt 1 nguồn (log Executions: 25-25 lượt/vài tiếng,
// avg vài giây/lượt — cộng dồn không nhỏ). Dữ liệu ward/hub mapping thuộc loại
// tham chiếu, ít khi đổi trong ngày → cache 30 phút là an toàn. Bất kỳ hàm nào
// cần đọc Mail/Data đều nên gọi qua đây thay vì tự getDataRange() riêng.
function _tc_getMailValues_() {
  var cached = CacheMgr.getChunked('TRACUU', 'mail_values_v1');
  if (cached) return cached;
  var sheet = _DS.ss(TRACUU_SHEET_ID).getSheetByName('Mail');
  var values = sheet ? sheet.getDataRange().getDisplayValues() : [];
  try { CacheMgr.setChunked('TRACUU', 'mail_values_v1', values, 1800); } catch (e) {}
  return values;
}
function _tc_getDataValues_() {
  var cached = CacheMgr.getChunked('TRACUU', 'data_values_v1');
  if (cached) return cached;
  var sheet = _DS.ss(TRACUU_SHEET_ID).getSheetByName('Data');
  var values = sheet ? sheet.getDataRange().getDisplayValues() : [];
  try { CacheMgr.setChunked('TRACUU', 'data_values_v1', values, 1800); } catch (e) {}
  return values;
}
 
// ----------------------------------------------------------
// HÀM 1: Lấy danh sách xã/phường kèm station (cho autocomplete)
// ----------------------------------------------------------
// ── HÀM 1 ──────────────────────────────────────────
function tracuu_getAllWards() {
  try {
    // [MỚI — theo quyết định trực tiếp "chỉ tính khi thực sự tải dữ liệu"]
    const data = _tc_getDataValues_(); // full rows from cột A, hàng 0 = header
    if (!data || data.length < 2) return [];

    let wards = [], seen = new Set();
    // Cột D (index 3) = Ward/Xã Phường | Cột I (index 8) = Station | Cột J (index 9) = Zone
    for (let i = 1; i < data.length; i++) {
      let ward    = (data[i][3] || '').toString().trim();
      let station = (data[i][8] || '').toString().trim();
      let zoneId  = (data[i][9] || '').toString().trim();
      if (!ward) continue;
      let key = ward + '|' + station + '|' + zoneId;
      if (!seen.has(key)) {
        wards.push({ ward, station, zoneId });
        seen.add(key);
      }
    }
    return wards;
  } catch(e) { _LOG.d('tracuu_getAllWards: ' + e.message); return []; }
}
// ----------------------------------------------------------
// HÀM 2: Lấy danh sách HUB Name + HUB Code (cho autocomplete)
// ----------------------------------------------------------
// ── HÀM 2 ──────────────────────────────────────────
function tracuu_getAllHubs() {
  try {
    const data = _tc_getMailValues_(); // full rows từ cột A, hàng 0 = header
    if (!data || data.length < 2) return [];

    let hubs = [], seen = new Set();
    // Cột B (index 1) = HUB Name (FMS)  |  Cột C (index 2) = HUB Code
    for (let i = 1; i < data.length; i++) {
      let name = (data[i][1] || '').toString().trim();
      let code = (data[i][2] || '').toString().trim();
      if (!name) continue;
      if (!seen.has(name)) { hubs.push({ name, code }); seen.add(name); }
    }
    return hubs;
  } catch(e) { _LOG.d('tracuu_getAllHubs: ' + e.message); return []; }
}
 
 
// ── HÀM 3 ──────────────────────────────────────────
function search_searchSortCode(query, mode) {
  try {
    // [SECURITY FIX — rà soát bảo mật toàn diện] Hàm này trả về danh bạ HUB
    // (tên, mã, email nội bộ, và từ hôm nay có cả địa chỉ/toạ độ) — trước đây
    // KHÔNG kiểm tra người gọi đã đăng nhập/được duyệt hay chưa. Vì Apps
    // Script cho phép gọi THẲNG bất kỳ hàm top-level nào qua
    // google.script.run bất kể frontend có gọi tới hay không, bất kỳ ai tải
    // được URL web app (kể cả chưa được duyệt truy cập) đều lấy được toàn bộ
    // danh bạ này qua console. Gate ở ĐÚNG hàm gốc (không phải chỉ ở
    // search_searchSortCode_v2) vì các Lớp 2-5 của v2 đều gọi lại hàm NÀY —
    // chặn ở đây tự động chặn luôn mọi đường gọi vào, không cần lặp lại.
    _requireApproved_();
    if (!query) return { success: false, error: 'Vui lòng nhập từ khóa!' };
 
    const mailData = _tc_getMailValues_();
    const dbData   = _tc_getDataValues_();
    if (!mailData.length || !dbData.length) return { success: false, error: 'Không tìm thấy sheet!' };
 
    const q        = query.toString().toLowerCase().trim();
    const qNoDia   = _tc_normalizeNoDiacritics(query); // hỗ trợ gõ tắt / gõ thiếu dấu / sai dấu
 
    // Build mail dict: hubName.lower → {email, name, code}
    let mailByName = {};
    for (let i = 1; i < mailData.length; i++) {
      let name  = (mailData[i][1] || '').toString().trim();
      let code  = (mailData[i][2] || '').toString().trim();
      let email = (mailData[i][4] || '').toString().trim();
      if (name) mailByName[name.toLowerCase()] = { email, name, code };
    }
 
    let results = [], seen = new Set();
 
    // MODE HUB: tìm trực tiếp trong sheet Mail
    if (!mode || mode === 'hub') {
      // [MỚI — theo yêu cầu trực tiếp "tra hub trả về địa chỉ, toạ độ luôn"]
      // Tái dùng ĐÚNG nguồn dữ liệu đã dùng ở tab "Trạm quản lý" (Admin) —
      // không tạo nguồn đọc riêng, đảm bảo nhất quán 1 nguồn sự thật duy nhất.
      var hubInfoMap = _spxGetHubInfoMap_().byHub || {};
      var _tcMatched = [], _tcAnyUnmatched = false;
      for (let i = 1; i < mailData.length; i++) {
        let name  = (mailData[i][1] || '').toString().trim();
        let code  = (mailData[i][2] || '').toString().trim();
        let email = (mailData[i][4] || '').toString().trim();
        if (!name) continue;
        if (name.toLowerCase().includes(q) || code.toLowerCase().includes(q)
            || _tc_normalizeNoDiacritics(name).includes(qNoDia)) {
          let key = name + '_' + code;
          if (!seen.has(key)) {
            var _hkey = _orgNormHub_(name);
            if (!hubInfoMap[_hkey]) _tcAnyUnmatched = true;
            _tcMatched.push({ key, name, code, email, hkey: _hkey });
            seen.add(key);
          }
        }
      }
      // [MỚI — TỰ PHỤC HỒI, cùng cơ chế đã kiểm chứng ở "Trạm quản lý" (Admin)]
      // Sheet "Mail" của Tra cứu nằm ở 1 file HOÀN TOÀN KHÁC với "Hub/SOC infor"
      // — nếu cache hub-info đang giữ bản cũ (dựng trước khi trạm này có/đổi
      // tên trong sheet nguồn), tên khớp 100% ngoài thực tế vẫn ra rỗng. Tự
      // làm mới NGAY MỘT LẦN khi phát hiện thiếu khớp, trước khi chịu thua —
      // không bắt Admin phải nhớ bấm "Làm mới cache trạm" mỗi lần.
      if (_tcAnyUnmatched) {
        hubInfoMap = _spxGetHubInfoMap_(true).byHub || hubInfoMap;
      }
      _tcMatched.forEach(function(m) {
        var hInfo = hubInfoMap[m.hkey] || null;
        results.push({ type: 'hub', station: m.name, sortCode: m.code,
                       province: 'Danh bạ HUB', email: m.email || 'Liên hệ quản lý', wardName: '',
                       // [MỚI] Địa chỉ + toạ độ thật từ sheet Hub/SOC infor — không có nghĩa là
                       // rỗng nếu hub chưa có trong sheet đó (VD hub quá mới), frontend tự ẩn
                       // phần này khi address rỗng, không hiện "-" gây rối mắt.
                       address:     hInfo ? hInfo.address  : '',
                       coord:       hInfo ? hInfo.coord    : '',
                       hubProvince: hInfo ? hInfo.province : '',
                       hubCity:     hInfo ? hInfo.city     : '',
                       parentHub:   hInfo ? hInfo.parent   : '',
                       // [MỚI — chẩn đoán] Vẫn không khớp được sau khi đã tự làm mới cache —
                       // gợi ý tên gần giống nhất để lộ ra ngay đây là lệch tên thật (không
                       // phải cache cũ), khỏi phải mở riêng 1 lượt điều tra khác.
                       _hubInfoUnmatched: !hInfo,
                       _hubInfoSuggest: hInfo ? [] : _spxSuggestHubMatches_(m.hkey, hubInfoMap, 3) });
      });
    }
 
    // MODE WARD: tìm trong sheet Data (cấu trúc mới, theo Delivery Hub Zone 5.3)
    // Cột D (index 3)  = ward list -- old ward
    // Cột E (index 4)  = L2 - District
    // Cột F (index 5)  = L1 - Old   (tỉnh/thành TRƯỚC sáp nhập)
    // Cột G (index 6)  = L1 - New   (tỉnh/thành SAU sáp nhập)
    // Cột I (index 8)  = Station name
    // Cột J (index 9)  = Hub zone id (Zone)
    // Cột K (index 10) = Hub zone name
    if (!mode || mode === 'ward') {
      const stationProvinceMap = _tc_getStationProvinceMap(); // { normalizedStation: province } — fallback nếu Data thiếu L1-New
      for (let i = 1; i < dbData.length; i++) {
        let ward        = (dbData[i][3]  || '').toString().trim();  // cột D
        let district     = (dbData[i][4]  || '').toString().trim();  // cột E
        let provinceOld  = (dbData[i][5]  || '').toString().trim();  // cột F
        let provinceNew  = (dbData[i][6]  || '').toString().trim();  // cột G
        let station      = (dbData[i][8]  || '').toString().trim();  // cột I
        let zoneId       = (dbData[i][9]  || '').toString().trim();  // cột J
        let hubZoneName  = (dbData[i][10] || '').toString().trim();  // cột K
        if (!ward || !station) continue;
        if (ward.toLowerCase().includes(q) || _tc_normalizeNoDiacritics(ward).includes(qNoDia)) {
          let mailInfo = mailByName[station.toLowerCase()];
          let key = station + '_' + ward + '_' + zoneId;
          if (!seen.has(key)) {
            let finalProvince = provinceNew || stationProvinceMap[_tc_normalize(station)] || '';
            results.push({
              type:        'ward',
              station,
              sortCode:    mailInfo ? mailInfo.code  : '',
              province:    finalProvince,   // giữ tên field cũ để không vỡ logic cảnh báo trùng tỉnh + frontend cũ
              provinceOld: provinceOld,     // MỚI: tỉnh/thành trước sáp nhập
              provinceNew: provinceNew,     // MỚI: tỉnh/thành sau sáp nhập
              district:    district,        // MỚI: quận/huyện cũ
              hubZoneName: hubZoneName,     // MỚI: tên hub zone
              email:       mailInfo ? mailInfo.email : 'Liên hệ quản lý',
              wardName:    ward,
              zoneId:      zoneId
            });
            seen.add(key);
          }
        }
      }
      // Nếu nhiều tỉnh khác nhau cùng trả kết quả (VD "Xuân Phú" trùng tên ở nhiều nơi),
      // sắp xếp theo tỉnh để các địa danh cùng tên nhưng khác tỉnh không bị xen kẽ lộn xộn
      const provincesInResult = new Set(results.map(r => r.province).filter(Boolean));
      if (provincesInResult.size > 1) {
        results.sort((a, b) => (a.province || '').localeCompare(b.province || '', 'vi'));
      }
    }
 
    return { success: true, data: results };
  } catch(e) { _LOG.d('search_searchSortCode: ' + e.message); return { success: false, error: e.message }; }
}

/**
 * ============================================================
 * MODULE 3B: XỬ LÝ TÌM KIẾM ĐỊA CHỈ SAU SÁP NHẬP XÃ/PHƯỜNG
 * ============================================================
 * search_searchSortCode_v2(query, mode) là ĐIỂM VÀO MỚI cho frontend
 * (thay thế search_searchSortCode trong JS_TraCuu.html).
 *
 * QUAN TRỌNG: sheet Data chỉ lưu tên xã/phường CŨ (trước sáp nhập) và chỉ có
 * cặp Old/New ở cấp TỈNH (cột L1-Old/L1-New) — KHÔNG có bảng ánh xạ Old/New
 * cấp xã/phường nào trong Data để so khớp tĩnh. Vì vậy khi user gõ tên xã/
 * phường MỚI (sau sáp nhập 2025), hệ thống phải "hỏi" 1 công cụ tìm kiếm/AI
 * có kiến thức cập nhật để suy ra (các) tên xã/phường CŨ tương ứng, rồi mới
 * tra tiếp trong Data như bình thường.
 *
 * Luồng xử lý (dừng ngay khi có kết quả ở lớp nào):
 *   Lớp 1: search_searchSortCode gốc (match/includes trực tiếp trong Data)
 *   Lớp 2: tra bảng "ResolvedAlias" đã học từ các lần tra AI/geocode trước đó
 *          — O(1), không tốn API. Hỗ trợ 1 query → NHIỀU xã cũ (N:1 do sáp nhập).
 *   Lớp 3: fuzzy match (Jaccard theo token) trực tiếp trong Data — bắt các
 *          case tên mới còn giữ 1 phần tên cũ, không cần gọi API
 *   Lớp 4: dùng AI SuperAgent (insea.io, _callInsea — cùng hạ tầng AI mascot
 *          đang dùng) như 1 "công cụ tìm kiếm" để suy ra tên xã/phường cũ đã
 *          sáp nhập thành địa danh user gõ. Hỗ trợ trả về NHIỀU xã cũ nếu 1
 *          phường mới gộp từ nhiều phường cũ khác station. Kết quả được lưu
 *          vào ResolvedAlias để lần sau tra thẳng Lớp 2, không gọi AI lại.
 *   Lớp 5: Geocoding API (Nominatim, miễn phí) — phương án cuối cùng nếu Lớp 4
 *          không xác định được (AI lỗi/quota/không chắc chắn).
 *   Không lớp nào ra kết quả → ghi vào sheet "UnresolvedQueries" để đội vận
 *   hành biết còn địa chỉ nào chưa cập nhật, đồng thời báo rõ cho user.
 * ============================================================
 */

const TC_ALIAS_SHEET_NAME = 'ResolvedAlias';
const TC_ALIAS_CACHE_KEY  = 'TC_WARD_ALIAS_MAP';
const TC_ALIAS_CACHE_TTL  = 21600; // 6 giờ (giới hạn CacheService: tối đa 21600s)
const TC_FUZZY_THRESHOLD  = 0.4;   // ngưỡng Jaccard để coi là "đủ giống"

// ── Bổ sung: tra Tỉnh/Thành theo tên Station, để phân biệt các ward TRÙNG TÊN
// nhưng thuộc các tỉnh khác nhau (VD "Xuân Phú" có ở cả Huế lẫn Thanh Hóa).
// Tái dùng bảng "AOM SUP"/"SA" mà module Rider Plan đang dùng (_rp_buildSAMap) —
// không cần tạo thêm dữ liệu, vì Station -> Province đã tồn tại sẵn ở đó.
function _tc_getStationProvinceMap() {
  var cache = CacheService.getScriptCache();
  var cacheKey = 'TC_STATION_PROVINCE_MAP';
  var cached = cache.get(cacheKey);
  if (cached) return JSON.parse(cached);

  var map = {};
  var _tcOk = true;
  try {
    var srcSS = _DS.ss(RP_SOURCE_ID); // sheet "AOM SUP"/"SA", đã dùng cho Rider Plan
    var saMap = _rp_buildSAMap(srcSS); // { hubName: {province, sup} }
    Object.keys(saMap).forEach(function(hub) {
      map[_tc_normalize(hub)] = saMap[hub].province;
    });
  } catch (e) {
    _LOG.d('_tc_getStationProvinceMap: ' + e.message);
    _tcOk = false;
  }
  // [SỬA] Trước đây lỗi đọc hay bản đồ rỗng vẫn bị lưu cache TC_ALIAS_CACHE_TTL (6 GIỜ) -> Tra cứu mất tỉnh của mọi trạm suốt 6 giờ.
  if (_tcOk && Object.keys(map).length > 0) { try { cache.put(cacheKey, JSON.stringify(map), TC_ALIAS_CACHE_TTL); } catch (eC) {} }
  return map;
}

// ── Chuẩn hóa chuỗi: bỏ tiền tố hành chính, dấu câu, khoảng trắng thừa (VẪN GIỮ DẤU) ──
function _tc_normalize(s) {
  return (s || '').toString().normalize('NFC').toLowerCase()
    .replace(/^(xã|phường|thị trấn|tt\.?)\s+/i, '')
    .replace(/[^\p{L}\p{N}\s]/gu, '')
    .replace(/\s+/g, ' ')
    .trim();
}

// ── Bỏ dấu tiếng Việt hoàn toàn — CÙNG LOGIC với hàm norm() ở frontend (JS_TraCuu.html)
// để đảm bảo tìm được cả khi user gõ tắt không dấu (VD "binh thuan" hoặc "bình thuan"
// gõ thiếu dấu vẫn khớp được "Bình Thuận") ──
function _tc_stripDiacritics(s) {
  if (!s) return '';
  return s.toString()
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/đ/gi, 'd')
    .replace(/[^a-z0-9\s]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

// ── Chuẩn hóa "không dấu" đầy đủ (bỏ tiền tố hành chính + bỏ dấu) — dùng làm
// khóa so khớp/alias/cache, để khớp được dù user gõ có dấu, thiếu dấu, hay sai dấu ──
function _tc_normalizeNoDiacritics(s) {
  return _tc_stripDiacritics(_tc_normalize(s));
}

// ── Độ tương đồng theo token (Jaccard) — so khớp KHÔNG DẤU để bắt được cả lỗi gõ tắt/sai dấu ──
function _tc_similarity(a, b) {
  var tokensA = _tc_normalizeNoDiacritics(a).split(' ').filter(Boolean);
  var tokensB = _tc_normalizeNoDiacritics(b).split(' ').filter(Boolean);
  var setB = {}; tokensB.forEach(function(t){ setB[t] = true; });
  var unionSet = {}; tokensA.forEach(function(t){ unionSet[t]=true; }); tokensB.forEach(function(t){ unionSet[t]=true; });
  var inter = 0; tokensA.forEach(function(t){ if (setB[t]) inter++; });
  var unionSize = Object.keys(unionSet).length;
  return unionSize ? inter / unionSize : 0;
}


// ── Lấy (hoặc tạo mới) sheet lưu các alias đã "học" ──
function _tc_getAliasSheet_() {
  var ss = _DS.ss(TRACUU_SHEET_ID);
  var sheet = ss.getSheetByName(TC_ALIAS_SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(TC_ALIAS_SHEET_NAME);
    sheet.appendRow(['OldQueryNorm', 'OldQueryLabel', 'ResolvedNewWard', 'Timestamp']);
    sheet.setFrozenRows(1);
  }
  return sheet;
}

// ── Đọc bảng alias, có cache để không phải đọc sheet mỗi lần search ──
// Trả về { normQuery: [oldWard1, oldWard2, ...] } — hỗ trợ 1 địa danh mới
// gộp từ NHIỀU xã/phường cũ (N:1). Đọc được cả dữ liệu cũ (lưu 1 chuỗi đơn).
function _tc_getResolvedAliasMap() {
  var cache = CacheService.getScriptCache();
  var cached = cache.get(TC_ALIAS_CACHE_KEY);
  if (cached) return JSON.parse(cached);

  var sheet = _tc_getAliasSheet_();
  var map = {};
  var lastRow = sheet.getLastRow();
  if (lastRow >= 2) {
    var data = sheet.getRange(2, 1, lastRow - 1, 3).getDisplayValues();
    data.forEach(function(r) {
      var norm = (r[0] || '').trim();
      var raw  = (r[2] || '').trim();
      if (!norm || !raw) return;
      var arr;
      try { arr = JSON.parse(raw); if (!Array.isArray(arr)) arr = [String(arr)]; }
      catch (e) { arr = [raw]; } // dữ liệu cũ lưu dạng 1 chuỗi đơn — vẫn đọc được bình thường
      arr = arr.map(function(w){ return (w||'').toString().trim(); }).filter(Boolean);
      if (arr.length) map[norm] = arr;
    });
  }
  cache.put(TC_ALIAS_CACHE_KEY, JSON.stringify(map), TC_ALIAS_CACHE_TTL);
  return map;
}

// ── Ghi 1 alias mới đã được xác nhận (từ Lớp 4/5) ──
// oldWards: string (1 xã) hoặc array (nhiều xã cũ gộp thành 1 địa danh mới)
function _tc_saveResolvedAlias(oldQuery, oldWards) {
  try {
    var arr = Array.isArray(oldWards) ? oldWards : [oldWards];
    arr = arr.map(function(w){ return (w||'').toString().trim(); }).filter(Boolean);
    if (!arr.length) return;

    var norm = _tc_normalizeNoDiacritics(oldQuery);
    var sheet = _tc_getAliasSheet_();
    var lastRow = sheet.getLastRow();
    if (lastRow >= 2) {
      var existing = sheet.getRange(2, 1, lastRow - 1, 1).getDisplayValues();
      for (var i = 0; i < existing.length; i++) {
        if ((existing[i][0] || '').trim() === norm) return; // đã có rồi, khỏi ghi trùng
      }
    }
    sheet.appendRow([norm, oldQuery, JSON.stringify(arr), new Date()]);

    var cache = CacheService.getScriptCache();
    var map = JSON.parse(cache.get(TC_ALIAS_CACHE_KEY) || '{}');
    map[norm] = arr;
    cache.put(TC_ALIAS_CACHE_KEY, JSON.stringify(map), TC_ALIAS_CACHE_TTL);
  } catch (e) { _LOG.d('_tc_saveResolvedAlias: ' + e.message); }
}

// ── Sheet ghi lại các query KHÔNG lớp nào tra ra — để đội vận hành biết
// còn địa chỉ (mới sáp nhập) nào chưa có trong Data mà cần bổ sung ──
function _tc_getUnresolvedSheet_() {
  var ss = _DS.ss(TRACUU_SHEET_ID);
  var sheet = ss.getSheetByName('UnresolvedQueries');
  if (!sheet) {
    sheet = ss.insertSheet('UnresolvedQueries');
    sheet.appendRow(['Query gốc', 'QueryNorm', 'Số lần bị hỏi', 'Lần đầu', 'Lần gần nhất']);
    sheet.setFrozenRows(1);
  }
  return sheet;
}

function _tc_logUnresolvedQuery(query) {
  try {
    var norm = _tc_normalizeNoDiacritics(query);
    if (!norm) return;
    var sheet = _tc_getUnresolvedSheet_();
    var lastRow = sheet.getLastRow();
    var now = new Date();
    if (lastRow >= 2) {
      var existing = sheet.getRange(2, 1, lastRow - 1, 2).getDisplayValues();
      for (var i = 0; i < existing.length; i++) {
        if ((existing[i][1] || '').trim() === norm) {
          var rowIdx = i + 2;
          var curCount = Number(sheet.getRange(rowIdx, 3).getValue()) || 0;
          sheet.getRange(rowIdx, 3).setValue(curCount + 1);
          sheet.getRange(rowIdx, 5).setValue(now);
          return;
        }
      }
    }
    sheet.appendRow([query, norm, 1, now, now]);
  } catch (e) { _LOG.d('_tc_logUnresolvedQuery: ' + e.message); }
}

// ── Lớp 4: dùng AI SuperAgent (insea.io) làm "công cụ tìm kiếm" để suy ra
// (các) xã/phường CŨ đã sáp nhập/đổi tên thành địa danh user gõ. Dùng chung
// hạ tầng _callInsea đang phục vụ AI mascot — có cache theo query 7 ngày để
// đỡ tốn quota cho các câu hỏi lặp lại. ──
function _tc_llmWardLookup(query) {
  try {
    var prompt = ''
      + 'Bạn là chuyên gia hành chính Việt Nam, nắm rõ đợt sáp nhập đơn vị hành chính '
      + 'cấp xã/phường và cấp tỉnh năm 2025.\n'
      + 'Địa danh cần tra: "' + query + '"\n'
      + 'Hãy xác định (các) xã/phường TRƯỚC sáp nhập (tên cũ) đã được sáp nhập và/hoặc '
      + 'đổi tên thành địa danh trên. Nếu địa danh này vốn dĩ đã là tên cũ (chưa từng đổi), '
      + 'trả về chính nó. Nếu không tìm được thông tin đáng tin cậy, trả về mảng rỗng — '
      + 'TUYỆT ĐỐI không suy đoán/bịa tên.\n'
      + 'CHỈ trả lời bằng JSON hợp lệ, không kèm bất kỳ chữ nào khác, đúng định dạng:\n'
      + '{"oldWards":["Tên xã/phường cũ 1","Tên xã/phường cũ 2"],"confidence":"high|medium|low"}';

    var res = _callInsea(prompt, { cacheKey: 'wm_' + _tc_normalizeNoDiacritics(query), cacheTTL: 604800 }); // cache 7 ngày
    if (!res || !res.success || !res.text) return null;

    var raw = res.text.toString().trim()
      .replace(/^```json/i, '').replace(/^```/, '').replace(/```$/, '').trim();
    var m = raw.match(/\{[\s\S]*\}/);
    if (!m) return null;

    var parsed = JSON.parse(m[0]);
    if (!parsed || !Array.isArray(parsed.oldWards) || !parsed.oldWards.length) return null;

    var out = parsed.oldWards.map(function(w){ return (w || '').toString().trim(); }).filter(Boolean);
    return out.length ? out : null;
  } catch (e) {
    _LOG.d('_tc_llmWardLookup: ' + e.message);
    return null;
  }
}

// ── Lớp 5: gọi Nominatim (OpenStreetMap) để suy ra tên xã/phường hiện hành ──
// Miễn phí, KHÔNG cần API key. Theo chính sách sử dụng của Nominatim:
//   - Tối đa 1 request/giây → có Utilities.sleep(1000) trước mỗi lần gọi
//   - Bắt buộc gửi User-Agent định danh ứng dụng (thay email bên dưới bằng email thật của bạn/team)
//   - Nếu tần suất tra cứu lớn hơn nhiều, nên cân nhắc tự host Nominatim thay vì dùng server công cộng
function _tc_geocodeFallback(query) {
  var address = encodeURIComponent(query + ', Việt Nam');
  var url = 'https://nominatim.openstreetmap.org/search?q=' + address
          + '&format=json&addressdetails=1&countrycodes=vn&limit=1&accept-language=vi';

  try {
    Utilities.sleep(1000); // tôn trọng rate-limit 1 req/giây của Nominatim
    var resp = UrlFetchApp.fetch(url, {
      muteHttpExceptions: true,
      headers: { 'User-Agent': 'SPX-HUB-Ops-TraCuu/1.0 (noi bo cong ty; lien he: thay-email-cua-ban@congty.vn)' }
    });
    var json = JSON.parse(resp.getContentText());
    if (!json || !json.length) {
      _LOG.d('_tc_geocodeFallback (Nominatim): không có kết quả cho "' + query + '"');
      return null;
    }
    var addr = json[0].address || {};
    // Cấp xã/phường trong dữ liệu OSM VN thường nằm ở 1 trong các field sau, tùy khu vực
    var ward = addr.suburb || addr.quarter || addr.neighbourhood
             || addr.city_district || addr.town || addr.village || addr.hamlet || null;
    return ward;
  } catch (e) {
    _LOG.d('_tc_geocodeFallback (Nominatim) error: ' + e.message);
    return null;
  }
}

/**
 * GHI CHÚ: Nominatim không cần API key nên KHÔNG cần chạy hàm setup nào trước khi dùng.
 * Chỉ cần đảm bảo domain "nominatim.openstreetmap.org" không bị chặn trong policy mạng
 * của tổ chức bạn (Apps Script mặc định không bị giới hạn domain).
 */

// ── Lớp 3: fuzzy match trực tiếp trong Data (không cần API, đã bỏ dấu khi so khớp) ──
function _tc_findWardFuzzy(query, dbData) {
  var best = null, bestScore = 0;
  for (var i = 1; i < dbData.length; i++) {
    var ward = (dbData[i][3] || '').toString().trim();
    if (!ward) continue;
    var score = _tc_similarity(query, ward);
    if (score > bestScore) { bestScore = score; best = ward; }
  }
  return bestScore >= TC_FUZZY_THRESHOLD ? { ward: best, score: bestScore } : null;
}

/**
 * ĐIỂM VÀO CHÍNH — gọi hàm này thay cho search_searchSortCode trong frontend.
 * Trả về đúng format cũ ({ success, data: [...] }), chỉ thêm 2 field trong mỗi item:
 *   - matchedFromOldName: nếu có giá trị, UI hiển thị "đã cập nhật từ tên cũ"
 *   - _layer: 1 | 2 | 3 (phục vụ debug, không bắt buộc hiển thị cho user)
 */
function search_searchSortCode_v2(query, mode) {
  if (!query) return { success: false, error: 'Vui lòng nhập từ khóa!' };

  // Lớp 1: hàm gốc (đủ nhanh, xử lý được phần lớn case bình thường)
  var direct = search_searchSortCode(query, mode);
  if (direct.success && direct.data && direct.data.length > 0) {
    direct.data.forEach(function(r){ r._layer = 1; });
    return direct;
  }
  if (mode === 'hub') return direct; // HUB không có khái niệm sáp nhập, dừng ở đây

  try {
    var dbData = _tc_getDataValues_();

    // Lớp 2: bảng alias đã học từ các lần tra AI/geocode trước — hỗ trợ 1 query
    // khớp NHIỀU xã cũ (N:1, do 1 phường mới có thể gộp từ nhiều phường cũ)
    var aliasMap = _tc_getResolvedAliasMap();
    var mappedOldWards = aliasMap[_tc_normalizeNoDiacritics(query)];
    if (mappedOldWards && mappedOldWards.length) {
      var merged2 = [], seen2 = new Set();
      mappedOldWards.forEach(function(ow) {
        var r = search_searchSortCode(ow, 'ward');
        if (r.success && r.data && r.data.length) {
          r.data.forEach(function(item) {
            var k = item.station + '_' + item.wardName + '_' + item.zoneId;
            if (!seen2.has(k)) { seen2.add(k); merged2.push(item); }
          });
        }
      });
      if (merged2.length) {
        merged2.forEach(function(r){ r.matchedFromOldName = query; r._layer = 2; });
        return { success: true, data: merged2 };
      }
    }

    // Lớp 3: fuzzy match trực tiếp, không cần API
    var fuzzy = _tc_findWardFuzzy(query, dbData);
    if (fuzzy) {
      var r3 = search_searchSortCode(fuzzy.ward, 'ward');
      if (r3.success && r3.data.length > 0) {
        r3.data.forEach(function(r){ r._layer = 3; });
        return r3;
      }
    }

    // Lớp 4: AI SuperAgent (insea.io) làm công cụ tìm kiếm — suy ra (các) xã/phường
    // cũ đã sáp nhập/đổi tên thành địa danh user gõ. Hỗ trợ N:1 (nhiều xã cũ khác station).
    var aiOldWards = _tc_llmWardLookup(query);
    if (aiOldWards && aiOldWards.length) {
      var merged4 = [], seen4 = new Set();
      aiOldWards.forEach(function(ow) {
        var r = search_searchSortCode(ow, 'ward');
        if (r.success && r.data && r.data.length) {
          r.data.forEach(function(item) {
            var k = item.station + '_' + item.wardName + '_' + item.zoneId;
            if (!seen4.has(k)) { seen4.add(k); merged4.push(item); }
          });
        }
      });
      if (merged4.length) {
        _tc_saveResolvedAlias(query, aiOldWards); // học lại — lần sau tra thẳng Lớp 2, không gọi AI nữa
        merged4.forEach(function(r){ r.matchedFromOldName = query; r._layer = 4; });
        return { success: true, data: merged4 };
      }
    }

    // Lớp 5: Geocoding API (Nominatim) — phương án cuối cùng, khi AI cũng không xác định được
    var geoWard = _tc_geocodeFallback(query);
    if (geoWard) {
      var r5 = search_searchSortCode(geoWard, 'ward');
      if (r5.success && r5.data.length > 0) {
        _tc_saveResolvedAlias(query, [geoWard]); // học lại cho lần sau
        r5.data.forEach(function(r){ r.matchedFromOldName = query; r._layer = 5; });
        return r5;
      }
    }

    // Không lớp nào ra kết quả — ghi log để đội vận hành biết còn địa chỉ nào
    // (rất có thể vừa sáp nhập/đổi tên) chưa được cập nhật trong Data
    _tc_logUnresolvedQuery(query);
    return { success: true, data: [] }; // vẫn trả success để UI hiện "không tìm thấy" như bình thường
  } catch (e) {
    _LOG.d('search_searchSortCode_v2: ' + e.message);
    return { success: false, error: e.message };
  }
}

/**
 * ============================================================
 * HƯỚNG DẪN THAY THẾ TRONG BACKEND.GS
 * ============================================================
 *
 * 1. Mở file Code.gs (hoặc Backend.gs) trong Apps Script Editor
 * 2. Tìm và XÓA 3 hàm cũ:
 *      - tracuu_getAllWards()
 *      - tracuu_getAllHubs()
 *      - search_searchSortCode()  (hàm cũ chỉ nhận 1 tham số)
 * 3. DÁN toàn bộ nội dung file này vào thay thế
 * 4. Lưu lại (Ctrl+S)
 *
 * THAY ĐỔI SO VỚI PHIÊN BẢN CŨ:
 * ─────────────────────────────────────────────────────────
 * tracuu_getAllWards():
 *   CŨ: chỉ trả về [{ward: string}]
 *   MỚI: trả về [{ward, station}] — gồm cả Delivery Station1
 *        để autocomplete biết xã thuộc hub nào
 *
 * tracuu_getAllHubs():
 *   CŨ: trả về [string]  (chỉ tên HUB)
 *   MỚI: trả về [{name, code}]  (tên + mã HUB Code)
 *        để autocomplete hiển thị cả mã HUB
 *
 * search_searchSortCode(query, mode):
 *   CŨ: 1 tham số, tìm đồng thời cả Hub và Ward
 *   MỚI: 2 tham số (query + mode)
 *        mode='hub'  → chỉ tìm trong sheet Mail
 *        mode='ward' → tìm trong sheet Data, map sang Mail lấy email
 *        (nếu không truyền mode → tìm cả hai, giữ backward compat)
 *
 * Kết quả trả về có thêm field:
 *   - type: 'hub' | 'ward'    (để UI phân biệt màu/icon)
 *   - wardName: string        (tên xã/phường gốc user tìm)
 * ─────────────────────────────────────────────────────────
 */

// ============================================================

// --- MODULE 4: QUÁ HẠN (AGING) ---

// ============================================================

// [ĐÃ XOÁ — aging_getCoreData(), chính comment gốc của hàm này đã tự xác nhận
// "KHÔNG CÒN FRONTEND NÀO GỌI TỚI" (tiền thân của aging_getMasterData() đang
// dùng thật) — xác nhận lại qua grep toàn bộ 4 file .gs + .html]

// [ĐÃ XOÁ — aging_getLostData() và aging_getFMData(), xác nhận qua grep toàn
// bộ 4 file .gs + toàn bộ .html — không còn nơi nào gọi tới. Cả 2 đều lấy
// từng loại dữ liệu riêng lẻ (Lost/FM), đã được thay thế bởi endpoint gộp
// aging_getMasterData() đang dùng thật xuyên suốt Quá Hạn/Tổng quan.]


// ============================================================
// PATCH: aging_getMasterData() — Thêm phân quyền
// THAY THẾ hàm aging_getMasterData() cũ trong backend.gs
// Cache giờ là per-user (key theo email) thay vì global,
// vì mỗi user thấy tập hợp hub khác nhau.
// ============================================================


// ============================================================
// PHÂN QUYỀN MODULE — SHARED PERMISSION ENGINE
// Dùng chung cho Quá Hạn (aging) và KPI Fail (kpifail)
// 3 tầng: admin > aom > sup > station
// Nguồn: sheet "AOM SUP" trong RP_SOURCE_ID
//   col3 = AOM_Email → hubs tương ứng (col8 = Hub_Name AMH)
//   col5 = Sup_Email  → hubs tương ứng
//   DS Nhân viên col7=Email, col4=Nơi làm việc → 1 hub/hàng
//     (1 email xuất hiện ở nhiều hàng = quản lý nhiều trạm, role station)
// Conflict AOM+SUP trên cùng email → lấy AOM (role cao hơn)
// ============================================================

/**
 * getModuleAccess()
 * Trả về { role: 'admin'|'aom'|'sup'|'station'|'denied', email, hubs: [] }
 * Tái dùng _rp_lookupSA (Rider Plan engine) để đảm bảo cùng sheet, cùng
 * column, cùng hub format — tránh mismatch khi filter aging/kpifail data.
 * Cache ScriptCache 120s per-user.
 */
/**
 * _spx_mapRoleToLevel_(access)
 * [FIX 2026-08-16] Ánh xạ role gốc (admin/aom/sup/station/denied — KHÔNG ĐỔI, hàng
 * trăm hàm khác trong hệ thống vẫn đang dựa thẳng vào các giá trị này) sang cấp bậc
 * MỚI theo đúng thứ bậc đã thống nhất: Admin > ROM > AOM > SUP > Lead > Staff. Đây
 * là lớp ánh xạ THÊM VÀO — access.role/access.hubs vẫn giữ nguyên y hệt cũ cho MỌI
 * hàm hiện có, không phá vỡ bất kỳ phân quyền nào đang chạy.
 *
 * - ROM (levelNum=2): CHƯA có dữ liệu nguồn (đội vận hành xác nhận sẽ bổ sung sau) —
 *   chưa có role nào ánh xạ vào đây, chỉ CHỪA SẴN vị trí trong thứ bậc số để khi có
 *   dữ liệu ROM thật, không phải đánh số lại toàn bộ các cấp còn lại.
 * - Lead/Staff (levelNum=5/6): sheet "DS Nhân viên" HIỆN CHƯA có cột chức danh —
 *   mọi 'station' mặc định là Lead (khớp cách dùng thực tế hiện tại — chính prompt AI
 *   nội bộ đã gọi role này là "Hub Team Lead"). Khi cột chức danh được bổ sung (đã dò
 *   tự động qua TÊN cột ở _rp_lookupSA(), không cần sửa hàm này), access.title sẽ có
 *   giá trị thật và hàm này TỰ ĐỘNG tách đúng Lead/Staff — không cần đổi code thêm.
 */
function _spx_mapRoleToLevel_(access) {
  var role = access.role;
  if (role === 'admin') return { levelNum: 1, levelCode: 'admin', levelLabel: 'Admin' };
  if (role === 'aom')   return { levelNum: 3, levelCode: 'aom',   levelLabel: 'AOM' };
  if (role === 'sup')   return { levelNum: 4, levelCode: 'sup',   levelLabel: 'SUP' };
  if (role === 'station') {
    var title = (access.title || '').toString().trim().toLowerCase();
    if (title === 'staff' || title === 'nhân viên') {
      return { levelNum: 6, levelCode: 'staff', levelLabel: 'Staff' };
    }
    return { levelNum: 5, levelCode: 'lead', levelLabel: 'Lead' };
  }
  return { levelNum: 99, levelCode: 'denied', levelLabel: 'Không có quyền' };
}

/** Gắn thêm levelNum/levelCode/levelLabel vào 1 object access đã có role/hubs — dùng chung ở mọi điểm return của getModuleAccess(). */
function _spx_withLevel_(result) {
  var lvl = _spx_mapRoleToLevel_(result);
  result.levelNum = lvl.levelNum;
  result.levelCode = lvl.levelCode;
  result.levelLabel = lvl.levelLabel;
  return result;
}

function getModuleAccess() {
  var CACHE_TTL = 120;
  var sc = CacheService.getScriptCache();

  try {
    var email = Session.getActiveUser().getEmail().toLowerCase().trim();
    if (!email) return _spx_withLevel_({ role: 'denied', email: '', hubs: [] });

    // Admin bypass — dùng sheet Admin_Roles (2 cấp), có failsafe cứng trong code
    var adminMap = _admin_getAdminMap();
    if (adminMap[email]) {
      return _spx_withLevel_({ role: 'admin', level: adminMap[email], email: email, hubs: [] }); // hubs=[] → không lọc, thấy tất cả
    }

    // Thử cache per-user
    // [SỬA] v2 -> v3: bộ đệm cũ chứa cấp bậc SAI (mọi user cấp trạm đều là Lead do
    // thiếu chức danh). Đổi phiên bản khoá để mọi người được tính lại ngay sau deploy.
    var cacheKey = 'mod_access_v3_' + email.replace(/[^a-z0-9]/g, '_');
    try {
      var cached = sc.get(cacheKey);
      if (cached) return _spx_withLevel_(JSON.parse(cached));
    } catch(ce) {}

    // Dùng _rp_lookupSA — cùng engine với Rider Plan, cùng sheet SA, cùng col6 (Hub)
    // Đảm bảo hub format trong access.hubs khớp với hub trong aging/kpifail data
    // [SỬA LỖI THẬT — báo cáo: user chức danh "Staff" nhưng giao diện hiện "Lead"]
    // Hệ thống có HAI bộ phân quyền song song:
    //   (1) _rp_lookupSA  -> đọc file CŨ (RP_SOURCE_ID). Sheet nhân sự ở đó không có
    //       cột chức danh -> title luôn rỗng -> MỌI user cấp trạm mặc định thành LEAD
    //       (387 nhân viên Staff bị cấp nhầm quyền Lead, đo trên file tổ chức).
    //   (2) _spxBuildOrgAccessMap_ -> đọc ĐÚNG nguồn duy nhất (ORG_SOURCE_SPREADSHEET_ID),
    //       có sẵn chức danh và ánh xạ chuẩn staff/team lead/supervisor.
    // Giao diện đang chạy bằng (1). Nay ưu tiên (2) — nguồn chính thức — và CHỈ khi
    // không tìm thấy mới lùi về (1), để không ai đột ngột mất quyền nếu nguồn mới
    // còn thiếu người. Kết quả trả về giữ NGUYÊN định dạng cũ (role/hubs/title) nên
    // các module khác không phải sửa gì.
    var result = null;
    try {
      var _orgMap = _spxBuildOrgAccessMap_();
      var _me = (_orgMap && _orgMap.byEmail) ? _orgMap.byEmail[email] : null;
      if (_me && _me.stations && _me.stations.length) {
        var _r = String(_me.role || '').toUpperCase();
        var _roleOut = (_r === 'AOM') ? 'aom' : (_r === 'SUP') ? 'sup' : 'station';
        result = {
          role: _roleOut, email: email, hubs: _me.stations.slice(),
          title: _me.position || null,          // 'Staff' / 'Team Lead' / 'Supervisor'
          source: 'org'
        };
      }
    } catch (eOrgAcc) { /* nguồn mới lỗi -> lùi về đường cũ, không chặn đăng nhập */ }

    if (!result) {
      var srcSS = _DS.ss(RP_SOURCE_ID);
      var sa = _rp_lookupSA(email, srcSS);
      if (sa && sa.role && sa.hubs && sa.hubs.length > 0) {
        result = { role: sa.role, email: email, hubs: sa.hubs, title: sa.title || null, source: 'legacy' };
      } else {
        result = { role: 'denied', email: email, hubs: [] };
      }
    }

    try { sc.put(cacheKey, JSON.stringify(result), CACHE_TTL); } catch(ce) {}
    return _spx_withLevel_(result);

  } catch(e) {
    return _spx_withLevel_({ role: 'denied', email: '', hubs: [], error: e.message });
  }
}

/**
 * getModuleAccess_invalidate()
 * Gọi khi cần reset cache (ví dụ sau khi update sheet SA)
 */
function getModuleAccess_invalidate(email) {
  try {
    var sc = CacheService.getScriptCache();
    if (email) {
      sc.remove('mod_access_v3_' + email.replace(/[^a-z0-9]/g, '_'));
    }
  } catch(e) {}
}


/**
 * spx_getModuleAccess()
 * Public wrapper — được gọi từ index.html qua google.script.run
 * Trả về JSON string { role, hubs } để frontend lưu vào window.SPX_ACCESS
 */
function spx_getModuleAccess() {
  try {
    var access = getModuleAccess();
    return JSON.stringify(access);
  } catch(e) {
    return JSON.stringify({ role: 'denied', hubs: [], error: e.message });
  }
}

// =========================================================================
// spx_translateText(text, targetLang) — NỀN TẢNG En/Vi, PHƯƠNG ÁN DỰ PHÒNG
// =========================================================================
// [MỤC ĐÍCH — theo đúng yêu cầu "cơ sở làm nền, chỗ nào cấu trúc chưa có thì
// dùng GG Translate, nhưng phải đúng logic ngữ nghĩa"] Từ điển tay ở frontend
// (I18N_NAV/I18N_SECTION) đã cover đúng 28 module + 8 nhóm hiện có — hàm này
// CHỈ được gọi khi 1 nhãn tĩnh MỚI xuất hiện mà chưa kịp cập nhật từ điển tay
// (VD: thêm module thứ 29 sau này). Dùng LanguageApp.translate() — dịch vụ
// Google Translate có sẵn trong Apps Script, không cần API key riêng.
// [AN TOÀN] Chỉ dùng cho NHÃN GIAO DIỆN TĨNH — KHÔNG được gọi cho dữ liệu
// thật (tên trạm/tên người/mã đơn...) vì máy dịch có thể biến tên riêng
// thành nghĩa khác hoàn toàn (dịch sai ngữ nghĩa) — việc này được ép ở phía
// frontend (spxTranslateDynamic() chỉ gọi từ spxNavLabel()/spxSectionLabel(),
// không có đường nào khác gọi vào hàm backend này).
// Cache 6 giờ bằng CacheService — tránh gọi lại Google Translate cho cùng 1
// chuỗi nhiều lần (áp lực lên dịch vụ ngoài + độ trễ không cần thiết).
function spx_translateText(text, targetLang) {
  try {
    if (!text || typeof text !== 'string') return '';
    targetLang = targetLang || 'en';
    var cache = CacheService.getScriptCache();
    var cacheKey = 'i18n_' + targetLang + '_' + Utilities.base64Encode(Utilities.newBlob(text).getBytes()).substring(0, 60);
    var cached = cache.get(cacheKey);
    if (cached) return cached;
    // sourceLang='vi' cố định — mọi nhãn gốc trong hệ thống đều là tiếng Việt.
    var translated = LanguageApp.translate(text, 'vi', targetLang);
    if (translated) cache.put(cacheKey, translated, 21600); // 6 giờ
    return translated || text;
  } catch (e) {
    // Lỗi dịch vụ ngoài (quota/mạng...) -> trả nguyên văn, KHÔNG chặn UI,
    // frontend tự hiểu "không có bản dịch" và giữ nguyên tiếng Việt.
    return text;
  }
}

// =====================================================================================
// [MỚI 2026-10-24] TỔNG QUAN CHIA PHẦN — spx_getOverviewPart(part, previewHub, force)
// Executions đo thật: spx_getRoleOverviewData trung vị 61 giây, chỉ ~5% lượt trúng cache, vì gọi TUẦN TỰ 5 hàm
// con. Client nay gọi 5 phần SONG SONG (thời gian chờ = phần chậm nhất, không phải tổng) và vẽ từng thẻ khi có số.
//
// CAM KẾT ĐỘ MỚI (không để số cũ khi đã có số mới) — mỗi phần dùng đúng tín hiệu đổi dữ liệu của nó:
//   · aging     : khoá cache gắn phiên bản bản chụp + mốc sửa file nguồn (Drive lastUpdated, kiểm tối đa 20 giây/lần).
//   · kpifail   : khoá cache gắn phiên bản cache "lite" (được tăng ngay khi dữ liệu KPI đổi) — trước đây chỉ gắn
//                 phiên bản "idx" chỉ tăng khi bấm Làm mới nên có thể giữ số cũ tới hết TTL.
//   · violation : khoá cache gắn mốc sửa file nguồn + cache dữ liệu thô tự bỏ khi file nguồn đổi (tối đa trễ ~60 giây).
//   · rescue / riderplan: KHÔNG cache thêm — luôn tính lại từ nguồn (đơn "đã xử lý" đổi ngay khi người dùng thao tác).
//   · force=true (bấm Làm mới / phát hiện bản dữ liệu mới): bỏ qua cache ĐỌC của phần đó và tính lại từ nguồn.
// Mỗi phần trả generatedAt để giao diện hiện rõ "cập nhật lúc" và không bao giờ ghi đè số mới bằng phản hồi cũ.
// Hàm cũ spx_getRoleOverviewData giữ nguyên (tab cũ chưa tải lại vẫn chạy).
// =====================================================================================
var _SPX_OV_FORCE_ = false;   // true trong lúc spx_getOverviewPart(force) — các hàm tóm tắt bỏ qua cache ĐỌC (mỗi lượt thực thi 1 giá trị riêng)

/** Mốc "file nguồn được sửa lần cuối" (Drive), cache 20 giây để không gọi Drive ở mỗi lượt. Lỗi/không đọc được -> '0' (quay về hành vi theo TTL cũ). */
function _spxSrcStamp_(fileId) {
  if (!fileId) return '0';
  var sc = null, key = 'srcstamp_v1_' + fileId;
  try { sc = CacheService.getScriptCache(); var h = sc.get(key); if (h) return h; } catch (e0) {}
  var v = '0';
  try { v = String(DriveApp.getFileById(fileId).getLastUpdated().getTime()); } catch (e1) { return '0'; }
  try { if (sc) sc.put(key, v, 20); } catch (e2) {}
  return v;
}

/** Phiên bản bản chụp Quá hạn (dùng chung cache 45 giây với aging_getDataVersion). */
function _spxAgingVerTag_() {
  try {
    var sc = CacheService.getScriptCache(), info = null;
    try { var hit = sc.get('aging_dataver_v1'); if (hit) info = JSON.parse(hit); } catch (eC) {}
    if (!info) {
      var m = _kpifail_getMetaMap_(_aging_getSnapshotMetaSheet_(_DS.ss(ADMIN_DB_ID))) || {};
      info = { snapshotVersion: Number(m.snapshot_version) || 0, savedAt: m.snapshot_saved_at || '', sourceVersion: String(m.snapshot_source_version || '').split('|')[0] };
      try { sc.put('aging_dataver_v1', JSON.stringify(info), 45); } catch (eP) {}
    }
    return String(info.snapshotVersion || 0);
  } catch (e) { return '0'; }
}

function _spxOvFail_(part, msg) { return JSON.stringify({ success: false, part: String(part || ''), error: String(msg || 'Lỗi không xác định'), generatedAt: Date.now() }); }

function spx_getOverviewPart(part, previewHub, force) {
  var t0 = Date.now();
  try {
    part = String(part || '');
    var access = getModuleAccess();
    if (!access || access.role === 'denied') return _spxOvFail_(part, 'Không có quyền truy cập.');
    var ph = (previewHub && String(previewHub).trim() && String(previewHub).trim().toUpperCase() !== 'ALL') ? String(previewHub).trim() : null;
    var out = { success: true, part: part, generatedAt: Date.now() };
    _SPX_OV_FORCE_ = !!force;
    var r;
    switch (part) {
      case 'meta':
        out.data = { levelCode: access.levelCode, hubs: access.hubs || [] };
        break;
      case 'aging':
        r = JSON.parse(aging_getIndexSummary('', ph));
        if (!r.success) return _spxOvFail_(part, r.error);
        out.data = { overdueCount: r.overdueCount || 0, closedLostCount: r.closedLostCount || 0, processingCount: r.processingCount || 0,
                     otherFlaggedCount: r.otherFlaggedCount || 0, hubs: r.hubs || [] };
        out.dataVersion = _spxAgingVerTag_(); out.cacheHit = !!r._cacheHit;
        break;
      case 'kpifail':
        r = JSON.parse(kpifail_getIndexSummary('', ph));
        if (!r.success) return _spxOvFail_(part, r.error);
        out.data = { totalFM: r.totalFM || 0, totalLM: r.totalLM || 0, totalSOP: r.totalSOP || 0, totalFail: r.totalFail || 0,
                     trendPct: r.trendPct, riskLevel: r.riskLevel || 'green' };
        try { out.dataVersion = _kpifail_dataVersionString_(); } catch (eV) {}
        break;
      case 'rescue':
        r = JSON.parse(rq_getIndexSummary(ph));
        if (!r.success) return _spxOvFail_(part, r.error);
        out.data = { redCount: r.redCount || 0, totalCount: r.totalCount || 0 };
        break;
      case 'violation':
        r = JSON.parse(vp_getIndexSummary(ph));
        if (!r.success) return _spxOvFail_(part, r.error);
        out.data = { noTicketCount: r.noTicketCount || 0, totalCount: r.totalCount || 0 };
        out.cacheHit = !!r._cacheHit;
        break;
      case 'riderplan':
        r = JSON.parse(rp_getIndexSummary(ph));
        if (!r.success) return _spxOvFail_(part, r.error);
        out.data = { missingCount: r.missingCount || 0, totalCount: r.totalCount || 0, single: r.single || null };
        break;
      default:
        return _spxOvFail_(part, 'Phần không hợp lệ.');
    }
    out.generatedAt = Date.now();
    out.ms = out.generatedAt - t0;
    return JSON.stringify(out);
  } catch (e) {
    return _spxOvFail_(part, e && e.message ? e.message : e);
  } finally {
    _SPX_OV_FORCE_ = false;
  }
}

/**
 * spx_getRoleOverviewData(previewHub)
 * [PERF 2026-10] Executions đo thật: 27 lượt, trung bình 81 giây, tối đa 131 giây — mỗi lượt
 * giữ 1 trong 30 chỗ chạy đồng thời suốt hơn 1 phút. Các hàm con (aging/kpifail/rescue/
 * violation/riderplan) vốn đã có cache + snapshot riêng; lớp này chỉ thêm 1 cache KẾT QUẢ
 * 90 giây theo (email + vai trò + hub + previewHub) để mở lại/F5/đổi tab liên tục KHÔNG phải
 * tính lại cả 5 hàm. Chỉ cache kết quả thành công. Có trường generatedAt để biết số liệu
 * được tính lúc nào. Số liệu gốc từ snapshot nên độ trễ thêm tối đa 90 giây.
 */
function spx_getRoleOverviewData(previewHub) {
  try {
    var access = getModuleAccess();
    if (!access || access.role === 'denied') return _spx_getRoleOverviewDataCore_(previewHub);
    var sig = JSON.stringify([
      String(access.email || ''), access.role, access.level || '', access.levelCode || '',
      (access.hubs || []).map(String).sort(), String(previewHub || '').trim().toUpperCase()
    ]);
    var dg = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, sig, Utilities.Charset.UTF_8)
      .map(function (b) { var x = (b < 0 ? b + 256 : b).toString(16); return x.length < 2 ? '0' + x : x; }).join('');
    var key = 'ov_cache_v1_' + dg;
    var sc = CacheService.getScriptCache();
    try { var hit = sc.get(key); if (hit) return hit; } catch (eH) {}
    var res = _spx_getRoleOverviewDataCore_(previewHub);
    try {
      var okObj = JSON.parse(res);
      if (okObj && okObj.success && res.length < 90000) sc.put(key, res, 90);
    } catch (eP) {}
    return res;
  } catch (e) {
    return _spx_getRoleOverviewDataCore_(previewHub);
  }
}

/**
 * spx_getRoleOverviewData()
 * [FIX 2026-08-16 — Trang thử nghiệm UI mới] Nối số liệu KPI ở trang tổng quan mỗi
 * cấp (Admin/AOM/SUP/Lead) với DỮ LIỆU THẬT đã có sẵn — KHÔNG viết logic tính toán
 * mới, chỉ gọi lại các hàm thật đang chạy production (aging_getIndexSummary(),
 * kpifail_getIndexSummary(), _rp_getAllHubsFromSA()) và gói lại thành 1 lệnh gọi
 * duy nhất cho gọn phía client. Mọi lớp kiểm tra quyền của các hàm gốc vẫn nguyên
 * vẹn — hàm này chỉ gọi hubName RỖNG, để chính các hàm đó tự lọc đúng theo
 * access.hubs của người gọi (đã xác nhận an toàn — xem aging_getIndexSummary()).
 * ROM/Staff: CHƯA có nguồn dữ liệu thật (đã thống nhất bổ sung sau) — không gọi gì
 * thêm cho 2 cấp này, trang thử nghiệm tự hiện cảnh báo "đang xây dựng".
 */
function _spx_getRoleOverviewDataCore_(previewHub) {
  try {
    var access = getModuleAccess();
    if (access.role === 'denied') {
      return JSON.stringify({ success: false, error: 'Không có quyền truy cập.' });
    }

    var out = {
      success: true,
      levelCode: access.levelCode,
      hubs: access.hubs || [],
      totalHubs: null,
      aging: null,
      kpifail: null,
      rescue: null,
      violation: null,
      riderplan: null
    };

    // Tổng số hub — admin: toàn hệ thống; còn lại: đúng số hub được cấp quyền
    try {
      out.totalHubs = (access.role === 'admin') ? _rp_getAllHubsFromSA().length : (access.hubs || []).length;
    } catch (eH) { out.totalHubsError = eH.message; }

    // [FIX — hoàn thành phần backend đã chuẩn bị sẵn từ trước, theo yêu cầu
    // trực tiếp "Tổng quan không đổi theo level, sao biết đúng sai"] Cả 5 hàm
    // con bên dưới đã CÓ SẴN tham số overrideHub (ghi rõ đúng mục đích này
    // trong comment của chính chúng) — chỉ thiếu bước cuối cùng: hàm tổng hợp
    // này chưa từng nhận/truyền previewHub xuống. Giờ đã nối đủ dây.
    var _ph = (previewHub && String(previewHub).trim() && String(previewHub).trim().toUpperCase() !== 'ALL') ? String(previewHub).trim() : null;
    // [CHẨN ĐOÁN — báo cáo: Tổng quan tải rất lâu] Đo thời gian TỪNG phần để
    // biết phần nào chậm thay vì đoán. Trả về trong out._timing (mili-giây).
    var _tm = {}, _tmLast = Date.now(), _tmStart = _tmLast;
    var _tmMark = function (k) { var n = Date.now(); _tm[k] = n - _tmLast; _tmLast = n; };

    // Aging (Quá Hạn) — overdueCount/closedLostCount/processingCount, đã tự lọc theo quyền bên trong
    try {
      var agingRes = JSON.parse(aging_getIndexSummary('', _ph));
      _tmMark('aging'); try { _tm.agingHit = !!(agingRes && agingRes._cacheHit); } catch (eHt) {}
      if (agingRes.success) {
        out.aging = {
          overdueCount: agingRes.overdueCount || 0,
          closedLostCount: agingRes.closedLostCount || 0,
          processingCount: agingRes.processingCount || 0,
          hubs: agingRes.hubs || []
        };
      } else { out.agingError = agingRes.error; }
    } catch (eA) { out.agingError = eA.message; }

    // KPIFail — totalFM/totalLM/totalSOP/totalFail/trendPct/riskLevel, đã tự lọc theo quyền bên trong
    try {
      var kpiRes = JSON.parse(kpifail_getIndexSummary('', _ph));
      _tmMark('kpi');
      if (kpiRes.success) {
        out.kpifail = {
          totalFM: kpiRes.totalFM || 0,
          totalLM: kpiRes.totalLM || 0,
          totalSOP: kpiRes.totalSOP || 0,
          totalFail: kpiRes.totalFail || 0,
          trendPct: kpiRes.trendPct,
          riskLevel: kpiRes.riskLevel || 'green'
        };
      } else { out.kpifailError = kpiRes.error; }
    } catch (eK) { out.kpifailError = eK.message; }

    // [MỚI — theo yêu cầu "Rider Plan/Vi phạm/Đơn cầu cứu cũng phải cần" trong
    // Tổng quan] Đơn cầu cứu — số đơn Đỏ khẩn cấp chưa xử lý, đã tự lọc theo
    // quyền bên trong rq_getIndexSummary().
    try {
      var rqRes = JSON.parse(rq_getIndexSummary(_ph));
      _tmMark('rescue');
      if (rqRes.success) {
        out.rescue = { redCount: rqRes.redCount || 0, totalCount: rqRes.totalCount || 0 };
      } else { out.rescueError = rqRes.error; }
    } catch (eRq) { out.rescueError = eRq.message; }

    // Vi phạm — số vụ chưa gắn ticket, đã tự lọc theo quyền bên trong vp_getIndexSummary().
    try {
      var vpRes = JSON.parse(vp_getIndexSummary(_ph));
      _tmMark('violation'); try { _tm.violationHit = !!(vpRes && vpRes._cacheHit); } catch (eHt) {}
      if (vpRes.success) {
        out.violation = { noTicketCount: vpRes.noTicketCount || 0, totalCount: vpRes.totalCount || 0 };
      } else { out.violationError = vpRes.error; }
    } catch (eVp) { out.violationError = eVp.message; }

    // Rider Plan — số trạm chưa nhập Inbound hôm nay, đã tự lọc theo quyền bên trong rp_getIndexSummary().
    try {
      var rpRes = JSON.parse(rp_getIndexSummary(_ph));
      _tmMark('riderplan');
      if (rpRes.success) {
        out.riderplan = { missingCount: rpRes.missingCount || 0, totalCount: rpRes.totalCount || 0, single: rpRes.single || null };
      } else { out.riderplanError = rpRes.error; }
    } catch (eRp) { out.riderplanError = eRp.message; }

    out.generatedAt = Date.now();
    _tm.total = Date.now() - _tmStart; out._timing = _tm; out._ver = 'OV-2209-D';  // dấu phiên bản — đổi mỗi lần sửa để xác nhận đã deploy
    return JSON.stringify(out);
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}
/**
 * spx_checkLuongAccess()
 * Public wrapper — index gọi khi load để cache kết quả quyền lương.
 * Dùng ScriptCache 300s để tránh gọi lại Admin_Access nhiều lần.
 */
function spx_checkLuongAccess() {
  try {
    var sc = CacheService.getScriptCache();
    var email = Session.getActiveUser().getEmail().toLowerCase().trim();
    var cacheKey = 'luong_access_v1_' + email.replace(/[^a-z0-9]/g, '_');
    var cached = sc.get(cacheKey);
    if (cached) return cached; // 'granted' | 'denied' | 'not_found'

    var ss    = _DS.ss(ADMIN_DB_ID);
    var sheet = ss.getSheetByName('Admin_Access');
    if (!sheet) { sc.put(cacheKey, 'denied', 300); return 'denied'; }

    var data = sheet.getDataRange().getValues();
    for (var i = 1; i < data.length; i++) {
      var emailInSheet = data[i][0] ? data[i][0].toString().toLowerCase().trim() : '';
      if (emailInSheet === email) {
        var status = data[i][3] ? data[i][3].toString().trim() : '';
        var result = (status === 'Duyệt') ? 'granted' : 'denied';
        sc.put(cacheKey, result, 300);
        return result;
      }
    }
    sc.put(cacheKey, 'not_found', 300);
    return 'not_found';
  } catch(e) {
    return 'denied';
  }
}


// ============================================================
// ADMIN CACHE UTILITIES — Chạy thủ công từ Apps Script Editor
// ============================================================

/**
 * spx_invalidateLuongCache()
 * Xóa cache quyền lương của tất cả user trong Admin_Access.
 * Chạy sau khi update col D (Duyệt truy cập Lương) trong sheet Admin_Access.
 */
function spx_invalidateLuongCache() {
  // [SECURITY FIX 2026-08] Bump cache quyền Lương toàn hệ thống — trước đây không
  // kiểm tra quyền. Chỉ admin mới được chạy.
  _requireAdmin_(2);
  try {
    var sc = CacheService.getScriptCache();
    var ss = _DS.ss(ADMIN_DB_ID);
    var sheet = ss.getSheetByName('Admin_Access');
    if (!sheet) return JSON.stringify({ success: false, error: 'No Admin_Access sheet' });
    var data = sheet.getDataRange().getValues();
    var keys = [];
    for (var i = 1; i < data.length; i++) {
      var email = data[i][0] ? data[i][0].toString().toLowerCase().trim() : '';
      if (email) keys.push('luong_access_v1_' + email.replace(/[^a-z0-9]/g, '_'));
    }
    if (keys.length) sc.removeAll(keys);
    _LOG.d('[spx_invalidateLuongCache] Cleared ' + keys.length + ' entries');
    return JSON.stringify({ success: true, cleared: keys.length });
  } catch(e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_invalidateAllCache()
 * Xóa toàn bộ ScriptCache liên quan đến phân quyền + data modules.
 * Chạy sau khi:
 *   - Cập nhật sheet SA (thêm/sửa/xóa quyền AOM/SUP/Hub)
 *   - Thêm nhân viên mới vào DS Nhân viên
 *   - Cần force refresh data cho tất cả users
 *
 * Cách chạy: Apps Script Editor → chọn hàm spx_invalidateAllCache → Run
 */
function spx_invalidateAllCache() {
  // [SECURITY FIX 2026-08] Hàm bump version cache TOÀN HỆ THỐNG (buộc mọi user đọc
  // lại từ Sheets, tốn quota) — trước đây không kiểm tra quyền, có thể bị spam gọi
  // để làm chậm hệ thống cho mọi người. Chỉ admin mới được chạy.
  _requireAdmin_(2);
  var sc = CacheService.getScriptCache();
  var report = { cleared: [], errors: [] };

  // ── 1. Access permission cache (mod_access_v2_*) ──
  // ScriptCache không hỗ trợ list-by-prefix → xóa bằng cách bump version
  // Cách hiệu quả: xóa cache của tất cả email trong sheet SA + DS Nhân viên
  try {
    var srcSS = _DS.ss(RP_SOURCE_ID);

    // Đọc tất cả email từ sheet SA
    var saSheet = srcSS.getSheetByName('AOM SUP') || srcSS.getSheetByName('SA');
    var emails = [];
    if (saSheet) {
      var saData = saSheet.getDataRange().getValues();
      for (var i = 1; i < saData.length; i++) {
        var e1 = String(saData[i][3] || '').toLowerCase().trim(); // AOM_Email
        var e2 = String(saData[i][5] || '').toLowerCase().trim(); // Sup_Email
        if (e1 && emails.indexOf(e1) < 0) emails.push(e1);
        if (e2 && emails.indexOf(e2) < 0) emails.push(e2);
      }
    }

    // Đọc email từ DS Nhân viên
    var empSheet = srcSS.getSheetByName('DS Nhân viên');
    if (empSheet) {
      var empData = empSheet.getDataRange().getValues();
      for (var j = 1; j < empData.length; j++) {
        var empEmail = String(empData[j][7] || '').toLowerCase().trim();
        if (empEmail && emails.indexOf(empEmail) < 0) emails.push(empEmail);
      }
    }

    // Xóa cache permission từng email
    var accessKeys = emails.map(function(e) {
      return 'mod_access_v3_' + e.replace(/[^a-z0-9]/g, '_');
    });
    if (accessKeys.length) {
      sc.removeAll(accessKeys);
      report.cleared.push('access_permission: ' + accessKeys.length + ' users');
    }
  } catch(e) {
    report.errors.push('access_permission: ' + e.message);
  }

  // ── 2. Aging data cache (aging_master_v3_*) ──
  // Xóa cache của admin (giữ đúng phạm vi hiện tại — chỉ admin, chưa mở rộng)
  // [FIX 2026-07] aging_getMasterData() đã chuyển sang ghi cache qua CacheMgr (xem hàm
  // đó) — key vật lý đổi từ 'aging_master_v3_admin_meta' sang key có tiền tố 'cm_AGING_'.
  // Nếu không cập nhật ở đây, nút "Refresh System" sẽ xoá nhầm key cũ không còn ai ghi
  // vào, giống hệt bug đã tìm thấy ở _aging_invalidateMasterCache() — dùng CacheMgr.invalidateChunked
  // để luôn đồng bộ đúng key thật, bất kể sau này đổi tiếp cách đặt tên bên trong CacheMgr.
  try {
    CacheMgr.invalidateChunked('AGING', 'master_v3_admin');
    // Bump bằng cách ghi một giá trị sentinel khiến key cũ không match
    sc.put('aging_cache_bust', String(Date.now()), 1);
    report.cleared.push('aging_data: flushed');
  } catch(e) {
    report.errors.push('aging_data: ' + e.message);
  }

  // ── 3. KPI Fail index summary cache ──
  try {
    _kpifail_bumpIdxCacheVersion_();
    _kpifail_invalidateNotesCache_();
    report.cleared.push('kpifail_index: bumped');
  } catch(e) {
    report.errors.push('kpifail_index: ' + e.message);
  }

  // ── 4. Rider Plan forecast cache (nếu có) ──
  try {
    var rpKey = 'rp_forecast_cache';
    sc.remove(rpKey);
    report.cleared.push('rider_plan: cleared');
  } catch(e) {
    report.errors.push('rider_plan: ' + e.message);
  }

  // ── 5. Luong access cache ──
  try {
    var luongRes = JSON.parse(spx_invalidateLuongCache());
    report.cleared.push('luong_access: ' + (luongRes.cleared || 0) + ' users');
  } catch(e) {
    report.errors.push('luong_access: ' + e.message);
  }

  _LOG.d('[spx_invalidateAllCache] ' + JSON.stringify(report, null, 2));
  return JSON.stringify({ success: true, report: report, ts: new Date().toISOString() });
}

/**
 * spx_invalidatePermissionOnly()
 * Chỉ xóa cache phân quyền — dùng khi chỉ cập nhật sheet SA/DS Nhân viên
 * mà không muốn reset data cache (aging/kpifail sẽ giữ nguyên cache)
 */
function spx_invalidatePermissionOnly() {
  var report = { cleared: [], errors: [] };
  try {
    var sc = CacheService.getScriptCache();
    var srcSS = _DS.ss(RP_SOURCE_ID);

    var saSheet = srcSS.getSheetByName('AOM SUP') || srcSS.getSheetByName('SA');
    var emails = [];
    if (saSheet) {
      var saData = saSheet.getDataRange().getValues();
      for (var i = 1; i < saData.length; i++) {
        var e1 = String(saData[i][3] || '').toLowerCase().trim();
        var e2 = String(saData[i][5] || '').toLowerCase().trim();
        if (e1 && emails.indexOf(e1) < 0) emails.push(e1);
        if (e2 && emails.indexOf(e2) < 0) emails.push(e2);
      }
    }
    var empSheet = srcSS.getSheetByName('DS Nhân viên');
    if (empSheet) {
      var empData = empSheet.getDataRange().getValues();
      for (var j = 1; j < empData.length; j++) {
        var empEmail = String(empData[j][7] || '').toLowerCase().trim();
        if (empEmail && emails.indexOf(empEmail) < 0) emails.push(empEmail);
      }
    }

    // Thêm admin emails (mảng cũ + sheet Admin_Roles 2 cấp)
    (RP_ADMIN_EMAIL || []).forEach(function(e) {
      var em = e.toLowerCase().trim();
      if (em && emails.indexOf(em) < 0) emails.push(em);
    });
    Object.keys(_admin_getAdminMap()).forEach(function(em) {
      if (em && emails.indexOf(em) < 0) emails.push(em);
    });

    var keys = emails.map(function(e) {
      return 'mod_access_v3_' + e.replace(/[^a-z0-9]/g, '_');
    });
    if (keys.length) sc.removeAll(keys);

    report.cleared.push('permission_cache: ' + keys.length + ' users cleared');
    _LOG.d('[spx_invalidatePermissionOnly] ' + JSON.stringify(report));
    return JSON.stringify({ success: true, count: keys.length, report: report });
  } catch(e) {
    _LOG.d('[spx_invalidatePermissionOnly] ERROR: ' + e.message);
    return JSON.stringify({ success: false, error: e.message });
  }
}

// [FIX 2026-08-03] "AGING RAW SNAPSHOT" — chuyển từ ScriptCache (CacheMgr,
// trần cứng ~3.6MB/key) sang lưu trong Sheet kiểu ping-pong (2 slot A/B, y hệt
// pattern đã chứng minh hiệu quả cho KPI Fail persistent snapshot). Log
// Executions xác nhận aging_getMasterData chỉ còn ~5% lượt cache-hit (từ ~95%+
// trước đó) đúng lúc traffic tăng đột biến — code đọc/ghi đã soát kỹ, không có
// bug logic → khả năng cao nhất là dữ liệu Core+Lost+FM giờ đã VƯỢT trần
// 3.6MB của CacheMgr.setChunked(), khiến việc ghi cache ÂM THẦM THẤT BẠI mọi
// lúc (setChunked trả false, không throw) — mỗi lượt tưởng ghi xong nhưng thực
// ra chưa từng lưu được, lượt sau luôn miss. Sheet không có trần 3.6MB này.
var AGING_SNAPSHOT_SHEET      = 'Aging_Snapshot_Data';
var AGING_SNAPSHOT_META_SHEET = 'Aging_Snapshot_Meta';
// [MỚI] Phiên bản CÁCH ĐỌC CỘT của bản chụp. Bản chụp dựng bằng cách đọc cột cũ (theo vị trí
// cố định) chứa dữ liệu SAI (tên trạm = trạng thái đơn...) — đổi chuỗi này để mọi bản chụp
// cũ bị coi là không hợp lệ và dựng lại ngay, không phải chờ hết hạn 3 giờ.
var AGING_SNAPSHOT_SCHEMA = 'lm-header-map-v1';

function _aging_getSnapshotSheet_(ss, slot) {
  var name = AGING_SNAPSHOT_SHEET + '_' + (slot === 'B' ? 'B' : 'A');
  var sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
    sheet.appendRow(['Key', 'ChunkIndex', 'ChunkData']);
    sheet.setFrozenRows(1);
    sheet.getRange(1, 1, 1, 3).setFontWeight('bold');
  }
  return sheet;
}
function _aging_getSnapshotMetaSheet_(ss) {
  var sheet = ss.getSheetByName(AGING_SNAPSHOT_META_SHEET);
  if (!sheet) {
    sheet = ss.insertSheet(AGING_SNAPSHOT_META_SHEET);
    sheet.appendRow(['Key', 'Value']);
    sheet.setFrozenRows(1);
    sheet.getRange(1, 1, 1, 2).setFontWeight('bold');
  }
  return sheet;
}

// Đọc bản snapshot đang ACTIVE — trả về {coreData, lostData, fmData} hoặc null
// nếu chưa từng ghi (lần đầu deploy).
function _aging_readRawSnapshot_() {
  try {
    var ss = _DS.ss(ADMIN_DB_ID);
    var metaSheet = _aging_getSnapshotMetaSheet_(ss);
    var metaMap = _kpifail_getMetaMap_(metaSheet); // hàm dùng chung, không riêng KPI Fail
    if (!metaMap.snapshot_version) return null;
    // [MỚI] Bản chụp dựng bằng cách đọc cột cũ -> bỏ, dựng lại từ nguồn thật.
    if (metaMap.snapshot_schema !== AGING_SNAPSHOT_SCHEMA) {
      try { _LOG.d('[Aging Snapshot] Bản chụp khác schema (' + (metaMap.snapshot_schema || 'không có') + ') - dựng lại.'); } catch (eSc) {}
      return null;
    }
    // [SỬA LỖI THẬT — "toàn bộ data hiển thị đều là data cũ, sai lệch 100%"]
    // Đo thật trạm 45-DLK Krong Pak 02: màn hình 233 đơn / nguồn 161 đơn, không nhóm
    // tồn nào khớp. Module đọc BẢN CHỤP dựng sẵn, trước đây dùng BẤT KỂ DỰNG TỪ BAO
    // GIỜ -> job dựng lại không chạy thì giao diện phục vụ số cũ vô thời hạn.
    // Nguồn cập nhật mỗi giờ (7:00-18:00): bản chụp quá 3 giờ -> trả null để luồng
    // phía trên dựng lại ngay từ sheet thật.
    var _snapAgeMs = Date.now() - (Number(metaMap.snapshot_version) || 0);
    if (!isFinite(_snapAgeMs) || _snapAgeMs > 3 * 3600 * 1000) {
      try { _LOG.d('[Aging Snapshot] Ban chup cu ' + Math.round(_snapAgeMs / 60000) + ' phut - dung lai tu nguon that.'); } catch (eLg) {}
      return null;
    }
    var activeSlot = metaMap.snapshot_active_slot === 'B' ? 'B' : 'A';
    var dataSheet = _aging_getSnapshotSheet_(ss, activeSlot);
    if (dataSheet.getLastRow() < 2) return null;
    var rows = dataSheet.getRange(2, 1, dataSheet.getLastRow() - 1, 3).getDisplayValues();
    var chunks = [];
    for (var i = 0; i < rows.length; i++) {
      if (rows[i][0] !== 'snapshot') continue;
      var _cell = rows[i][2] == null ? '' : String(rows[i][2]);
      if (_cell.charAt(0) === AGING_CHUNK_PREFIX) _cell = _cell.slice(1);   // gỡ ký tự mở đầu an toàn
      chunks.push({ idx: Number(rows[i][1]) || 0, data: _cell });
    }
    if (!chunks.length) return null;
    chunks.sort(function(a, b) { return a.idx - b.idx; });
    var json = chunks.map(function(c) { return c.data; }).join('');
    return JSON.parse(json);
  } catch (e) {
    return null;
  }
}

// Ghi snapshot mới — kiểu ping-pong: ghi vào slot KHÔNG active, chỉ đổi con trỏ
// sau khi ghi xong hẳn (an toàn nếu bị giết giữa chừng — slot active cũ vẫn nguyên).
/**
 * _aging_getSourceVersion_()
 * [MỚI — tận dụng nhịp cập nhật của nguồn: "Update daily at 7:00-18:00, mỗi tiếng
 * 1 lần"] Mọi dòng trong sheet nguồn đều mang cùng mốc 'report_datetime' — chính là
 * DẤU PHIÊN BẢN của lần cập nhật đó. Đọc ĐÚNG 1 Ô (rất rẻ) là biết nguồn đã đổi hay
 * chưa, thay vì phải đọc 91.000 dòng mới biết. Kèm số dòng để bắt trường hợp nguồn
 * ghi lại cùng mốc nhưng khác dữ liệu.
 */
/**
 * _aging_countSourceOrders_() — SỐ ĐƠN THẬT (dòng có mã đơn) của sheet LM. Dùng cho chốt chặn "nguồn ghi
 * dở": lastRow của sheet không phản ánh khối lượng thật (file export: 91.500 dòng nhưng chỉ 12.419 đơn,
 * còn lại là dòng trống) nên so lastRow gần như không bao giờ phát hiện được ghi dở.
 */
function _aging_countSourceOrders_() {
  var sh = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA').getSheetByName('1. LM high aging');
  if (!sh) return 0;
  var last = sh.getLastRow();
  if (last < 3) return 0;
  var M = _aging_lmColumnMap_(sh.getRange(2, 1, 1, Math.min(sh.getMaxColumns(), Math.max(sh.getLastColumn(), 18))).getValues()[0]);
  var col = sh.getRange(3, M.ship + 1, last - 2, 1).getValues();
  var n = 0;
  for (var i = 0; i < col.length; i++) { if (col[i][0] !== '' && col[i][0] != null && String(col[i][0]).trim() !== '') n++; }
  return n;
}

function _aging_getSourceVersion_() {
  try {
    var sh = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA').getSheetByName('1. LM high aging');
    if (!sh) return '';
    return String(sh.getRange(3, 8).getDisplayValue() || '').trim() + '|' + sh.getLastRow();  // cột H = report_datetime
  } catch (e) { return ''; }
}

function _aging_writeRawSnapshot_(coreData, lostData, fmDataSlim, srcVerStamp) {
  // [SỬA LỖI THẬT — "lỗi cứ lặp lại, phải vào chạy lại lệnh"] Trước đây dấu phiên bản nguồn
  // được đọc NGAY LÚC GHI. Nhưng một chu kỳ dựng (core -> lost -> fm -> finalize) có thể kéo
  // qua nhiều lượt trigger khi 1 giai đoạn lỗi/bị cắt: phần core đã đọc từ TRƯỚC giờ cập nhật
  // nguồn, mà bản chụp lại đóng dấu phiên bản MỚI -> vòng nền tin "đã khớp nguồn" và nghỉ tới
  // 3 giờ trong khi giao diện hiện số cũ. Nay finalize truyền vào phiên bản đã đọc TRƯỚC KHI đọc
  // core; không truyền (đường dựng trực tiếp) thì lấy phiên bản hiện tại như cũ.
  var _stampVer = srcVerStamp ? String(srcVerStamp) : '';
  if (!_stampVer) { try { _stampVer = _aging_getSourceVersion_(); } catch (eSv0) { _stampVer = ''; } }
  var ss = _DS.ss(ADMIN_DB_ID);
  var metaSheet = _aging_getSnapshotMetaSheet_(ss);
  var oldMeta = _kpifail_getMetaMap_(metaSheet);
  var oldActiveSlot = oldMeta.snapshot_active_slot === 'B' ? 'B' : 'A';
  var newSlot = oldActiveSlot === 'A' ? 'B' : 'A';
  var dataSheet = _aging_getSnapshotSheet_(ss, newSlot);

  var json = JSON.stringify({ coreData: coreData, lostData: lostData, fmData: fmDataSlim });
  var chunkSize = 45000;
  var rows = [['Key', 'ChunkIndex', 'ChunkData']];
  var idx = 0;
  for (var pos = 0; pos < json.length; pos += chunkSize) {
    // [SỬA] Cùng lỗi đã làm hỏng dữ liệu 7 ngày ở sheet tạm: ô bắt đầu bằng '=',
    // '+', '-', '@' bị Google Sheets hiểu thành CÔNG THỨC. Bản chụp cũng ghi theo
    // khúc nên mang đúng rủi ro đó — thêm ký tự mở đầu an toàn.
    rows.push(['snapshot', idx++, AGING_CHUNK_PREFIX + json.slice(pos, pos + chunkSize)]);
  }
  dataSheet.clearContents();
  dataSheet.getRange(1, 1, rows.length, 3).setValues(rows);
  dataSheet.getRange(1, 1, 1, 3).setFontWeight('bold');

  var nowIso = Utilities.formatDate(new Date(), SPX_TZ, "yyyy-MM-dd'T'HH:mm:ss");
  _kpifail_setMetaMap_(metaSheet, {
    snapshot_version: String(Date.now()),
    snapshot_saved_at: nowIso,
    snapshot_active_slot: newSlot,
    // [MỚI] Dấu phiên bản NGUỒN mà bản chụp này dựng từ đó.
    snapshot_source_version: _stampVer,
    snapshot_schema: AGING_SNAPSHOT_SCHEMA,
    // Số dòng nguồn tại thời điểm dựng — dùng làm mốc so sánh khối lượng cho lần sau,
    // vì nguồn GHI ĐÈ TOÀN BỘ nên giữa chừng số dòng có thể tụt hẳn.
    snapshot_row_count: String(Number((_stampVer || '|0').split('|')[1]) || 0),
    snapshot_core_count: String(Array.isArray(coreData) ? coreData.length : 0)
  });
}

// =========================================================================
// [FIX 2026-08-14] "XÂY THEO GIAI ĐOẠN" — chia _aging_buildRawData_() (đọc 3
// nguồn Core/Lost/FM RỒI MỚI ghi snapshot, TẤT CẢ trong 1 lần chạy) thành 4
// LƯỢT TRIGGER RIÊNG BIỆT (core → lost → fm → finalize), mỗi lượt chỉ đọc ĐÚNG
// 1 nguồn. Lý do: nguồn thật đã xác nhận rất lớn (sheet "Detail orders" của
// FMS Live tương tự có 194.000 dòng — cùng lớp quy mô); dồn cả 3 lần đọc lớn
// vào 1 lần chạy có nguy cơ chạm trần 6 phút/lần — CỨNG, không có ngoại lệ cho
// tài khoản Workspace (mức 30 phút từng có đã bị Google thu hồi, xác nhận qua
// tài liệu 2026).
//
// AN TOÀN QUAN TRỌNG: KHÔNG đụng vào _aging_getCoreDataFromSS/_aging_getLostDataFromSS/
// _aging_getFMDataFromSS (giữ nguyên 100% — đây là các hàm đã qua thực chiến,
// từng có bài học "chia nhỏ theo CỘT bị rollback vì kém tin cậy hơn 1 lệnh đọc
// duy nhất" — không lặp lại rủi ro đó). Chỉ chia theo NGUỒN (mỗi nguồn 1 lệnh
// đọc trọn vẹn, y hệt cũ), KHÔNG chia theo dòng bên trong 1 sheet. Cũng KHÔNG
// đụng _aging_writeRawSnapshot_ (cơ chế ping-pong A/B có sẵn) — chỉ gọi nó Ở
// GIAI ĐOẠN FINALIZE, sau khi đã có đủ cả 3 phần.
//
// KHÔNG thay thế _aging_buildRawData_() — hàm đó vẫn giữ nguyên, vẫn được dùng
// cho đường "build trực tiếp lúc user đang chờ" (khi giành được cold-lock trong
// aging_getMasterData()) — đường đó CẦN trả lời ngay trong 1 lần, không thể
// trải ra nhiều lượt trigger. CHỈ đổi cách aging_prewarmCache() (job NỀN, không
// ai đang chờ) gọi — xem sửa đổi ở aging_prewarmCache() bên dưới.
// =========================================================================
var AGING_BUILD_STAGE_KEY = 'aging_build_stage_v1';

function _aging_stagingSheet_(ss) {
  var sheet = ss.getSheetByName('AgingBuild_Staging');
  if (!sheet) {
    sheet = ss.insertSheet('AgingBuild_Staging');
    sheet.appendRow(['Stage', 'ChunkIndex', 'ChunkData']);
    sheet.getRange(1, 1, 1, 3).setFontWeight('bold');
  }
  return sheet;
}

/** Ghi kết quả của 1 giai đoạn — CHỈ xoá/ghi lại các dòng của ĐÚNG giai đoạn này, giữ nguyên các giai đoạn khác đã lưu trước đó trong cùng sheet tạm. */
// Ky tu mo dau an toan cho moi khuc du lieu ghi vao o Google Sheets — tranh bi
// hieu nham la cong thuc khi khuc bat dau bang '=', '+', '-', '@'.
var AGING_CHUNK_PREFIX = '~';

function _aging_writeStageResult_(ss, stageName, dataObj) {
  var sheet = _aging_stagingSheet_(ss);
  var values = sheet.getDataRange().getValues();
  var keepRows = [values[0]]; // header
  for (var i = 1; i < values.length; i++) {
    if (values[i][0] !== stageName) keepRows.push(values[i]);
  }
  var json = JSON.stringify(dataObj);
  var chunkSize = 45000;
  var wrote = false;
  // [SỬA LỖI THẬT — chẩn đoán: phần 'core' hỏng, JSON đứt ở vị trí 2.430.009 =
  // ĐÚNG 54 x 45.000 -> khúc số 54 bị biến dạng, giai đoạn finalize lỗi 7 ngày]
  // Nguyên nhân: mỗi khúc được ghi THẲNG vào ô Google Sheets. Sheets tự diễn giải
  // chuỗi mở đầu bằng '=', '+', '-', '@' thành CÔNG THỨC -> nội dung ô khác hẳn
  // chuỗi gốc. JSON bị cắt ở vị trí bất kỳ nên sớm muộn cũng có khúc rơi vào đó.
  // Cách sửa: thêm ký tự mở đầu an toàn (AGING_CHUNK_PREFIX) vào MỌI khúc, và gỡ
  // ra khi đọc. Ô luôn bắt đầu bằng ký tự thường -> Sheets giữ nguyên dạng văn bản.
  for (var pos = 0; pos < json.length; pos += chunkSize) {
    keepRows.push([stageName, Math.floor(pos / chunkSize), AGING_CHUNK_PREFIX + json.slice(pos, pos + chunkSize)]);
    wrote = true;
  }
  if (!wrote) keepRows.push([stageName, 0, AGING_CHUNK_PREFIX + json]); // mảng rỗng ('[]') vẫn cần 1 dòng đánh dấu "đã xong giai đoạn này"
  sheet.clearContents();
  sheet.getRange(1, 1, keepRows.length, 3).setValues(keepRows);
}

/** Đọc lại kết quả của 1 giai đoạn — trả về null nếu giai đoạn đó CHƯA từng ghi xong (khác với ghi xong nhưng rỗng). */
function _aging_readStageResult_(ss, stageName) {
  var sheet = _aging_stagingSheet_(ss);
  var values = sheet.getDataRange().getValues();
  var chunks = [];
  var found = false;
  var maxIdx = -1;
  for (var i = 1; i < values.length; i++) {
    if (values[i][0] === stageName) {
      var idx = Number(values[i][1]);
      var cell = values[i][2] == null ? '' : String(values[i][2]);
      // Gỡ ký tự mở đầu an toàn (khúc ghi bằng bản cũ không có -> vẫn đọc được).
      if (cell.charAt(0) === AGING_CHUNK_PREFIX) cell = cell.slice(1);
      chunks[idx] = cell;
      if (idx > maxIdx) maxIdx = idx;
      found = true;
    }
  }
  if (!found) return null;
  // [SỬA LỖI THẬT] Trước đây dùng chunks.join('') — khúc thiếu bị nối IM LẶNG
  // thành JSON hỏng, và lỗi chỉ lộ ra ở bước cuối dưới dạng "Expected ',' or '}'".
  // Nay: thiếu khúc -> trả null (coi như giai đoạn CHƯA xong) để hệ thống dựng lại
  // từ đầu, thay vì ghi bản chụp hỏng hoặc kẹt vòng lặp.
  for (var k = 0; k <= maxIdx; k++) {
    if (chunks[k] === undefined) {
      _LOG.d('[Aging Stage] Thieu khuc so ' + k + '/' + maxIdx + ' cua giai doan ' + stageName + ' - coi nhu chua xong.');
      return null;
    }
  }
  try {
    return JSON.parse(chunks.join(''));
  } catch (eParse) {
    _LOG.d('[Aging Stage] Du lieu giai doan ' + stageName + ' hong: ' + eParse.message + ' - coi nhu chua xong, se dung lai.');
    return null;
  }
}

/**
 * Job nền chạy XÂY THEO GIAI ĐOẠN — gọi thay cho _aging_buildRawData_() từ
 * aging_prewarmCache(). Mỗi lượt gọi chỉ làm ĐÚNG 1 việc rồi dừng (đọc 1 nguồn,
 * hoặc finalize). Best-effort: lỗi giữa chừng KHÔNG làm nhảy cursor sai (chỉ
 * setProperty sang giai đoạn kế tiếp SAU KHI đã ghi xong giai đoạn hiện tại —
 * xem mô phỏng đã kiểm chứng), lượt trigger sau tự thử lại đúng giai đoạn đang
 * dang dở.
 */
/**
 * spx_diagAgingSnapshot() — CHẠY THỦ CÔNG (chọn hàm rồi bấm Run).
 * [MỚI — báo cáo: "toàn bộ data module Kiểm soát Giao hàng là data cũ"]
 * Module KHÔNG đọc sheet trực tiếp mà đọc BẢN CHỤP dựng sẵn. Hàm này cho biết
 * bản chụp dựng lúc nào, đang ở giai đoạn nào, và VÌ SAO job dựng lại không chạy
 * (cầu dao ngân sách hay khoá chống chạy chồng) — thay vì đoán.
 */
/**
 * spx_diagAgingFinalize() — CHẠY THỦ CÔNG (chọn hàm rồi bấm Run).
 * [MỚI — chẩn đoán: giai đoạn dựng bản chụp kẹt ở 'finalize' 7 ngày]
 * Nhánh finalize trong aging_stagedBuildRunner bọc try/catch chỉ GHI LOG rồi bỏ
 * qua, KHÔNG đổi giai đoạn -> lỗi lặp lại mỗi lượt mà không ai thấy. Hàm này chạy
 * đúng các bước của finalize và TRẢ VỀ câu lỗi thật, kèm kích thước từng phần —
 * để biết lỗi do dữ liệu quá lớn, sheet tạm hỏng, hay nguyên nhân khác.
 */
function spx_diagAgingFinalize() {
  var out = { buoc: [] };
  try {
    var ssStaging = _DS.ss(ADMIN_DB_ID);
    out.buoc.push('Mở Admin DB: OK');
    var core = null, lost = null, fm = null;
    try { core = _aging_readStageResult_(ssStaging, 'core'); out.buoc.push('Đọc phần core: ' + (core === null ? 'NULL (thiếu)' : core.length + ' dòng')); }
    catch (e1) { out.buoc.push('Đọc phần core LỖI: ' + e1.message); }
    try { lost = _aging_readStageResult_(ssStaging, 'lost'); out.buoc.push('Đọc phần lost: ' + (lost === null ? 'NULL (thiếu)' : lost.length + ' dòng')); }
    catch (e2) { out.buoc.push('Đọc phần lost LỖI: ' + e2.message); }
    try { fm = _aging_readStageResult_(ssStaging, 'fm'); out.buoc.push('Đọc phần fm: ' + (fm === null ? 'NULL (thiếu)' : fm.length + ' dòng')); }
    catch (e3) { out.buoc.push('Đọc phần fm LỖI: ' + e3.message); }
    if (core === null || lost === null || fm === null) {
      out.ketLuan = 'Thiếu dữ liệu giai đoạn -> lẽ ra phải reset về core. Chạy spx_rebuildAgingSnapshotNow() để dựng lại từ đầu.';
      Logger.log(JSON.stringify(out, null, 2)); return JSON.stringify(out, null, 2);
    }
    var json = JSON.stringify({ coreData: core, lostData: lost, fmData: fm });
    out.kichThuocBanChup_kyTu = json.length;
    out.soO50kCanDung = Math.ceil(json.length / 45000);
    try {
      _aging_writeRawSnapshot_(core, lost, fm);
      out.buoc.push('GHI BẢN CHỤP: THÀNH CÔNG');
      PropertiesService.getScriptProperties().setProperty(AGING_BUILD_STAGE_KEY, 'core');
      out.ketLuan = 'Đã ghi bản chụp mới thành công — giai đoạn đặt lại về core. Dữ liệu module sẽ đúng ngay.';
    } catch (eW) {
      out.buoc.push('GHI BẢN CHỤP LỖI: ' + eW.message);
      out.loiGoc = eW.message;
      out.ketLuan = 'ĐÂY là lỗi khiến bản chụp kẹt 7 ngày. Xem "loiGoc" để xử lý gốc.';
    }
  } catch (e) { out.loi = e.message; }
  Logger.log(JSON.stringify(out, null, 2));
  return JSON.stringify(out, null, 2);
}

function spx_diagAgingSnapshot() {
  var out = {};
  try {
    var ss = _DS.ss(ADMIN_DB_ID);
    var meta = _kpifail_getMetaMap_(_aging_getSnapshotMetaSheet_(ss));
    var ver  = Number(meta.snapshot_version) || 0;
    out.banChup = {
      dungLuc: ver ? Utilities.formatDate(new Date(ver), 'Asia/Ho_Chi_Minh', 'yyyy-MM-dd HH:mm:ss') : '(chưa có)',
      cuBaoNhieuPhut: ver ? Math.round((Date.now() - ver) / 60000) : null,
      oDangDung: meta.snapshot_active_slot || '(?)'
    };
  } catch (e) { out.banChup = { loi: e.message }; }
  try {
    var props = PropertiesService.getScriptProperties();
    out.giaiDoanKeTiep = props.getProperty(AGING_BUILD_STAGE_KEY) || 'core';
  } catch (e) { out.giaiDoanKeTiep = '(?)'; }
  try {
    var b = _spxReadDailyBudget_();
    out.nganSach = {
      daDung_phut: Math.round(b.usedMinutes || 0),
      nguongBoQua_phut: SPX_DAILY_BUDGET_SKIP_THRESHOLD,
      dangChanJob: (b.usedMinutes || 0) >= SPX_DAILY_BUDGET_SKIP_THRESHOLD
    };
  } catch (e) { out.nganSach = { loi: e.message }; }
  try {
    var got = _anaAcquireNamedLock('aging_staged_build_lock_v1', 1000, 600000);
    out.khoaChongChayChong = got ? 'RẢNH (không phải nguyên nhân)' : 'ĐANG BỊ GIỮ — job không chạy được vì chốt này';
    if (got) _anaReleaseNamedLock('aging_staged_build_lock_v1');
  } catch (e) { out.khoaChongChayChong = 'lỗi: ' + e.message; }
  // [SỬA] Xét TUỔI BẢN CHỤP trước: bản chụp còn mới thì mọi thứ đang chạy đúng,
  // không việc gì phải đi xem Executions (dòng kết luận cũ gây hiểu nhầm).
  var _snapMin = (out.banChup && typeof out.banChup.cuBaoNhieuPhut === 'number') ? out.banChup.cuBaoNhieuPhut : null;
  out.ketLuan = (_snapMin !== null && _snapMin <= 180) ? ('Bản chụp mới ' + _snapMin + ' phút trước (CHỈ xét tuổi — muốn biết có khớp nguồn hiện tại không, chạy spx_diagAgingHealth).')
              : (out.nganSach && out.nganSach.dangChanJob) ? 'Cầu dao ngân sách đang chặn job dựng bản chụp.'
              : (String(out.khoaChongChayChong).indexOf('ĐANG BỊ GIỮ') >= 0) ? 'Khoá chống chạy chồng đang giữ — job bị bỏ qua mỗi lượt.'
              : 'Cả 2 chốt đều KHÔNG chặn — cần xem Executions của aging_prewarmCache để biết job dừng ở đâu.';
  Logger.log(JSON.stringify(out, null, 2));
  return JSON.stringify(out, null, 2);
}

/**
 * spx_diagAgingHealth() — CHẠY THỦ CÔNG ĐÚNG LÚC thấy số cũ/sai (trước khi chạy lệnh dựng lại!).
 * Khác spx_diagAgingSnapshot (chỉ xét TUỔI bản chụp): hàm này so bản chụp với NGUỒN THẬT và đọc
 * thử NỘI DUNG bản chụp đang phục vụ, kèm lý do vòng nền không dựng được (lỗi gần nhất, thời gian
 * chạy, chu kỳ dang dở, cầu dao). Gửi kết quả này để biết chính xác vì sao nó lặp lại.
 */
function spx_diagAgingHealth() {
  var out = { canhBao: [] };
  var warn = function (m) { out.canhBao.push(m); };
  var props = PropertiesService.getScriptProperties();
  var meta = {};
  try { meta = _kpifail_getMetaMap_(_aging_getSnapshotMetaSheet_(_DS.ss(ADMIN_DB_ID))) || {}; } catch (e) { warn('Không đọc được meta bản chụp: ' + e.message); }
  var ver = Number(meta.snapshot_version) || 0;
  var live = ''; try { live = _aging_getSourceVersion_(); } catch (e2) {}
  var stamped = String(meta.snapshot_source_version || '');
  var ageMin = ver ? Math.round((Date.now() - ver) / 60000) : null;
  out.banChup = {
    dungLuc: ver ? Utilities.formatDate(new Date(ver), 'Asia/Ho_Chi_Minh', 'yyyy-MM-dd HH:mm:ss') : '(chưa có)',
    cuBaoNhieuPhut: ageMin,
    schemaDung: meta.snapshot_schema === AGING_SNAPSHOT_SCHEMA,
    dauNguonDaDong: stamped || '(trống)',
    nguonHienTai: live || '(không đọc được)',
    banTamDungTrucTiep: /^COLD/.test(stamped),
    nguonDaDoiSauKhiDung: !!(live && stamped && !/^COLD/.test(stamped) && live !== stamped)
  };
  var _cw = _spx_getColWarn_(); if (_cw) warn('Cảnh báo cột nguồn: ' + _cw);
  if (out.banChup.banTamDungTrucTiep) warn('Bản chụp TẠM (dựng trực tiếp khi không có bản hợp lệ) — vòng nền sẽ dựng lại đúng quy trình ở lượt kế.');
  if (!ver) warn('Chưa có bản chụp nào.');
  if (ver && !out.banChup.schemaDung) warn('Bản chụp sai schema — sẽ bị bỏ và dựng lại.');
  if (ageMin !== null && ageMin > 180) warn('Bản chụp đã ' + ageMin + ' phút (>180) — người dùng đầu tiên sẽ phải chờ dựng trực tiếp.');
  if (out.banChup.nguonDaDoiSauKhiDung) warn('Nguồn đã đổi sau khi dựng bản chụp — lượt trigger kế tiếp sẽ dựng lại; nếu cứ lặp lại, xem loiGanNhat/thoiGianChay bên dưới.');
  var hasStage = props.getProperty(AGING_BUILD_STAGE_KEY) || 'core';
  out.tienTrinh = {
    giaiDoanKeTiep: hasStage,
    dauNguonLucDocCore: props.getProperty('aging_stage_core_srcver') || '(không có chu kỳ dở)',
    soLanLoiLienTiep: { core: props.getProperty('aging_stage_fail_core') || 0, lost: props.getProperty('aging_stage_fail_lost') || 0, fm: props.getProperty('aging_stage_fail_fm') || 0, finalize: props.getProperty('aging_stage_fail_finalize') || 0 },
    chuoiNguonItDong: props.getProperty('aging_low_rows_streak') || 0
  };
  if (hasStage !== 'core') warn('Chu kỳ dựng đang DANG DỞ ở giai đoạn "' + hasStage + '" — dữ liệu core trong sheet tạm có thể đã cũ.');
  try {
    out.dieuKien = { khungGioVang_23h_5h: _spxIsPrewarmQuietHours_(), cauDaoNganSachDangChan: _spxShouldSkipForBudget_() };
    if (out.dieuKien.cauDaoNganSachDangChan) warn('Cầu dao ngân sách đang chặn job dựng.');
  } catch (e3) {}
  try {
    var errs = JSON.parse(props.getProperty('spx_fn_last_errors') || '{}');
    out.loiGanNhat = { aging_prewarmCache: errs.aging_prewarmCache || [], spxDispatcher10Min: errs.spxDispatcher10Min || [] };
    if ((errs.aging_prewarmCache || []).length) warn('aging_prewarmCache có lỗi gần đây — xem loiGanNhat.');
  } catch (e4) {}
  try {
    var st = JSON.parse(props.getProperty(SPX_DISPATCH_TIMING_KEY) || '{}');
    out.thoiGianChay = {};
    ['aging_prewarmCache', 'aging_lmFullPicPrewarm', 'kpifail_prewarmCache', 'fms_live_prewarmCache', 'spx_usageStats_flushBuffer'].forEach(function (fn) {
      if (st[fn]) out.thoiGianChay[fn] = { lan: st[fn].count, tbGiay: Math.round(st[fn].totalS / st[fn].count), maxGiay: Math.round(st[fn].maxS), lanLoi: st[fn].errCount };
    });
  } catch (e5) {}
  try {
    var snap = _aging_readRawSnapshot_();
    if (!snap) { warn('Bản chụp đang phục vụ KHÔNG hợp lệ (sai schema / quá 3 giờ / rỗng).'); }
    else {
      var arr = Array.isArray(snap.coreData) ? snap.coreData : ((snap.coreData && snap.coreData.data) || []);
      var hubs = {}, hubLike = 0, newestIn = '';
      arr.forEach(function (r) {
        var h = String(r.hubName || ''); hubs[h] = 1;
        if (/hub|soc|station/i.test(h)) hubLike++;
        if (r.inboundAt && String(r.inboundAt) > newestIn) newestIn = String(r.inboundAt);
      });
      out.noiDungBanChup = { soDon: arr.length, soTram: Object.keys(hubs).length, tyLeDongCoTenTram: arr.length ? Math.round(hubLike / arr.length * 100) + '%' : 'n/a',
                             mauTram: Object.keys(hubs).slice(0, 3), ngayVeTramMoiNhat: newestIn || '(không có)' };
      if (arr.length && hubLike / arr.length < 0.5) warn('Nội dung bản chụp có cột trạm KHÔNG giống tên trạm — dữ liệu sai bố cục.');
      if (!arr.length) warn('Bản chụp không có đơn nào.');
    }
  } catch (e6) { warn('Không đọc được nội dung bản chụp: ' + e6.message); }
  out.ketLuan = out.canhBao.length ? 'CÓ ' + out.canhBao.length + ' ĐIỂM CẦN XEM — đọc mục canhBao.' : 'Khớp nguồn, vòng nền không có dấu hiệu bất thường.';
  Logger.log(JSON.stringify(out, null, 2));
  return JSON.stringify(out, null, 2);
}

/**
 * spx_rebuildAgingSnapshotNow() — CHẠY THỦ CÔNG khi cần dữ liệu đúng NGAY.
 * Chạy liên tiếp các giai đoạn dựng bản chụp, BỎ QUA cầu dao ngân sách, cho tới
 * khi hoàn tất hoặc gần chạm giới hạn 6 phút/lượt của Apps Script. Nếu chưa xong,
 * chạy lại hàm này (nó tiếp tục từ giai đoạn đang dở).
 */
function spx_rebuildAgingSnapshotNow() {
  // [SỬA LỖI THẬT — bản trước của chính hàm này dừng sai] Nó thoát ngay khi giai
  // đoạn quay về 'core', hiểu nhầm là "xong 1 chu kỳ". Thực tế 'core' là lúc BẮT
  // ĐẦU: phát hiện dữ liệu hỏng -> đặt lại về đầu -> thoát mà chưa dựng gì.
  // Nay căn cứ vào SỰ THẬT: bản chụp đã được ghi mới hay chưa (mốc thời gian đổi).
  function _verNow() {
    try { return Number(_kpifail_getMetaMap_(_aging_getSnapshotMetaSheet_(_DS.ss(ADMIN_DB_ID))).snapshot_version) || 0; }
    catch (e) { return 0; }
  }
  var t0 = Date.now(), verBefore = _verNow(), steps = [], lastStage = '';
  for (var i = 0; i < 12; i++) {
    if (Date.now() - t0 > 4.5 * 60 * 1000) {
      steps.push('DỪNG vì gần hết 6 phút/lượt — CHẠY LẠI hàm này để tiếp tục từ giai đoạn đang dở.');
      break;
    }
    var before = PropertiesService.getScriptProperties().getProperty(AGING_BUILD_STAGE_KEY) || 'core';
    try { aging_stagedBuildRunner(true); }
    catch (eRun) { steps.push('LỖI ở giai đoạn ' + before + ': ' + eRun.message); break; }
    var after = PropertiesService.getScriptProperties().getProperty(AGING_BUILD_STAGE_KEY) || 'core';
    steps.push(before + ' -> ' + after);
    if (_verNow() !== verBefore) { steps.push('✅ ĐÃ GHI BẢN CHỤP MỚI — dữ liệu module đúng ngay từ bây giờ.'); break; }
    // Không tiến triển 2 lượt liên tiếp ở cùng giai đoạn -> dừng, tránh lặp vô ích.
    if (before === after && lastStage === before) { steps.push('Giai đoạn ' + after + ' không tiến triển 2 lượt — dừng. Chạy spx_diagAgingFinalize() để xem lỗi thật.'); break; }
    lastStage = before;
  }
  var res = { cacBuoc: steps, banChupDaDoiMoi: _verNow() !== verBefore, sau: JSON.parse(spx_diagAgingSnapshot()) };
  Logger.log(JSON.stringify(res, null, 2));
  return JSON.stringify(res, null, 2);
}

function aging_stagedBuildRunner(_forceIgnoreBudget) {
  // [SỬA] Cho phép chạy thủ công bỏ qua cầu dao (xem spx_rebuildAgingSnapshotNow).
  if (!_forceIgnoreBudget && _spxShouldSkipForBudget_()) { _LOG.d('[Aging Staged Build] Bỏ qua — ngân sách runtime hôm nay đã cao.'); return; }
  var gotLock = _anaAcquireNamedLock('aging_staged_build_lock_v1', 10000, 600000);
  if (!gotLock) { _LOG.d('[Aging Staged Build] Bỏ qua — lượt trước còn đang chạy.'); return; }
  var _t0 = Date.now();
  try {
    var props = PropertiesService.getScriptProperties();
    var stage = props.getProperty(AGING_BUILD_STAGE_KEY) || 'core';
    var ssStaging = _DS.ss(ADMIN_DB_ID); // cùng chỗ với sheet snapshot ping-pong thật

    if (stage === 'core') {
      var ssCore = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA');
      // [MỚI] Ghi nhớ phiên bản nguồn TRƯỚC khi đọc: nguồn đổi giữa chừng thì dấu này cũ hơn dữ
      // liệu mới đọc -> vòng nền thấy lệch và dựng lại, thay vì tin nhầm là đã khớp.
      try { props.setProperty('aging_stage_core_srcver', _aging_getSourceVersion_() || ''); } catch (eCv) {}
      var coreRes = JSON.parse(_aging_getCoreDataFromSS(ssCore)); // [KHÔNG ĐỔI] hàm gốc, nguyên vẹn
      if (!coreRes.success) throw new Error('Lỗi đọc Core: ' + coreRes.error);
      _aging_writeStageResult_(ssStaging, 'core', coreRes.data);
      props.setProperty(AGING_BUILD_STAGE_KEY, 'lost');
      _LOG.d('[Aging Staged Build] Giai đoạn CORE xong (' + coreRes.data.length + ' dòng) → tiếp theo: lost');

    } else if (stage === 'lost') {
      var ssLost = _DS.ss('1vvOZG80Rz5PTNPFsbHzmUMPkPaAkGOY70nDHBwfzjQE');
      var lostRes = JSON.parse(_aging_getLostDataFromSS(ssLost)); // [KHÔNG ĐỔI]
      if (!lostRes.success) throw new Error('Lỗi đọc Lost: ' + lostRes.error);
      _aging_writeStageResult_(ssStaging, 'lost', lostRes.data);
      props.setProperty(AGING_BUILD_STAGE_KEY, 'fm');
      _LOG.d('[Aging Staged Build] Giai đoạn LOST xong (' + lostRes.data.length + ' dòng) → tiếp theo: fm');

    } else if (stage === 'fm') {
      var ssCoreForFm = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA');
      var fmRes = JSON.parse(_aging_getFMDataFromSS(ssCoreForFm)); // [KHÔNG ĐỔI]
      if (!fmRes.success) throw new Error('Lỗi đọc FM: ' + fmRes.error);
      // [KHÔNG ĐỔI logic rỗng-hoá — y hệt _aging_buildRawData_() gốc]
      var fmDataSlim = new Array(fmRes.count || 0).fill(0).map(function () { return {}; });
      _aging_writeStageResult_(ssStaging, 'fm', fmDataSlim);
      props.setProperty(AGING_BUILD_STAGE_KEY, 'finalize');
      _LOG.d('[Aging Staged Build] Giai đoạn FM xong (' + fmDataSlim.length + ' dòng) → tiếp theo: finalize');

    } else { // finalize
      var coreData = _aging_readStageResult_(ssStaging, 'core');
      var lostData = _aging_readStageResult_(ssStaging, 'lost');
      var fmDataSlim2 = _aging_readStageResult_(ssStaging, 'fm');
      if (coreData === null || lostData === null || fmDataSlim2 === null) {
        // Thiếu 1 phần (hiếm — VD sheet tạm bị ai đó xoá tay giữa chừng) -> an
        // toàn quay lại từ đầu thay vì ghi snapshot thiếu dữ liệu.
        props.setProperty(AGING_BUILD_STAGE_KEY, 'core');
        throw new Error('Thiếu dữ liệu 1 giai đoạn khi finalize — reset về core, chạy lại từ đầu ở lượt sau.');
      }
      // [SỬA] Đóng dấu bằng phiên bản nguồn LÚC ĐỌC core (xem _aging_writeRawSnapshot_).
      _aging_writeRawSnapshot_(coreData, lostData, fmDataSlim2, props.getProperty('aging_stage_core_srcver') || ''); // cơ chế ping-pong gốc
      // Dọn sheet tạm sau khi đã ghi xong snapshot thật — không giữ lại dữ liệu cũ vô ích
      var stagingSheet = _aging_stagingSheet_(ssStaging);
      stagingSheet.clearContents();
      stagingSheet.appendRow(['Stage', 'ChunkIndex', 'ChunkData']);
      stagingSheet.getRange(1, 1, 1, 3).setFontWeight('bold');
      props.setProperty(AGING_BUILD_STAGE_KEY, 'core'); // reset cho chu kỳ tiếp theo
      try { props.deleteProperty('aging_stage_core_srcver'); } catch (eDv) {}
      try { ['core','lost','fm','finalize'].forEach(function (s) { props.deleteProperty('aging_stage_fail_' + s); }); } catch (eClr) {}
      _LOG.d('[Aging Staged Build] FINALIZE xong — đã ghi snapshot thật (ping-pong), bắt đầu chu kỳ mới từ core.');
    }
  } catch (e) {
    _LOG.d('[Aging Staged Build] LỖI ở giai đoạn hiện tại: ' + e.message + ' — sẽ tự thử lại đúng giai đoạn này ở lượt trigger sau.');
    // [SỬA LỖI THẬT — sự cố ẩn 7 ngày] Trước đây lỗi chỉ được ghi log rồi bỏ qua,
    // GIỮ NGUYÊN giai đoạn -> cùng một lỗi lặp lại mỗi 15 phút suốt nhiều ngày,
    // bản chụp không bao giờ được dựng lại, và KHÔNG AI BIẾT. Đo thật: bản chụp
    // đứng yên từ 16/09, giai đoạn kẹt ở 'finalize'.
    // Nay: đếm số lần lỗi LIÊN TIẾP của cùng giai đoạn. Quá 3 lần -> tự quay lại
    // từ đầu (core) để thoát vòng lặp, và ghi cảnh báo để còn truy được nguyên nhân.
    try {
      var _failKey = 'aging_stage_fail_' + (props.getProperty(AGING_BUILD_STAGE_KEY) || 'core');
      var _n = Number(props.getProperty(_failKey) || 0) + 1;
      props.setProperty(_failKey, String(_n));
      if (_n >= 3) {
        props.setProperty(AGING_BUILD_STAGE_KEY, 'core');
        props.deleteProperty(_failKey);
        _LOG.d('[Aging Staged Build] ⚠️ Giai đoạn lỗi ' + _n + ' lượt liên tiếp — tự quay lại từ đầu (core) để thoát vòng lặp.');
      }
    } catch (eFail) {}
  } finally {
    _anaReleaseNamedLock('aging_staged_build_lock_v1');
    var _elapsedMin = (Date.now() - _t0) / 60000;
    _spxTrackExecMinutes_(_elapsedMin);
    if (_elapsedMin >= 3) {
      _LOG.d('[Aging Staged Build] ⚠️ CẢNH BÁO: 1 giai đoạn đơn lẻ đã chạy ' + _elapsedMin.toFixed(1) +
        ' phút (>50% trần 6 phút) — dữ liệu 1 nguồn đơn lẻ đang lớn tới mức cần cân nhắc chia nhỏ hơn nữa.');
    }
  }
}


// riêng — dùng chung cho cả 2 nhánh của khóa chống chồng lấn trong
// aging_getMasterData() (nhánh giành được khóa, và nhánh hiếm khi phải tự build
// độc lập do chờ khóa quá lâu) — tránh lặp code, đảm bảo cả 2 đường luôn cùng
// logic đọc/ghi.
/**
 * aging_getOrderDetail(shipmentId)
 * [MỚI — theo yêu cầu trực tiếp "kết hợp Quá Hạn + Live, show chi tiết hành
 * trình đơn hàng, mỗi level đúng góc nhìn"] Tra cứu LƯỜI (lazy) — CHỈ chạy khi
 * user click xem chi tiết 1 đơn cụ thể, KHÔNG đụng gì tới đường tải bảng
 * chính _aging_getMasterDataCore_() (giữ nguyên tốc độ hiện tại cho mọi user,
 * tránh lặp lại đúng lỗi hiệu năng "tải hết rồi lọc" đã sửa ở Rider Plan).
 *
 * Vì "Detail orders" (nguồn Live) chỉ giữ đơn CÒN TỒN ĐỌNG tại thời điểm đọc
 * (đã xác nhận qua đối chiếu dữ liệu thật: chỉ ~25% đơn Quá Hạn join được),
 * hàm này trả found:false cho 75% còn lại — KHÔNG giả vờ có dữ liệu không
 * tồn tại, để frontend tự ẩn đúng phần Timeline/Trạng thái hiện tại.
 */
function aging_getOrderDetail(shipmentId) {
  try {
    if (!shipmentId || !String(shipmentId).trim()) {
      return JSON.stringify({ success: false, error: 'Thiếu mã đơn.' });
    }
    var sid = String(shipmentId).trim();

    var ss = _DS.ss(FMS_LIVE_SHEET_ID);
    var sheet = ss.getSheetByName(FMS_LIVE_SHEET_NAME);
    if (!sheet || sheet.getLastRow() < 2) {
      return JSON.stringify({ success: true, found: false });
    }

    // TextFinder — tra cứu hiệu quả (built-in Apps Script search), KHÔNG đọc
    // toàn bộ 144k dòng mỗi lần như _fmsLive_buildRawSnapshot_() (hàm đó phục
    // vụ mục đích khác — build toàn bộ snapshot FMS, không phải tra 1 đơn).
    var match = sheet.createTextFinder(sid).matchEntireCell(true).findNext();
    if (!match) {
      return JSON.stringify({ success: true, found: false });
    }

    var lastCol = sheet.getLastColumn();
    var headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0].map(function (h) { return String(h || '').trim(); });
    var rowNum = match.getRow();
    var rowVals = sheet.getRange(rowNum, 1, 1, lastCol).getValues()[0];

    function _val(names) {
      var idx = _fmsLive_findIdxAny_(headers, names);
      return idx === -1 ? null : rowVals[idx];
    }

    var hubName = _val(['station_name', 'Current Station']);

    // [FIX BẢO MẬT — defense-in-depth, cùng nguyên tắc đã áp dụng xuyên suốt
    // hệ thống] Apps Script không có "hàm nội bộ" thật — ai cũng gọi được RPC
    // này qua console với BẤT KỲ shipmentId nào. Dù frontend chỉ cho click vào
    // dòng đã hiện trong bảng (đã lọc đúng quyền/level từ trước), vẫn PHẢI
    // kiểm tra lại ở đây — không tin tưởng phía client.
    var access = getModuleAccess();
    if (access.role === 'denied') {
      return JSON.stringify({ success: false, error: 'Không có quyền truy cập.' });
    }
    if (access.role !== 'admin' && hubName && access.hubs.indexOf(hubName) === -1) {
      return JSON.stringify({ success: false, error: 'Không có quyền xem đơn hàng thuộc hub này.' });
    }

    var rawReason = _val(['last_on_hold_reason_code', 'OnHoldReason']);
    var toIso = function (v) { return (v instanceof Date) ? v.toISOString() : null; };

    return JSON.stringify({
      success: true,
      found: true,
      shipmentId: sid,
      hubName: hubName,
      action: _val(['action']),
      backlogStage: _val(['backlog_stage']),
      reasonLabel: _fmsLive_reasonLabel_(rawReason),
      agingLeadtime: _val(['aging_leadtime']),
      timeline: {
        createdTime: toIso(_val(['created_time'])),
        pickupDone: toIso(_val(['pickup_done'])),
        inboundTime: toIso(_val(['inbound_time'])),
        arrivedTime: toIso(_val(['arrived_time'])),
        lastTouchAt: toIso(_val(['last_touch_at']))
      },
      lastTouchBy: _val(['last_touch_by']),
      codAmount: _val(['cod_amount']),
      deliverAttempt: _val(['deliver_attempt']),
      buyerAddr: {
        state: _val(['buyer_addr_state']),
        city: _val(['buyer_addr_city']),
        district: _val(['buyer_addr_district']),
        ward: _val(['buyer_ward_old'])
      }
    });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

var AGING_LM_FULLPIC_CACHE_KEY = 'aging_lm_fullpic_v1';
var AGING_LM_FULLPIC_TTL_S = 1200; // 20 phút — cùng bậc TTL đã kiểm chứng ở FMS Live cho cùng nguồn dữ liệu

// Nhóm status_desc theo prefix — an toàn hơn liệt kê hết giá trị cụ thể (có
// thể phát sinh giá trị mới chưa từng thấy), đồng thời giữ NGUYÊN chuỗi gốc
// để hiển thị chi tiết (nhóm chỉ dùng cho đếm tổng hợp).
function _aging_groupStatusDesc_(status) {
  var s = (status || '').toString().trim();
  if (!s) return 'unknown';
  if (s === 'OnHold') return 'onhold';
  if (s === 'Delivering') return 'delivering';
  if (s.indexOf('Return_') === 0) return 'return';
  if (s === 'Missing' || s.indexOf('Exception_') === 0) return 'issue';
  return 'processing'; // LMHub_*, SOC_* — đang trong quy trình xử lý/vận chuyển, chưa tới bước giao
}

/**
 * _aging_buildLmFullPicture_()
 * [TÁCH RA từ aging_getLmFullPicture() cũ — theo đúng bài học FMS Live đã rút
 * ra với CHÍNH nguồn dữ liệu này: sheet "Detail orders" đã tới ~194.000 dòng
 * (comment fms_live_installPrewarmTrigger() xác nhận), khiến "user tự build
 * đồng bộ mỗi lần gọi" (thiết kế cũ của CHÍNH aging_getLmFullPicture(), y hệt
 * thiết kế FMS Live đã TỪ BỎ) gây đúng triệu chứng "build dở dang giữ khoá,
 * mọi request sau đều bị chặn 'thử lại sau'" — xác nhận qua báo cáo trực tiếp
 * "load xong không trả về, báo thử lại nhiều lần". Hàm này CHỈ tính toán
 * thuần, không tự cache/khoá — để dùng chung cho cả trigger nền lẫn
 * forceRefresh thủ công.
 */
/**
 * _aging_getOrgMapCached_()
 * [MỚI — TỐI ƯU, theo yêu cầu trực tiếp "tối ưu nâng cấp GAS, không đánh đổi
 * trải nghiệm/tốc độ"] Đọc sheet "AOM SUP" (mapping Hub->AOM/SUP), cache 1
 * giờ — dữ liệu tổ chức hiếm khi đổi trong ngày, không cần đọc lại mỗi 10
 * phút như trước. Trả về { hubKey: {aom, sup} }.
 */
function _aging_getOrgMapCached_() {
  var cached = CacheMgr.getChunked('AGING', 'org_map_hub_aom_sup_v1');
  if (cached) return cached;
  var map = {};
  var _orgOk = true;
  try {
    var ssPerm = SpreadsheetApp.openById(RESCUE_PERMISSION_SPREADSHEET_ID);
    var aomSupSheet = ssPerm.getSheetByName(SHEET_NAME_AOM_SUP);
    if (aomSupSheet && aomSupSheet.getLastRow() > 1) {
      var permData = aomSupSheet.getDataRange().getValues();
      var permIdx = buildHeaderIndex_(permData[0]);
      var cHub = findCol_(permIdx, ['Hub']);
      var cAom = findCol_(permIdx, ['AOM']);
      var cSupName = findCol_(permIdx, ['Sup_Name', 'Sup Name']);
      if (cHub != null) {
        for (var i = 1; i < permData.length; i++) {
          var hubRaw2 = String(permData[i][cHub] || '').trim();
          if (!hubRaw2) continue;
          var hubKey2 = normStationKey_(hubRaw2);
          map[hubKey2] = {
            aom: (cAom != null) ? String(permData[i][cAom] || '').trim() : '',
            sup: (cSupName != null) ? String(permData[i][cSupName] || '').trim() : ''
          };
        }
      }
    }
  } catch (eOrg) { _orgOk = false; /* không chặn — trả map rỗng/1 phần nếu lỗi giữa chừng, hub vẫn hiển thị, chỉ thiếu aom/sup */ }
  // [SỬA] KHÔNG cache bản đồ rỗng/dở dang do lỗi đọc — trước đây một lần Sheets lỗi thoáng qua làm mất
  // AOM/SUP của mọi trạm suốt 1 giờ. Lỗi/rỗng thì trả tạm, lượt sau đọc lại.
  if (_orgOk && Object.keys(map).length > 0) CacheMgr.setChunked('AGING', 'org_map_hub_aom_sup_v1', map, 3600);
  return map;
}

function _aging_buildLmFullPicture_() {
  // ── Nguồn 1: Live — TOÀN BỘ pipeline LM ──────────────────────────
  var ss = _DS.ss(FMS_LIVE_SHEET_ID);
  var sheet = ss.getSheetByName(FMS_LIVE_SHEET_NAME);
  if (!sheet || sheet.getLastRow() < 2) {
    return { success: false, error: 'Không tìm thấy sheet "' + FMS_LIVE_SHEET_NAME + '" hoặc sheet rỗng.' };
  }
  var lastRow = sheet.getLastRow();
  var lastCol = sheet.getLastColumn();
  var headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0].map(function (h) { return String(h || '').trim(); });

  var c = {
    cur: _fmsLive_findIdxAny_(headers, ['station_name', 'Current Station']),
    stage: _fmsLive_findIdxAny_(headers, ['backlog_stage']),
    status: _fmsLive_findIdxAny_(headers, ['status_desc']),
    aging: _fmsLive_findIdxAny_(headers, ['aging_leadtime']),
    // [MỚI — theo yêu cầu trực tiếp "tổng hợp OnHold theo reason code"]
    reason: _fmsLive_findIdxAny_(headers, ['last_on_hold_reason_code', 'OnHoldReason'])
  };
  if (c.cur === -1 || c.stage === -1 || c.status === -1 || c.aging === -1) {
    return { success: false, error: 'Sheet "Detail orders" thiếu cột station_name, backlog_stage, status_desc, hoặc aging_leadtime.' };
  }
  var colIdxs = [c.cur, c.stage, c.status, c.aging];
  if (c.reason !== -1) colIdxs.push(c.reason); // không có cột này vẫn chạy được — chỉ thiếu phần breakdown reason
  var colMin = Math.min.apply(null, colIdxs);
  var colMax = Math.max.apply(null, colIdxs);
  var relC = {};
  Object.keys(c).forEach(function (k) { relC[k] = (c[k] === -1) ? -1 : (c[k] - colMin); });
  var rows = sheet.getRange(2, colMin + 1, lastRow - 1, colMax - colMin + 1).getValues();

  var byHub = {}; // hubKey -> { rawName, statusGroups:{}, agingBuckets:{}, onHoldReasons:{}, liveTotal }
  rows.forEach(function (r) {
    var hubRaw = (r[relC.cur] || '').toString().trim();
    if (!hubRaw) return;
    var stage = (r[relC.stage] || '').toString().trim().toUpperCase();
    if (stage !== 'LM') return; // CHỈ LM — chưa đụng FM theo đúng chỉ đạo

    var hubKey = normStationKey_(hubRaw);
    if (!byHub[hubKey]) byHub[hubKey] = { rawName: hubRaw, statusGroups: {}, agingBuckets: {}, onHoldReasons: {}, liveTotal: 0 };
    var h = byHub[hubKey];

    var group = _aging_groupStatusDesc_(r[relC.status]);
    h.statusGroups[group] = (h.statusGroups[group] || 0) + 1;

    var agingRaw = (r[relC.aging] || '').toString().trim() || '(chưa có mốc)';
    h.agingBuckets[agingRaw] = (h.agingBuckets[agingRaw] || 0) + 1;

    // [MỚI] Chỉ tính lý do cho đơn ĐANG OnHold thật sự — reason code không có
    // ý nghĩa với đơn đang ở trạng thái khác (đang giao/đã giao/đang xử lý).
    if (group === 'onhold' && relC.reason !== -1) {
      var reasonLabel = _fmsLive_reasonLabel_(r[relC.reason]);
      h.onHoldReasons[reasonLabel] = (h.onHoldReasons[reasonLabel] || 0) + 1;
    }

    h.liveTotal++;
  });

  // ── Nguồn 2: mapping tổ chức — sheet "AOM SUP", ĐỘC LẬP với aging cũ ──
  // [TỐI ƯU — theo yêu cầu trực tiếp "tối ưu nâng cấp, không đánh đổi trải
  // nghiệm/tốc độ"] Cache riêng 1 giờ — mapping tổ chức (Hub->AOM/SUP) hiếm
  // khi đổi trong ngày, không cần đọc lại sheet mỗi 10 phút như trước. Không
  // ảnh hưởng gì tới độ tươi dữ liệu vận hành thật (Live/Core/Lost vẫn đúng
  // tần suất 10 phút như cũ) — chỉ riêng bảng tổ chức, đổi rất hiếm, được
  // phép "cũ" tối đa 1 giờ mà không ai nhận ra khác biệt.
  // ── Nguồn 2+3+4 — TÁCH RA HÀM DÙNG CHUNG (xem _aging_mergeOrgCoreLost_) để
  // hàm staged build mới (aging_lmFullPicStagedBuildRunner) tái dùng đúng y
  // hệt logic, không lặp lại code.
  byHub = _aging_mergeOrgCoreLost_(byHub);

  return { success: true, byHub: byHub, generatedAt: new Date().toISOString() };
}

/**
 * _aging_mergeOrgCoreLost_(byHub)
 * [MỚI — tách ra từ _aging_buildLmFullPicture_ để dùng chung với staged
 * build] Gộp mapping tổ chức (Nguồn 2) + backlog cũ/Lost hôm nay (Nguồn 3) +
 * đã chốt Lost (Nguồn 4) vào byHub đã có sẵn dữ liệu Live (Nguồn 1). KHÔNG
 * đổi logic — copy nguyên vẹn từ bản gốc.
 */
function _aging_mergeOrgCoreLost_(byHub) {
  var orgMap = _aging_getOrgMapCached_();
  Object.keys(orgMap).forEach(function (hubKey2) {
    if (byHub[hubKey2]) {
      byHub[hubKey2].aom = orgMap[hubKey2].aom;
      byHub[hubKey2].sup = orgMap[hubKey2].sup;
    }
  });

  // ── Nguồn 3+4 GỘP LẠI — TỐI ƯU HIỆU NĂNG (theo yêu cầu trực tiếp "tối ưu
  // nâng cấp, không đánh đổi trải nghiệm/tốc độ") — tái dùng snapshot ĐÃ CÓ
  // SẴN của aging_getMasterData() (_aging_readRawSnapshot_) thay vì tự đọc lại
  // "1. LM high aging" (~91k dòng) + "Raw" (Lost) từ đầu mỗi 10 phút. Cả 2
  // nguồn này CÙNG được aging_prewarmCache() làm mới đều đặn CÙNG tần suất 10
  // phút với chính hàm này — snapshot luôn đủ mới, KHÔNG hề giảm độ tươi dữ
  // liệu, chỉ loại bỏ 1 lượt quét trùng lặp thật sự không cần thiết mỗi chu
  // kỳ. Giữ NGUYÊN fallback đọc trực tiếp nếu snapshot chưa từng có (lần đầu
  // deploy) hoặc lỗi đọc — không bao giờ để rớt dữ liệu chỉ vì thiếu snapshot.
  var snap = _aging_readRawSnapshot_();
  if (snap && snap.coreData) {
    snap.coreData.forEach(function (r) {
      var hubKey3 = normStationKey_(r.hubName || '');
      if (!hubKey3) return;
      if (!byHub[hubKey3]) byHub[hubKey3] = { rawName: r.hubName, statusGroups: {}, agingBuckets: {}, onHoldReasons: {}, liveTotal: 0 };
      var h3 = byHub[hubKey3];
      if (!h3.coreBacklogTotal) h3.coreBacklogTotal = 0;
      if (!h3.coreLostTodayCount) h3.coreLostTodayCount = 0;
      h3.coreBacklogTotal++;
      if (r.lostToday) h3.coreLostTodayCount++;
    });
    (snap.lostData || []).forEach(function (r) {
      var hubKey4 = normStationKey_(r.hubName || '');
      if (!hubKey4) return;
      if (!byHub[hubKey4]) byHub[hubKey4] = { rawName: r.hubName, statusGroups: {}, agingBuckets: {}, onHoldReasons: {}, liveTotal: 0 };
      var h4 = byHub[hubKey4];
      if (!h4.confirmedLostCount) h4.confirmedLostCount = 0;
      h4.confirmedLostCount++;
    });
  } else {
    // [Fallback — KHÔNG xoá, giữ nguyên cách đọc trực tiếp gốc] Chỉ chạy khi
    // snapshot thật sự chưa từng có hoặc lỗi đọc — đảm bảo không bao giờ mất
    // dữ liệu chỉ vì phụ thuộc snapshot của 1 hàm khác.
    try {
      var ssCore = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA');
      var coreRes = JSON.parse(_aging_getCoreDataFromSS(ssCore));
      if (coreRes.success && coreRes.data) {
        coreRes.data.forEach(function (r) {
          var hubKey3f = normStationKey_(r.hubName || '');
          if (!hubKey3f) return;
          if (!byHub[hubKey3f]) byHub[hubKey3f] = { rawName: r.hubName, statusGroups: {}, agingBuckets: {}, onHoldReasons: {}, liveTotal: 0 };
          var h3f = byHub[hubKey3f];
          if (!h3f.coreBacklogTotal) h3f.coreBacklogTotal = 0;
          if (!h3f.coreLostTodayCount) h3f.coreLostTodayCount = 0;
          h3f.coreBacklogTotal++;
          if (r.lostToday) h3f.coreLostTodayCount++;
        });
      }
    } catch (eCore) { /* không chặn toàn bộ nếu nguồn cũ tạm lỗi */ }
    try {
      var ssLostF = _DS.ss('1vvOZG80Rz5PTNPFsbHzmUMPkPaAkGOY70nDHBwfzjQE');
      var lostRes = JSON.parse(_aging_getLostDataFromSS(ssLostF));
      if (lostRes.success && lostRes.data) {
        lostRes.data.forEach(function (r) {
          var hubKey4f = normStationKey_(r.hubName || '');
          if (!hubKey4f) return;
          if (!byHub[hubKey4f]) byHub[hubKey4f] = { rawName: r.hubName, statusGroups: {}, agingBuckets: {}, onHoldReasons: {}, liveTotal: 0 };
          var h4f = byHub[hubKey4f];
          if (!h4f.confirmedLostCount) h4f.confirmedLostCount = 0;
          h4f.confirmedLostCount++;
        });
      }
    } catch (eLost) { /* không chặn toàn bộ nếu nguồn cũ tạm lỗi */ }
  }
  return byHub;
}

var AGING_LM_BUILD_CHUNK_ROWS = 40000; // giống FMS Live — đã kiểm chứng an toàn trong 6 phút/lần
var AGING_LM_BUILD_CURSOR_KEY = 'aging_lm_build_cursor_v1';
var AGING_LM_STAGING_KEY = 'aging_lm_staging_byhub_v1';

/**
 * aging_lmFullPicPrewarm()
 * [SỬA — xác nhận bằng số liệu ĐO THẬT qua spxGetDispatcherTimingReport():
 * hàm này chiếm ~186.5 phút/ngày — THỦ PHẠM LỚN NHẤT toàn hệ thống — do đọc
 * TOÀN BỘ "Detail orders" (Nguồn 1) trong 1 lần MỖI 10 PHÚT. Trong khi đó
 * fms_live_prewarmCache (đọc CÙNG sheet, số cột tương đương) chỉ tốn ~52.6
 * phút/ngày nhờ kỹ thuật "chia lô" (staged build) đã kiểm chứng ổn định từ
 * trước. Áp dụng lại đúng nguyên tắc đó — đọc theo TỪNG LÔ
 * (AGING_LM_BUILD_CHUNK_ROWS dòng/lượt) thay vì toàn bộ 1 lần, tích luỹ qua
 * nhiều lượt trigger 10 phút liên tiếp, chỉ ghi đè cache thật (đang phục vụ
 * người dùng) khi đã đọc xong hết sheet (isFinalChunk) — cache cũ vẫn còn
 * hiệu lực suốt các lượt đang gộp dở, không có khoảng trống dữ liệu.
 * [QUYẾT ĐỊNH KIẾN TRÚC — đã hỏi ý kiến trực tiếp] Viết RIÊNG cho aging,
 * KHÔNG tái dùng/động vào fmsLive_stagedBuildRunner() (hệ thống đã ổn định,
 * phức tạp, có cơ chế phát hiện "sheet bị thay file giữa chừng" mà aging
 * không cần tới) — đánh đổi: vẫn có 2 lượt quét "Detail orders" độc lập thay
 * vì 1, nhưng an toàn hơn, không rủi ro ảnh hưởng module khác đang chạy tốt.
 * Đơn giản hoá so với bản gốc FMS Live — KHÔNG cần cơ chế phát hiện thay file
 * (aging không yêu cầu độ chính xác tuyệt đối như FMS Live, tần suất cập
 * nhật ~30-50 phút/chu kỳ vẫn đủ mới cho mục đích cảnh báo quản lý).
 * _aging_buildLmFullPicture_() (đọc toàn bộ 1 lần) GIỮ NGUYÊN KHÔNG ĐỔI, vẫn
 * dùng cho forceRefresh=true (user chủ động bấm "Build ngay" — hành động thủ
 * công, hiếm, chấp nhận được vì không lặp lại tự động mỗi 10 phút).
 */
function aging_lmFullPicPrewarm() {
  if (_spxIsPrewarmQuietHours_()) { try { Logger.log('aging_lmFullPicPrewarm — bỏ qua, khung giờ vắng user (23h-5h).'); } catch (e) {} return; }
  if (_spxShouldSkipForBudget_()) { try { Logger.log('aging_lmFullPicPrewarm — bỏ qua, ngân sách runtime hôm nay đã cao.'); } catch (e) {} return; }
  var gotLock = _anaAcquireNamedLock('aging_lm_fullpic_build_lock_v1', 20000, 600000);
  if (!gotLock) { try { Logger.log('aging_lmFullPicPrewarm — bỏ qua, lượt trước hoặc forceRefresh đang giữ khoá.'); } catch (e) {} return; }
  var _t0 = Date.now();
  try {
    var ss = _DS.ss(FMS_LIVE_SHEET_ID);
    var sheet = ss.getSheetByName(FMS_LIVE_SHEET_NAME);
    if (!sheet || sheet.getLastRow() < 2) { try { Logger.log('aging_lmFullPicPrewarm — sheet "Detail orders" trống hoặc không tồn tại.'); } catch (e) {} return; }

    var lastRow = sheet.getLastRow();
    var lastCol = sheet.getLastColumn();
    var props = PropertiesService.getScriptProperties();
    var cursor = Number(props.getProperty(AGING_LM_BUILD_CURSOR_KEY)) || 0; // 0 = bắt đầu chu kỳ mới

    var headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0].map(function (h) { return String(h || '').trim(); });
    var c = {
      cur: _fmsLive_findIdxAny_(headers, ['station_name', 'Current Station']),
      stage: _fmsLive_findIdxAny_(headers, ['backlog_stage']),
      status: _fmsLive_findIdxAny_(headers, ['status_desc']),
      aging: _fmsLive_findIdxAny_(headers, ['aging_leadtime']),
      reason: _fmsLive_findIdxAny_(headers, ['last_on_hold_reason_code', 'OnHoldReason'])
    };
    if (c.cur === -1 || c.stage === -1 || c.status === -1 || c.aging === -1) {
      try { Logger.log('aging_lmFullPicPrewarm — sheet thiếu cột bắt buộc, huỷ chu kỳ, reset cursor.'); } catch (e) {}
      props.setProperty(AGING_LM_BUILD_CURSOR_KEY, '0');
      return;
    }
    var colIdxs = [c.cur, c.stage, c.status, c.aging];
    if (c.reason !== -1) colIdxs.push(c.reason);
    var colMin = Math.min.apply(null, colIdxs);
    var colMax = Math.max.apply(null, colIdxs);
    var relC = {};
    Object.keys(c).forEach(function (k) { relC[k] = (c[k] === -1) ? -1 : (c[k] - colMin); });

    var dataStartRow = cursor + 2; // +2: bỏ header (dòng 1), cursor=0 -> dòng dữ liệu đầu tiên là dòng 2
    var rowsToRead = Math.min(AGING_LM_BUILD_CHUNK_ROWS, lastRow - dataStartRow + 1);
    var isFinalChunk = rowsToRead <= 0 || (dataStartRow + rowsToRead - 1) >= lastRow;

    // Đọc lại phần đã tích luỹ từ các lượt trước (nếu đang giữa chu kỳ)
    var byHub = (cursor > 0) ? (CacheMgr.getChunked('AGING', AGING_LM_STAGING_KEY) || {}) : {};

    if (rowsToRead > 0) {
      var rows = sheet.getRange(dataStartRow, colMin + 1, rowsToRead, colMax - colMin + 1).getValues();
      rows.forEach(function (r) { // [KHÔNG ĐỔI logic phân loại — y hệt _aging_buildLmFullPicture_() Nguồn 1]
        var hubRaw = (r[relC.cur] || '').toString().trim();
        if (!hubRaw) return;
        var stage = (r[relC.stage] || '').toString().trim().toUpperCase();
        if (stage !== 'LM') return;

        var hubKey = normStationKey_(hubRaw);
        if (!byHub[hubKey]) byHub[hubKey] = { rawName: hubRaw, statusGroups: {}, agingBuckets: {}, onHoldReasons: {}, liveTotal: 0 };
        var h = byHub[hubKey];

        var group = _aging_groupStatusDesc_(r[relC.status]);
        h.statusGroups[group] = (h.statusGroups[group] || 0) + 1;

        var agingRaw = (r[relC.aging] || '').toString().trim() || '(chưa có mốc)';
        h.agingBuckets[agingRaw] = (h.agingBuckets[agingRaw] || 0) + 1;

        if (group === 'onhold' && relC.reason !== -1) {
          var reasonLabel = _fmsLive_reasonLabel_(r[relC.reason]);
          h.onHoldReasons[reasonLabel] = (h.onHoldReasons[reasonLabel] || 0) + 1;
        }
        h.liveTotal++;
      });
    }

    if (!isFinalChunk) {
      // Còn dở — lưu tạm, tăng cursor, ĐỢI lượt trigger sau tiếp tục (KHÔNG
      // ghi đè cache thật đang phục vụ người dùng — cache cũ vẫn còn hiệu lực).
      CacheMgr.setChunked('AGING', AGING_LM_STAGING_KEY, byHub, 1800); // 30 phút — đủ cho vài lượt 10 phút nối tiếp
      props.setProperty(AGING_LM_BUILD_CURSOR_KEY, String(dataStartRow + rowsToRead - 2));
      try { Logger.log('aging_lmFullPicPrewarm — lô ' + dataStartRow + '-' + (dataStartRow + rowsToRead - 1) + '/' + lastRow + ' xong, tiếp tục lượt sau.'); } catch (e) {}
      return;
    }

    // [Lô CUỐI] — gộp Nguồn 2+3+4 (dùng chung hàm đã tách), ghi cache thật, reset chu kỳ
    byHub = _aging_mergeOrgCoreLost_(byHub);
    var result = { success: true, byHub: byHub, generatedAt: new Date().toISOString() };
    CacheMgr.setChunked('AGING', AGING_LM_FULLPIC_CACHE_KEY, result, AGING_LM_FULLPIC_TTL_S);
    props.setProperty(AGING_LM_BUILD_CURSOR_KEY, '0');
    try { Logger.log('aging_lmFullPicPrewarm — hoàn tất chu kỳ (' + lastRow + ' dòng), đã ghi cache thật.'); } catch (e) {}
  } finally {
    _anaReleaseNamedLock('aging_lm_fullpic_build_lock_v1');
    _spxTrackExecMinutes_((Date.now() - _t0) / 60000);
  }
}

/**
 * aging_resetLmBuildCursor() — CHẠY THỦ CÔNG (Apps Script Editor) nếu nghi
 * ngờ chu kỳ chia lô bị kẹt giữa chừng (VD cột sheet đổi cấu trúc, hoặc dữ
 * liệu tạm bị lỗi) — xoá cursor + dữ liệu đang gộp dở, lượt trigger kế tiếp
 * sẽ tự bắt đầu lại từ đầu. KHÔNG ảnh hưởng cache thật đang phục vụ người
 * dùng (vẫn giữ nguyên tới khi chu kỳ mới hoàn tất).
 */
function aging_resetLmBuildCursor() {
  PropertiesService.getScriptProperties().deleteProperty(AGING_LM_BUILD_CURSOR_KEY);
  CacheMgr.invalidateChunked('AGING', AGING_LM_STAGING_KEY);
  return 'Đã xoá cursor + dữ liệu đang gộp dở — lượt trigger kế tiếp sẽ tự bắt đầu lại từ đầu.';
}

/**
 * aging_installLmFullPicTrigger() — CHẠY THỦ CÔNG 1 LẦN (từ trình soạn thảo
 * Apps Script, chọn hàm này rồi bấm Run) để cài time-driven trigger. Không tự
 * động cài lại — dọn trigger cũ trước khi tạo mới, an toàn khi chạy lại.
 */
function aging_installLmFullPicTrigger() {
  // [CẢNH BÁO — theo yêu cầu trực tiếp "gộp trigger tương đồng"] Trigger 10-phút riêng lẻ này ĐÃ ĐƯỢC GỘP vào spxDispatcher10Min() — chỉ chạy hàm này nếu THẬT SỰ muốn tách nó ra khỏi nhóm gộp trở lại (sẽ tạo lại đúng trigger đã gộp, làm mất tác dụng gộp). Bình thường KHÔNG cần chạy nữa —
  // dùng spxInstallDispatcher10Min() thay thế.
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'aging_lmFullPicPrewarm') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('aging_lmFullPicPrewarm').timeBased().everyMinutes(10).create();
  return 'Đã cài trigger prewarm cache Bức tranh toàn cảnh LM (mỗi 10 phút). Chạy tay aging_lmFullPicPrewarm() 1 lần ngay sau đó để có dữ liệu sớm, không phải chờ tới chu kỳ đầu tiên.';
}

/**
 * aging_getLmFullPicture(forceRefresh)
 * [SỬA DỨT ĐIỂM — xác nhận qua báo cáo trực tiếp "load xong không trả về kết
 * quả, báo thử lại nhiều lần"] TRƯỚC ĐÂY mỗi request không có cache đều tự
 * thử build đồng bộ (dù có khoá) — với sheet ~194.000 dòng, lần build đầu
 * chạy rất lâu, giữ khoá suốt thời gian đó, khiến MỌI request khác (kể cả từ
 * chính user đó bấm lại) đều nhận "đang có tiến trình khác, thử lại sau" liên
 * tục mà không bao giờ thấy kết quả — đúng vòng lặp trong ảnh chụp thực tế.
 * Giờ mặc định CHỈ đọc cache (rất nhanh) — cache do trigger nền lo, không bao
 * giờ để user phải chờ/kẹt trong 1 lần build trực tiếp nữa.
 */
/**
 * _aging_scopeFullPicByAccess_(payload)
 * [BẢO MẬT] aging_getLmFullPicture() trước đây trả về byHub của TOÀN BỘ hub cho
 * mọi user — Lead/Staff 1 trạm vẫn nhận đủ số liệu của cả nghìn trạm khác, lọc
 * chỉ diễn ra ở phía trình duyệt (dễ dàng xem được). Nay lọc NGAY TẠI MÁY CHỦ
 * theo đúng phạm vi quyền thật. Admin/ROM (unrestricted) giữ nguyên toàn bộ nên
 * panel cấp cao KHÔNG bị ảnh hưởng.
 */
function _aging_scopeFullPicByAccess_(payload) {
  try {
    if (!payload || !payload.byHub) return payload;
    var access = getCurrentUserAccess_();
    if (!access || access.unrestricted) return payload;
    var allow = {};
    (access.stations || access.hubs || []).forEach(function (h) {
      var k = normStationKey_(h);
      if (k) allow[k] = 1;
    });
    if (!Object.keys(allow).length) return payload; // không xác định được phạm vi -> giữ nguyên, không tự ý chặn
    var out = {};
    Object.keys(payload.byHub).forEach(function (k) { if (allow[k]) out[k] = payload.byHub[k]; });
    var copy = {};
    Object.keys(payload).forEach(function (k) { copy[k] = payload[k]; });
    copy.byHub = out;
    copy.scopedByAccess = true;
    return copy;
  } catch (e) { return payload; } // lỗi đọc quyền -> giữ nguyên, không làm hỏng module
}

function aging_getLmFullPicture(forceRefresh) {
  try {
    if (!forceRefresh) {
      var cached = CacheMgr.getChunked('AGING', AGING_LM_FULLPIC_CACHE_KEY);
      if (cached) return JSON.stringify(_aging_scopeFullPicByAccess_(cached));
      return JSON.stringify({
        success: false, notReady: true,
        error: 'Dữ liệu đang được cập nhật, vui lòng thử lại sau vài phút. Nếu tình trạng kéo dài, báo quản trị viên hệ thống.'
      });
    }

    // forceRefresh=true — hành động CHỦ ĐỘNG, hiếm khi xảy ra (user bấm nút
    // "Làm mới" tự ý) — vẫn có khoá bảo vệ để không chồng lấn với trigger nền.
    var gotLock = _anaAcquireNamedLock('aging_lm_fullpic_build_lock_v1', 30000, 600000);
    if (!gotLock) {
      var staleCached = CacheMgr.getChunked('AGING', AGING_LM_FULLPIC_CACHE_KEY);
      if (staleCached) return JSON.stringify(_aging_scopeFullPicByAccess_(staleCached));
      return JSON.stringify({ success: false, busy: true, error: 'Đang có tiến trình khác tổng hợp dữ liệu, vui lòng thử lại sau ít giây.' });
    }
    try {
      var result = _aging_buildLmFullPicture_();
      if (result.success) CacheMgr.setChunked('AGING', AGING_LM_FULLPIC_CACHE_KEY, result, AGING_LM_FULLPIC_TTL_S);
      return JSON.stringify(_aging_scopeFullPicByAccess_(result));
    } finally {
      _anaReleaseNamedLock('aging_lm_fullpic_build_lock_v1');
    }
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

function _aging_buildRawData_() {
  var _verBefore = ''; try { _verBefore = _aging_getSourceVersion_(); } catch (eVb) {}
  var ssCore = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA');
  var ssLost = _DS.ss('1vvOZG80Rz5PTNPFsbHzmUMPkPaAkGOY70nDHBwfzjQE');

  var coreRes = JSON.parse(_aging_getCoreDataFromSS(ssCore));
  if (!coreRes.success) throw new Error('Lỗi đọc file Aging Core: ' + coreRes.error);

  var lostRes = JSON.parse(_aging_getLostDataFromSS(ssLost));
  if (!lostRes.success) throw new Error('Lỗi đọc file Lost: ' + lostRes.error);

  var fmRes = JSON.parse(_aging_getFMDataFromSS(ssCore));
  if (!fmRes.success) throw new Error('Lỗi đọc file FM: ' + fmRes.error);

  var coreData = coreRes.data;
  var lostData = lostRes.data;
  // [OPT 2026-07] fmData: đã đối chiếu index.html + JS_FMS.html, không nơi nào đọc
  // field cụ thể (shipment_id, station_name, pickup_done, fleet_final_status,
  // pickup_station_name, order_type, leadtime_hour(SUM), timing_day(SUM), cogs(SUM))
  // -- chỉ dùng fmData.length để đếm badge. RUNTIME_CACHE.fmsData thực tế được
  // JS_FMS.html GHI ĐÈ bằng dữ liệu từ file CSV user tự nạp (schema hoàn toàn khác:
  // {shipmentId, processStatus, hubName}) nên field gốc ở đây chưa từng được dùng.
  // Giữ nguyên ĐỘ DÀI mảng (mọi chỗ .length ở FE không đổi hành vi), chỉ rỗng hoá
  // nội dung từng phần tử để giảm băng thông (mỗi dòng ~200+ byte -> ~2 byte).
  var fmDataSlim = new Array(fmRes.count || 0).fill(0).map(function () { return {}; });

  // [FIX 2026-08-03] Lưu RAW (chưa lọc quyền) vào SHEET SNAPSHOT (ping-pong, xem
  // _aging_writeRawSnapshot_) thay vì ScriptCache — CacheMgr.setChunked() có trần
  // cứng ~3.6MB/key, log Executions xác nhận cache-hit rớt gần về 0% đúng lúc
  // traffic tăng đột biến (dữ liệu Core+Lost+FM nhiều khả năng đã vượt trần này,
  // khiến ghi cache âm thầm thất bại mọi lúc — setChunked trả false, không throw).
  // Sheet không có trần 3.6MB — loại bỏ hẳn rủi ro này.
  // [SỬA LỖI THẬT] Đường dựng TRỰC TIẾP (người dùng đầu tiên sau >3 giờ, sai schema...) không có chốt
  // chặn nào của vòng nền (đọc lại sau 8 giây, kiểm khối lượng) mà trước đây vẫn đóng dấu "khớp nguồn" —
  // nguồn đang ghi dở lúc đó sẽ bị đóng băng tới lần đổi kế tiếp. Nay đây chỉ là bản TẠM: dấu 'COLD'
  // không bao giờ khớp nguồn nên vòng nền dựng lại ĐÚNG QUY TRÌNH ở lượt kế (tối đa ~10 phút).
  _aging_writeRawSnapshot_(coreData, lostData, fmDataSlim, 'COLD|' + (Number(String(_verBefore || '|0').split('|')[1]) || 0));

  return { coreData: coreData, lostData: lostData, fmDataSlim: fmDataSlim };
}

// [FIX 2026-07-31] Tách "lõi lấy dữ liệu" (_aging_getMasterDataCore_) khỏi điểm
// vào RPC công khai (aging_getMasterData, ngay dưới) — trước đây tracking nằm
// trong hàm này, nhưng hàm này còn bị gọi NỘI BỘ (không qua RPC thật) từ
// aging_prewarmCache() (trigger nền, chạy tự động) và _aging_findHubById_()
// (mỗi lần lưu note) — khiến Usage_Stats đếm nhầm các lượt trigger/lưu note
// thành "user mở module". Giờ chỉ hàm aging_getMasterData() (bên dưới) mới
// track, còn lõi này không track gì cả — 2 nơi gọi nội bộ đã chuyển sang gọi
// thẳng lõi này để không còn bị đếm nhầm.
function _aging_getMasterDataCore_() {

  // ── LẤY ACCESS ──────────────────────────────────────────────────────────
  var access = getModuleAccess();
  // denied → trả về lỗi rõ ràng thay vì data rỗng gây nhầm lẫn
  if (access.role === 'denied') {
    return JSON.stringify({ success: false, error: 'Bạn không có quyền truy cập module này.' });
  }

  // [FIX 2026-07-28] TÁCH cache "dữ liệu thô" (Core+Lost+FM, đọc từ Sheets — tốn
  // 20-350s theo log Executions) ra khỏi cache "theo từng user" cũ. Lý do: trước
  // đây cache key có userKey riêng cho từng người (master_v3_<email>) → (1)
  // aging_prewarmCache() chạy dưới danh nghĩa 1 tài khoản duy nhất (admin) nên
  // CHỈ làm nóng đúng 1 cache — mọi vai trò Hub/SUP/AOM khác (chính là người
  // dùng thật hằng ngày) không bao giờ hưởng được cache làm nóng sẵn, luôn phải
  // đọc cold; (2) aging_saveNote() — hàm được chính code ghi chú là "dùng
  // THƯỜNG XUYÊN NHẤT cả app, mọi trạm mọi ca, liên tục cả ngày" — mỗi lần lưu
  // note lại xoá cache CỦA CHÍNH NGƯỜI ĐÓ, ép họ đọc cold ngay sau đó dù dữ
  // liệu Core/Lost/FM chẳng liên quan gì tới việc lưu note. Cộng dồn 2 lý do
  // trên khiến phần lớn user gần như luôn cache-miss → "Quá Hạn load chậm".
  // Sửa: RAW data (chưa lọc quyền) giờ dùng 1 cache CHUNG duy nhất, ai đọc
  // cũng dùng lại được, phần lọc theo hub của từng user áp lên SAU (rẻ, in-memory).
  // [FIX 2026-08-03] Đọc thẳng snapshot Sheet (luôn có sẵn sau lần build đầu
  // tiên, do aging_prewarmCache làm mới đều đặn mỗi 10 phút) — KHÔNG còn khái
  // niệm "TTL hết hạn" kiểu ScriptCache nữa. User luôn đọc bản ĐÃ CÓ SẴN (nhanh,
  // không rebuild), đúng triết lý đã dùng cho KPI Fail persistent snapshot. Chỉ
  // khi CHƯA TỪNG có snapshot nào (lần đầu deploy) mới cần build đồng bộ 1 lần,
  // có khóa chống nhiều user cùng build lần đầu đó.
  var snap = _aging_readRawSnapshot_();
  var coreData, lostData, fmDataSlim;

  if (snap && snap.coreData) {
    coreData = snap.coreData; lostData = snap.lostData; fmDataSlim = snap.fmData;
  } else {
    var _agGotLock = _anaAcquireNamedLock('aging_masterdata_cold_lock_v1', 90000, 180000);
    if (_agGotLock) {
      try {
        var _agRecheck = _aging_readRawSnapshot_();
        if (_agRecheck && _agRecheck.coreData) {
          coreData = _agRecheck.coreData; lostData = _agRecheck.lostData; fmDataSlim = _agRecheck.fmData;
        } else {
          var _agBuilt = _aging_buildRawData_();
          coreData = _agBuilt.coreData; lostData = _agBuilt.lostData; fmDataSlim = _agBuilt.fmDataSlim;
        }
      } catch (eAgLock) {
        return JSON.stringify({ success: false, error: eAgLock.message, stack: eAgLock.stack || '' });
      } finally {
        _anaReleaseNamedLock('aging_masterdata_cold_lock_v1');
      }
    } else {
      // Không giành được khóa trong 90s (hiếm — nghĩa là lượt đang giữ khóa
      // cũng đang bị chậm bất thường) — vẫn tự build độc lập, thà chậm hơn 1
      // chút còn hơn để user bị treo response vô thời hạn.
      try {
        var _agBuilt2 = _aging_buildRawData_();
        coreData = _agBuilt2.coreData; lostData = _agBuilt2.lostData; fmDataSlim = _agBuilt2.fmDataSlim;
      } catch (eAgNoLock) {
        return JSON.stringify({ success: false, error: eAgNoLock.message, stack: eAgNoLock.stack || '' });
      }
    }
  }

  // ── LỌC THEO QUYỀN (áp lên RAW data, dù lấy từ cache chung hay vừa đọc mới) ──
  try {
    // admin → không lọc gì cả (thấy tất cả)
    // aom/sup/station → chỉ giữ records có hub thuộc access.hubs
    if (access.role !== 'admin' && access.hubs.length > 0) {
      // [FIX] Dùng object làm hash set → tra cứu O(1) mỗi dòng, tổng chi phí O(số
      // dòng), không phụ thuộc số hub được cấp (trước đây indexOf() là O(số hub)
      // mỗi dòng, chậm hẳn với user nhiều trạm).
      var allowedSet = Object.create(null);
      access.hubs.forEach(function(s) { allowedSet[_normStationKey_(s, { pakFix: false, stripSuffix: false })] = true; });

      var filterByHub = function(arr, hubGetter) {
        return arr.filter(function(r) {
          var h = _normStationKey_(hubGetter(r), { pakFix: false, stripSuffix: false });
          return !!h && allowedSet[h] === true;
        });
      };

      // coreData: hub field là r.hubName (từ cột fleet_final_station của sheet LM high aging — dò theo tiêu đề)
      coreData = filterByHub(coreData, function(r) { return r.hubName || r.hub || r.Hub || ''; });
      lostData = filterByHub(lostData, function(r) { return r.hubName || r.hub || r.Hub || ''; });
      // fmDataSlim đã bị rỗng hoá nội dung ở trên nên không còn field hub để lọc
      // theo — giữ nguyên như hành vi cũ (chỉ dùng .length, không lọc theo hub).
    }

    var ssNote = _DS.ss(ADMIN_DB_ID);
    var noteRes = JSON.parse(_aging_getNotesWithCache(ssNote, null));
    if (!noteRes.success) throw new Error('Lỗi hệ thống Note CRM: ' + noteRes.error);

    var result = JSON.stringify({
      success:  true,
      coreData: coreData,
      lostData: lostData,
      fmData:   fmDataSlim,
      notes:    noteRes.notes || {},
      access:   { role: access.role, hubs: access.hubs }, // gửi lên frontend để UI biết role
      // [MỚI — minh bạch độ mới] Cho giao diện biết số liệu này thuộc LẦN CẬP NHẬT
      // NÀO CỦA NGUỒN (nguồn chạy mỗi giờ, 7:00-18:00) và bản chụp dựng lúc nào.
      // Người dùng nhìn là biết đang xem số của lần cập nhật nào, không phải đoán.
      dataInfo: (function () {
        try {
          var _m = _kpifail_getMetaMap_(_aging_getSnapshotMetaSheet_(_DS.ss(ADMIN_DB_ID))) || {};
          return {
            nguonLuc:  String(_m.snapshot_source_version || '').split('|')[0],
            dungLuc:   _m.snapshot_saved_at || '',
            tuoiPhut:  _m.snapshot_version ? Math.round((Date.now() - Number(_m.snapshot_version)) / 60000) : null,
            // [MỚI] Mốc phiên bản bản chụp — client so với aging_getDataVersion() để biết có bản mới hay chưa
            snapshotVersion: Number(_m.snapshot_version) || 0,
            // [MỚI] Cảnh báo cột nguồn (VD sheet Raw đổi tên cột) — hiện ở thanh trạng thái đồng bộ
            canhBao: _spx_getColWarn_('aging:')
          };
        } catch (eDi) { return null; }
      })()
    });

    return result;

  } catch(e) {
    return JSON.stringify({ success: false, error: e.message, stack: e.stack || '' });
  }
}

/**
 * aging_getDataVersion()
 * [MỚI — "Quá Hạn hiện số liệu cũ nhiều ngày dù nguồn đã đổi"] Frontend giữ dữ liệu
 * trong bộ nhớ và trước đây KHÔNG BAO GIỜ tự hỏi lại máy chủ — chỉ tải lúc mở trang hoặc
 * khi bấm Đồng bộ. Tab mở nhiều ngày thì hiện số của lần tải cuối. Muốn hỏi định kỳ mà
 * không kéo cả payload hàng MB, dùng hàm thăm dò này: chỉ trả mốc phiên bản của bản chụp
 * (1 ô trong sheet meta, cache 45 giây dùng chung) — client so với mốc mình đang giữ,
 * khác mới tải lại. KHÔNG đọc dữ liệu đơn, KHÔNG track usage.
 */
function aging_getDataVersion() {
  try {
    var access = getModuleAccess();
    if (!access || access.role === 'denied') {
      return JSON.stringify({ success: false, error: 'Bạn không có quyền truy cập module này.' });
    }
    var sc = CacheService.getScriptCache();
    var info = null;
    try { var hit = sc.get('aging_dataver_v1'); if (hit) info = JSON.parse(hit); } catch (eC) {}
    if (!info) {
      var m = _kpifail_getMetaMap_(_aging_getSnapshotMetaSheet_(_DS.ss(ADMIN_DB_ID))) || {};
      info = {
        snapshotVersion: Number(m.snapshot_version) || 0,
        savedAt: m.snapshot_saved_at || '',
        sourceVersion: String(m.snapshot_source_version || '').split('|')[0]
      };
      try { sc.put('aging_dataver_v1', JSON.stringify(info), 45); } catch (eP) {}
    }
    return JSON.stringify({
      success: true,
      snapshotVersion: info.snapshotVersion,
      savedAt: info.savedAt,
      sourceVersion: info.sourceVersion,
      ageMin: info.snapshotVersion ? Math.round((Date.now() - info.snapshotVersion) / 60000) : null
    });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

// [FIX 2026-07-31] Điểm vào RPC công khai THẬT — chỉ chỗ này track usage (user
// thật sự mở module qua JS_Quahan.html gọi google.script.run.aging_getMasterData()
// mới tới đây). Mọi lời gọi NỘI BỘ trong code (trigger, note-lookup...) phải gọi
// thẳng _aging_getMasterDataCore_(), không qua wrapper này.
function aging_getMasterData() {
  return _aging_getMasterDataCore_();
}

// ── aging_clearCache() — xóa cache v1 (cũ) + cache raw dùng chung (mới) ──────
// [FIX 2026-07-28] Trước đây xoá cache v3 CỦA RIÊNG user đang gọi (per-user) —
// giờ dữ liệu Core/Lost/FM dùng 1 cache CHUNG (raw_v1, xem aging_getMasterData())
// nên xoá đúng key chung này — ai bấm cũng cho TẤT CẢ mọi user đọc lại dữ liệu
// mới ở lượt kế tiếp, không chỉ riêng người bấm nút.
function aging_clearCache() {
  try {
    var sc = CacheService.getScriptCache();
    // Xóa cache cũ (v1 — global)
    var oldKey = 'aging_master_v1';
    try {
      var oldMeta = sc.get(oldKey + '_meta');
      if (oldMeta) {
        var om = JSON.parse(oldMeta);
        var oldKeys = [oldKey + '_meta'];
        for (var i = 0; i < om.chunks; i++) oldKeys.push(oldKey + '_c' + i);
        sc.removeAll(oldKeys);
      }
    } catch(e1) {}

    // Xóa cache raw dùng chung (mới) — ảnh hưởng TẤT CẢ user, không chỉ người gọi
    CacheMgr.invalidateChunked('AGING', 'raw_v1');
    var access = getModuleAccess();

    // Invalidate access cache của user này
    getModuleAccess_invalidate(access.email);

    return JSON.stringify({ success: true });
  } catch(e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

// ============================================================
// MODULE: PICK — LIVE (sheet "3. FM action realtime")
// ============================================================
// [KIẾN TRÚC LẠI 2026-07-23 — HIỆU NĂNG, sheet đã vượt >100k dòng]
// TRƯỚC ĐÂY: mỗi request user (pick_getLiveData) tự quét lại TOÀN BỘ sheet,
// build object cho MỌI dòng rồi mới lọc theo trạm sau, và cache qua
// CacheMgr.setChunked() (giới hạn cứng 40 chunk x 90KB ≈ 3.6MB). Ở quy mô
// >100k dòng, JSON vượt xa 3.6MB nên setChunked() luôn trả false lặng lẽ —
// cache KHÔNG BAO GIỜ hit nữa, mọi lần mở tab Live đều full-scan sheet.
//
// GIỜ: áp dụng lại đúng kiến trúc đã dùng cho module FMS Live (sheet
// 200k+ dòng, xem _fmsLive_buildRawSnapshot_ / _fmsLive_getHubsDataCached_
// phía trên) — tái dùng CHUNG các helper cache vật lý _fmsLive_writeChunkedJson_
// / _fmsLive_readChunkedJson_ / _fmsLive_readChunkedJsonBatch_ (đã tổng quát
// hoá theo prefix, không riêng cho FMS):
//   1) Quét sheet 1 LẦN DUY NHẤT ở tiến trình NỀN (trigger 5 phút/lần,
//      pick_live_prewarmCache), gom dữ liệu theo TỪNG TRẠM, ghi cache riêng
//      từng trạm — KHÔNG còn cache theo user.
//   2) Request của user KHÔNG BAO GIỜ tự quét sheet. Cache miss -> trả về
//      "chưa sẵn sàng" ngay lập tức thay vì bắt user chờ.
//   3) User (KỂ CẢ ADMIN) phải chủ động CHỌN TRẠM muốn xem — không còn
//      nhánh "tải tất cả" ngầm định. pick_live_getStations() trả danh sách
//      trạm (+ số đơn) để FE hiển thị bộ chọn; pick_live_getStationData()
//      chỉ trả dữ liệu của (những) trạm được chọn VÀ nằm trong quyền thực
//      tế của user (server luôn ép giao, không tin dữ liệu FE gửi lên).
//   4) Đọc sheet bằng getValues() THÔ (bỏ hẳn getDisplayValues()) — nhanh
//      hơn đáng kể ở quy mô lớn vì không tốn chi phí format từng cell theo
//      locale. Cell kiểu Date được quy về epoch ms (number), FE tự format
//      hiển thị (xem fmtDT() trong renderLiveTablePICK, JS_Pick.html).
//
// Cấu trúc sheet: A1 = dòng ghi chú lịch cập nhật, HEADER THẬT ở ROW 2,
// dữ liệu bắt đầu ROW 3. Cột A→P:
//   A shipment_id | B station_name | C created_time | D pickup_done
//   E inbound_time | F last_touch_at | G fleet_final_status | H shop_id
//   I product_name | J order_type | K action_needed | L depart_time_1
//   M depart_time_2 | N lh_packed | O aom | P sup
//
// Phân quyền dùng LẠI đúng getModuleAccess() (3 tầng admin/aom/sup/station)
// và _normStationKey_() để lọc theo station_name — giống hệt cách
// aging_getMasterData() lọc fmData theo hub.

var PICK_LIVE_INDEX_KEY = 'pick_live_index_v1';
var PICK_LIVE_CACHE_TTL = 3600; // [FIX 2026-08-01] 60 phút — dư so với chu kỳ trigger nền MỚI 30 phút (đủ dư nếu 1 lượt trigger lỡ nhịp, hoặc bị bỏ qua vì khung giờ vắng)
var PICK_LIVE_SS_ID = '1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA';
var PICK_LIVE_MAX_HUBS_PER_CALL = 30; // chặn 1 lần gọi kéo quá nhiều trạm cùng lúc

// Sanitizer key cache riêng cho Pick Live — CỐ Ý không dùng _normStationKey_()
// (hàm đó bỏ dấu + bỏ hậu tố để so khớp MỜ, 2 trạm khác nhau có thể trùng key,
// chấp nhận được khi SO KHỚP quyền nhưng làm cache key thì sẽ đè dữ liệu nhau).
function _pickLive_hubCacheKey_(stationName) {
  var s = (stationName || '').toString().toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/\u0111/g, 'd')
    .replace(/[^a-z0-9]+/g, '_')
    .replace(/^_+|_+$/g, '');
  return 'pick_live_hub_' + s + '_v1';
}

// Quy 1 cell thô về dạng gọn cho JSON: Date -> epoch ms (number, FE tự format),
// null/undefined -> '', còn lại giữ nguyên (string/number).
function _pickLiveCellOut_(v) {
  if (v instanceof Date) return v.getTime();
  if (v === null || v === undefined) return '';
  return v;
}

/**
 * _pickLive_buildRawSnapshot_()
 * Quét TOÀN BỘ sheet 1 LẦN, gom theo trạm. CHỈ gọi từ tiến trình nền
 * (pick_live_prewarmCache, qua trigger) hoặc thủ công từ Apps Script editor
 * khi cần build ngay — KHÔNG BAO GIỜ gọi trực tiếp từ 1 request user thường.
 */
function _pickLive_buildRawSnapshot_() {
  try {
    var ss = _DS.ss(PICK_LIVE_SS_ID);
    var sheet = ss.getSheetByName('3. FM action realtime');
    if (!sheet) return { success: false, error: "Không thấy sheet '3. FM action realtime'" };
    var lastRow = sheet.getLastRow();
    var updatedNote = sheet.getRange(1, 1).getDisplayValue() || '';
    if (lastRow < 3) return { success: true, hubs: [], counts: {}, data: {}, updatedNote: updatedNote, generatedAt: Date.now() };

    // [FIX 2026-07-30] NGÂN SÁCH THỜI GIAN — trước đây đọc TOÀN BỘ sheet trong 1
    // lệnh getRange().getValues() duy nhất, không có điểm dừng nào. Log Executions
    // xác nhận đã có lượt build mất 606.9s (>10 phút) — cùng lớp rủi ro đã gặp và
    // vá ở KPI Fail (nguy cơ chạm trần cứng 30 phút khi sheet tiếp tục lớn thêm).
    // Đọc theo lô, dừng SỚM nếu vượt ngân sách — trả về snapshot PARTIAL (thiếu 1
    // phần trạm ở cuối sheet) thay vì có nguy cơ timeout. Vì cache này BUILD LẠI
    // TOÀN BỘ mỗi 5 phút (không có incremental merge như KPI Fail), thiếu 1 phần ở
    // lượt này chỉ khiến các trạm đó "cũ hơn 1 chu kỳ" — tự khỏi ở lượt kế tiếp,
    // không cần logic tiếp tục phức tạp.
    var _startTime = Date.now();
    var _timeBudgetMs = 270000; // 4.5 phút — cùng mức đã dùng cho KPI Fail
    // [FIX — đo thật: max 398.6s, VẪN vượt 330s lý thuyết (đọc 4.5p + ghi 1p) dù
    // đã có ngân sách] Nguyên nhân: kiểm tra ngân sách chỉ diễn ra GIỮA CÁC BATCH,
    // không ngắt được 1 lệnh getValues() đang chạy giữa chừng (Apps Script không
    // hỗ trợ huỷ đồng bộ). Nếu đã dùng gần hết ngân sách (vd 260/270s) và Sheets
    // API đang chậm bất thường, 1 batch 20.000 dòng cuối có thể tự nó mất thêm
    // hàng chục giây, đẩy tổng vượt xa lý thuyết. Giảm batch 20.000 -> 10.000 để
    // giảm MỘT NỬA biên độ "vượt quá" tối đa có thể xảy ra ở batch cuối cùng.
    var _batchRows = 10000;
    var numRows = lastRow - 2; // từ row 3 (data thật) .. lastRow
    var _reachedRow = 2;
    var _budgetExceeded = false;
    var byStation = Object.create(null); // { normKey: { name, rows:[] } }

    // [SỬA] Dò cột theo TIÊU ĐỀ (dòng 2) — xem _spx_findCols_(). Trước đây đọc A-K cố định.
    var _hdrA = sheet.getRange(2, 1, 1, sheet.getLastColumn()).getValues()[0];
    var A = _spx_findCols_(_hdrA, _SPX_SPEC_FMACT_);
    _spx_requireCols_("Sheet '3. FM action realtime'", A, _SPX_REQ_FMACT_, _hdrA);
    var _wA = Math.min(sheet.getMaxColumns(), _spx_maxIdx_(A) + 1);
    var _ga = function (r, k) { return A[k] === undefined ? undefined : r[A[k]]; };

    var _row = 3;
    while (_row <= lastRow) {
      if (Date.now() - _startTime > _timeBudgetMs) { _budgetExceeded = true; break; }
      var _batchSize = Math.min(_batchRows, lastRow - _row + 1);
      // [FIX 2026-07-30] Thu hẹp phạm vi đọc từ 16 xuống 11 cột (A-K) — đối chiếu
      // JS_Pick.html + toàn bộ backend.gs xác nhận 8 field (shopId, pickupDone,
      // inboundTime, departTime1/2, lhPacked, aom, sup) KHÔNG được đọc ở BẤT KỲ
      // đâu (cả client lẫn server) — 5 field cuối (departTime1/2, lhPacked, aom,
      // sup, cột L-P) nằm cuối dải nên bỏ hẳn được khỏi phạm vi đọc; giảm ~31%
      // lượng dữ liệu tải về cho đúng lượt đọc nặng nhất hệ thống (>100k dòng).
      // [PERF] getValues() THÔ, KHÔNG getDisplayValues() — bỏ chi phí format từng
      // cell theo locale sheet, quan trọng ở quy mô >100k dòng.
      var values = sheet.getRange(_row, 1, _batchSize, _wA).getValues();

      for (var i = 0; i < values.length; i++) {
        var row = values[i];
        var shipmentId = _ga(row, 'id');
        if (!shipmentId || shipmentId.toString().trim() === '') continue;
        var stationName = _ga(row, 'station') ? _ga(row, 'station').toString().trim() : '';
        var hubKey = _normStationKey_(stationName, { pakFix: false, stripSuffix: false });
        if (!hubKey) continue; // dòng không xác định được trạm -> bỏ qua

        var rec = {
          shipmentId:       shipmentId.toString().trim(),
          stationName:      stationName,
          createdTime:      _pickLiveCellOut_(_ga(row, 'created')),
          lastTouchAt:      _pickLiveCellOut_(_ga(row, 'last')),
          fleetFinalStatus: _ga(row, 'status') ? _ga(row, 'status').toString().trim() : '',
          productName:      _ga(row, 'product') ? _ga(row, 'product').toString().trim() : '',
          orderType:        _ga(row, 'otype') ? _ga(row, 'otype').toString().trim() : '',
          actionNeeded:     _ga(row, 'action') ? _ga(row, 'action').toString().trim() : ''
        };

        if (!byStation[hubKey]) byStation[hubKey] = { name: stationName, rows: [] };
        byStation[hubKey].rows.push(rec);
      }

      _reachedRow = _row + _batchSize - 1;
      _row += _batchSize;
    }

    var hubs = [];
    var counts = {};
    var dataByStationName = {};
    Object.keys(byStation).forEach(function (k) {
      var b = byStation[k];
      hubs.push(b.name);
      counts[b.name] = b.rows.length;
      dataByStationName[b.name] = b.rows;
    });
    hubs.sort();

    if (_budgetExceeded) {
      _LOG.d('[Pick Live Prewarm] Hết ngân sách thời gian ở dòng ' + _reachedRow + '/' + lastRow + ' — snapshot lần này thiếu 1 phần, tự đầy đủ lại ở chu kỳ 5 phút kế tiếp.');
    }

    return {
      success: true,
      hubs: hubs,
      counts: counts,
      data: dataByStationName,
      updatedNote: updatedNote,
      generatedAt: Date.now(),
      partial: _budgetExceeded
    };
  } catch (e) {
    return { success: false, error: e.message, stack: e.stack || '' };
  }
}

// Ghi index (nhẹ — chỉ danh sách trạm + đếm) + cache riêng từng trạm, cùng TTL.
function _pickLive_writeSnapshotPerHub_(fresh) {
  var indexPayload = {
    success: true,
    hubs: fresh.hubs,
    counts: fresh.counts,
    updatedNote: fresh.updatedNote,
    generatedAt: fresh.generatedAt
  };
  try { _fmsLive_writeChunkedJson_(PICK_LIVE_INDEX_KEY, JSON.stringify(indexPayload), PICK_LIVE_CACHE_TTL); } catch (e) {}
  // [FIX — đo thật: max 361.2s, VƯỢT trần cứng 360s (6 phút) của GAS] Bước đọc
  // sheet đã có ngân sách 4.5 phút (xem _pickLive_buildRawSnapshot_), nhưng bước
  // GHI CACHE RIÊNG TỪNG TRẠM này trước đây KHÔNG CÓ ngân sách gì — với mục tiêu
  // quy mô 1.000 trạm, forEach ghi JSON.stringify + cache phân mảnh cho từng trạm
  // có thể cộng thêm nhiều phút SAU KHI đọc đã dùng hết 4.5 phút, đẩy tổng vượt
  // trần. Nay có ngân sách RIÊNG cho bước ghi — dừng sớm nếu vượt, các trạm chưa
  // ghi kịp giữ nguyên cache cũ (chỉ "cũ hơn 1 chu kỳ"), tự đầy đủ lại ở lượt kế
  // tiếp — CÙNG cách đánh đổi đã áp dụng an toàn cho bước đọc phía trên.
  var _wStart = Date.now();
  var _wBudgetMs = 60000; // 1 phút — đủ cho đa số trạm, chừa biên độ an toàn thật cho bước đọc
  var _wSkipped = 0;
  for (var _wi = 0; _wi < fresh.hubs.length; _wi++) {
    if (Date.now() - _wStart > _wBudgetMs) { _wSkipped = fresh.hubs.length - _wi; break; }
    var h = fresh.hubs[_wi];
    try { _fmsLive_writeChunkedJson_(_pickLive_hubCacheKey_(h), JSON.stringify(fresh.data[h]), PICK_LIVE_CACHE_TTL); } catch (e) {}
  }
  if (_wSkipped > 0) {
    _LOG.d('[Pick Live Prewarm] Hết ngân sách ghi — bỏ qua ' + _wSkipped + '/' + fresh.hubs.length + ' trạm cuối, tự cập nhật ở chu kỳ kế tiếp.');
  }
}

// Biến tạm TRONG PHẠM VI 1 LẦN THỰC THI — nếu vừa build fresh trong CHÍNH
// request này (forceRefresh), các bước đọc dữ liệu ngay sau đó khỏi phải
// đọc lại cache vừa ghi. Mỗi request GAS chạy execution context riêng nên
// biến top-level này không rò rỉ/lẫn giữa các request khác nhau.
var _pickLive_lastFreshBuild_ = null;

// [FIX 2026-07-29] Khung giờ CHẮC CHẮN vắng user (theo xác nhận thực tế: 23:00 -
// 05:00) — dùng chung cho 4 trigger prewarm (kpifail/aging/fms_live/pick_live).
// Các trigger này chỉ tồn tại để làm nóng cache CHO REQUEST SẮP TỚI của user —
// nếu chắc chắn không có user nào trong khung giờ này, làm nóng cache là lãng
// phí thuần túy (vẫn tốn execution, cộng vào tổng thời lượng thực thi/ngày,
// góp phần vào áp lực giới hạn 1000 lệnh đồng thời). Bỏ qua theo lịch KHÔNG làm
// mất dữ liệu gì — nếu lỡ có ai mở app đúng lúc này, họ vẫn được phục vụ bình
// thường, chỉ là đọc cold (y hệt cache hết hạn bình thường) thay vì cache đã ấm sẵn.
function _spxIsPrewarmQuietHours_() {
  try {
    var h = Number(Utilities.formatDate(new Date(), 'Asia/Ho_Chi_Minh', 'H'));
    return (h >= 23 || h < 5);
  } catch (e) {
    return false; // lỗi đọc giờ -> an toàn hơn là KHÔNG bỏ qua, cứ chạy như bình thường
  }
}

// ============================================================
// [MỚI 2026-07-30] ĐO TẦN SUẤT SỬ DỤNG MODULE — theo (giờ, module, vai trò, trạm)
// ============================================================
var USAGE_STATS_SHEET   = 'Usage_Stats';
var USAGE_BUFFER_TTL_S  = 7200; // 2 tiếng — dư dả so với chu kỳ flush 10 phút

/**
 * spx_trackModuleOpen(moduleKey) — ĐIỂM GHI NHẬN DUY NHẤT của thống kê tần suất.
 * [SỬA LỖI THẬT — báo cáo: "1.509 lượt trong 7 ngày, làm sao mở nhiều vậy?"]
 * Trước đây lượt mở được ghi BÊN TRONG các hàm LẤY DỮ LIỆU. Nhiều hàm trong số đó
 * chạy mỗi lần tải Tổng quan (thẻ KPI Fail / Vi phạm / Cầu cứu) hoặc mỗi lượt đồng
 * bộ nền -> con số đo được là "số lần hệ thống lấy dữ liệu", KHÔNG phải "số lần
 * người dùng mở module". Admin mở Tổng quan nhiều nhất nên luôn đứng đầu bảng.
 * Nay CHỈ ghi khi người dùng bấm mở module thật (gọi từ openModule() ở giao diện),
 * kèm CHỐNG ĐẾM TRÙNG: mỗi người + mỗi module chỉ tính 1 lượt trong 10 phút, để
 * việc vẽ lại màn hình hay bấm qua lại không thổi phồng số.
 */
var SPX_OPEN_DEDUPE_SECONDS = 600;
function spx_trackModuleOpen(moduleKey) {
  try {
    moduleKey = String(moduleKey || '').trim();
    if (!moduleKey) return;
    var access = getModuleAccess();
    var email = (access && access.email) || 'unknown';
    var dedupeKey = 'open_seen_' + moduleKey + '_' + String(email).replace(/[^a-z0-9]/gi, '_');
    var sc = CacheService.getScriptCache();
    if (sc.get(dedupeKey)) return;                 // đã tính trong 10 phút gần đây
    sc.put(dedupeKey, '1', SPX_OPEN_DEDUPE_SECONDS);
    _spx_trackModuleUsage_(moduleKey, access);
  } catch (e) {}
}

function _spx_trackModuleUsage_(moduleKey, access) {
  try {
    var role = (access && access.role) || 'unknown';
    var email = (access && access.email) || 'unknown';
    var station;
    if (access && access.role === 'admin') {
      station = 'ALL(admin)';
    } else if (access && access.hubs && access.hubs.length === 1) {
      station = access.hubs[0];
    } else if (access && access.hubs && access.hubs.length > 1) {
      station = 'ALL(' + access.hubs.length + ' trạm)';
    } else {
      station = 'unknown';
    }
    var tz = 'Asia/Ho_Chi_Minh';
    var now = new Date();
    var hourKey = Utilities.formatDate(now, tz, 'yyyyMMddHH');
    var cacheKey = 'usage_buf_' + hourKey;
    // [FIX 2026-07-31] Thêm email vào tổ hợp đếm — trước chỉ có (module, vai
    // trò, trạm), không biết CHÍNH XÁC ai truy cập (đặc biệt user quản nhiều
    // trạm/admin đều gộp chung "ALL"). Email không chứa ký tự '|' nên an toàn
    // khi ghép/tách bằng dấu này.
    var comboKey = moduleKey + '|' + role + '|' + station + '|' + email;

    // [FIX HIỆU NĂNG THẬT — xác nhận qua báo cáo trực tiếp "gần như toàn bộ
    // module load chậm đồng bộ", đúng ngay sau khi tracking được mở rộng từ 3
    // lên 12 module] Buffer usage chỉ vài KB (không bao giờ gần ngưỡng chunk
    // 90KB) nhưng lại dùng getChunked/setChunked — tốn 3 lượt gọi CacheService
    // API/lần thay vì 1. Hàm này giờ chạy ở MỌI lần tải dữ liệu thật của cả 12
    // module (trước chỉ 3), nên overhead này nhân lên rõ rệt. Đổi sang get/set
    // đơn giản — đúng loại dữ liệu nhỏ này cần dùng.
    var buf = CacheMgr.get('USAGE', cacheKey) || {};
    buf[comboKey] = (buf[comboKey] || 0) + 1;
    CacheMgr.set('USAGE', cacheKey, buf, USAGE_BUFFER_TTL_S);
  } catch (e) {
    // Thống kê phụ — lỗi ở đây không được phép ảnh hưởng tới việc mở module thật.
  }
}

function _spx_getUsageStatsSheet_() {
  var ss = _DS.ss(ADMIN_DB_ID);
  var sheet = ss.getSheetByName(USAGE_STATS_SHEET);
  if (!sheet) {
    sheet = ss.insertSheet(USAGE_STATS_SHEET);
    sheet.appendRow(['Ngày', 'Giờ', 'Module', 'Vai trò', 'Trạm', 'Email', 'Số lượt mở']);
    sheet.setFrozenRows(1);
    sheet.getRange(1, 1, 1, 7).setFontWeight('bold');
  }
  return sheet;
}

/**
 * spx_diagUsageStats() — CHẠY THỦ CÔNG (chọn hàm rồi bấm Run).
 * [MỚI — kèm bản sửa "tần suất = 0"] Cho biết ngay: bộ đệm giờ này đang giữ bao
 * nhiêu lượt, sheet đã có bao nhiêu dòng, lần ghi xuống gần nhất là giờ nào — và
 * GHI XUỐNG LUÔN cả giờ hiện tại để kiểm chứng mà không phải đợi hết giờ.
 */
function spx_diagUsageStats() {
  var out = {};
  try {
    var tz = 'Asia/Ho_Chi_Minh', now = new Date();
    var hourNow = Utilities.formatDate(now, tz, 'yyyyMMddHH');
    var bufNow = CacheMgr.get('USAGE', 'usage_buf_' + hourNow) || {};
    out.gioHienTai = hourNow;
    out.luotDangChoTrongBoDem = Object.keys(bufNow).length;
    out.chiTietChoGhi = Object.keys(bufNow).slice(0, 10).map(function (k) { return k + ' = ' + bufNow[k]; });
    out.lanGhiGanNhat = PropertiesService.getScriptProperties().getProperty('usage_last_flushed_hour') || '(chưa lần nào)';
    var sheet = _spx_getUsageStatsSheet_();
    out.soDongTrongSheet = sheet ? Math.max(0, sheet.getLastRow() - 1) : 0;

    // Ghi xuống ngay cả giờ hiện tại (bình thường job chỉ ghi giờ TRƯỚC).
    if (Object.keys(bufNow).length) {
      var rows = [];
      var dateStr = hourNow.substring(0, 4) + '-' + hourNow.substring(4, 6) + '-' + hourNow.substring(6, 8);
      var hourStr = hourNow.substring(8, 10) + 'h';
      Object.keys(bufNow).forEach(function (comboKey) {
        var parts = comboKey.split('|');
        rows.push([dateStr, hourStr, parts[0] || '', parts[1] || '', parts[2] || '', parts[3] || '', bufNow[comboKey]]);
      });
      sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, 7).setValues(rows);
      try { CacheMgr.invalidate('USAGE', 'usage_buf_' + hourNow); } catch (eI) {}
      out.vuaGhiXuong = rows.length + ' dòng';
    } else {
      out.vuaGhiXuong = '0 dòng (bộ đệm giờ này đang trống)';
    }
    out.ketLuan = (out.soDongTrongSheet > 0 || Object.keys(bufNow).length)
      ? 'Luồng ghi nhận hoạt động. Mở lại tab Tần suất để xem.'
      : 'Chưa có lượt nào được ghi — hãy mở vài module rồi chạy lại hàm này.';
  } catch (e) { out.loi = e.message; }
  Logger.log(JSON.stringify(out, null, 2));
  return JSON.stringify(out, null, 2);
}

function spx_usageStats_flushBuffer() {
  // [SECURITY FIX 2026-08] Trước đây không kiểm tra quyền. Rủi ro thấp (tự giới hạn
  // theo giờ + named lock) nhưng thêm chặn cho đồng bộ với các job nền khác.
  _requireAdminIfInteractive_(2);   // [SỬA] job nền không có người đăng nhập
  var gotLock = _anaAcquireNamedLock('usage_stats_flush_lock_v1', 5000);
  if (!gotLock) return;
  try {
    var tz = 'Asia/Ho_Chi_Minh';
    var now = new Date();
    var prevHourDate = new Date(now.getTime() - 3600000);
    var targetHourKey = Utilities.formatDate(prevHourDate, tz, 'yyyyMMddHH');

    var props = PropertiesService.getScriptProperties();
    var lastFlushed = props.getProperty('usage_last_flushed_hour') || '';
    if (targetHourKey <= lastFlushed) return;

    var buf = CacheMgr.get('USAGE', 'usage_buf_' + targetHourKey);
    if (buf) {
      var dateStr = targetHourKey.substring(0, 4) + '-' + targetHourKey.substring(4, 6) + '-' + targetHourKey.substring(6, 8);
      var hourStr = targetHourKey.substring(8, 10) + 'h';
      var rows = [];
      Object.keys(buf).forEach(function (comboKey) {
        var parts = comboKey.split('|');
        rows.push([dateStr, hourStr, parts[0] || '', parts[1] || '', parts[2] || '', parts[3] || '', buf[comboKey]]);
      });
      if (rows.length) {
        var sheet = _spx_getUsageStatsSheet_();
        sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, 7).setValues(rows);
      }
      try { CacheMgr.invalidate('USAGE', 'usage_buf_' + targetHourKey); } catch (eInv) {}
    }
    props.setProperty('usage_last_flushed_hour', targetHourKey);
  } catch (e) {
    _LOG.d('[Usage Stats Flush] ERROR: ' + e.message);
  } finally {
    _anaReleaseNamedLock('usage_stats_flush_lock_v1');
  }
}

function setupUsageStatsFlushTrigger() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'spx_usageStats_flushBuffer') ScriptApp.deleteTrigger(t);
  });
  // [SỬA 2026-10] spx_usageStats_flushBuffer ĐÃ nằm trong spxDispatcher10Min() — tạo thêm trigger
  // riêng làm nó chạy 2 lần mỗi 10 phút (xác nhận qua Executions). Nay hàm này chỉ đảm bảo trigger
  // GỘP tồn tại, KHÔNG tạo trigger riêng nữa.
  var _hasDisp = ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === 'spxDispatcher10Min'; });
  if (!_hasDisp) { spxInstallDispatcher10Min(); }
  _LOG.d('✅ spx_usageStats_flushBuffer chạy qua spxDispatcher10Min (mỗi 10 phút) — không cài trigger riêng.');
  return 'spx_usageStats_flushBuffer chạy trong spxDispatcher10Min (mỗi 10 phút); đã gỡ trigger riêng nếu có. Xem kết quả trong sheet "Usage_Stats".';
}

/**
 * spx_checkUsageStatsTriggerStatus()
 * [MỚI — phát hiện qua câu hỏi trực tiếp "có sai lệch gì không?"] setupUsageStatsFlushTrigger()
 * là hàm CÀI ĐẶT 1 LẦN, phải chạy tay trong Apps Script Editor — KHÔNG có cách
 * nào để biết từ giao diện liệu nó đã từng được chạy hay chưa. Nếu CHƯA từng
 * chạy, buffer cache (TTL 2 tiếng) sẽ tự xoá vĩnh viễn trước khi kịp ghi vào
 * sheet — toàn bộ dữ liệu tracking từ trước tới nay có thể đã mất hoàn toàn,
 * không phải chỉ "trễ vài giờ" như trường hợp trigger hoạt động bình thường.
 * Hàm này cho phép UI tự kiểm tra và cảnh báo đúng thực trạng, không đoán mò.
 */
function spx_checkUsageStatsTriggerStatus() {
  try {
    _requireAdmin_(2);
    var triggers = ScriptApp.getProjectTriggers();
    var found = triggers.some(function (t) { var h = t.getHandlerFunction(); return h === 'spx_usageStats_flushBuffer' || h === 'spxDispatcher10Min'; });
    var props = PropertiesService.getScriptProperties();
    var lastFlushed = props.getProperty('usage_last_flushed_hour') || '';
    return JSON.stringify({ success: true, installed: found, lastFlushedHour: lastFlushed });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_installUsageStatsTrigger()
 * [MỚI] Cho phép admin tự cài đặt trigger NGAY từ giao diện (nút bấm trong tab
 * "Tần suất sử dụng") thay vì phải vào Apps Script Editor thủ công — hàm gốc
 * setupUsageStatsFlushTrigger() giữ nguyên không đổi, chỉ bọc thêm kiểm tra quyền.
 */
function spx_installUsageStatsTrigger() {
  // [CẢNH BÁO — theo yêu cầu trực tiếp "gộp trigger tương đồng"] Trigger 10-phút riêng lẻ này ĐÃ ĐƯỢC GỘP vào spxDispatcher10Min() — chỉ chạy hàm này nếu THẬT SỰ muốn tách nó ra khỏi nhóm gộp trở lại (sẽ tạo lại đúng trigger đã gộp, làm mất tác dụng gộp). Bình thường KHÔNG cần chạy nữa —
  // dùng spxInstallDispatcher10Min() thay thế.
  try {
    _requireAdmin_(2);
    var msg = setupUsageStatsFlushTrigger();
    return JSON.stringify({ success: true, message: msg });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_auditTriggers() — CHỈ XEM, không xoá gì. Chạy tay trong Apps Script Editor.
 * Liệt kê mọi trigger và đánh dấu: MỒ CÔI (hàm không còn trong mã nguồn — mỗi lượt chạy đều lỗi,
 * VD saveSnapshotTrigger), TRÙNG (spx_usageStats_flushBuffer khi đã có spxDispatcher10Min),
 * NGHI TRÙNG (cùng hàm + cùng loại sự kiện — chỉ báo, không tự xoá vì có thể cố ý).
 */
function spx_auditTriggers() { return _spxTriggerCleanup_(false); }

/**
 * spx_cleanRedundantTriggers() — XOÁ trigger MỒ CÔI và trigger TRÙNG đã xác nhận (xem trên).
 * Chạy tay 1 lần sau khi đã chạy spx_auditTriggers() và đồng ý với danh sách.
 */
function spx_cleanRedundantTriggers() { return _spxTriggerCleanup_(true); }

function _spxTriggerCleanup_(doDelete) {
  var triggers = ScriptApp.getProjectTriggers();
  var g = (typeof globalThis !== 'undefined') ? globalThis : this;
  var hasDisp10 = triggers.some(function (t) { return t.getHandlerFunction() === 'spxDispatcher10Min'; });
  var seen = {}, rows = [], removed = 0;
  triggers.forEach(function (t) {
    var h = t.getHandlerFunction();
    var sig = h + '|' + t.getEventType() + '|' + t.getTriggerSource();
    var defined = true;
    try { defined = (typeof g[h] === 'function'); } catch (eD) { defined = true; }
    var verdict = 'GIỮ', del = false;
    if (!defined) { verdict = 'MỒ CÔI — không có hàm "' + h + '" trong mã nguồn'; del = true; }
    else if (h === 'spx_usageStats_flushBuffer' && hasDisp10) { verdict = 'TRÙNG — đã chạy trong spxDispatcher10Min'; del = true; }
    else if (seen[sig]) { verdict = 'NGHI TRÙNG — cùng hàm + cùng loại sự kiện (không tự xoá)'; }
    seen[sig] = true;
    var row = { ham: h, loai: String(t.getEventType()), nguon: String(t.getTriggerSource()), ketLuan: verdict, daXoa: false };
    if (del && doDelete) { try { ScriptApp.deleteTrigger(t); row.daXoa = true; removed++; } catch (eX) { row.loi = eX.message; } }
    rows.push(row);
  });
  var res = { tongTrigger: triggers.length, daXoa: removed, cheDo: doDelete ? 'XOÁ' : 'CHỈ XEM', chiTiet: rows };
  Logger.log(JSON.stringify(res, null, 2));
  return JSON.stringify(res, null, 2);
}

/**
 * spx_listAllTriggers()
 * [MỚI — tab "Tuỳ chọn nâng cao", nhóm "Kiểm soát hệ thống & chẩn đoán"] Liệt
 * kê TOÀN BỘ trigger đang chạy trong project — mở rộng từ cách kiểm tra riêng
 * lẻ đã làm cho Usage Stats, giờ cho mọi trigger để admin thấy tổng quan 1 chỗ
 * thay vì phải đoán/vào tận Apps Script Editor.
 */
function spx_listAllTriggers() {
  try {
    // [SỬA — theo yêu cầu trực tiếp "loại bỏ Tuỳ chọn nâng cao khỏi admin
    // cấp 2"] Nâng từ _requireAdmin_(2) lên (1) — chỉ cấp 1 gọi được.
    _requireAdmin_(1);
    var triggers = ScriptApp.getProjectTriggers();
    var list = triggers.map(function (t) {
      var info = { handlerFunction: t.getHandlerFunction(), eventType: String(t.getEventType()) };
      try {
        if (t.getTriggerSource().toString() === 'CLOCK') {
          info.triggerSourceDetail = 'Định kỳ (time-based)';
        } else {
          info.triggerSourceDetail = t.getTriggerSource().toString();
        }
      } catch (e) { info.triggerSourceDetail = 'Không xác định'; }
      return info;
    });
    return JSON.stringify({ success: true, triggers: list, totalCount: list.length });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_getRecentErrors()
 * [MỚI — tab "Tuỳ chọn nâng cao"] Trả về tối đa 50 lỗi gần nhất đã ghi qua
 * _LOG.e() trong 6 tiếng qua (xem giải thích đầy đủ ở _LOG object).
 */
function spx_getRecentErrors() {
  try {
    // [SỬA — theo yêu cầu trực tiếp "loại bỏ Tuỳ chọn nâng cao khỏi admin
    // cấp 2"] Nâng từ _requireAdmin_(2) lên (1) — chỉ cấp 1 gọi được.
    _requireAdmin_(1);
    return JSON.stringify({ success: true, errors: _LOG.getRecentErrors() });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_getSystemConfig() / spx_setSystemConfig(config)
 * [MỚI — tab "Tuỳ chọn nâng cao", nhóm "Cấu hình vận hành"] Cho phép admin
 * chỉnh vài ngưỡng đang HARDCODE ở frontend (badgeDays/autoCleanDays/
 * autoCleanMB trong index.html) mà không cần deploy lại code. Lưu qua
 * PropertiesService — dùng CHUNG cho toàn hệ thống (không phải localStorage
 * riêng từng trình duyệt), đúng bản chất "cấu hình vận hành áp dụng cho mọi
 * user". Chỉ đưa 3 ngưỡng đã xác nhận rõ ràng, KHÔNG động vào toàn bộ hằng số
 * khác trong hệ thống — an toàn, có phạm vi rõ ràng.
 */
var SPX_CONFIG_DEFAULTS = { badgeDays: 14, autoCleanDays: 30, autoCleanMB: 5 };

function spx_getSystemConfig() {
  try {
    var props = PropertiesService.getScriptProperties();
    var raw = props.getProperty('spx_system_config_v1');
    var saved = raw ? JSON.parse(raw) : {};
    var merged = {};
    Object.keys(SPX_CONFIG_DEFAULTS).forEach(function (k) {
      merged[k] = (saved[k] !== undefined && saved[k] !== null) ? saved[k] : SPX_CONFIG_DEFAULTS[k];
    });
    return JSON.stringify({ success: true, config: merged, defaults: SPX_CONFIG_DEFAULTS });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message, config: SPX_CONFIG_DEFAULTS });
  }
}

function spx_setSystemConfig(config) {
  try {
    _requireAdmin_(2);
    var badgeDays = Number(config && config.badgeDays);
    var autoCleanDays = Number(config && config.autoCleanDays);
    var autoCleanMB = Number(config && config.autoCleanMB);
    if (!(badgeDays > 0) || !(autoCleanDays > 0) || !(autoCleanMB > 0)) {
      return JSON.stringify({ success: false, error: 'Giá trị phải là số dương.' });
    }
    var toSave = { badgeDays: badgeDays, autoCleanDays: autoCleanDays, autoCleanMB: autoCleanMB };
    PropertiesService.getScriptProperties().setProperty('spx_system_config_v1', JSON.stringify(toSave));
    return JSON.stringify({ success: true, config: toSave });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_getModuleStatusPublic() / spx_adminListModuleStatus() / spx_adminSetModuleStatus()
 * [MỚI — tab "Quản lý Module", theo yêu cầu trực tiếp "khoá/ẩn/thông báo cho
 * module chưa hoàn thiện hoặc đang bảo trì"] Cho Admin cấp 1 tạm khoá hoặc ẩn
 * 1 module đã hoàn thiện (status 'ok' trong NAV) đang cần sửa/bảo trì — KHÔNG
 * cần deploy lại code. User thường bấm vào sẽ thấy thông báo thay vì vào giữa
 * chừng lúc dữ liệu/logic chưa ổn định. Lưu qua PropertiesService — cùng
 * pattern spx_getSystemConfig/spx_setSystemConfig ở trên (nhẹ, không tốn quota
 * Sheets/Firestore cho việc đọc mỗi lần tải trang).
 */
var MODULE_STATUS_PROP_KEY = 'spx_module_status_v1';
// [SỬA — theo phản hồi trực tiếp "module WIP/RAW cũng phải khoá/ẩn được như
// module đã xây"] Trước đây CHỈ liệt kê 11 module đã hoàn thiện (status 'ok').
// Mở rộng ra ĐỦ 24 mục trong NAV (index.html) — kể cả module chưa xây (wip/raw)
// vì chúng vẫn hiện trên sidebar và có thể cần ẩn/khoá y hệt (VD sắp demo cho
// khách, muốn tạm ẩn bớt các mục "đang xây" để đỡ rối). Value đổi từ chuỗi
// nhãn đơn thuần sang {label, section} — section dùng để nhóm hiển thị ở tab
// Quản lý Module cho khỏi rối mắt với danh sách dài (giống cách sidebar nhóm
// theo section). Key dùng ĐÚNG toolKey thật mà spxJumpToNav()/openModule() xử
// lý (xem REAL_MODULE_MAP ở index.html — module có mapping dùng toolKey đã
// mapping, module WIP/RAW không có mapping thì key NAV chính là toolKey).
// CỐ Ý KHÔNG đưa 'adminzone' vào đây — không được để Admin tự khoá luôn màn
// quản trị của chính mình.
var MODULE_LOCKABLE_KEYS = {
  quahan:    { label: 'Kiểm soát Giao hàng',        section: 'Kiểm soát vận hành' },
  pickup:    { label: 'Tồn đọng FirstMile',          section: 'Kiểm soát vận hành' },
  pick:      { label: 'Quản lý Pick',                section: 'Kiểm soát vận hành' },
  tondong:   { label: 'Tồn Đọng LastMile',           section: 'Kiểm soát vận hành' },
  workforce: { label: 'Kiểm soát nhân lực',          section: 'Kiểm soát vận hành' },
  rescue:    { label: 'Đơn cần cầu cứu',             section: 'Kiểm soát vận hành' },
  lost:      { label: 'Phòng ngừa thất lạc',         section: 'Kiểm soát vận hành' },
  kpifail:   { label: 'Theo dõi KPI',                section: 'Quản lý hiệu suất' },
  riderperf: { label: 'Hiệu suất Rider',             section: 'Quản lý hiệu suất' },
  monitor:   { label: 'Giám sát hiệu suất',          section: 'Quản lý hiệu suất' },
  forecast:  { label: 'Dự báo sản lượng',            section: 'Lập kế hoạch & Năng lực' },
  market:    { label: 'Phân tích thị trường',        section: 'Lập kế hoạch & Năng lực' },
  riderplan: { label: 'Lập kế hoạch nhân lực',       section: 'Lập kế hoạch & Năng lực' },
  dispute:   { label: 'Tranh chấp & Lạm dụng',       section: 'Rủi ro & Tuân thủ' },
  incident:  { label: 'Quản lý sự cố',               section: 'Rủi ro & Tuân thủ' },
  violation: { label: 'Vi phạm',                     section: 'Rủi ro & Tuân thủ' },
  luong:     { label: 'Hiệu quả chi phí (Lương)',    section: 'Chi phí & Hiệu quả' },
  asset:     { label: 'Hiệu quả cơ sở',              section: 'Chi phí & Hiệu quả' },
  analytics: { label: 'Báo cáo (BI)',                section: 'Báo cáo & Dữ liệu' },
  tracuu:    { label: 'Tra cứu',                     section: 'Báo cáo & Dữ liệu' },
  tailieu:   { label: 'Tài Liệu',                    section: 'Báo cáo & Dữ liệu' },
  dataquality:{ label: 'Data Quality',               section: 'Báo cáo & Dữ liệu' },
  config:    { label: 'Rule Config',                 section: 'Hệ thống' },
  action:    { label: 'Action Center',               section: 'Hệ thống' }
};

function _spxGetModuleStatusMap_() {
  try {
    var raw = PropertiesService.getScriptProperties().getProperty(MODULE_STATUS_PROP_KEY);
    return raw ? JSON.parse(raw) : {};
  } catch (e) { return {}; }
}

/**
 * spx_getModuleStatusPublic()
 * Gọi lúc tải trang, CHO MỌI USER đã duyệt (không cần quyền admin) — cần biết
 * module nào đang khoá/ẩn để vẽ đúng sidebar + chặn đúng ở openModule() phía
 * client. Chỉ trả về status+message, KHÔNG trả ai sửa lúc nào (không cần thiết
 * cho user thường, và tránh lộ thông tin nội bộ không liên quan).
 */
function spx_getModuleStatusPublic() {
  try {
    _requireApproved_();
    var map = _spxGetModuleStatusMap_();
    var out = {};
    Object.keys(MODULE_LOCKABLE_KEYS).forEach(function (k) {
      if (map[k] && map[k].status && map[k].status !== 'normal') {
        out[k] = { status: map[k].status, message: map[k].message || '' };
      }
    });
    return JSON.stringify({ success: true, statuses: out });
  } catch (e) {
    // Lỗi đọc trạng thái KHÔNG được chặn cả trang tải — fail-open: coi như
    // không module nào bị khoá, còn hơn khoá NHẦM toàn bộ hệ thống.
    // [SỬA] Nhưng PHẢI trả kèm LÝ DO — trước đây trả rỗng im lặng, nên khi admin
    // ẩn module mà người dùng vẫn thấy đủ thì không có cách nào biết vì sao
    // (thường gặp: tài khoản chưa có dòng "Duyệt" trong Admin_Access khiến
    // _requireApproved_() ném lỗi ngay đầu hàm).
    return JSON.stringify({ success: false, statuses: {}, error: e.message });
  }
}

/**
 * spx_adminListModuleStatus()
 * [Tab "Quản lý Module"] Cả 2 cấp admin đều XEM được (giống các bảng thống kê
 * khác) — chỉ SỬA (spx_adminSetModuleStatus) mới giới hạn cấp 1, cùng mức
 * nhạy cảm đã áp dụng cho Trạm quản lý/Dọn dẹp hệ thống/Tuỳ chọn nâng cao.
 */
function spx_adminListModuleStatus() {
  try {
    _requireAdmin_(1);
    var map = _spxGetModuleStatusMap_();
    var list = Object.keys(MODULE_LOCKABLE_KEYS).map(function (k) {
      var st = map[k] || {};
      return {
        key: k, label: MODULE_LOCKABLE_KEYS[k].label, section: MODULE_LOCKABLE_KEYS[k].section,
        status: st.status || 'normal', message: st.message || '',
        updatedBy: st.updatedBy || '', updatedAt: st.updatedAt || ''
      };
    });
    return JSON.stringify({ success: true, list: list });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_adminSetModuleStatus(toolKey, status, message)
 * status: 'normal' | 'locked' | 'hidden'.
 * — 'locked': vẫn hiện trên sidebar (nhãn "BẢO TRÌ"), bấm vào hiện thông báo
 *   (message tuỳ chỉnh nếu có), KHÔNG vào được — trừ Admin (mọi cấp, để tự
 *   kiểm tra module trong lúc sửa mà không cần tắt khoá trước).
 * — 'hidden': ẩn hẳn khỏi sidebar với user thường; Admin vẫn thấy (mờ + nhãn
 *   "ẨN") để biết đang ẩn gì, mở được để kiểm tra như 'locked'.
 * Giới hạn admin cấp 1 — đây là cấu hình ảnh hưởng TOÀN BỘ user hệ thống.
 */
function spx_adminSetModuleStatus(toolKey, status, message) {
  try {
    var email = _requireAdmin_(1);
    if (!MODULE_LOCKABLE_KEYS[toolKey]) throw new Error('Module không hợp lệ: ' + toolKey);
    if (['normal', 'locked', 'hidden'].indexOf(status) < 0) throw new Error('Trạng thái không hợp lệ.');
    var map = _spxGetModuleStatusMap_();
    if (status === 'normal') {
      delete map[toolKey]; // dọn gọn — không cần lưu trạng thái mặc định
    } else {
      map[toolKey] = {
        status: status,
        message: String(message || '').slice(0, 300), // giới hạn độ dài, tránh lưu tràn lan
        updatedBy: email,
        updatedAt: new Date().toISOString()
      };
    }
    PropertiesService.getScriptProperties().setProperty(MODULE_STATUS_PROP_KEY, JSON.stringify(map));
    return spx_adminListModuleStatus();
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_getSystemAnnouncement() / spx_adminSetBanner() / spx_adminSetMaintenance()
 * [MỚI — theo yêu cầu trực tiếp "gửi thông báo popup real-time cho user +
 * chế độ bảo trì toàn hệ thống, chuyển hết user đang dùng sang màn bảo trì"]
 * Khác "Quản lý Module" (khoá TỪNG module riêng lẻ) — đây là 2 kênh TOÀN HỆ
 * THỐNG:
 *   (1) banner/popup thông báo — KHÔNG chặn thao tác, chỉ để user biết trước
 *       (VD "sắp bảo trì lúc 22h, nhớ lưu việc đang làm").
 *   (2) khoá bảo trì toàn hệ thống — chặn HẲN mọi module, mọi user thường
 *       (Admin tự bypass được, theo đúng quyết định trực tiếp).
 * Apps Script KHÔNG hỗ trợ push/WebSocket — client phải TỰ POLL định kỳ (xem
 * spxInitAnnouncement() ở index.html, chu kỳ 120s theo quyết định trực tiếp
 * "tiết kiệm quota nhất") nên có độ trễ tối đa = 1 chu kỳ polling, KHÔNG phải
 * tức thời 100% — đã trao đổi rõ giới hạn này với user trước khi làm.
 */
var SYSTEM_ANNOUNCEMENT_PROP_KEY = 'spx_system_announcement_v1';

function _spxGetAnnouncementState_() {
  var empty = {
    banner: { active: false, message: '', severity: 'info', id: '', updatedBy: '', updatedAt: '' },
    maintenance: { active: false, message: '', updatedBy: '', updatedAt: '' }
  };
  try {
    var raw = PropertiesService.getScriptProperties().getProperty(SYSTEM_ANNOUNCEMENT_PROP_KEY);
    var st = raw ? JSON.parse(raw) : {};
    return {
      banner: st.banner || empty.banner,
      maintenance: st.maintenance || empty.maintenance
    };
  } catch (e) { return empty; }
}
function _spxSaveAnnouncementState_(st) {
  PropertiesService.getScriptProperties().setProperty(SYSTEM_ANNOUNCEMENT_PROP_KEY, JSON.stringify(st));
  // [MỚI — "tận dụng Firebase để thông báo" theo yêu cầu trực tiếp] Đẩy thêm
  // lên Firestore để client nhận được GẦN NHƯ TỨC THỜI qua onSnapshot, thay vì
  // đợi tối đa 120s như polling cũ (xem spxInitAnnouncement() ở index.html —
  // VẪN GIỮ NGUYÊN làm lưới an toàn, tự động dùng nếu realtime lỗi/tắt).
  // PropertiesService ở trên vẫn là NGUỒN SỰ THẬT chính (đọc lúc tải trang
  // qua spx_getSystemAnnouncement(), không phụ thuộc Firestore còn sống hay
  // không) — Firestore chỉ là kênh ĐẨY nhanh, ghi lỗi KHÔNG được làm hỏng
  // luồng lưu chính (try/catch nuốt lỗi, giống mọi điểm ghi Firestore khác
  // trong hệ thống — ưu tiên tuyệt đối không làm gãy tính năng gốc).
  try {
    if (typeof _fsUpsertDoc_ === 'function') {
      _fsUpsertDoc_('system_status', 'state', st);
    }
  } catch (eFsPush) {
    console.warn('[Announcement] Đẩy Firestore lỗi (bỏ qua, polling vẫn hoạt động): ' + eFsPush.message);
  }
}

/**
 * spx_getSystemAnnouncement()
 * Gọi lúc tải trang VÀ định kỳ (polling mỗi 120s khi user đang dùng app) —
 * CHO MỌI USER đã duyệt (không cần quyền admin — mọi người đều cần biết bảo
 * trì, không riêng admin). Fail-open nếu lỗi: coi như không có gì mới, KHÔNG
 * được để lỗi đọc biến thành khoá NHẦM toàn hệ thống.
 */
function spx_getSystemAnnouncement() {
  try {
    var _email = _requireApproved_();
    // [MỚI — "biết bao nhiêu user đang online" theo yêu cầu trực tiếp, nhớ
    // hạn mức] "Bám" vào ĐÚNG lượt gọi định kỳ đã có sẵn (mọi user tự gọi hàm
    // này lúc tải trang + poll 120s/600s tuỳ realtime) — KHÔNG tạo thêm 1
    // request mới nào, không tốn thêm ngân sách thực thi Apps Script. Dùng
    // CacheService (miễn phí, KHÔNG phải Firestore) — tránh đúng rủi ro hạn
    // mức ghi Firestore (heartbeat 300+ user sẽ vượt xa 20K ghi/ngày nếu lỡ
    // dùng Firestore cho việc này).
    _spxTouchOnlinePresence_(_email);
    return JSON.stringify({ success: true, state: _spxGetAnnouncementState_() });
  } catch (e) {
    return JSON.stringify({ success: false, state: { banner: { active: false }, maintenance: { active: false } } });
  }
}

// [MỚI — "biết bao nhiêu user đang online"] Lưu { email: lastSeenEpochMs }
// trong ĐÚNG 1 cache entry (không phải 1 entry/user — tránh CacheService
// không có API liệt kê key theo mẫu, và giữ chi phí đọc/ghi cố định dù bao
// nhiêu user). Ngưỡng "online" 15 phút — đủ rộng để không hiện SAI "offline"
// cho user đang bật realtime (poll fallback giãn ra 600s = 10 phút, cộng
// thêm biên độ).
var SPX_ONLINE_CACHE_KEY = 'spx_online_users_v1';
var SPX_ONLINE_TTL_MIN = 15;

function _spxTouchOnlinePresence_(email) {
  try {
    if (!email) return;
    var cache = CacheService.getScriptCache();
    var raw = cache.get(SPX_ONLINE_CACHE_KEY);
    var map = {};
    try { map = raw ? JSON.parse(raw) : {}; } catch (eParse) { map = {}; }
    var now = Date.now();
    map[email.toLowerCase().trim()] = now;
    // Dọn bớt entry đã quá cũ trước khi ghi lại — tránh blob phình to vô hạn
    // nếu nhiều user luân phiên trong ngày (mỗi entry chỉ ~40-60 byte, dọn cho
    // gọn chứ không phải vì lo vượt giới hạn dung lượng CacheService).
    var cutoff = now - (SPX_ONLINE_TTL_MIN + 10) * 60 * 1000;
    Object.keys(map).forEach(function (e) { if (map[e] < cutoff) delete map[e]; });
    cache.put(SPX_ONLINE_CACHE_KEY, JSON.stringify(map), 3600); // TTL cache 1h, dài hơn hẳn ngưỡng online 15 phút ở trên
  } catch (eTouch) { /* lỗi ghi presence KHÔNG được làm gãy luồng thông báo chính */ }
}

/**
 * spx_adminGetOnlineUsers()
 * [Tab "Quản lý Module"] Admin cấp 1 — cùng mức nhạy cảm các thẻ hệ thống
 * khác trong tab này (Thông báo/Bảo trì, Hạn mức Firestore).
 */
function spx_adminGetOnlineUsers() {
  try {
    _requireAdmin_(1);
    var cache = CacheService.getScriptCache();
    var raw = cache.get(SPX_ONLINE_CACHE_KEY);
    var map = raw ? JSON.parse(raw) : {};
    var now = Date.now();
    var cutoff = now - SPX_ONLINE_TTL_MIN * 60 * 1000;
    var online = Object.keys(map)
      .filter(function (e) { return map[e] >= cutoff; })
      .map(function (e) { return { email: e, lastSeenSec: Math.round((now - map[e]) / 1000) }; })
      .sort(function (a, b) { return a.lastSeenSec - b.lastSeenSec; });
    return JSON.stringify({ success: true, count: online.length, users: online, thresholdMin: SPX_ONLINE_TTL_MIN });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_adminSetBanner(message, severity)
 * message rỗng => TẮT banner đang hiện (nếu có). severity: 'info'|'warning'|'critical'.
 * Mỗi lần gửi banner MỚI, đổi "id" (timestamp) để client phân biệt được "đây
 * là thông báo MỚI cần hiện lại popup" khác với thông báo cũ user đã bấm "Đã
 * hiểu" trong phiên hiện tại của họ (xem _spxLastSeenBannerId ở index.html).
 * Giới hạn admin cấp 1 — cùng mức nhạy cảm các cấu hình toàn hệ thống khác.
 */
function spx_adminSetBanner(message, severity) {
  try {
    var email = _requireAdmin_(1);
    var st = _spxGetAnnouncementState_();
    message = String(message || '').trim();
    if (!message) {
      st.banner = { active: false, message: '', severity: 'info', id: '', updatedBy: email, updatedAt: new Date().toISOString() };
    } else {
      if (['info', 'warning', 'critical'].indexOf(severity) < 0) severity = 'info';
      st.banner = {
        active: true,
        message: message.slice(0, 500),
        severity: severity,
        id: 'ann_' + Date.now(),
        updatedBy: email,
        updatedAt: new Date().toISOString()
      };
    }
    _spxSaveAnnouncementState_(st);
    // [MỚI — "FCM foreground" theo yêu cầu trực tiếp] Chỉ gửi push cho mức
    // Cảnh báo/Khẩn cấp — mức Thông tin chỉ cần popup trong app là đủ, không
    // cần làm phiền thêm 1 thông báo hệ thống. Best-effort — lỗi FCM KHÔNG
    // được làm gãy việc lưu banner chính (đã lưu xong ở dòng trên).
    if (st.banner && st.banner.active && (severity === 'warning' || severity === 'critical')) {
      try {
        if (typeof _fsSendFcmTopic_ === 'function') {
          var _fcmTitle = severity === 'critical' ? '🔴 Khẩn cấp — SPX HUB' : '⚠️ Lưu ý — SPX HUB';
          _fsSendFcmTopic_(_fcmTitle, st.banner.message);
        }
      } catch (eFcm) {
        console.warn('[Announcement] Gửi FCM lỗi (bỏ qua, banner vẫn lưu OK): ' + eFcm.message);
      }
    }
    return JSON.stringify({ success: true, state: st });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_adminSetMaintenance(active, message)
 * Khoá bảo trì TOÀN HỆ THỐNG — khác hẳn khoá từng module ("Quản lý Module").
 * User thường bị che TOÀN BỘ app bởi màn "Đang bảo trì", mọi module. Admin
 * (mọi cấp) tự bypass được (theo đúng quyết định trực tiếp) để tự kiểm
 * tra/tắt bảo trì mà không cần thao tác qua Apps Script Editor.
 */
function spx_adminSetMaintenance(active, message) {
  try {
    var email = _requireAdmin_(1);
    var st = _spxGetAnnouncementState_();
    st.maintenance = {
      active: !!active,
      message: String(message || '').trim().slice(0, 500),
      updatedBy: email,
      updatedAt: new Date().toISOString()
    };
    _spxSaveAnnouncementState_(st);
    return JSON.stringify({ success: true, state: st });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_exportUsageStatsRaw(daysBack)
 * [MỚI — theo yêu cầu "export ra file toàn bộ lịch sử theo khung thời gian"]
 * Trả về TOÀN BỘ dòng THÔ (không tổng hợp) trong daysBack ngày gần nhất — để
 * frontend tự dựng CSV và tải xuống, đúng pattern đã có sẵn ở KPI Fail/Rider
 * Plan (new Blob + URL.createObjectURL), không cần cách riêng.
 */
function spx_exportUsageStatsRaw(daysBack) {
  try {
    _requireAdmin_(2);
    daysBack = Number(daysBack) || 7;
    var tz = 'Asia/Ho_Chi_Minh';
    var sheet = _spx_getUsageStatsSheet_();
    var lastRow = sheet.getLastRow();
    var rows = [], everSeen = {}, activeInRange = {}, dataSince = '';

    if (lastRow >= 2) {
      var data = sheet.getRange(2, 1, lastRow - 1, 7).getValues();
      var cutoff = _spxVnMidnight_(-daysBack); // [SỬA] 00:00 GIỜ VIỆT NAM của (hôm nay − daysBack), không theo múi giờ dự án

      data.forEach(function (row) {
        var dateStr = row[0];
        var rowDate = (dateStr instanceof Date) ? dateStr : new Date(String(dateStr));
        if (isNaN(rowDate.getTime())) return;
        var dOut = (dateStr instanceof Date) ? Utilities.formatDate(dateStr, tz, 'yyyy-MM-dd') : String(dateStr);
        var emailL = String(row[5] || '').toLowerCase().trim();
        var cnt = Number(row[6]) || 0;

        // [MỚI] "đã từng dùng" tính trên toàn bộ lịch sử, không chỉ trong daysBack
        if (!dataSince || dOut < dataSince) dataSince = dOut;
        if (emailL && cnt) everSeen[emailL] = true;

        if (rowDate < cutoff) return;
        if (emailL && cnt) activeInRange[emailL] = true;
        rows.push([
          dOut, String(row[1] || ''), String(row[2] || ''), String(row[3] || ''),
          String(row[4] || ''), String(row[5] || ''), cnt
        ]);
      });
    }

    // [MỚI] Kèm danh sách người được duyệt nhưng chưa dùng / không hoạt động trong kỳ
    var g = { approvedTotal: 0, neverUsed: [], inactive: [] };
    try { g = _spx_usageApprovedGroups_(everSeen, activeInRange); } catch (eG) {}

    return JSON.stringify({
      success: true, rows: rows, daysBack: daysBack, dataSince: dataSince,
      approvedTotal: g.approvedTotal, neverUsed: g.neverUsed, inactive: g.inactive
    });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_clearUsageStatsHistory()
 * [MỚI — theo yêu cầu "thêm phần xoá lịch sử để recheck lại"] Xoá TOÀN BỘ dữ
 * liệu đã ghi (giữ header) + xoá luôn mọi buffer cache đang chờ flush — đảm
 * bảo "sạch hoàn toàn" để kiểm tra lại từ đầu, không để sót dữ liệu cũ bị
 * flush chèn vào sau khi đã xoá. Yêu cầu admin CẤP 1 (nghiêm ngặt hơn xem/cài
 * trigger) vì đây là hành động phá huỷ dữ liệu KHÔNG THỂ hoàn tác.
 */
function spx_clearUsageStatsHistory() {
  try {
    _requireAdmin_(1);
    var sheet = _spx_getUsageStatsSheet_();
    var lastRow = sheet.getLastRow();
    if (lastRow > 1) {
      sheet.getRange(2, 1, lastRow - 1, 7).clearContent();
    }
    // Xoá buffer cache đang chờ flush của vài giờ gần nhất — tránh dữ liệu CŨ
    // (trước khi xoá) bị flush chèn ngược lại sau khi sheet đã sạch.
    try {
      var tz = 'Asia/Ho_Chi_Minh';
      var now = new Date();
      for (var h = 0; h < 3; h++) {
        var hourDate = new Date(now.getTime() - h * 3600000);
        var hourKey = Utilities.formatDate(hourDate, tz, 'yyyyMMddHH');
        CacheMgr.invalidate('USAGE', 'usage_buf_' + hourKey);
      }
    } catch (eClearBuf) {}
    // Xoá cache tổng hợp đã lưu (mọi khoảng ngày) để lần xem tiếp theo đọc lại
    // đúng dữ liệu mới (rỗng), không trả về bản cache cũ còn hạn.
    try {
      CacheMgr.invalidateAll('ANALYTICS', ['usage_stats_v1_7', 'usage_stats_v1_30', 'usage_stats_v1_90', 'usage_stats_v2_7', 'usage_stats_v2_30', 'usage_stats_v2_90']);
    } catch (eClearCache) {}
    return JSON.stringify({ success: true });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * spx_getUsageStats(daysBack)
 * [MỚI — theo yêu cầu "tab Tần suất sử dụng trong Quản trị hệ thống, chỉ admin
 * xem được"] Phần GHI (tracking + flush + trigger) đã có sẵn từ trước (xem
 * _spx_trackModuleUsage_/spx_usageStats_flushBuffer ở trên) nhưng CHƯA từng có
 * hàm ĐỌC LẠI cho UI — hàm này bổ sung đúng phần còn thiếu đó. Tổng hợp theo
 * module (tổng lượt mở + số user khác nhau) và theo user (tổng lượt mở + top
 * module hay dùng nhất), trong daysBack ngày gần nhất. Cache 5 phút để tránh
 * đọc lại sheet có thể đã lớn theo thời gian mỗi lần admin mở tab.
 */
/**
 * spx_trackLuongUsage()
 * [MỚI — theo quyết định trực tiếp "chỉ tính khi thực sự tải dữ liệu"] Lương
 * hoạt động HOÀN TOÀN client-side (xử lý file CSV người dùng tự upload ngay
 * trong trình duyệt) — không có bất kỳ RPC nào để gắn tracking vào như 8
 * module còn lại. Thêm 1 endpoint RIÊNG, CHỈ để ghi nhận "đã upload file
 * thành công" — đây là hành động "sử dụng thật" rõ ràng nhất của module này,
 * tương đương ý nghĩa với "tải dữ liệu thật" ở các module khác.
 */
function spx_trackLuongUsage() {
  return 'ok';
}

/**
 * _spx_usageApprovedGroups_(everSeen, activeInRange)
 * [MỚI — theo yêu cầu "người được duyệt mà chưa bao giờ sử dụng thì sao?"]
 * Tạo "mẫu số" cho thống kê tần suất: danh sách người ĐÃ ĐƯỢC DUYỆT truy cập,
 * đối chiếu với Usage_Stats (chỉ có dòng khi user thật sự mở module) để tách:
 *   - neverUsed : được duyệt nhưng KHÔNG có dòng nào trong toàn bộ lịch sử Usage_Stats
 *   - inactive  : từng có lượt mở trong lịch sử nhưng KHÔNG có lượt nào trong kỳ đang xem
 * "Được duyệt" định nghĩa ĐÚNG như checkUserAccess()/_requireApproved_():
 *   (1) Admin_Access cột B = "Duyệt"  (2) admin mọi cấp trong _admin_getAdminMap()
 *       (admin mặc nhiên được duyệt, có thể không có dòng trong Admin_Access).
 * Email chuẩn hoá toLowerCase().trim() ở CẢ HAI phía — Admin_Access do người nhập
 * tay nên có thể lẫn hoa/thường, trong khi tracking ghi email đã chuẩn hoá.
 * Lưu ý: cột C Admin_Access bị ghi đè thành "thời điểm thao tác gần nhất" mỗi lần
 * duyệt/thu hồi — nên approvedTs là "thao tác gần nhất", KHÔNG phải ngày duyệt gốc.
 */
function _spx_usageApprovedGroups_(everSeen, activeInRange) {
  var out = { approvedTotal: 0, neverUsed: [], inactive: [] };
  var tz = 'Asia/Ho_Chi_Minh';
  var approved = {}; // email -> { kind, hub, ts }

  var adm = {};
  try { adm = _admin_getAdminMap() || {}; } catch (eAdm) {}
  Object.keys(adm).forEach(function (em) {
    approved[em] = { kind: 'Admin cấp ' + adm[em], hub: '', ts: 0 };
  });

  var accSheet = _DS.ss(ADMIN_DB_ID).getSheetByName('Admin_Access');
  if (accSheet) {
    var acc = accSheet.getDataRange().getValues();
    for (var i = 1; i < acc.length; i++) {
      var em = String(acc[i][0] || '').toLowerCase().trim();
      if (!em || String(acc[i][1] || '').trim() !== 'Duyệt') continue;
      var raw = acc[i][2];
      var ts = raw ? (raw instanceof Date ? raw.getTime() : (new Date(raw).getTime() || 0)) : 0;
      var prev = approved[em] || {};
      approved[em] = { kind: prev.kind || 'User', hub: String(acc[i][4] || '').trim(), ts: ts };
    }
  }

  Object.keys(approved).forEach(function (em) {
    out.approvedTotal++;
    if (activeInRange[em]) return;
    var a = approved[em];
    var item = {
      email: em, kind: a.kind, hub: a.hub, approvedTs: a.ts,
      approvedDate: a.ts ? Utilities.formatDate(new Date(a.ts), tz, 'yyyy-MM-dd') : ''
    };
    (everSeen[em] ? out.inactive : out.neverUsed).push(item);
  });
  // Người có thao tác duyệt LÂU NHẤT mà vẫn chưa dùng -> lên đầu (đáng quan tâm nhất)
  var byOld = function (x, y) { return (x.approvedTs || 0) - (y.approvedTs || 0); };
  out.neverUsed.sort(byOld);
  out.inactive.sort(byOld);
  return out;
}

function spx_getUsageStats(daysBack) {
  try {
    _requireAdmin_(2); // cả admin cấp 1 và cấp 2 đều xem được, đúng yêu cầu "chỉ admin"
    daysBack = Number(daysBack) || 7;
    // [SỬA] v1 -> v2: kết quả nay có thêm approvedTotal/neverUsed/inactive/dataSince,
    // bỏ qua cache cũ thiếu các trường này.
    var cacheKey = 'usage_stats_v2_' + daysBack;
    var cached = CacheMgr.get('ANALYTICS', cacheKey);
    if (cached) return JSON.stringify(cached);

    var sheet = _spx_getUsageStatsSheet_();
    var lastRow = sheet.getLastRow();
    var result = {
      success: true, daysBack: daysBack, totalOpens: 0, byModule: [], byUser: [],
      approvedTotal: 0, neverUsed: [], inactive: [], dataSince: '',
      generatedAt: new Date().toISOString()
    };
    var everSeen = {};       // email -> true: có dòng trong TOÀN BỘ lịch sử còn lưu
    var activeInRange = {};  // email -> true: có lượt mở trong daysBack

    if (lastRow >= 2) {
      var data = sheet.getRange(2, 1, lastRow - 1, 7).getValues();
      var cutoff = _spxVnMidnight_(-daysBack); // [SỬA] 00:00 GIỜ VIỆT NAM của (hôm nay − daysBack), không theo múi giờ dự án

      var byModule = {}; // module -> { opens, users: {email:true} }
      var byUser = {};   // email -> { opens, role, modules: {module: count} }

      data.forEach(function (row) {
        var dateStr = row[0]; // "yyyy-MM-dd" hoặc Date object tuỳ Sheets tự parse
        var rowDate = (dateStr instanceof Date) ? dateStr : new Date(String(dateStr));
        if (isNaN(rowDate.getTime())) return;

        var moduleKey = String(row[2] || '');
        var role = String(row[3] || '');
        var email = String(row[5] || '').toLowerCase().trim();
        var count = Number(row[6]) || 0;

        // [MỚI] Ghi nhận TRƯỚC khi lọc theo kỳ: "đã từng dùng" tính trên toàn bộ lịch sử.
        var dStr = (dateStr instanceof Date) ? Utilities.formatDate(dateStr, 'Asia/Ho_Chi_Minh', 'yyyy-MM-dd') : String(dateStr);
        if (!result.dataSince || dStr < result.dataSince) result.dataSince = dStr;
        if (email && count) everSeen[email] = true;

        if (rowDate < cutoff) return;
        if (!moduleKey || !count) return;

        result.totalOpens += count;

        if (!byModule[moduleKey]) byModule[moduleKey] = { opens: 0, users: {} };
        byModule[moduleKey].opens += count;
        if (email) byModule[moduleKey].users[email] = true;

        if (email) {
          activeInRange[email] = true;
          if (!byUser[email]) byUser[email] = { opens: 0, role: role, modules: {} };
          byUser[email].opens += count;
          byUser[email].modules[moduleKey] = (byUser[email].modules[moduleKey] || 0) + count;
        }
      });

      result.byModule = Object.keys(byModule).map(function (m) {
        return { module: m, opens: byModule[m].opens, uniqueUsers: Object.keys(byModule[m].users).length };
      }).sort(function (a, b) { return b.opens - a.opens; });

      result.byUser = Object.keys(byUser).map(function (e) {
        var mods = byUser[e].modules;
        var topModule = Object.keys(mods).sort(function (a, b) { return mods[b] - mods[a]; })[0] || '';
        return { email: e, role: byUser[e].role, opens: byUser[e].opens, topModule: topModule };
      }).sort(function (a, b) { return b.opens - a.opens; });
    }

    // [MỚI] Đối chiếu với danh sách người được duyệt — KHÔNG phụ thuộc lastRow>=2,
    // vì khi Usage_Stats rỗng (vừa xoá lịch sử) thì mọi người được duyệt đều "chưa dùng".
    try {
      var g = _spx_usageApprovedGroups_(everSeen, activeInRange);
      result.approvedTotal = g.approvedTotal;
      result.neverUsed = g.neverUsed;
      result.inactive = g.inactive;
    } catch (eG) { result.approvedError = eG.message; }

    CacheMgr.set('ANALYTICS', cacheKey, result, 300);
    return JSON.stringify(result);
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * pick_live_prewarmCache()
 * Chạy NỀN qua time-driven trigger (5 phút/lần — pick_live_installPrewarmTrigger)
 * hoặc thủ công qua pick_live_forceRefreshNow(). Có LockService bảo vệ nên nếu
 * nhiều lần gọi chồng lấn (trigger trùng lúc user bấm "Làm mới"), chỉ 1 lần
 * thực sự quét sheet.
 */
function pick_live_prewarmCache() {
  // [FIX 2026-08-01] BẬT LẠI khung giờ vắng — trước đây (2026-07-30) phải tắt
  // vì pick_live_getStations() báo lỗi cứng khi cache trống, không có build dự
  // phòng. Giờ đã thêm build dự phòng (có khóa bảo vệ) vào pick_live_getStations()
  // — nếu lỡ có user mở đúng lúc 23h-5h, module vẫn phục vụ được (build live,
  // chỉ chậm hơn 1 chút), không còn lỗi cứng nữa — an toàn để nghỉ giờ vắng.
  if (_spxIsPrewarmQuietHours_()) { _LOG.d('[Pick Live Prewarm] Bỏ qua — khung giờ vắng user (23h-5h).'); return; }
  // [FIX NGHẼN LOCK 2026-07-24] TRƯỚC ĐÂY dùng thẳng LockService.getScriptLock() —
  // hàm này chạy NỀN MỖI 5 PHÚT và giữ lock TRONG SUỐT thời gian quét sheet FM Live
  // (có thể mất nhiều giây với sheet lớn) — nghĩa là cứ mỗi 5 phút, TOÀN BỘ hệ thống
  // (Rider Plan, Admin Access, Quá Hạn note...) có thể bị chặn theo 1 chu kỳ đều đặn,
  // kể cả khi không có nhiều user cùng thao tác. Đổi sang named lock riêng — chỉ cần
  // tự chặn chính nó chạy chồng lấn (trigger trùng lúc user bấm "Làm mới"), không đụng
  // gì tới phần còn lại của hệ thống.
  // [FIX 2026-07-30] BUG: trước đây không truyền staleMs, dùng mặc định 90s của
  // _anaAcquireNamedLock() (chọn cho các use case khác, tối đa ~45s) — nhưng log
  // Executions xác nhận lượt build của CHÍNH hàm này có thể hợp lệ mất tới 606.9s
  // (>10 phút, sheet '3. FM action realtime' đã lớn). Sau đúng 90s, bất kỳ lượt
  // trigger nào bắn tiếp theo đều tưởng lượt trước đã crash và CƯỚP LUÔN khóa —
  // 2 lượt cùng build song song, tranh nhau tài nguyên, càng chồng càng chậm.
  // [FIX 2026-08-01] Trigger đổi tiếp từ 15 -> 30 phút — staleMs cũ 1800s (30
  // phút) lại TRÙNG chu kỳ mới, nâng tiếp lên 3600s (60 phút, gấp đôi) để giữ
  // đúng biên độ an toàn.
  var gotLock = _anaAcquireNamedLock('pick_live_prewarm_lock_v1', 20000, 3600000);
  if (!gotLock) return { success: false, busy: true };
  try {
    var fresh = _pickLive_buildRawSnapshot_();
    if (!fresh.success) return fresh;
    _pickLive_lastFreshBuild_ = fresh;
    _pickLive_writeSnapshotPerHub_(fresh);
    return { success: true, hubCount: fresh.hubs.length, generatedAt: fresh.generatedAt };
  } finally {
    _anaReleaseNamedLock('pick_live_prewarm_lock_v1');
  }
}

/**
 * pick_live_installPrewarmTrigger()
 * Chạy TAY 1 LẦN từ Apps Script editor (sau khi deploy bản này) để cài trigger
 * nền 5 phút/lần — xoá trigger trùng tên cũ (nếu có) trước khi tạo mới, tránh
 * bị nhân đôi trigger nếu chạy lại hàm này nhiều lần. Build ngay 1 lần sau khi
 * cài để có dữ liệu tức thì, khỏi phải đợi tới chu kỳ 5 phút đầu tiên.
 */
function pick_live_installPrewarmTrigger() {
  // [CẢNH BÁO — theo yêu cầu trực tiếp "gộp trigger tương đồng"] Trigger 30-phút riêng lẻ này ĐÃ ĐƯỢC GỘP vào spxDispatcher30Min() — chỉ chạy hàm này nếu THẬT SỰ muốn tách nó ra khỏi nhóm gộp trở lại (sẽ tạo lại đúng trigger đã gộp, làm mất tác dụng gộp). Bình thường KHÔNG cần chạy nữa —
  // dùng spxInstallDispatcher30Min() thay thế.
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'pick_live_prewarmCache') ScriptApp.deleteTrigger(t);
  });
  // [FIX 2026-07-31] Đổi 5 phút -> 15 phút. Log Executions xác nhận đây là trigger
  // TỐN NHIỀU NHẤT trong toàn hệ thống (~485 phút/ngày ở chu kỳ 5 phút — MỘT MÌNH
  // đã vượt hẳn quota 360 phút/ngày của tài khoản Workspace cho TỔNG mọi trigger
  // cộng lại). Đổi sang 15 phút giảm ~1/3 (còn ~162 phút/ngày). Đồng bộ tăng
  // PICK_LIVE_CACHE_TTL từ 600s lên 1800s (xem hằng số) — nếu không tăng TTL,
  // cache sẽ hết hạn trước lượt trigger kế tiếp, tái phát lỗi "chưa sẵn sàng".
  // [FIX 2026-08-01] Đổi 15 phút -> 30 phút (mốc lớn nhất ScriptApp chấp nhận) —
  // đây là trigger tốn nhiều nhất hệ thống, giảm thêm 1 nửa. Cộng với việc bật
  // lại khung giờ vắng (23h-5h, ~25% thời gian/ngày) nhờ build dự phòng mới có
  // ở pick_live_getStations() — tổng 2 thay đổi giảm đóng góp của trigger này
  // từ ~162 phút/ngày xuống còn ~61 phút/ngày. Đồng bộ tăng PICK_LIVE_CACHE_TTL
  // lên 3600s (xem hằng số) để vẫn dư biên độ với chu kỳ mới.
  ScriptApp.newTrigger('pick_live_prewarmCache').timeBased().everyMinutes(30).create();
  return pick_live_prewarmCache();
}

/**
 * pick_live_getStations()
 * Public entry — gọi từ JS_Pick.html khi mở tab Live. Trả DANH SÁCH TRẠM
 * (+ số đơn mỗi trạm) mà user hiện tại ĐƯỢC PHÉP xem, để FE hiển thị bộ chọn
 * trạm — KHÔNG chứa dữ liệu chi tiết. Admin thấy toàn bộ trạm có dữ liệu.
 * KHÔNG BAO GIỜ tự quét sheet — cache miss thì báo "chưa sẵn sàng" ngay.
 */
function pick_live_getStations() {
  var access = getModuleAccess();
  if (access.role === 'denied') {
    return JSON.stringify({ success: false, error: 'Bạn không có quyền truy cập module này.' });
  }

  var idxStr = _fmsLive_readChunkedJson_(PICK_LIVE_INDEX_KEY);
  if (!idxStr) {
    // [FIX 2026-08-01] TRƯỚC ĐÂY: cache trống -> báo lỗi cứng ngay, KHÔNG BAO
    // GIỜ tự build. Đây là lý do KHÔNG thể áp khung giờ vắng cho
    // pick_live_prewarmCache (đã từng làm module "chết" hẳn suốt 23h-5h, user
    // báo cáo thật). Giờ THỬ TỰ BUILD 1 LẦN (có khóa bảo vệ, double-check sau
    // khi giành khóa) trước khi báo lỗi — cho phép bật lại khung giờ vắng cho
    // trigger nền mà module vẫn luôn phục vụ được (build live có ngân sách
    // thời gian riêng, không rủi ro treo — xem _pickLive_buildRawSnapshot_).
    var gotLockLive = _anaAcquireNamedLock('pick_live_prewarm_lock_v1', 20000, 3600000);
    if (gotLockLive) {
      try {
        var idxStrRecheck = _fmsLive_readChunkedJson_(PICK_LIVE_INDEX_KEY);
        if (idxStrRecheck) { idxStr = idxStrRecheck; }
        else {
          var freshLive = _pickLive_buildRawSnapshot_();
          if (freshLive && freshLive.success) {
            _pickLive_lastFreshBuild_ = freshLive;
            try { _pickLive_writeSnapshotPerHub_(freshLive); } catch (eWr) {}
            // [FIX] Xây thẳng idxStr từ freshLive thay vì đọc lại cache vừa ghi —
            // nếu _pickLive_writeSnapshotPerHub_ lỡ ghi thất bại (vd payload vượt
            // trần chunk cache), đọc lại sẽ ra null dù build đã thành công thật,
            // khiến user vẫn thấy lỗi "chưa sẵn sàng" một cách oan uổng.
            idxStr = JSON.stringify({
              success: true, hubs: freshLive.hubs, counts: freshLive.counts,
              updatedNote: freshLive.updatedNote, generatedAt: freshLive.generatedAt
            });
          }
        }
      } catch (eLive) {
        // rơi xuống báo lỗi bên dưới nếu idxStr vẫn rỗng — không throw ra ngoài
      } finally {
        _anaReleaseNamedLock('pick_live_prewarm_lock_v1');
      }
    }
  }
  if (!idxStr) {
    return JSON.stringify({ success: false, notReady: true, error: 'Dữ liệu Live chưa sẵn sàng — tiến trình cập nhật nền chạy mỗi 30 phút, vui lòng thử lại sau ít phút.' });
  }
  var idx;
  try { idx = JSON.parse(idxStr); } catch (e) {
    return JSON.stringify({ success: false, error: 'Dữ liệu tạm bị lỗi, vui lòng thử lại sau ít phút.' });
  }

  var counts = idx.counts || {};
  var hubs;
  if (access.role === 'admin') {
    hubs = idx.hubs || [];
  } else {
    var allowedSet = Object.create(null);
    (access.hubs || []).forEach(function (s) { allowedSet[_normStationKey_(s, { pakFix: false, stripSuffix: false })] = true; });
    hubs = (idx.hubs || []).filter(function (h) {
      return allowedSet[_normStationKey_(h, { pakFix: false, stripSuffix: false })] === true;
    });
  }

  return JSON.stringify({
    success: true,
    hubs: hubs.map(function (h) { return { name: h, count: counts[h] || 0 }; }),
    updatedNote: idx.updatedNote || '',
    generatedAt: idx.generatedAt,
    role: access.role
  });
}

/**
 * pick_live_getStationData(stationNames)
 * Public entry — dữ liệu chi tiết CHỈ cho các trạm user chủ động chọn trong
 * bộ chọn trạm ở FE. ADMIN CŨNG PHẢI truyền danh sách trạm cụ thể — không còn
 * nhánh "lấy tất cả" ngầm định. Server luôn ép giao (intersect) với quyền
 * thực tế: non-admin không thể "xin" trạm ngoài quyền dù FE gửi gì lên.
 * Giới hạn PICK_LIVE_MAX_HUBS_PER_CALL trạm/lần gọi — FE nên gọi theo đợt
 * nếu user chọn nhiều trạm hơn mức này.
 */
function pick_live_getStationData(stationNames) {
  var access = getModuleAccess();
  if (access.role === 'denied') {
    return JSON.stringify({ success: false, error: 'Bạn không có quyền truy cập module này.' });
  }
  if (!Array.isArray(stationNames) || stationNames.length === 0) {
    return JSON.stringify({ success: true, data: [], stationsReturned: [], fetchedAt: Date.now() });
  }

  var idxStr = _fmsLive_readChunkedJson_(PICK_LIVE_INDEX_KEY);
  if (!idxStr) {
    return JSON.stringify({ success: false, notReady: true, error: 'Dữ liệu Live chưa sẵn sàng — tiến trình cập nhật nền chạy mỗi 5 phút, vui lòng thử lại sau ít phút.' });
  }
  var idx;
  try { idx = JSON.parse(idxStr); } catch (e) {
    return JSON.stringify({ success: false, error: 'Dữ liệu tạm bị lỗi, vui lòng thử lại sau ít phút.' });
  }
  var allHubs = idx.hubs || [];

  var requestedSet = Object.create(null);
  stationNames.forEach(function (s) { requestedSet[_normStationKey_(s, { pakFix: false, stripSuffix: false })] = true; });

  var allowedHubs;
  if (access.role === 'admin') {
    allowedHubs = allHubs.filter(function (h) { return requestedSet[_normStationKey_(h, { pakFix: false, stripSuffix: false })] === true; });
  } else {
    var myAllowed = Object.create(null);
    (access.hubs || []).forEach(function (s) { myAllowed[_normStationKey_(s, { pakFix: false, stripSuffix: false })] = true; });
    allowedHubs = allHubs.filter(function (h) {
      var k = _normStationKey_(h, { pakFix: false, stripSuffix: false });
      return myAllowed[k] === true && requestedSet[k] === true;
    });
  }

  var truncated = false;
  if (allowedHubs.length > PICK_LIVE_MAX_HUBS_PER_CALL) { allowedHubs = allowedHubs.slice(0, PICK_LIVE_MAX_HUBS_PER_CALL); truncated = true; }

  if (!allowedHubs.length) {
    return JSON.stringify({ success: true, data: [], stationsReturned: [], updatedNote: idx.updatedNote || '', generatedAt: idx.generatedAt, fetchedAt: Date.now() });
  }

  var keys = allowedHubs.map(_pickLive_hubCacheKey_);
  var batch = _fmsLive_readChunkedJsonBatch_(keys);
  var data = [];
  allowedHubs.forEach(function (h, i) {
    var raw = batch[keys[i]];
    if (!raw) return;
    try {
      var rows = JSON.parse(raw);
      if (rows && rows.length) data = data.concat(rows);
    } catch (e) {}
  });

  return JSON.stringify({
    success: true,
    data: data,
    stationsReturned: allowedHubs,
    truncated: truncated,
    updatedNote: idx.updatedNote || '',
    generatedAt: idx.generatedAt,
    fetchedAt: Date.now()
  });
}

/**
 * pick_live_forceRefreshNow()
 * Nút "Làm mới" chủ động của user — build lại NGAY (đồng bộ) thay vì đợi chu
 * kỳ trigger 5 phút. Nếu đang có tiến trình khác build song song (busy), đọc
 * lại index 1 lần nữa (có thể vừa xong) thay vì báo lỗi ngay. Đây vẫn là 1
 * lần full-scan sheet nên CHỈ nên là hành động thủ công của user, không nên
 * tự động lặp lại.
 */
/**
 * pick_live_getHubSummary(stationName)
 * [2026-07-24] Bản tóm tắt SIÊU NHẸ cho ĐÚNG 1 trạm — phục vụ badge cảnh báo
 * trên card "Quản lý Pick" ở trang chủ, KHÔNG cần mở module Pick. Chỉ đọc lại
 * 1 chunk cache của trạm đó (đã có sẵn nhờ pick_live_prewarmCache chạy nền mỗi
 * 5 phút) — không quét sheet, an toàn gọi mỗi lần tải trang chủ.
 * Trước đây có badge-pick trên card này nhưng đã bị GỠ vì lấy nhầm số liệu từ
 * data Quá Hạn (sai). Hàm này lấy đúng nguồn Pick Live thật nên khắc phục được.
 */
function pick_live_getHubSummary(stationName) {
  var access = getModuleAccess();
  if (access.role === 'denied' || !stationName) {
    return JSON.stringify({ success: true, total: 0, problem: 0 });
  }
  // Ép quyền: non-admin chỉ được xem tóm tắt đúng trạm mình quản lý.
  if (access.role !== 'admin') {
    var myAllowed = Object.create(null);
    (access.hubs || []).forEach(function (s) { myAllowed[_normStationKey_(s, { pakFix: false, stripSuffix: false })] = true; });
    if (myAllowed[_normStationKey_(stationName, { pakFix: false, stripSuffix: false })] !== true) {
      return JSON.stringify({ success: true, total: 0, problem: 0 });
    }
  }

  var idxStr = _fmsLive_readChunkedJson_(PICK_LIVE_INDEX_KEY);
  if (!idxStr) return JSON.stringify({ success: true, total: 0, problem: 0, notReady: true });
  var idx;
  try { idx = JSON.parse(idxStr); } catch (e) { return JSON.stringify({ success: true, total: 0, problem: 0 }); }

  var targetKey = _normStationKey_(stationName, { pakFix: false, stripSuffix: false });
  var match = (idx.hubs || []).filter(function (h) { return _normStationKey_(h, { pakFix: false, stripSuffix: false }) === targetKey; })[0];
  if (!match) return JSON.stringify({ success: true, total: 0, problem: 0 });

  var raw = _fmsLive_readChunkedJson_(_pickLive_hubCacheKey_(match));
  if (!raw) return JSON.stringify({ success: true, total: 0, problem: 0 });
  var rows;
  try { rows = JSON.parse(raw); } catch (e) { return JSON.stringify({ success: true, total: 0, problem: 0 }); }

  var total = rows.length, problem = 0;
  rows.forEach(function (r) {
    var s = (r.fleetFinalStatus || '').toLowerCase();
    // Nhóm "cần chú ý": fail/lost/cancel/onhold — khớp đúng logic tô màu đỏ
    // đang dùng ở card trạng thái Pick Live (updateLiveStatusChipsPICK).
    if (s.indexOf('fail') > -1 || s.indexOf('lost') > -1 || s.indexOf('cancel') > -1 || s.indexOf('onhold') > -1) problem++;
  });

  return JSON.stringify({ success: true, total: total, problem: problem, station: match, generatedAt: idx.generatedAt });
}

function pick_live_forceRefreshNow() {
  var res = pick_live_prewarmCache();
  if (res && res.busy) {
    var idxStr = _fmsLive_readChunkedJson_(PICK_LIVE_INDEX_KEY);
    if (idxStr) {
      try { var idx = JSON.parse(idxStr); return JSON.stringify({ success: true, generatedAt: idx.generatedAt }); } catch (e) {}
    }
  }
  return JSON.stringify(res);
}


// Xóa cache aging_getMasterData — gọi sau mỗi write operation (saveNote, syncNotes)

/**
 * qh_getBacklogByStation()
 * [MỚI — khai thác sheet 'Backlog FM+LM' chưa từng được dùng]
 * Trả về phân bố backlog LastMile theo 5 mốc tuổi cho TỪNG TRẠM — thứ mà
 * module Quá hạn còn thiếu: hiện chỉ có danh sách đơn, chưa có bức tranh
 * "trạm mình đang nặng ở mốc nào so với các trạm khác".
 *
 * CẤU TRÚC SHEET (đã xác minh trực tiếp trên file thật, không suy đoán):
 *   - Dòng 3 (index 2): tiêu đề — cột 1 'Station' (FirstMile), cột 8 'Station' (LastMile)
 *   - Sheet có 3 KHỐI LỒNG NHAU, phân cách bằng dòng trống:
 *       d4-d11   : cấp AOM  (8 dòng, gồm 'Grand Total')
 *       d15-d47  : cấp SUP  (33 dòng)
 *       d51-d420 : cấp HUB  (370 dòng) <- KHỐI TA CẦN
 *     Bằng chứng khối lồng nhau: cộng TẤT CẢ dòng ra 110.940 = ~3x Grand Total
 *     37.335, và 1 tên xuất hiện ở cả khối AOM lẫn SUP với số liệu y hệt.
 *   - Cột LastMile: [8]=tên, [9]='>7 Day', [10]='5-7 Day', [11]='2-5 Day',
 *     [12]='37H - 2 Day', [13]='<= 37H'
 *   - Kiểm chứng: cộng riêng khối HUB = [1255,3456,21002,971,10653], khớp
 *     Grand Total [1255,3456,21002,971,10651] (lệch 2 đơn = 0.005%, do thời
 *     điểm chốt số khác nhau).
 *
 * KHÔNG dò theo số dòng cứng (sheet có thể thêm/bớt trạm) — thay vào đó nhận
 * diện khối HUB bằng đặc điểm dữ liệu: tên chứa 'Hub'/'SOC' (tên trạm thật),
 * khác hẳn khối AOM/SUP vốn là tên người.
 */
function qh_getBacklogByStation(scopeStationsJson) {
  try {
    _requireApproved_();

    // [SỬA LỖI THIẾT KẾ — báo cáo trực tiếp kèm ảnh: "Lead quản 1 trạm mà show
    // cả nước? AOM/SUP cần khu vực mình quản lý chứ đâu cần coi cả nước"]
    // TRƯỚC ĐÂY hàm không nhận tham số phạm vi nào -> luôn trả về CẢ 371 trạm
    // toàn quốc cho MỌI cấp. Sai cả về nghiệp vụ (người dùng cần so sánh trong
    // phạm vi mình quản, không phải toàn quốc) lẫn về quyền dữ liệu (Lead thấy
    // được số liệu của 370 trạm không thuộc quyền mình).
    //
    // NAY: lọc theo ĐÚNG phạm vi được phân quyền của người gọi.
    //   - Admin            -> toàn hệ thống (giữ nguyên, để kiểm tra tổng thể)
    //   - ROM/AOM/SUP/Lead -> chỉ các trạm trong perm.stations
    //   - scopeStationsJson: khi Admin đang "xem thử" theo vai 1 AOM/SUP cụ thể,
    //     frontend truyền danh sách trạm của người đó để mô phỏng đúng góc nhìn.
    var email = Session.getActiveUser().getEmail();
    var perm  = checkAnalyticsPermission(email);
    if (!perm || !perm.allowed) return JSON.stringify({ success: false, error: 'Không có quyền truy cập.' });

    var scopeSet = null;   // null = không giới hạn (toàn hệ thống)
    var scopeList = null;
    try {
      if (scopeStationsJson) {
        var arr = JSON.parse(scopeStationsJson);
        if (Array.isArray(arr) && arr.length) scopeList = arr;
      }
    } catch (eParse) { scopeList = null; }

    // Không truyền scope -> dùng đúng quyền thật của người gọi.
    // Admin (isAdmin) và KHÔNG có scope -> xem toàn hệ thống.
    if (!scopeList && !perm.isAdmin) scopeList = perm.stations || [];

    if (scopeList) {
      scopeSet = {};
      scopeList.forEach(function(s) {
        var k = String(s || '').trim().toLowerCase();
        if (k) scopeSet[k] = true;
      });
      if (!Object.keys(scopeSet).length) scopeSet = null;
    }

    // [PERF 2026-10] TRƯỚC ĐÂY cache theo TỪNG phạm vi (mỗi user/phạm vi khác nhau = 1 khoá
    // riêng) nên mỗi phạm vi mới đều phải đọc lại cả sheet nguồn (~5 giây) — đỉnh đồng thời
    // 27 lượt trong Executions có 8 lượt đúng hàm này (8 phạm vi khác nhau cùng "miss").
    // NAY: đọc + phân tích sheet đúng 1 lần, cache dữ liệu THÔ (toàn bộ trạm), mọi phạm vi
    // chỉ lọc trong bộ nhớ. TTL 10 phút (trước 30 phút): nguồn cập nhật 8:00/14:00 nên số
    // liệu mới hiện chậm tối đa 10 phút thay vì 30.
    var RAW_KEY = 'qh_backlog_raw_v3';
    var raw = CacheMgr.getChunked('ANALYTICS', RAW_KEY);
    if (!raw || !raw.stations) {
      var ss = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA');
      var sheet = ss.getSheetByName('Backlog FM+LM');
      if (!sheet) return JSON.stringify({ success: false, error: "Không thấy sheet 'Backlog FM+LM'" });

      var lastRow = sheet.getLastRow();
      if (lastRow < 5) return JSON.stringify({ success: true, stations: [], total: null });
      // [SỬA] Dò khối LastMile + các cột mốc tuổi theo TIÊU ĐỀ (dòng 2 = nhãn khối, dòng 3 = tiêu đề cột).
      // Chấp nhận cả tên mốc cũ ('37H - 2 Day', '<= 37H') lẫn mới ('1-2 Day', '<= 1 Day').
      var _lastCol = sheet.getLastColumn();
      var _hdr2 = sheet.getRange(2, 1, 1, _lastCol).getValues()[0];
      var _hdr3 = sheet.getRange(3, 1, 1, _lastCol).getValues()[0];
      var _lm = -1;
      for (var _c = 0; _c < _hdr2.length; _c++) {
        var _nn = _spx_normHdr_(_hdr2[_c]);
        if (_nn === 'lastmile' || _nn === 'last mile') { _lm = _c; break; }
      }
      if (_lm < 0) throw new Error("Sheet 'Backlog FM+LM': không thấy ô 'LastMile' ở dòng 2. Dòng 2 hiện có: " + _hdr2.map(function (x) { return String(x || '').trim(); }).filter(String).join(' | '));
      var B = _spx_findCols_(_hdr3, _SPX_SPEC_BKLM_, { from: _lm });
      _spx_requireCols_("Sheet 'Backlog FM+LM' (khối LastMile)", B, _SPX_REQ_BKLM_, _hdr3);
      var values = sheet.getRange(1, 1, lastRow, Math.min(sheet.getMaxColumns(), _spx_maxIdx_(B) + 1)).getValues();

      var allStations = [];
      var grandTotal = null;
      for (var i = 3; i < values.length; i++) {
        var nm = values[i][B.station];
        if (!nm || typeof nm !== 'string') continue;
        nm = nm.trim();
        if (!nm) continue;

        var b = [];
        var sum = 0;
        var _bc = [B.over7, B.d57, B.d25, B.mid, B.low];
        for (var kk = 0; kk < _bc.length; kk++) {
          var v = values[i][_bc[kk]];
          var n = (typeof v === 'number') ? v : 0;
          b.push(n); sum += n;
        }

        if (nm === 'Grand Total') {
          // Dòng này là tổng TOÀN QUỐC — chỉ dùng khi KHÔNG giới hạn phạm vi (xem bên dưới).
          grandTotal = { over7: b[0], d57: b[1], d25: b[2], h37_2d: b[3], h37: b[4], sum: sum };
          continue;
        }
        // Chỉ lấy khối HUB — tên trạm luôn chứa 'Hub' hoặc 'SOC' (VD '45-DLK Krong Pak 02 Hub'),
        // trong khi khối AOM/SUP là tên người. Ổn định hơn dò theo số dòng cố định.
        var up = nm.toUpperCase();
        if (up.indexOf('HUB') < 0 && up.indexOf('SOC') < 0) continue;
        if (sum <= 0) continue;

        allStations.push({
          station: nm,
          over7:  b[0],   // >7 Day    (Critical)
          d57:    b[1],   // 5-7 Day
          d25:    b[2],   // 2-5 Day   (Moderate)
          h37_2d: b[3],   // 37H - 2 Day
          h37:    b[4],   // <= 37H    (Green)
          sum:    sum
        });
      }
      raw = { stations: allStations, grandTotal: grandTotal, asOf: Date.now() };
      CacheMgr.setChunked('ANALYTICS', RAW_KEY, raw, 600);
    }

    var stations = raw.stations;
    var total = null;
    if (scopeSet) {
      // Có giới hạn phạm vi -> chỉ giữ trạm trong phạm vi, tự cộng tổng từ đúng các trạm đó
      // để mọi tỉ lệ/xếp hạng tính trên đúng mẫu số của phạm vi (không dùng Grand Total toàn quốc).
      stations = raw.stations.filter(function (st) { return scopeSet[String(st.station).toLowerCase()]; });
      var t = { over7: 0, d57: 0, d25: 0, h37_2d: 0, h37: 0, sum: 0 };
      stations.forEach(function (st) {
        t.over7 += st.over7; t.d57 += st.d57; t.d25 += st.d25;
        t.h37_2d += st.h37_2d; t.h37 += st.h37; t.sum += st.sum;
      });
      total = t;
    } else {
      total = raw.grandTotal || null;
    }

    var out = JSON.stringify({ success: true, stations: stations, total: total, scoped: !!scopeSet, asOf: raw.asOf || null });
    return out;
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

/**
 * _aging_lmColumnMap_(headerRow)
 * [SỬA LỖI THẬT — "Quá Hạn trắng dù nguồn có dữ liệu"] Trước đây sheet '1. LM high aging'
 * được đọc theo VỊ TRÍ cột cố định (trạm = cột K...). Sheet nguồn đã đổi bố cục: thêm cột
 * order_status ở J, bỏ cột cogs và cột nhãn mốc -> mọi cột từ J trở đi lệch 1 vị trí, tên
 * trạm bị đọc thành trạng thái đơn ('Delivering'...) nên không trạm nào lọc ra đơn.
 * Nay dò theo TÊN TIÊU ĐỀ ở dòng 2 (spx_shipment_id, fleet_final_station, ...), nên sheet
 * thêm/bớt cột về sau không làm sai số liệu âm thầm nữa. Cột không tồn tại -> -1.
 * Không tìm thấy tiêu đề then chốt -> lùi về bố cục cũ (fallback=true) để không gãy hẳn.
 * Bố cục cũ (trạm ở K) vẫn nhận ra được: cột nhãn mốc khi đó nằm ở R.
 */
function _aging_lmColumnMap_(hdr) {
  var norm = function (s) { return String(s == null ? '' : s).toLowerCase().replace(/\s+/g, ' ').trim(); };
  var pos = {};
  var set = function (k, c) { if (pos[k] === undefined) pos[k] = c; };
  for (var c = 0; c < (hdr ? hdr.length : 0); c++) {
    var h = norm(hdr[c]);
    if (!h) continue;
    if (h === 'spx_shipment_id') set('ship', c);
    else if (h === 'fleet_final_status') set('status', c);
    else if (h === 'fleet_final_station') set('hub', c);
    else if (h.indexOf('inbound_date_current') === 0) set('inbound', c);
    else if (h.indexOf('deliver_attempt') === 0) set('att', c);
    else if (h.indexOf('timing_date') === 0) set('timing', c);
    else if (/^aging(\(sum\))?$/.test(h)) set('aging', c);
    else if (h.indexOf('cogs') === 0) set('cogs', c);
    else if (/bucket|nhóm tồn|nhãn mốc/.test(h)) set('bucket', c);
    else if (h === 'aom') set('aom', c);
    else if (h === 'sup') set('sup', c);
    else if (h.indexOf('đến hạn lost') === 0) set('lost', c);
    else if (h.indexOf('trạng thái xử lý') === 0) set('proc', c);
  }
  var M;
  if (pos.ship === undefined || pos.hub === undefined) {
    M = { ship: 5, status: 9, hub: 10, inbound: 11, att: 13, timing: 14, aging: 15, cogs: 16, bucket: 17,
          lost: 0, proc: 1, aom: 2, sup: 3, fallback: true };
  } else {
    var g = function (k, d) { return pos[k] !== undefined ? pos[k] : d; };
    M = { ship: pos.ship, status: g('status', -1), hub: pos.hub, inbound: g('inbound', -1), att: g('att', -1),
          timing: g('timing', -1), aging: g('aging', -1), cogs: g('cogs', -1),
          bucket: g('bucket', pos.hub === 10 ? 17 : -1),
          lost: g('lost', 0), proc: g('proc', 1), aom: g('aom', 2), sup: g('sup', 3), fallback: false };
  }
  M.width = Math.max(M.ship, M.status, M.hub, M.inbound, M.att, M.timing, M.aging, M.cogs, M.bucket,
                     M.lost, M.proc, M.aom, M.sup) + 1;
  return M;
}

function _aging_getCoreDataFromSS(ss) {
  try {
    const sheet = ss.getSheetByName('1. LM high aging');
    if (!sheet) return JSON.stringify({ success: false, error: "Không thấy sheet '1. LM high aging'" });
    const lastRow = sheet.getLastRow();
    if (lastRow < 3) return JSON.stringify({ success: true, data: [], hubs: [] });
    const nCols = Math.min(sheet.getMaxColumns(), Math.max(sheet.getLastColumn(), 18));
    const values  = sheet.getRange(1, 1, lastRow, nCols).getValues();
    // [SỬA] Dò cột theo tiêu đề dòng 2 — xem _aging_lmColumnMap_().
    const M = _aging_lmColumnMap_(values[1]);
    if (M.fallback) { try { _LOG.d('[Aging Core] Không dò được tiêu đề cột — dùng bố cục cũ, CÓ THỂ SAI.'); } catch (eLg) {} }
    const data = []; const hubs = new Set();
    for (let i = 2; i < values.length; i++) {
      const row = values[i];
      if (!row[M.ship] || row[M.ship].toString().trim() === "") continue;
      const hub = row[M.hub] ? row[M.hub].toString().trim() : "";
      // [TỐI ƯU DUNG LƯỢNG — giữ nguyên] bản chụp ghi vào Google Sheet chia khối 45.000 ký tự,
      // mỗi byte thêm vào 1 bản ghi nhân với hàng chục nghìn dòng: hasAttempt bỏ hẳn (suy ra
      // từ att), inboundAt cắt tới phút, deliverAttempt đặt tên ngắn 'att'.
      const rec = {
        lostToday: row[M.lost], processStatus: row[M.proc],
        aom: row[M.aom] ? row[M.aom].toString().trim() : "",
        sup: row[M.sup] ? row[M.sup].toString().trim() : "",
        shipmentId: row[M.ship].toString().trim(),
        finalStatus: M.status >= 0 ? row[M.status] : "",
        hubName: hub,
        // timingDate = số ngày tồn TẠI TRẠM HIỆN TẠI. Nhãn mốc (agingBucket) chỉ có khi sheet
        // còn cột đó; thiếu thì frontend tự chia mốc từ timingDate (đã có sẵn đường dự phòng).
        timingDate: M.timing >= 0 ? row[M.timing] : "",
        aging: M.aging >= 0 ? row[M.aging] : "",
        agingBucket: (M.bucket >= 0 && row[M.bucket]) ? row[M.bucket].toString().trim() : "",
        att: M.att >= 0 ? row[M.att] : "",
        inboundAt: (M.inbound >= 0 && row[M.inbound] instanceof Date && !isNaN(row[M.inbound]))
          ? Utilities.formatDate(row[M.inbound], 'Asia/Ho_Chi_Minh', "yyyy-MM-dd'T'HH:mm")
          : ''
      };
      // cogs chỉ có khi sheet còn cột này — vắng thì BỎ HẲN field (tiết kiệm dung lượng, và
      // frontend nhận ra "nguồn không có COGS" để ẩn thẻ/hiện "—" thay vì hiện 0 đ sai lệch).
      if (M.cogs >= 0) rec.cogs = row[M.cogs];
      data.push(rec);
      if (hub) hubs.add(hub);
    }
    // [MỚI] Chốt chặn: cột "trạm" phải chứa tên trạm. Nếu hầu hết dòng không có chữ Hub/SOC/Station
    // (VD cột bị lệch, đọc ra trạng thái đơn) thì TỪ CHỐI — giữ bản chụp tốt trước đó và báo lỗi rõ,
    // thay vì xuất bản dữ liệu rác khiến bảng trắng mà không ai biết nguyên nhân.
    if (data.length >= 50) {
      let _okHub = 0;
      for (let k = 0; k < data.length; k++) { if (/hub|soc|station/i.test(data[k].hubName)) _okHub++; }
      // Đo thật: bố cục đúng = 100% dòng có chữ Hub/SOC/Station; đọc nhầm sang cột trạng thái đơn = ~12%
      // (vì có 'LMHub_Received'...). Ngưỡng 60% nằm giữa, chừa biên rộng cho cả hai phía.
      if (_okHub / data.length < 0.6) {
        return JSON.stringify({ success: false, error: 'Cột trạm không chứa tên trạm (' + _okHub + '/' + data.length + ' dòng có chữ Hub/SOC/Station) — sheet nguồn có thể đã đổi bố cục. Giữ nguyên bản chụp trước đó.' });
      }
    }
    return JSON.stringify({ success: true, data, hubs: Array.from(hubs).sort() });
  } catch (e) { return JSON.stringify({ success: false, error: e.message }); }
}

function _aging_getLostDataFromSS(ss) {
  try {
    const sheetLost = ss.getSheetByName('Raw');
    if (!sheetLost || sheetLost.getLastRow() < 1) return JSON.stringify({ success: true, data: [] });
    // [SỬA] Dò cột theo TIÊU ĐỀ đã ghim (xem _spx_pinnedCols_) thay vì cột C/D/F/J/K cố định.
    // Thử lại 1 lần sau vài giây: nguồn ghi đè đẩy dần nên tiêu đề có thể trống thoáng qua.
    let LC = null, lcErr = null;
    for (let attempt = 0; attempt < 2 && !LC; attempt++) {
      try { LC = _aging_lostCols_(sheetLost); } catch (eLc) { lcErr = eLc; if (attempt === 0) Utilities.sleep(4000); }
    }
    if (!LC) {
      // KHÔNG làm hỏng cả bản chụp Quá Hạn (phần LM vẫn đúng): bỏ riêng phần Chốt Lost và BÁO RÕ.
      _spx_setColWarn_('aging:lost_raw', 'Sheet Raw (Chốt Lost) đang bị bỏ qua: ' + (lcErr ? lcErr.message : ''));
      return JSON.stringify({ success: true, data: [], hubs: [], warning: lcErr ? lcErr.message : '' });
    }
    const values = sheetLost.getRange(1, 1, sheetLost.getLastRow(), Math.min(sheetLost.getMaxColumns(), _spx_maxIdx_(LC) + 1)).getValues();
    const data   = [];
    for (let i = 1; i < values.length; i++) {
      if (!values[i][LC.ship]) continue;
      let shipmentId = values[i][LC.ship].toString().trim();
      if (['spx_shipment_id','mã đơn hàng','spx tracking'].includes(shipmentId.toLowerCase())) continue;
      data.push({
        isChotLost: true, lostToday: "", processStatus: values[i][LC.proc] ? values[i][LC.proc].toString() : "",
        aom: "-", sup: "-", shipmentId,
        finalStatus: values[i][LC.status] ? values[i][LC.status].toString() : "",
        hubName: values[i][LC.hub]  ? values[i][LC.hub].toString()  : "",
        aging: "CHỐT LOST",
        cogs: values[i][LC.cogs] ? Number(values[i][LC.cogs]).toLocaleString('vi-VN')+' đ' : "0 đ"
      });
    }
    // Chốt chặn: cột trạm phải chứa tên trạm; nếu không, tiêu đề đã ghim có thể SAI -> bỏ ghim, bỏ phần này.
    if (data.length >= 20) {
      let ok = 0;
      for (let k = 0; k < data.length; k++) { if (/hub|soc|station/i.test(data[k].hubName)) ok++; }
      if (ok / data.length < 0.6) {
        try { PropertiesService.getScriptProperties().deleteProperty('spx_colpin_lost_raw'); } catch (eDp) {}
        const msg = 'Cột trạm của sheet Raw không giống tên trạm (' + ok + '/' + data.length + ') — đã bỏ ghim tiêu đề, phần Chốt Lost tạm bị bỏ qua; chạy spx_diagAllColumns() để kiểm tra.';
        _spx_setColWarn_('aging:lost_raw', msg);
        return JSON.stringify({ success: true, data: [], hubs: [], warning: msg });
      }
    }
    _spx_setColWarn_('aging:lost_raw', null);
    return JSON.stringify({ success: true, data, hubs: [] });
  } catch (e) { return JSON.stringify({ error: e.message }); }
}

/**
 * pick_getFmHighAging()
 * [MỚI — khai thác sheet '2. FM high aging' đang bị bỏ phí]
 * Trả về CHI TIẾT các đơn FirstMile tồn đọng kéo dài, kèm THAO TÁC CẦN XỬ LÝ
 * (cột 'action' — đã xác nhận với nghiệp vụ đây là việc nhân viên trạm phải
 * làm, không phải nhãn phân loại nội bộ).
 *
 * VÌ SAO VIẾT HÀM RIÊNG, KHÔNG SỬA _aging_getFMDataFromSS():
 *   Hàm đó CỐ Ý chỉ đọc 1 cột (shipment_id) để đếm badge — comment tại chỗ ghi
 *   rõ đã giảm ~21 lần lượng dữ liệu sau khi xác nhận "không nơi nào đọc field
 *   cụ thể". Sửa nó sẽ phá tối ưu đó và làm nặng luồng Quá Hạn vốn đã tải
 *   37.336 bản ghi LM. Tách riêng để JS_Pick tự gọi khi cần.
 *
 * CHI PHÍ (đo thật trên file nguồn, không ước lượng):
 *   - Sheet chỉ có 113 dòng dữ liệu (so với 37.336 dòng của LM — nhỏ hơn 330 lần)
 *   - Đọc 113 x 27 = 3.051 ô (LM đọc 672.048 ô)
 *   - Trả về ~28.6 KB = 0.26% payload của LM
 *   => Không ảnh hưởng trần thời gian/dung lượng của Apps Script.
 *
 * CẤU TRÚC SHEET (xác minh trực tiếp):
 *   dòng 1 = ghi chú, dòng 2 (index 1) = TIÊU ĐỀ, dữ liệu từ dòng 3.
 *   [0]shipment_id [1]station_name [8]status_desc [10]pickup_station_name
 *   [12]order_type [13]action [19]timing_day [20]cogs [23]risk level
 */
/**
 * pick_getFmSummary(stationFilter)
 * [MỚI — khai thác sheet 'summary FM realtime' chưa từng được đọc]
 * Trả về số liệu FirstMile tổng hợp sẵn theo 4 GIAI ĐOẠN và 5 LOẠI ĐƠN.
 *
 * VÌ SAO DÙNG SHEET NÀY THAY VÌ TỰ CỘNG TỪ SHEET CHI TIẾT:
 *   Đã đối chiếu toàn diện 2 nguồn, khớp TUYỆT ĐỐI:
 *     - 4 giai đoạn: 102.597 / 22.533 / 1.482 / 9.981 (khớp 100%)
 *     - Cấp từng trạm: 319/319 trạm khớp, không lệch dòng nào
 *     - 5 loại đơn: MP 68.572 · Social 31.923 · Reverse 36.075 · CB 23 · WH 0
 *   => Nội dung KHÔNG mới, nhưng chênh lệch HIỆU NĂNG rất lớn:
 *     - '3. FM action realtime': 136.594 dòng, phải đọc theo lô kèm ngân sách
 *       thời gian, CÓ THỂ ĐỌC KHÔNG HẾT khi hết giờ (xem pick_getLiveFmActions)
 *     - 'summary FM realtime'  : 327 dòng, đọc 1 lần — nhẹ hơn 418 lần, số
 *       liệu chắc chắn đầy đủ, không phụ thuộc ngân sách thời gian.
 *   Dùng sheet tổng hợp cho CON SỐ, giữ sheet chi tiết cho TRA CỨU TỪNG ĐƠN.
 *
 * CẤU TRÚC (xác minh trực tiếp): dòng 2 (index 1) = tiêu đề, dữ liệu từ dòng 3.
 *   Sheet có 2 KHỐI LỒNG NHAU như 'Backlog FM+LM' — 7 dòng đầu là AOM, phần
 *   còn lại (319 dòng) là Hub; cộng riêng mỗi khối đều ra 136.593 (tức trùng
 *   nhau, KHÔNG được cộng cả hai). Phân biệt bằng tên chứa 'Hub'/'SOC'.
 *   [1]AOM/Station [2]Pending Pickup [3]Pending Inbound [4]Pending Packed
 *   [5]Pending Seal [6]MP [7]Social [8]Reverse [9]CB [10]WH
 */
function pick_getFmSummary(stationFilter, scopeStationsJson) {
  try {
    _requireApproved_();

    // [SỬA LỖI THIẾT KẾ — báo cáo trực tiếp kèm ảnh: "chọn trạm cụ thể, level
    // Lead mà ra dữ liệu toàn quốc 319 trạm"] TRƯỚC ĐÂY hàm này KHÔNG kiểm tra
    // phạm vi nào — luôn cộng cả 319 trạm toàn hệ thống cho MỌI cấp. Sai cả
    // nghiệp vụ (Lead cần số của trạm mình, không phải cả nước) lẫn quyền dữ
    // liệu. Áp ĐÚNG cơ chế đã dùng ở qh_getBacklogByStation.
    var email = Session.getActiveUser().getEmail();
    var perm  = checkAnalyticsPermission(email);
    if (!perm || !perm.allowed) return JSON.stringify({ success: false, error: 'Không có quyền truy cập.' });

    var scopeList = null;
    try {
      if (scopeStationsJson) {
        var arr = JSON.parse(scopeStationsJson);
        if (Array.isArray(arr) && arr.length) scopeList = arr;
      }
    } catch (eP) { scopeList = null; }
    // Không truyền scope + không phải Admin -> dùng đúng quyền thật.
    if (!scopeList && !perm.isAdmin) scopeList = perm.stations || [];

    var scopeSet = null;
    if (scopeList && scopeList.length) {
      scopeSet = {};
      scopeList.forEach(function(s){
        var k = String(s || '').trim().toLowerCase();
        if (k) scopeSet[k] = true;
      });
      if (!Object.keys(scopeSet).length) scopeSet = null;
    }

    var want = String(stationFilter || '').trim().toLowerCase();
    var cacheKey = 'pick_fm_summary_v2_' + (want || 'ALL') + '_' +
      (scopeSet ? Utilities.base64EncodeWebSafe(Object.keys(scopeSet).sort().join('|')).slice(0, 60) : 'ALL');
    var cache = CacheService.getScriptCache();
    var hit = cache.get(cacheKey);
    if (hit) return hit;

    var ss = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA');
    var sheet = ss.getSheetByName('summary FM realtime');
    if (!sheet) return JSON.stringify({ success: false, error: "Không thấy sheet 'summary FM realtime'" });

    var lastRow = sheet.getLastRow();
    if (lastRow < 3) return JSON.stringify({ success: true, mine: null, total: null });
    // [SỬA] Dò cột theo TIÊU ĐỀ (dòng 2) — xem _spx_findCols_().
    var _hdrS = sheet.getRange(2, 1, 1, sheet.getLastColumn()).getValues()[0];
    var S = _spx_findCols_(_hdrS, _SPX_SPEC_FMSUM_);
    _spx_requireCols_("Sheet 'summary FM realtime'", S, _SPX_REQ_FMSUM_, _hdrS);
    var values = sheet.getRange(1, 1, lastRow, Math.min(sheet.getMaxColumns(), _spx_maxIdx_(S) + 1)).getValues();

    function emptyAgg() {
      return { pickup: 0, inbound: 0, packed: 0, seal: 0,
               mp: 0, social: 0, reverse: 0, cb: 0, wh: 0, sum: 0 };
    }
    function addRow(agg, row) {
      function n(v) { return (typeof v === 'number') ? v : 0; }
      agg.pickup  += n(row[S.pickup]); agg.inbound += n(row[S.inbound]);
      agg.packed  += n(row[S.packed]); agg.seal    += n(row[S.seal]);
      agg.mp      += n(row[S.mp]); agg.social  += n(row[S.social]);
      agg.reverse += n(row[S.reverse]); agg.cb      += n(row[S.cb]); agg.wh += n(row[S.wh]);
      agg.sum = agg.pickup + agg.inbound + agg.packed + agg.seal;
      return agg;
    }

    var total = emptyAgg();
    var mine = null;
    var nStations = 0;

    for (var i = 2; i < values.length; i++) {
      var nm = values[i][S.name];
      if (!nm || typeof nm !== 'string') continue;
      nm = nm.trim();
      if (!nm || nm === 'Hub') continue;
      // CHỈ lấy khối Hub — khối AOM phía trên là CÙNG dữ liệu gộp lại, cộng cả
      // hai sẽ ra gấp đôi (đã kiểm chứng: mỗi khối đều ra đúng 136.593).
      var up = nm.toUpperCase();
      if (up.indexOf('HUB') < 0 && up.indexOf('SOC') < 0) continue;
      // [SỬA] Chỉ cộng trạm trong phạm vi được phân quyền — xem ghi chú đầu hàm.
      if (scopeSet && !scopeSet[nm.toLowerCase()]) continue;

      addRow(total, values[i]);
      nStations++;
      if (want && nm.toLowerCase() === want) {
        mine = addRow(emptyAgg(), values[i]);
        mine.station = nm;
      }
    }

    var out = JSON.stringify({ success: true, mine: mine, total: total, nStations: nStations, scoped: !!scopeSet });
    // Sheet cập nhật theo lịch (ghi trên chính sheet), cache 15 phút là đủ
    // tươi mà vẫn tránh đọc lặp khi nhiều người cùng mở module.
    try { cache.put(cacheKey, out, 900); } catch (eC) {}
    return out;
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

function pick_getFmHighAging(stationFilter, scopeStationsJson) {
  try {
    _requireApproved_();
    // [SỬA — cùng đợt sửa phạm vi] TRƯỚC ĐÂY chỉ lọc khi có tên trạm cụ thể;
    // nếu người dùng ở chế độ ALL thì trả về đơn của TOÀN HỆ THỐNG. Nay giới
    // hạn theo đúng quyền, giống pick_getFmSummary/qh_getBacklogByStation.
    var _email = Session.getActiveUser().getEmail();
    var _perm  = checkAnalyticsPermission(_email);
    if (!_perm || !_perm.allowed) return JSON.stringify({ success: false, error: 'Không có quyền truy cập.' });

    var _scopeList = null;
    try {
      if (scopeStationsJson) {
        var _arr = JSON.parse(scopeStationsJson);
        if (Array.isArray(_arr) && _arr.length) _scopeList = _arr;
      }
    } catch (eP2) { _scopeList = null; }
    if (!_scopeList && !_perm.isAdmin) _scopeList = _perm.stations || [];

    var scopeSet = null;
    if (_scopeList && _scopeList.length) {
      scopeSet = {};
      _scopeList.forEach(function(s){
        var k = String(s || '').trim().toLowerCase();
        if (k) scopeSet[k] = true;
      });
      if (!Object.keys(scopeSet).length) scopeSet = null;
    }

    var ss = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA');
    var sheet = ss.getSheetByName('2. FM high aging');
    if (!sheet) return JSON.stringify({ success: false, error: "Không thấy sheet '2. FM high aging'" });

    var lastRow = sheet.getLastRow();
    if (lastRow < 3) return JSON.stringify({ success: true, data: [], byAction: {}, byRisk: {} });

    // Đọc tới cột 24 (index 23 = 'risk level') — không đọc thừa 3 cột cuối
    // (kí tự/AOM/SUP) vì AOM/SUP đã có sẵn ở nguồn khác trong hệ thống.
    // [SỬA] Dò cột theo TIÊU ĐỀ (dòng 2) thay vì vị trí cố định — xem _spx_findCols_().
    var _hdrFm = sheet.getRange(2, 1, 1, sheet.getLastColumn()).getValues()[0];
    var F = _spx_findCols_(_hdrFm, _SPX_SPEC_FMHA_);
    _spx_requireCols_("Sheet '2. FM high aging'", F, _SPX_REQ_FMHA_, _hdrFm);
    var _cell = function (r, k) { return F[k] === undefined ? undefined : r[F[k]]; };
    var values = sheet.getRange(2, 1, lastRow - 1, Math.min(sheet.getMaxColumns(), _spx_maxIdx_(F) + 1)).getValues();

    var wantStation = String(stationFilter || '').trim().toLowerCase();
    var data = [], byAction = {}, byRisk = {};

    for (var i = 1; i < values.length; i++) { // i=0 là dòng tiêu đề
      var row = values[i];
      var id = _cell(row, 'id');
      if (!id || String(id).trim() === '') continue;

      var station = _cell(row, 'station') ? String(_cell(row, 'station')).trim() : '';
      // Lọc theo trạm NGAY TẠI BACKEND — tránh gửi cả 113 đơn của toàn hệ
      // thống về client rồi mới lọc bỏ đi.
      if (wantStation && station.toLowerCase() !== wantStation) continue;
      // [SỬA] Kể cả khi không chọn trạm cụ thể (ALL), vẫn phải giới hạn trong
      // phạm vi được phân quyền — xem ghi chú đầu hàm.
      if (scopeSet && !scopeSet[station.toLowerCase()]) continue;

      var action = _cell(row, 'action') ? String(_cell(row, 'action')).trim() : '';
      var risk   = _cell(row, 'risk') ? String(_cell(row, 'risk')).trim() : '';

      if (action) byAction[action] = (byAction[action] || 0) + 1;
      if (risk)   byRisk[risk]     = (byRisk[risk] || 0) + 1;

      data.push({
        id: String(id).trim(),
        station: station,
        action: action,                                          // THAO TÁC CẦN LÀM
        risk: risk,                                              // mức tuổi (2-5 Day, >7 Day...)
        status: _cell(row, 'status') ? String(_cell(row, 'status')).trim() : '',              // status_desc
        pickupStation: _cell(row, 'pickup') ? String(_cell(row, 'pickup')).trim() : '',
        orderType: _cell(row, 'otype') ? String(_cell(row, 'otype')).trim() : '',
        days: (typeof _cell(row, 'days') === 'number') ? _cell(row, 'days') : null,     // timing_day
        cogs: (typeof _cell(row, 'cogs') === 'number') ? _cell(row, 'cogs') : 0
      });
    }

    return JSON.stringify({ success: true, data: data, byAction: byAction, byRisk: byRisk });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

// =========================================================================
// [MỚI — "cấu trúc sheet nguồn đổi (VD cột Trạm từ K sang N) thì không lẽ lại sửa code?"]
// DÒ CỘT THEO TIÊU ĐỀ cho MỌI sheet nguồn thay vì vị trí cố định:
//   - _spx_findCols_()    : tìm cột theo tên tiêu đề (không phân biệt hoa/thường, dấu, khoảng trắng)
//   - _spx_requireCols_() : thiếu cột bắt buộc -> báo LỖI RÕ (nêu cột nào + tiêu đề đang có),
//                           KHÔNG đoán vị trí cũ rồi đọc ra dữ liệu sai âm thầm
//   - _spx_pinnedCols_()  : cho sheet chưa biết chắc tên tiêu đề (VD 'Raw' ở file Lost): lần đầu
//                           "học" tên tiêu đề đang ở các vị trí cũ rồi ghim lại; về sau tìm theo
//                           tên đã ghim -> cột dịch chỗ (K -> N) vẫn đọc đúng.
// Cột chỉ ĐỔI VỊ TRÍ thì code tự theo. Cột bị ĐỔI TÊN / XOÁ thì báo lỗi rõ để sửa 1 chỗ (spec).
// =========================================================================
function _spx_normHdr_(s) {
  return String(s == null ? '' : s).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/đ/g, 'd').replace(/\s+/g, ' ').trim();
}
function _spx_colLetter_(n) {
  var s = ''; n++;
  while (n > 0) { var m = (n - 1) % 26; s = String.fromCharCode(65 + m) + s; n = Math.floor((n - 1) / 26); }
  return s;
}
/** spec: { field: [ 'tên đã chuẩn hoá' | RegExp, ... ] } — thử lần lượt, lấy cột TRÁI NHẤT khớp. opts.from/to giới hạn dải cột. */
function _spx_findCols_(hdr, spec, opts) {
  opts = opts || {};
  var h = hdr || [];
  var from = opts.from || 0, to = (opts.to == null) ? h.length - 1 : Math.min(opts.to, h.length - 1);
  var norm = [];
  for (var c = from; c <= to; c++) norm[c] = _spx_normHdr_(h[c]);
  var out = {};
  Object.keys(spec).forEach(function (f) {
    var cands = spec[f];
    for (var ci = 0; ci < cands.length && out[f] === undefined; ci++) {
      for (var c2 = from; c2 <= to; c2++) {
        if (!norm[c2]) continue;
        var hit = (cands[ci] instanceof RegExp) ? cands[ci].test(norm[c2]) : (norm[c2] === cands[ci]);
        if (hit) { out[f] = c2; break; }
      }
    }
  });
  return out;
}
function _spx_requireCols_(label, found, required, hdr) {
  var miss = required.filter(function (f) { return found[f] === undefined; });
  if (miss.length) {
    var have = (hdr || []).map(function (x) { return String(x == null ? '' : x).trim(); }).filter(String).slice(0, 40).join(' | ');
    throw new Error(label + ': không tìm thấy cột [' + miss.join(', ') + '] theo tiêu đề. Tiêu đề hiện có: ' + have);
  }
}
function _spx_maxIdx_(F) {
  var m = 0; Object.keys(F).forEach(function (k) { if (F[k] > m) m = F[k]; });
  return m;
}
function _spx_pinnedCols_(key, hdr, legacy, nameSpec) {
  var props = PropertiesService.getScriptProperties();
  var propKey = 'spx_colpin_' + key;
  var pinned = {};
  try { pinned = JSON.parse(props.getProperty(propKey) || '{}'); } catch (e0) { pinned = {}; }
  var h = hdr || [];
  var norm = h.map(_spx_normHdr_);
  var out = {}, learned = false, problems = [];
  Object.keys(legacy).forEach(function (f) {
    if (nameSpec && nameSpec[f]) {                       // 1) tên đã biết chắc
      var spec = {}; spec[f] = nameSpec[f];
      var fo = _spx_findCols_(h, spec);
      if (fo[f] !== undefined) { out[f] = fo[f]; return; }
    }
    if (pinned[f]) {                                     // 2) tên đã ghim từ lần trước
      var seen = 0, idx = -1;
      for (var c = 0; c < norm.length; c++) {
        if (norm[c] === pinned[f].h) { if (seen === pinned[f].n) { idx = c; break; } seen++; }
      }
      if (idx >= 0) { out[f] = idx; return; }
      problems.push(f + ' (tiêu đề đã ghim: "' + pinned[f].raw + '")');
      return;
    }
    var li = legacy[f];                                  // 3) chưa ghim: học từ vị trí cũ
    if (norm[li]) {
      var n = 0; for (var c2 = 0; c2 < li; c2++) if (norm[c2] === norm[li]) n++;
      pinned[f] = { h: norm[li], n: n, raw: String(h[li]) };
      learned = true;
    }
    out[f] = li;
  });
  if (problems.length) {
    throw new Error('không tìm thấy các cột đã ghim: ' + problems.join(', ') + '. Tiêu đề hiện có: ' +
      h.map(function (x) { return String(x == null ? '' : x).trim(); }).filter(String).slice(0, 30).join(' | ') +
      '. Nếu chủ ý đổi tên cột, chạy spx_resetColumnAnchors() để học lại.');
  }
  if (learned) { try { props.setProperty(propKey, JSON.stringify(pinned)); } catch (e1) {} }
  return out;
}
var SPX_COLWARN_KEY = 'spx_col_warn_v1';
function _spx_setColWarn_(key, msg) {
  try {
    var p = PropertiesService.getScriptProperties();
    var cur = p.getProperty(SPX_COLWARN_KEY) || '{}';
    var m = {}; try { m = JSON.parse(cur); } catch (e0) { m = {}; }
    if (msg) m[key] = String(msg).slice(0, 300); else delete m[key];
    var s = JSON.stringify(m);
    if (s !== cur) p.setProperty(SPX_COLWARN_KEY, s);
  } catch (e) {}
}
function _spx_getColWarn_(prefix) {
  try {
    var m = JSON.parse(PropertiesService.getScriptProperties().getProperty(SPX_COLWARN_KEY) || '{}');
    return Object.keys(m).filter(function (k) { return !prefix || k.indexOf(prefix) === 0; }).map(function (k) { return m[k]; }).join(' | ');
  } catch (e) { return ''; }
}
// ---- Đặc tả cột từng sheet (tên tiêu đề THẬT, đối chiếu file export) ----
var _SPX_SPEC_FMHA_  = { id: ['shipment_id', 'spx_shipment_id'], station: ['station_name'], status: ['status_desc'],
                         pickup: ['pickup_station_name'], otype: ['order_type'], action: ['action'],
                         days: ['timing_day', 'timing_day(sum)'], cogs: ['cogs', 'cogs(sum)'], risk: ['risk level', 'risk_level'] };
var _SPX_REQ_FMHA_   = ['id', 'station', 'action', 'risk'];
var _SPX_SPEC_FMACT_ = { id: ['shipment_id', 'spx_shipment_id'], station: ['station_name'], created: ['created_time'],
                         last: ['last_touch_at'], status: ['fleet_final_status'], product: ['product_name'],
                         otype: ['order_type'], action: ['action_needed'] };
var _SPX_REQ_FMACT_  = ['id', 'station'];
var _SPX_SPEC_FMSUM_ = { name: ['aom', 'hub'], pickup: [/pending pickup/], inbound: [/pending inbound/], packed: [/pending packed/],
                         seal: [/pending seal/], mp: ['mp'], social: ['social'], reverse: ['reverse'], cb: ['cb'], wh: ['wh'] };
var _SPX_REQ_FMSUM_  = ['name', 'pickup', 'inbound', 'packed', 'seal', 'mp', 'social', 'reverse', 'cb', 'wh'];
var _SPX_SPEC_BKLM_  = { station: ['station'], over7: [/^>\s*7/], d57: [/^5\s*-\s*7/], d25: [/^2\s*-\s*5/],
                         mid: [/^(37h|1)\s*-\s*2/], low: [/^<\s*=?\s*(37h|1)\b/] };
var _SPX_REQ_BKLM_   = ['station', 'over7', 'd57', 'd25', 'mid', 'low'];
var _SPX_LOST_LEGACY_ = { ship: 2, proc: 3, hub: 5, cogs: 9, status: 10 };
function _aging_lostCols_(sheet) {
  var nc = Math.min(sheet.getMaxColumns(), Math.max(sheet.getLastColumn(), 11));
  var hdr = sheet.getRange(1, 1, 1, nc).getValues()[0];
  return _spx_pinnedCols_('lost_raw', hdr, _SPX_LOST_LEGACY_, { ship: ['spx_shipment_id', 'ma don hang', 'spx tracking'] });
}

function _aging_getFMDataFromSS(ss) {
  try {
    // [FIX 2026-07] Sheet thật tên '2. FM high aging' (đã đổi cấu trúc cột nhưng GIỮ
    // NGUYÊN thứ tự cột cũ — xem mapping row[] bên dưới, đã đối chiếu khớp với sheet
    // thật). Trước đây code tìm sheet tên 'FM realtime' — sheet này không tồn tại
    // (đã đổi tên/không còn dùng), khiến getSheetByName() trả về null và toàn bộ
    // luồng aging_getMasterData() (nguồn dữ liệu chính của Module Quá Hạn, tab Hàng
    // Lấy) bị lỗi "Không thấy sheet FM realtime", không trả được dữ liệu nào.
    const sheet = ss.getSheetByName('2. FM high aging');
    if (!sheet) return JSON.stringify({ success: false, error: "Không thấy sheet '2. FM high aging'" });
    const lastRow = sheet.getLastRow();
    if (lastRow < 3) return JSON.stringify({ success: true, count: 0 });
    // [FIX 2026-07-30] Trước đây đọc TOÀN BỘ 21 cột rồi dựng object 9 field/dòng —
    // nhưng đối chiếu kỹ index.html + JS_FMS.html + aging_getMasterData() xác nhận
    // KHÔNG NƠI NÀO đọc field cụ thể, chỉ dùng .length (đếm badge). Giờ chỉ đọc
    // ĐÚNG cột A (shipment_id, để giữ nguyên điều kiện "dòng có id mới tính") —
    // giảm ~21 lần lượng dữ liệu tải về cho đúng phần dữ liệu này, không đổi kết
    // quả trả về (aging_getMasterData() vẫn tự dựng lại đúng số lượng object rỗng
    // như cũ dựa trên count này).
    // [SỬA] Dò cột mã đơn theo TIÊU ĐỀ (dòng 2). Đồng thời sửa lỗi lệch 1: trước đây đọc từ dòng 2 —
    // chính là dòng TIÊU ĐỀ ('shipment_id') — nên badge đếm dư 1; dữ liệu thật bắt đầu từ dòng 3.
    const _hdrCnt = sheet.getRange(2, 1, 1, sheet.getLastColumn()).getValues()[0];
    const _Fc = _spx_findCols_(_hdrCnt, { id: _SPX_SPEC_FMHA_.id });
    _spx_requireCols_("Sheet '2. FM high aging'", _Fc, ['id'], _hdrCnt);
    const idCol = sheet.getRange(3, _Fc.id + 1, lastRow - 2, 1).getValues();
    let count = 0;
    for (let i = 0; i < idCol.length; i++) { if (idCol[i][0]) count++; }
    return JSON.stringify({ success: true, count: count });
  } catch (e) { return JSON.stringify({ success: false, error: e.message }); }
}

// [OPT] Cache wrapper cho notes — TTL 600s (10 phút), cache key cố định.
// Không truyền activeIds vào để tránh dọn orphan trong cold path chính.
// Orphan sẽ được dọn bởi trigger aging_orphanCleanup() chạy riêng (mỗi 6h).
// Cache bị xóa chủ động trong aging_saveNote() → data vẫn near-realtime.
function _aging_getNotesWithCache(ss, activeIds) {
  const sc        = CacheService.getScriptCache();
  const NOTES_KEY = 'aging_notes_v2';
  const NOTES_TTL = 600; // 10 phút

  try {
    const cached = sc.get(NOTES_KEY);
    if (cached) return cached; // cache hit — không mở ssNote
  } catch(ce) {}

  // Cache miss — đọc sheet thật, NHƯNG không dọn orphan (tránh clearContents trong cold path)
  const result = _aging_getNotesFromSS(ss, null); // null = không dọn orphan
  try { sc.put(NOTES_KEY, result, NOTES_TTL); } catch(ce) {}
  return result;
}

// Invalidate notes cache — gọi sau mỗi write operation
function _aging_invalidateNotesCache() {
  try { CacheService.getScriptCache().remove('aging_notes_v2'); } catch(e) {}
}

function _aging_getNotesFromSS(ss, activeIds) {
  try {
    const sheet = ss.getSheetByName('App_Notes');
    if (!sheet) return JSON.stringify({ success: true, notes: {} });
    const data  = sheet.getDataRange().getDisplayValues();

    var notesDict = {};
    var keepRows  = [];   // rows được giữ lại sau khi dọn orphan
    var hasOrphan = false;

    for (var i = 0; i < data.length; i++) {
      var id = data[i][0].toString().trim();

      // Giữ nguyên header row
      if (!id || id.toUpperCase() === 'TRACKING ID' || id.toUpperCase() === 'MÃ ĐƠN HÀNG') {
        keepRows.push(data[i]);
        continue;
      }

      // Nếu có activeIds và mã đơn KHÔNG còn trong data → orphan, bỏ qua (xóa)
      if (activeIds && activeIds.size > 0 && !activeIds.has(id)) {
        hasOrphan = true;
        _LOG.d('[Notes] Xóa note orphan: ' + id);
        continue;
      }

      notesDict[id] = { text: data[i][1], user: data[i][2], time: data[i][3] };
      keepRows.push(data[i]);
    }

    // Chỉ ghi lại sheet khi thực sự có orphan bị dọn (tránh write thừa)
    if (hasOrphan) {
      // [FIX NGHẼN LOCK 2026-07-24] Dùng CHUNG named lock 'aging_notes_write_lock_v1'
      // với aging_saveNote() (cùng ghi sheet App_Notes) — không còn kéo cả hệ thống chờ.
      if (_anaAcquireNamedLock('aging_notes_write_lock_v1', 8000, 15000)) {
        try {
          // [SỬA — cùng lỗi đã phát hiện và sửa ở phần archive đơn hàng:
          // clearContents() TOÀN BỘ sheet RỒI MỚI ghi lại — nếu bị ngắt giữa
          // chừng (lock timeout, lỗi API tạm thời) thì mất trắng toàn bộ ghi
          // chú (kể cả header), không còn ở đâu khôi phục. Đảo thứ tự: ghi
          // keepRows TRƯỚC (đè đúng vị trí cũ, kể cả header vì header đã nằm
          // sẵn trong keepRows[0]), rồi mới dọn phần dư phía dưới.
          if (keepRows.length > 0) {
            sheet.getRange(1, 1, keepRows.length, keepRows[0].length).setValues(keepRows);
          }
          if (keepRows.length < data.length) {
            sheet.getRange(1 + keepRows.length, 1, data.length - keepRows.length, keepRows[0].length).clearContent();
          }
        } catch(le) { _LOG.d('[Notes] Lock error khi dọn orphan: ' + le.message); }
        finally { _anaReleaseNamedLock('aging_notes_write_lock_v1'); }
      }
    }

    return JSON.stringify({ success: true, notes: notesDict });
  } catch (e) { return JSON.stringify({ success: false, error: e.message }); }
}

/**
 * rq_getIndexSummary()
 * [MỚI — theo yêu cầu "Tổng quan phải trả lời được khu vực này đang có vấn đề
 * gì NGAY TỪ ĐẦU, không đợi user tự mở module"] Trước đây số liệu "đơn Đỏ khẩn
 * cấp" CHỈ có sau khi user tự mở Đơn cầu cứu (đọc window.RQ_allOrders, biến
 * do CHÍNH module đó tạo ra khi tải — module này KHÔNG được tải nền vì "ít
 * dùng hơn"). Hàm này tái dùng ĐÚNG các hàm nội bộ đã có sẵn trong getOrders()
 * thật (fetchOrderRows_/filterRowsForStations_/computeUrgencyLevel_/
 * getResolvedOrdersAndCleanup_) — KHÔNG viết lại công thức tính urgency, chỉ
 * gọi lại để có SỐ THẬT ngay từ Tổng quan, độc lập với việc module đã tải hay
 * chưa. Nhẹ hơn getOrders() thật — bỏ qua phần mail/trend không cần cho mục
 * đích chỉ đếm số.
 */
function rq_getIndexSummary(overrideHub) {
  try {
    var access = getCurrentUserAccess_();
    if (!access.email || access.role === 'UNAUTHORIZED') {
      return JSON.stringify({ success: false, redCount: 0 });
    }
    var fetched = fetchOrderRows_();
    // [MỚI — theo yêu cầu trực tiếp "Tổng quan không đổi theo level"] Chỉ khi
    // thật sự ADMIN (unrestricted) mới cho phép overrideHub — không phải lỗ
    // hổng cho AOM/SUP lách qua để xem hub ngoài quyền của họ.
    var rows;
    // [SỬA — cùng lỗi với các thẻ khác] Người dùng thường cũng được lọc theo
    // trạm đang chọn, NHƯNG chỉ khi trạm đó nằm trong tập được phép
    // (access.stations) — thu hẹp, không vượt quyền.
    // [SỬA — hỗ trợ nhiều trạm] Xem thử cấp SUP/AOM/ROM truyền DANH SÁCH trạm.
    // Mọi trạm trong danh sách đều phải nằm trong phạm vi được phép, nếu không thì
    // bỏ qua toàn bộ (không hạ thấp yêu cầu quyền chỉ vì có nhiều trạm).
    var _rqSc = _spxScopeHubs_(overrideHub);
    var _rqKeys = Object.keys(_rqSc.keys);
    var _rqOvOk = _rqKeys.length > 0 && (access.unrestricted ||
      (access.stations && typeof access.stations.has === 'function' &&
       _rqKeys.every(function (k) { return access.stations.has(k); })));
    if (_rqOvOk) {
      rows = filterRowsForStations_(fetched.rows, new Set(_rqKeys));
    } else {
      rows = access.unrestricted ? fetched.rows : filterRowsForStations_(fetched.rows, access.stations);
    }
    var resolvedList = [];
    try { resolvedList = getResolvedOrdersAndCleanup_(fetched.rows); } catch (eRes) {}
    var resolvedSet = {};
    resolvedList.forEach(function (t) { resolvedSet[t] = true; });
    var now = new Date();
    var redCount = 0;
    rows.forEach(function (r) {
      if (resolvedSet[r.tracking_no]) return; // đã xử lý — không tính
      if (computeUrgencyLevel_(r.export_date, now) === 'red') redCount++;
    });
    return JSON.stringify({ success: true, redCount: redCount, totalCount: rows.length });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message, redCount: 0 });
  }
}

/**
 * vp_getIndexSummary()
 * [MỚI — cùng mục đích với rq_getIndexSummary() ở trên, áp dụng cho Vi phạm]
 * Tái dùng THẲNG getComplaintData(false) thật (đã có sẵn đầy đủ logic lọc
 * quyền + cache) — chỉ đếm thêm số case chưa gắn ticket_no, không viết lại
 * bất kỳ logic đọc/lọc dữ liệu nào.
 */
function vp_getIndexSummary(overrideHub) {
  // [SỬA — chẩn đoán "Tổng quan tải rất lâu": Vi phạm đo được 30-42 giây, KỂ CẢ
  // lần tải thứ hai] Hàm này phụ thuộc bộ nhớ đệm DỮ LIỆU THÔ (~20.000 dòng,
  // ~9MB, chia ~90 khúc) — không chắc lưu được (dung lượng tổng lớn, sát giới
  // hạn 100KB/khúc với tiếng Việt có dấu), nên thực tế gần như lần nào cũng đọc
  // lại cả sheet. Tổng quan chỉ cần 2 CON SỐ -> lưu thẳng kết quả tóm tắt (vài
  // chục byte, chắc chắn lưu được) theo đúng phạm vi quyền + trạm đang chọn.
  var _vpCk = '';
  try {
    var _vpA = getUserAccess();   // đã có bộ nhớ đệm 5 phút
    var _vpScope = (_vpA && _vpA.viewAll) ? 'ALL'
                 : ((_vpA && _vpA.allowedHubs) || []).map(function (h) { return normStationKey_(h); }).sort().join('~');
    // [SỬA — hỗ trợ nhiều trạm] Khoá đệm phải phản ánh ĐÚNG tập trạm, nếu không
    // kết quả của 1 trạm sẽ bị dùng lại cho cả nhóm trạm (và ngược lại).
    var _vpScopeHubs = _spxScopeHubs_(overrideHub);
    _vpCk = _spxSafeCacheKey_('vp_idx_v1_' + _vpScope + '_' + (_vpScopeHubs.empty ? 'ALL' : _vpScopeHubs.cacheKey()) + '_s' + _spxSrcStamp_(DATA_SPREADSHEET_ID));
    var _vpHit = _SPX_OV_FORCE_ ? null : CacheService.getScriptCache().get(_vpCk);
    if (_vpHit) { try { var _vh = JSON.parse(_vpHit); _vh._cacheHit = true; return JSON.stringify(_vh); } catch (eVh) { return _vpHit; } }
  } catch (eVc) { _vpCk = ''; }
  var _vpOut = _vpGetIndexSummaryUncached_(overrideHub);
  try {
    if (_vpCk && _vpOut && _vpOut.indexOf('"success":true') >= 0) {
      CacheService.getScriptCache().put(_vpCk, _vpOut, 600);   // 10 phút
    }
  } catch (eVp) {}
  return _vpOut;
}

function _vpGetIndexSummaryUncached_(overrideHub) {
  try {
    var rows = getComplaintData(!!_SPX_OV_FORCE_);   // force (Làm mới / có bản mới) -> đọc lại sheet thay vì dùng cache thô
    if (rows && rows.error) return JSON.stringify({ success: false, noTicketCount: 0 });
    // [MỚI — theo yêu cầu trực tiếp "Tổng quan không đổi theo level"] Lọc
    // thêm 1 lớp SAU khi đã có kết quả — an toàn hơn sửa sâu vào
    // getComplaintData() (hàm dùng chung phức tạp, có cache riêng). Chỉ Admin
    // thật (viewAll) mới dùng được overrideHub — không phải lỗ hổng cho AOM/
    // SUP lách qua để xem hub ngoài quyền của họ.
    // [SỬA LỖI THẬT — báo cáo: Tổng quan hiện "Vi phạm 20.118 vụ" trong khi
    // module Vi phạm của đúng trạm đó chỉ có 182 vụ]
    // TRƯỚC ĐÂY chỉ ADMIN mới được lọc theo trạm đang chọn ở header. Người dùng
    // khác nhận NGUYÊN phạm vi quyền (VD cả khu vực AOM) -> Tổng quan hiện tổng
    // nhiều trạm dù header đang chọn đúng 1 trạm.
    // Chặn người thường lọc là KHÔNG CẦN: getComplaintData() đã giới hạn theo
    // quyền TRƯỚC bước này, nên lọc thêm theo 1 trạm chỉ THU HẸP tập đã được
    // phép — không thể dùng để xem trạm ngoài quyền. An toàn cho mọi cấp.
    if (overrideHub) {
      try {
        var _vpSc = _spxScopeHubs_(overrideHub);
        rows = (rows || []).filter(function (r) { return _vpSc.has(r.station_name); });
      } catch (eVpAcc) {}
    }
    var noTicketCount = 0;
    (rows || []).forEach(function (r) { if (!r.ticket_no) noTicketCount++; });
    return JSON.stringify({ success: true, noTicketCount: noTicketCount, totalCount: (rows || []).length });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message, noTicketCount: 0 });
  }
}

/**
 * rp_getIndexSummary()
 * [MỚI — hoàn thành yêu cầu "Rider Plan cũng phải cần" trong Tổng quan] Đếm số
 * trạm CHƯA NHẬP Inbound hôm nay — tái dùng THẲNG loadRiderPlan()/
 * getCurrentUserAccess()/_rp_getAllHubsFromSA() đã có sẵn, không viết lại bất
 * kỳ logic đọc sheet nào. Mẫu số PHẢI lấy từ access.hubs/_rp_getAllHubsFromSA()
 * (toàn bộ trạm được phân quyền) — KHÔNG lấy từ Object.keys(kết quả trả về),
 * vì trạm CHƯA TỪNG nhập gì sẽ KHÔNG có dòng nào trong sheet Rider_Plan cả,
 * đếm theo cách đó sẽ bỏ sót đúng những trạm cần cảnh báo nhất. Ngày "hôm nay"
 * ép cứng Asia/Ho_Chi_Minh — cùng kỹ thuật _rp_currentMonth() đã dùng để tránh
 * lặp lại đúng lỗi lệch timezone đã từng sửa trong chính module này.
 */
function rp_getIndexSummary(overrideHub) {
  try {
    var access = getCurrentUserAccess();
    if (access.role === 'denied') return JSON.stringify({ success: false, missingCount: 0 });
    var monthStr = _rp_currentMonth();
    var planRes = loadRiderPlan(monthStr, access, overrideHub);
    if (!planRes.success) return JSON.stringify({ success: false, missingCount: 0 });
    // [MỚI — theo yêu cầu trực tiếp "Tổng quan không đổi theo level"] Khi có
    // overrideHub hợp lệ (chỉ Admin), mẫu số cũng phải thu hẹp về đúng 1 Hub
    // đó — giữ nguyên hành vi cũ (toàn bộ hub) khi không preview.
    // [SỬA LỖI THẬT — cùng lỗi với Vi phạm] Trước đây chỉ ADMIN mới lọc theo
    // trạm đang chọn ở header; người khác nhận nguyên phạm vi quyền. Lọc thêm
    // theo 1 trạm chỉ THU HẸP tập đã được phép -> an toàn cho mọi cấp. Vẫn kiểm
    // tra trạm đó nằm trong quyền để không ai lọc ra trạm ngoài phạm vi.
    // [SỬA HỒI QUY do chính lượt trước gây ra] Bản trước LUÔN đọc toàn bộ danh
    // sách trạm của Admin (_rp_getAllHubsFromSA — đọc sheet tổ chức) kể cả khi
    // đã chọn sẵn 1 trạm -> thêm 1 lượt đọc sheet thừa mỗi lần tải Tổng quan.
    // Nay chỉ đọc khi thật sự cần: Admin + KHÔNG chọn trạm cụ thể.
    var isAdm = (access.role === 'admin');
    var allHubs;
    if (overrideHub) {
      // [SỬA — hỗ trợ nhiều trạm] Xem thử cấp SUP/AOM/ROM gửi DANH SÁCH trạm.
      var _rpSc = _spxScopeHubs_(overrideHub);
      var _inScope = isAdm || _rpSc.list.every(function (oh) {
        return (access.hubs || []).some(function (h) {
          return String(h).trim().toLowerCase() === String(oh).trim().toLowerCase();
        });
      });
      allHubs = _inScope ? _rpSc.list.slice() : (isAdm ? _rp_getAllHubsFromSA() : (access.hubs || []));
    } else {
      allHubs = isAdm ? _rp_getAllHubsFromSA() : (access.hubs || []);
    }
    var todayIdx = parseInt(Utilities.formatDate(new Date(), 'Asia/Ho_Chi_Minh', 'd'), 10) - 1; // mảng 31 phần tử theo ngày
    var missingCount = 0;
    allHubs.forEach(function (hub) {
      var m = planRes.data[hub];
      var val = (m && m['Inbound TT']) ? m['Inbound TT'][todayIdx] : null;
      if (val === null || val === undefined || !(val > 0)) missingCount++;
    });

    // [MỚI — theo yêu cầu trực tiếp: "quản lý 1 trạm thì hiện 0 trạm làm gì?"]
    // Với ĐÚNG 1 trạm, đếm "số trạm chưa nhập" là vô nghĩa (chỉ ra 0 hoặc 1).
    // Trả thêm CHỈ SỐ THẬT của trạm hôm nay để thẻ Tổng quan hiện thứ hữu ích:
    // Inbound thực tế so với dự báo (FC) và số rider — đúng các con số người
    // quản trạm nhìn hằng ngày trong Rider Plan.
    var single = null;
    if (allHubs.length === 1) {
      var _m1 = planRes.data[allHubs[0]] || {};
      var _pick = function (k) {
        var arr = _m1[k];
        var v = (arr && arr.length > todayIdx) ? arr[todayIdx] : null;
        return (typeof v === 'number' && isFinite(v)) ? v : null;
      };
      var inb = _pick('Inbound TT'), fc = _pick('FC LM');
      single = {
        hub:       allHubs[0],
        inbound:   inb,
        fc:        fc,
        pct:       (inb != null && fc) ? Math.round(inb / fc * 100) : null,
        riders:    _pick('Rider TT'),
        ridersFc:  _pick('Riders FC'),
        entered:   !!(inb && inb > 0)
      };
    }
    return JSON.stringify({ success: true, missingCount: missingCount, totalCount: allHubs.length, single: single });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message, missingCount: 0 });
  }
}

/**
 * _spxSafeCacheKey_(key)
 * [MỚI — nguyên nhân thật của "Tổng quan tải rất lâu" với AOM/ROM]
 * CacheService của Apps Script giới hạn khoá TỐI ĐA 250 KÝ TỰ. Một số khoá
 * được ghép từ tên TOÀN BỘ trạm người dùng quản — đo thật: 40 trạm = 665 ký tự,
 * toàn vùng 383 trạm = 6.543 ký tự. Vượt giới hạn -> lệnh lưu ném lỗi, bị
 * try/catch nuốt im lặng -> KHÔNG BAO GIỜ có bộ nhớ đệm -> mỗi lần mở Tổng quan
 * đều đọc lại ~37.000 dòng (đo được 23-47 giây).
 * Admin không bị vì khoá của Admin chỉ là chữ 'ADMIN' ngắn.
 * Cách sửa: khoá dài thì thay phần đuôi bằng mã băm MD5 (cố định với cùng đầu
 * vào -> cùng phạm vi luôn ra cùng khoá, bộ nhớ đệm dùng lại được). Cùng ý
 * tưởng với _kpifail_scopeKey_() vốn đã làm đúng ở chỗ khác.
 */
function _spxSafeCacheKey_(key) {
  key = String(key == null ? '' : key);
  if (key.length <= 200) return key;
  try {
    var d = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, key, Utilities.Charset.UTF_8);
    var hex = d.map(function (b) { var v = (b < 0 ? b + 256 : b).toString(16); return v.length === 1 ? '0' + v : v; }).join('');
    return key.substring(0, 60).replace(/[^A-Za-z0-9_]/g, '_') + '_h' + hex;
  } catch (e) {
    var h = 0;
    for (var i = 0; i < key.length; i++) { h = ((h << 5) - h + key.charCodeAt(i)) | 0; }
    return key.substring(0, 60).replace(/[^A-Za-z0-9_]/g, '_') + '_j' + (h >>> 0).toString(36) + '_' + key.length;
  }
}

/**
 * spx_diagOverdueLost() — CHẠY THỦ CÔNG (chọn hàm rồi bấm Run).
 * [MỚI — báo cáo: "Tổng quan hiện 1 đơn quá hạn/chốt Lost nhưng mở module tìm
 * không ra"] Liệt kê ĐÚNG những đơn đang bị đếm, kèm giá trị cờ trên cột A của
 * file nguồn — để biết đơn đó là gì và vì sao module không hiện.
 * Đổi trạm cần tra ở SPX_DIAG_HUB bên dưới (để trống = mọi trạm trong quyền).
 */
var SPX_DIAG_HUB = '45-DLK Buon Ho Hub';

/**
 * spx_diagFindOrders() — CHẠY THỦ CÔNG (chọn hàm rồi bấm Run).
 * [MỚI — báo cáo: "UI hiện 2 đơn tồn >7 ngày nhưng tra file nguồn không có"]
 * Tra thẳng các mã đơn trong CẢ HAI nguồn thật (sheet tồn đọng và file đã chốt
 * Lost) tại thời điểm chạy — để phân biệt "dữ liệu ảo do bản tạm cũ trong trình
 * duyệt" với "đơn có thật mà tra sót".
 * Sửa danh sách mã cần tra ở SPX_DIAG_ORDERS bên dưới.
 */
var SPX_DIAG_ORDERS = ['SPXVN061367448829', 'SPXVN060001521429'];

function spx_diagFindOrders() {
  var want = {};
  SPX_DIAG_ORDERS.forEach(function (x) { var k = String(x || '').trim().toUpperCase(); if (k) want[k] = { maDon: k, trongSheetTonDong: null, trongFileLost: null }; });
  if (!Object.keys(want).length) return 'Chưa nhập mã đơn nào ở SPX_DIAG_ORDERS.';
  try {
    var sh = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA').getSheetByName('1. LM high aging');
    if (sh && sh.getLastRow() >= 3) {
      var _nc = Math.min(sh.getMaxColumns(), Math.max(sh.getLastColumn(), 18));
      var _M = _aging_lmColumnMap_(sh.getRange(2, 1, 1, _nc).getValues()[0]);
      var v = sh.getRange(3, 1, sh.getLastRow() - 2, _nc).getValues();
      for (var i = 0; i < v.length; i++) {
        var id = v[i][_M.ship] ? String(v[i][_M.ship]).trim().toUpperCase() : '';
        if (id && want[id]) {
          want[id].trongSheetTonDong = { dong: i + 3, tram: String(v[i][_M.hub] || ''), nhomTon: String(_M.bucket >= 0 ? (v[i][_M.bucket] || '') : ''), soNgayTon: (_M.aging >= 0 ? v[i][_M.aging] : ''), trangThai: String(v[i][_M.proc] || ''), coLostToday: String(v[i][_M.lost] || '') };
        }
      }
    }
  } catch (e) { return 'Lỗi đọc sheet tồn đọng: ' + e.message; }
  try {
    var shL = _DS.ss('1vvOZG80Rz5PTNPFsbHzmUMPkPaAkGOY70nDHBwfzjQE').getSheetByName('Raw');
    if (shL && shL.getLastRow() >= 2) {
      var _lc1 = null; try { _lc1 = _aging_lostCols_(shL); } catch (eLc3) { _lc1 = _SPX_LOST_LEGACY_; }
      var vl = shL.getRange(1, 1, shL.getLastRow(), Math.min(shL.getMaxColumns(), _spx_maxIdx_(_lc1) + 1)).getValues();
      for (var k = 1; k < vl.length; k++) {
        var idL = vl[k][_lc1.ship] ? String(vl[k][_lc1.ship]).trim().toUpperCase() : '';
        if (idL && want[idL]) want[idL].trongFileLost = { dong: k + 1, tram: String(vl[k][_lc1.hub] || '') };
      }
    }
  } catch (e) { /* file Lost lỗi -> vẫn trả phần đã tra được */ }
  var out = { thoiDiemTra: Utilities.formatDate(new Date(), 'Asia/Ho_Chi_Minh', 'yyyy-MM-dd HH:mm:ss'), ketQua: [] };
  Object.keys(want).forEach(function (k) {
    var r = want[k];
    r.ketLuan = (!r.trongSheetTonDong && !r.trongFileLost)
      ? 'KHÔNG có trong cả 2 nguồn -> đơn hiện trên màn hình là DỮ LIỆU CŨ trong trình duyệt, cần tải lại (Ctrl+Shift+R).'
      : (r.trongSheetTonDong ? 'Có thật trong sheet tồn đọng.' : 'Chỉ có trong file đã chốt Lost.');
    out.ketQua.push(r);
  });
  Logger.log(JSON.stringify(out, null, 2));
  return JSON.stringify(out, null, 2);
}

/**
 * spx_diagKpiFailHealth() — CHẠY THỦ CÔNG để kiểm tra KPI Fail sau khi triển khai (hoặc khi nghi số liệu thiếu).
 * Cho biết: bản lưu đã có VÂN TAY chưa, mốc dòng đã đọc so với số dòng nguồn hiện tại, nguồn có bị ghi lại
 * (trượt cửa sổ) không, lần đọc-lại-đầy-đủ gần nhất, và cảnh báo cột.
 */
function spx_diagKpiFailHealth() {
  var out = { canhBao: [] };
  var warn = function (m) { out.canhBao.push(m); };
  var ss = _DS.ss(KPIFAIL_SS_ID);
  var snap = null;
  try { snap = _kpifail_readPersistentSnapshot_(); } catch (e) { warn('Không đọc được bản lưu: ' + e.message); }
  if (!snap) { out.ketLuan = 'Chưa có bản lưu KPI Fail.'; return JSON.stringify(out, null, 2); }
  var cur = _kpifail_getSourceRowCounts_(ss);
  var prev = { FM: snap.lastRowFM || 0, LM: snap.lastRowLM || 0, SOP: snap.lastRowSOP || 0 };
  out.banLuu = { soBanGhi: (snap.records || []).length, ngayMoiNhat: snap.maxDate || '', phienBanDuLieu: _kpifail_dataVersionString_() };
  out.soDong = { daDoc: prev, nguonHienTai: cur };
  out.vanTay = snap.fp ? 'ĐÃ có' : 'CHƯA có (sẽ đọc gộp một lần ở lượt làm mới kế tiếp để lấy mốc chuẩn)';
  var chk = { rewritten: false };
  try { chk = _kpifail_sourceRewritten_(ss, snap, prev); } catch (e2) { warn('Không đối soát được vân tay: ' + e2.message); }
  out.nguonBiGhiLai = chk.rewritten ? ('CÓ — ' + chk.why) : 'Không';
  var lastFp = Number(PropertiesService.getScriptProperties().getProperty('kpifail_fp_rebuild_at') || 0);
  out.lanDocLaiDayDuDoVanTayGanNhat = lastFp ? Utilities.formatDate(new Date(lastFp), 'Asia/Ho_Chi_Minh', 'yyyy-MM-dd HH:mm:ss') : '(chưa có)';
  ['FM', 'LM', 'SOP'].forEach(function (k) { if (cur[k] > prev[k]) warn(k + ': nguồn còn ' + (cur[k] - prev[k]) + ' dòng chưa đọc (đang đọc dở hoặc đợi lượt làm mới).'); });
  if (chk.rewritten && snap.fp) warn('Nguồn đã đổi vị trí dòng — lượt làm mới kế tiếp sẽ đọc lại đầy đủ và gộp (tối đa 1 lần / 20 phút).');
  var cw = _spx_getColWarn_('kpifail:'); if (cw) warn('Cảnh báo cột: ' + cw);
  out.ketLuan = out.canhBao.length ? 'CÓ ' + out.canhBao.length + ' ĐIỂM CẦN XEM — đọc mục canhBao.' : 'Bản lưu khớp nguồn.';
  Logger.log(JSON.stringify(out, null, 2));
  return JSON.stringify(out, null, 2);
}

/**
 * spx_diagTimezone() — CHẠY THỦ CÔNG để xác nhận MÚI GIỜ của dự án và của TỪNG file nguồn đều là giờ Việt Nam.
 * Múi giờ file nguồn quan trọng: ô ngày-giờ đọc từ sheet là thời điểm tính theo múi giờ CỦA FILE ĐÓ; file đặt sai
 * múi giờ thì ngày/giờ các đơn sát nửa đêm bị lệch sang ngày khác.
 */
function spx_diagTimezone() {
  // [SỬA] So theo ĐỘ LỆCH SO VỚI UTC, không so tên múi giờ: Asia/Bangkok (và Asia/Jakarta, Asia/Phnom_Penh...) cũng là UTC+7
  // quanh năm, không có giờ mùa hè -> cho kết quả ngày giờ GIỐNG HỆT giờ Việt Nam, không cần đổi. Chỉ cảnh báo khi lệch thật
  // (độ lệch khác +0700 ở BẤT KỲ mùa nào, kể cả múi giờ có giờ mùa hè).
  var isUtc7 = function (tz) {
    try {
      return Utilities.formatDate(new Date(Date.UTC(2026, 0, 15, 12)), tz, 'Z') === '+0700' &&
             Utilities.formatDate(new Date(Date.UTC(2026, 6, 15, 12)), tz, 'Z') === '+0700';
    } catch (e) { return false; }
  };
  var out = { canhBao: [] };
  var warn = function (m) { out.canhBao.push(m); };
  var scriptTz = Session.getScriptTimeZone();
  out.duAn = { muiGioDuAn: scriptTz, mong_doi: SPX_TZ, bayGioTheoGioVN: Utilities.formatDate(new Date(), SPX_TZ, 'yyyy-MM-dd HH:mm:ss'),
               bayGioTheoMuiGioDuAn: Utilities.formatDate(new Date(), scriptTz, 'yyyy-MM-dd HH:mm:ss') };
  out.duAn.laUTC7 = isUtc7(scriptTz);
  if (!out.duAn.laUTC7) warn('Múi giờ DỰ ÁN là "' + scriptTz + '" (KHÔNG phải UTC+7) — nên đặt Asia/Ho_Chi_Minh (Project Settings → Time zone) để trigger/ngày giờ mặc định khớp. Code đã dùng SPX_TZ tường minh ở các chỗ quan trọng.');
  var ids = {
    'Báo cáo Backlog (LM/FM)': typeof PICK_LIVE_SS_ID !== 'undefined' ? PICK_LIVE_SS_ID : null,
    'KPI Fail': typeof KPIFAIL_SS_ID !== 'undefined' ? KPIFAIL_SS_ID : null,
    'FMS Live': typeof FMS_LIVE_SHEET_ID !== 'undefined' ? FMS_LIVE_SHEET_ID : null,
    'Khiếu nại (CXL)': typeof DATA_SPREADSHEET_ID !== 'undefined' ? DATA_SPREADSHEET_ID : null,
    'Admin DB': typeof ADMIN_DB_ID !== 'undefined' ? ADMIN_DB_ID : null,
    'Master DB': typeof MASTER_DB_ID !== 'undefined' ? MASTER_DB_ID : null,
    'Tra cứu': typeof TRACUU_SHEET_ID !== 'undefined' ? TRACUU_SHEET_ID : null,
    'Phân quyền / Rider': typeof RP_SOURCE_ID !== 'undefined' ? RP_SOURCE_ID : null,
    'File Lost': '1vvOZG80Rz5PTNPFsbHzmUMPkPaAkGOY70nDHBwfzjQE'
  };
  out.fileNguon = {};
  Object.keys(ids).forEach(function (k) {
    if (!ids[k]) { out.fileNguon[k] = '(không có ID)'; return; }
    try {
      var tz = SpreadsheetApp.openById(ids[k]).getSpreadsheetTimeZone();
      var ok = isUtc7(tz);
      out.fileNguon[k] = tz + (ok ? (tz === 'Asia/Ho_Chi_Minh' || tz === 'Asia/Saigon' ? '  ✓' : '  ✓ (UTC+7, cùng giờ VN)') : '  ✗ LỆCH GIỜ VN');
      if (!ok) warn('File "' + k + '" đặt múi giờ "' + tz + '" — KHÁC UTC+7. Đổi trong File → Settings → Time zone sang Asia/Ho_Chi_Minh (nếu bạn là chủ file) để ngày giờ không lệch.');
    } catch (e) { out.fileNguon[k] = 'không mở được: ' + e.message; }
  });
  out.ketLuan = out.canhBao.length ? 'CÓ ' + out.canhBao.length + ' ĐIỂM CẦN XEM — đọc mục canhBao.' : 'Dự án và mọi file nguồn đều theo UTC+7 (giờ Việt Nam).';
  Logger.log(JSON.stringify(out, null, 2));
  return JSON.stringify(out, null, 2);
}

/**
 * spx_resetColumnAnchors() — CHỈ chạy khi CHỦ Ý đổi tên cột tiêu đề ở sheet có ghim (VD 'Raw'): xoá
 * tiêu đề đã ghim để lần đọc kế tiếp học lại từ vị trí cũ. Không cần chạy khi cột chỉ đổi vị trí.
 */
function spx_resetColumnAnchors() {
  var p = PropertiesService.getScriptProperties();
  var all = p.getKeys().filter(function (k) { return k.indexOf('spx_colpin_') === 0; });
  all.forEach(function (k) { p.deleteProperty(k); });
  p.deleteProperty(SPX_COLWARN_KEY);
  return 'Đã xoá ' + all.length + ' tiêu đề ghim: ' + all.join(', ');
}

/**
 * spx_diagAllColumns() — cho biết MỌI sheet nguồn đang được đọc từ cột nào (chữ cột + tên tiêu đề thật).
 * Chạy sau khi nguồn đổi cấu trúc, hoặc khi nghi số liệu sai, để thấy ngay cột nào dịch chỗ / mất.
 */
function spx_diagAllColumns() {
  var out = {};
  var ss = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA');
  var show = function (hdr, F) {
    var o = {};
    Object.keys(F).forEach(function (k) { o[k] = F[k] === undefined ? 'KHÔNG THẤY' : (_spx_colLetter_(F[k]) + ' = ' + String(hdr[F[k]])); });
    return o;
  };
  var run = function (label, fn) { try { out[label] = fn(); } catch (e) { out[label] = 'LỖI: ' + e.message; } };
  run('1. LM high aging', function () {
    var sh = ss.getSheetByName('1. LM high aging');
    var hdr = sh.getRange(2, 1, 1, Math.min(sh.getMaxColumns(), Math.max(sh.getLastColumn(), 18))).getValues()[0];
    var M = _aging_lmColumnMap_(hdr); var o = { cachDoc: M.fallback ? 'LÙI BỐ CỤC CŨ' : 'theo tiêu đề' };
    ['ship', 'status', 'hub', 'inbound', 'att', 'timing', 'aging', 'cogs', 'bucket'].forEach(function (k) { o[k] = M[k] >= 0 ? _spx_colLetter_(M[k]) + ' = ' + hdr[M[k]] : 'KHÔNG CÓ'; });
    return o;
  });
  run('2. FM high aging', function () { var h = ss.getSheetByName('2. FM high aging').getRange(2, 1, 1, 30).getValues()[0]; return show(h, _spx_findCols_(h, _SPX_SPEC_FMHA_)); });
  run('3. FM action realtime', function () { var h = ss.getSheetByName('3. FM action realtime').getRange(2, 1, 1, 20).getValues()[0]; return show(h, _spx_findCols_(h, _SPX_SPEC_FMACT_)); });
  run('summary FM realtime', function () { var h = ss.getSheetByName('summary FM realtime').getRange(2, 1, 1, 14).getValues()[0]; return show(h, _spx_findCols_(h, _SPX_SPEC_FMSUM_)); });
  run('Backlog FM+LM (khối LastMile)', function () {
    var sh = ss.getSheetByName('Backlog FM+LM'); var lc = sh.getLastColumn();
    var h2 = sh.getRange(2, 1, 1, lc).getValues()[0], h3 = sh.getRange(3, 1, 1, lc).getValues()[0];
    var lm = -1; for (var c = 0; c < h2.length; c++) { var n = _spx_normHdr_(h2[c]); if (n === 'lastmile' || n === 'last mile') { lm = c; break; } }
    return lm < 0 ? 'KHÔNG THẤY ô LastMile' : show(h3, _spx_findCols_(h3, _SPX_SPEC_BKLM_, { from: lm }));
  });
  ['FM', 'LM', 'SOP'].forEach(function (k) {
    run('KPI Fail — ' + k, function () {
      var sh = _DS.ss(KPIFAIL_SS_ID).getSheetByName(k);
      var h = sh.getRange(1, 1, 1, Math.max(sh.getLastColumn(), 1)).getValues()[0];
      var F = _spx_findCols_(h, _SPX_KPI_SPEC_[k].spec); var o = show(h, F);
      var miss = _SPX_KPI_SPEC_[k].req.filter(function (f) { return F[f] === undefined; });
      o.ketLuan = miss.length ? 'THIẾU cột bắt buộc: ' + miss.join(', ') : 'Đủ cột bắt buộc';
      return o;
    });
  });
  run('Raw (file Lost)', function () {
    var sh = _DS.ss('1vvOZG80Rz5PTNPFsbHzmUMPkPaAkGOY70nDHBwfzjQE').getSheetByName('Raw');
    var h = sh.getRange(1, 1, 1, Math.min(sh.getMaxColumns(), 20)).getValues()[0];
    var LC = _aging_lostCols_(sh); var o = {};
    Object.keys(LC).forEach(function (k) { o[k] = _spx_colLetter_(LC[k]) + ' = ' + String(h[LC[k]]); });
    o.canhBao = _spx_getColWarn_() || '(không)';
    return o;
  });
  var txt = JSON.stringify(out, null, 2); Logger.log(txt); return txt;
}

/**
 * spx_diagLmColumns() — CHẠY THỦ CÔNG sau khi triển khai (hoặc khi nghi sheet nguồn đổi cột).
 * Cho biết mỗi trường dữ liệu đang được đọc từ cột nào (kèm tên tiêu đề thật), và đọc thử
 * 2.000 dòng đầu để kiểm tra cột "trạm" có thật sự chứa tên trạm hay không.
 */
function spx_diagLmColumns() {
  var sh = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA').getSheetByName('1. LM high aging');
  if (!sh) return 'Không mở được sheet nguồn "1. LM high aging".';
  var nCols = Math.min(sh.getMaxColumns(), Math.max(sh.getLastColumn(), 18));
  var hdr = sh.getRange(2, 1, 1, nCols).getValues()[0];
  var M = _aging_lmColumnMap_(hdr);
  var letter = function (n) { var s = ''; n++; while (n > 0) { var m = (n - 1) % 26; s = String.fromCharCode(65 + m) + s; n = Math.floor((n - 1) / 26); } return s; };
  var describe = function (c) { return c >= 0 ? (letter(c) + ' = ' + String(hdr[c] || '(không có tiêu đề)')) : 'KHÔNG CÓ cột này'; };
  var sampleN = Math.min(2000, Math.max(0, sh.getLastRow() - 2));
  var v = sampleN ? sh.getRange(3, 1, sampleN, nCols).getValues() : [];
  var hubs = {}, withShip = 0, looksStatus = 0, hubHasWord = 0;
  v.forEach(function (r) {
    if (!r[M.ship]) return;
    withShip++;
    var h = String(r[M.hub] || '').trim();
    hubs[h] = (hubs[h] || 0) + 1;
    if (/^[A-Za-z]+(_[A-Za-z]+)+$/.test(h) || /^(Delivering|Missing|OnHold)$/i.test(h)) looksStatus++;
    if (/hub|soc/i.test(h)) hubHasWord++;
  });
  var out = {
    cachDocCot: M.fallback ? 'LÙI VỀ BỐ CỤC CŨ (không dò được tiêu đề then chốt) — kiểm tra lại dòng 2 của sheet' : 'Theo tên tiêu đề dòng 2',
    maDon: describe(M.ship), tram: describe(M.hub), trangThaiCuoi: describe(M.status), ngayVeTram: describe(M.inbound),
    soLanGiao: describe(M.att), timingDate: describe(M.timing), aging: describe(M.aging),
    cogs: describe(M.cogs), nhanMoc: describe(M.bucket),
    docThu: { soDongCoMaDon: withShip, soTramKhacNhau: Object.keys(hubs).length, dongCoChuHubHoacSOC: hubHasWord, dongTramGiongTrangThai: looksStatus,
              mauTram: Object.keys(hubs).slice(0, 5) }
  };
  out.ketLuan = M.fallback ? 'CẢNH BÁO: đang dùng bố cục cũ.'
    : (withShip && looksStatus / withShip > 0.3) ? 'SAI: cột "trạm" đang chứa trạng thái đơn — kiểm tra tiêu đề cột.'
    : (withShip && hubHasWord / withShip < 0.5) ? 'NGHI NGỜ: dưới nửa số dòng có tên trạm dạng "... Hub/SOC" — xem mauTram.'
    : 'Bình thường — cột trạm chứa tên trạm.';
  Logger.log(JSON.stringify(out, null, 2));
  return JSON.stringify(out, null, 2);
}

function spx_diagOverdueLost() {
  var hub = String(SPX_DIAG_HUB || '').trim();
  var target = hub ? _normStationKey_(hub) : '';
  var out = { tram: hub || '(mọi trạm)', tongDongCoCo: 0, chotLostHomNay: [], coKhac: [], daChotLost: [] };
  var sh = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA').getSheetByName('1. LM high aging');
  if (!sh) return 'Không mở được sheet nguồn "1. LM high aging".';
  var last = sh.getLastRow();
  if (last >= 3) {
    var _nc2 = Math.min(sh.getMaxColumns(), Math.max(sh.getLastColumn(), 18));
    var _M2 = _aging_lmColumnMap_(sh.getRange(2, 1, 1, _nc2).getValues()[0]);
    var v = sh.getRange(3, 1, last - 2, _nc2).getValues();
    for (var i = 0; i < v.length; i++) {
      var flag = v[i][_M2.lost] ? String(v[i][_M2.lost]).trim() : '';
      if (!flag) continue;
      var rowHub = v[i][_M2.hub] ? String(v[i][_M2.hub]).trim() : '';
      if (target && _normStationKey_(rowHub) !== target) continue;
      out.tongDongCoCo++;
      var rec = { maDon: v[i][_M2.ship] ? String(v[i][_M2.ship]).trim() : '', tram: rowHub, giaTriCotA: flag, trangThai: v[i][_M2.proc] ? String(v[i][_M2.proc]).trim() : '' };
      if (flag.toLowerCase().indexOf('today') >= 0) out.chotLostHomNay.push(rec);
      else out.coKhac.push(rec);
    }
  }
  var shL = _DS.ss('1vvOZG80Rz5PTNPFsbHzmUMPkPaAkGOY70nDHBwfzjQE').getSheetByName('Raw');
  if (shL && shL.getLastRow() >= 2) {
    var _lc2 = null; try { _lc2 = _aging_lostCols_(shL); } catch (eLc4) { _lc2 = _SPX_LOST_LEGACY_; }
    var vl = shL.getRange(2, 1, shL.getLastRow() - 1, Math.min(shL.getMaxColumns(), Math.max(_lc2.ship, _lc2.hub) + 1)).getValues();
    for (var k = 0; k < vl.length; k++) {
      var hubL = vl[k][_lc2.hub] ? String(vl[k][_lc2.hub]).trim() : '';
      if (target && _normStationKey_(hubL) !== target) continue;
      out.daChotLost.push({ maDon: vl[k][_lc2.ship] ? String(vl[k][_lc2.ship]).trim() : '', tram: hubL });
    }
  }
  out.ketLuan = 'Thẻ Tổng quan = ' + out.chotLostHomNay.length + ' (chốt Lost hôm nay) + ' +
                out.daChotLost.length + ' (đã chốt Lost). Ngoài ra ' + out.coKhac.length +
                ' đơn mang cờ khác trên cột A — không phải đến hạn hôm nay.';
  Logger.log(JSON.stringify(out, null, 2));
  return JSON.stringify(out, null, 2);
}

/**
 * _spxScopeHubs_(overrideHub)
 * [MỚI — theo yêu cầu: "SUP/AOM/ROM phải thấy số của TOÀN KHU VỰC mình quản"]
 * Trước đây 5 hàm tổng hợp của Tổng quan chỉ nhận MỘT trạm, nên khi Admin xem thử
 * cấp SUP/AOM/ROM (mỗi cấp quản nhiều trạm) thì các thẻ rơi về số TOÀN HỆ THỐNG —
 * sai phạm vi, và sai theo hướng nguy hiểm: số to hơn thực tế rất nhiều.
 * Hàm này cho phép truyền DANH SÁCH TRẠM, giữ nguyên tương thích với lời gọi cũ:
 *   · '' hoặc null      -> không lọc thêm (giữ nguyên hành vi cũ)
 *   · 'Tên trạm'        -> đúng 1 trạm  (giữ nguyên hành vi cũ)
 *   · 'A||B||C'         -> nhiều trạm   (dạng mới, dùng cho SUP/AOM/ROM)
 *   · ['A','B']         -> nhiều trạm   (dạng mới, khi gọi nội bộ)
 * Trả về { list: [tên gốc...], keys: {khoá chuẩn hoá: true}, has(hub), empty }.
 */
function _spxScopeHubs_(overrideHub) {
  var list = [];
  if (Array.isArray(overrideHub)) list = overrideHub.slice();
  else if (overrideHub) {
    var s = String(overrideHub).trim();
    list = (s.indexOf('||') >= 0) ? s.split('||') : [s];
  }
  list = list.map(function (x) { return String(x || '').trim(); }).filter(Boolean);
  var keys = {};
  list.forEach(function (h) { keys[_normStationKey_(h)] = true; });
  return {
    list: list,
    keys: keys,
    empty: list.length === 0,
    has: function (hub) { return !list.length || !!keys[_normStationKey_(hub)]; },
    // Khoá bộ đệm: nhiều trạm -> chuỗi ổn định, không phụ thuộc thứ tự người dùng chọn.
    cacheKey: function () { return list.length ? Object.keys(keys).sort().join('~') : ''; }
  };
}

function aging_getIndexSummary(hubName, overrideHub) {

  // [SECURITY FIX 2026-08] Trước đây hàm này KHÔNG kiểm tra quyền — bất kỳ ai
  // (kể cả AOM/SUP chỉ được cấp 1 hub, hoặc user gọi thẳng qua console) đều lấy
  // được summary quá hạn/lost của TOÀN BỘ hub bằng cách để hubName rỗng, hoặc
  // xem trộm hub khác bằng cách truyền đúng tên hub đó. Thêm chặn theo
  // getModuleAccess() + lọc từng dòng theo hub được cấp. Cache key cũng phải
  // thêm phạm vi quyền (_scopeKey) — nếu không, kết quả admin (toàn bộ hub) bị
  // cache chung key với non-admin sẽ vô tình phục vụ nhầm dữ liệu ngoài quyền
  // cho lần gọi tiếp theo dù đã lọc đúng ở đây.
  const _access = getModuleAccess();
  if (_access.role === 'denied') return JSON.stringify({ success: false, error: 'Không có quyền truy cập.' });
  const _isAdmin = (_access.role === 'admin');
  const _allowedNormHubs = new Set((_access.hubs || []).map(function(h){ return _normStationKey_(h); }));
  if (!_isAdmin && hubName && !_allowedNormHubs.has(_normStationKey_(hubName))) {
    return JSON.stringify({ success: false, error: 'Không có quyền xem dữ liệu hub này.' });
  }
  // [MỚI — theo yêu cầu trực tiếp "Tổng quan không đổi theo level, sao biết
  // đúng sai"] Khi Admin thật đang "Xem thử Lead/Staff" ở 1 Hub cụ thể,
  // frontend truyền overrideHub — cho phép lọc đúng theo Hub đó dù access
  // thật là admin (không hạn chế). Chỉ Admin mới được dùng tham số này (không
  // phải lỗ hổng cho phép non-admin lách qua hubName ở trên).
  // [SỬA LỖI THẬT — Tổng quan không theo trạm đang chọn với người dùng thường]
  // Trước đây CHỈ Admin được lọc theo trạm; người quản nhiều trạm chọn 1 trạm ở
  // header vẫn nhận tổng cả phạm vi. Nay cho lọc khi trạm NẰM TRONG quyền —
  // chỉ thu hẹp, không thể vượt quyền.
  // [SỬA — hỗ trợ NHIỀU TRẠM] Xem thử cấp SUP/AOM/ROM: mỗi cấp quản nhiều trạm, nên
  // phạm vi phải là DANH SÁCH. Trước đây chỉ nhận 1 trạm -> các thẻ rơi về số toàn
  // hệ thống, sai theo hướng nguy hiểm (số to hơn thực tế rất nhiều).
  const _ovScope = _spxScopeHubs_(overrideHub);
  const _ovOk = !_ovScope.empty && (_isAdmin || _ovScope.list.every(function (h) {
    return _allowedNormHubs.has(_normStationKey_(h));
  }));
  const _effectiveHub = _ovOk ? overrideHub : hubName;
  // Khoá cache PHẢI gồm trạm đang lọc — nếu không, kết quả nhiều trạm đã lưu
  // sẽ bị trả nhầm cho yêu cầu 1 trạm (và ngược lại).
  const _scopeKey = _isAdmin
    ? ('ADMIN' + (_ovOk ? '_PV_' + _ovScope.cacheKey() : ''))

    : (Array.from(_allowedNormHubs).sort().join('~') + (_ovOk ? '_PV_' + _ovScope.cacheKey() : ''));


  // ============================================================
  // STALE-WHILE-REVALIDATE:
  // - Kiểm tra CacheService trước (cache 60 giây)
  // - Nếu có cache → trả về ngay, đồng thời vẫn đọc Sheets thật bên dưới
  //   để lần gọi sau có data mới hơn (GAS không hỗ trợ async, nên cache
  //   sẽ được làm mới ngay trong cùng lần gọi nếu hết hạn)
  // - Nếu Sheets lỗi → fallback về cache cũ thay vì trả lỗi
  // ============================================================

  const cache      = CacheService.getScriptCache();
  // Normalize key: bỏ dấu tiếng Việt + ký tự đặc biệt để tránh cache miss do encoding
  const _normalizeKey = s => s ? s.toString().trim().toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')  // bỏ dấu
    .replace(/đ/g, 'd').replace(/[^a-z0-9_-]/g, '_')  // thay ký tự lạ
    .replace(/_+/g, '_').replace(/^_|_$/g, '')         // dọn underscore thừa
    : 'all';
  // [MỚI 2026-10-24] Khoá gắn phiên bản bản chụp + mốc sửa file nguồn: nguồn/bản chụp đổi -> khoá đổi -> tính lại ngay,
  // thay vì giữ số cũ tới hết 15 phút.
  const cacheKey   = _spxSafeCacheKey_('aging_idx_' + _normalizeKey(hubName) + '_' + _scopeKey + '_v' + _spxAgingVerTag_() + '_s' + _spxSrcStamp_('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA'));
  const cachedStr  = cache.get(cacheKey);

  // [SỬA LỖI THẬT — nguyên nhân chính của "Tổng quan tải rất lâu"]
  // Trước đây bộ nhớ đệm được ĐỌC ra ở đây nhưng chỉ được DÙNG trong nhánh
  // catch bên dưới — tức CHỈ KHI đọc sheet bị lỗi. Luồng bình thường LUÔN đọc
  // lại ~37.000 dòng (đo được 18-49 giây), bất kể bộ nhớ đệm có sẵn hay không.
  // Ghi chú cũ "có cache -> trả về ngay" mô tả SAI hành vi thật của code.
  // Nay: có bộ nhớ đệm hợp lệ thì trả về NGAY. Nguồn chỉ cập nhật 8:00 và
  // 14:00 mỗi ngày nên dùng lại kết quả trong 15 phút là an toàn.
  if (cachedStr && !_SPX_OV_FORCE_) {
    try {
      const _hit = JSON.parse(cachedStr);
      if (_hit && _hit.success) { _hit._cacheHit = true; return JSON.stringify(_hit); }
    } catch (eHit) {}
  }

  try {

    const t0       = Date.now();
    const hubSet   = new Set();
    // [FIX 2026-06] Trước đây so khớp bằng lowercase thô, không strip hậu tố
    // "Hub/LM/FM" → trạm ghi "Krông Pắk LM Hub" sẽ KHÔNG khớp với input "Krông Pắk",
    // khiến overdueCount/closedLostCount bị đếm thiếu khi lọc theo trạm cụ thể.
    // Nay dùng chung _normStationKey_() như các module khác (FMS, KPI Fail, Quá hạn JS).
    // Phạm vi lọc: danh sách trạm (Xem thử) hoặc 1 trạm như trước.
  const _scope = _ovOk ? _ovScope : _spxScopeHubs_(hubName);

    const summary = {
      success: true,
      overdueCount: 0,
      otherFlaggedCount: 0,   // don co co khac tren cot A (khong phai 'today')
      closedLostCount: 0,
      processingCount: 0,
      hubs: [],
      elapsedMs: 0,
      timestamp: Date.now(),
      // Nhiều trạm (Xem thử SUP/AOM/ROM) -> hiện số lượng thay vì ghép chuỗi khó đọc.
      hubName: (_ovOk && _ovScope.list.length > 1)
        ? (_ovScope.list.length + ' trạm')
        : (_effectiveHub ? String(_effectiveHub).split('||')[0].trim() : "")
    };

    // --- ĐỌC FILE CORE: dùng getSheetByName thay vì vòng for tìm sheet ---
    const ssCore   = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA');
    const coreSheet = ssCore.getSheetByName('1. LM high aging');

    if (coreSheet) {
      const lastRow = coreSheet.getLastRow();
      if (lastRow >= 3) {
        // [SỬA] Dò cột theo tiêu đề (cùng bản đồ với bộ nạp chính) — trước đây đọc cột K
        // cố định nên sau khi sheet nguồn đổi bố cục, phạm vi trạm lọc ra rỗng.
        const _lmM = _aging_lmColumnMap_(coreSheet.getRange(2, 1, 1, Math.min(coreSheet.getMaxColumns(), Math.max(coreSheet.getLastColumn(), 18))).getValues()[0]);
        const values = coreSheet.getRange(3, 1, lastRow - 2, Math.min(coreSheet.getMaxColumns(), Math.max(_lmM.ship, _lmM.hub, _lmM.lost) + 1)).getValues();
        for (let i = 0; i < values.length; i++) {
          const row        = values[i];
          const shipmentId = row[_lmM.ship] ? row[_lmM.ship].toString().trim() : "";
          if (!shipmentId) continue;

          const rowHub = row[_lmM.hub] ? row[_lmM.hub].toString().trim() : "";
          if (!_isAdmin && !_allowedNormHubs.has(_normStationKey_(rowHub))) continue;
          if (rowHub) hubSet.add(rowHub);
          if (!_scope.has(rowHub)) continue;

          const lostToday  = row[_lmM.lost] ? row[_lmM.lost].toString().trim() : "";
          // "Quá hạn" trên header = đơn có cột A (lostToday) mang giá trị bất kỳ
          // Đây là cờ hệ thống đánh dấu đơn quá hạn, khác agingValue (số ngày tồn kho)
          summary.processingCount++;
          // [SỬA LỖI THẬT — báo cáo: Tổng quan hiện "1 đơn" nhưng mở module tìm
          // không ra đơn nào] Hai nơi đếm CÙNG cột A nhưng KHÁC quy tắc:
          //   · Tổng quan (cũ): cột A khác rỗng -> đếm, bất kể giá trị gì
          //   · Module Kiểm soát Giao hàng: chỉ đếm khi giá trị CÓ CHỮ "today"
          // -> đơn mang cờ khác bị đếm ở Tổng quan mà không hiện trong module.
          // Nay Tổng quan dùng ĐÚNG quy tắc của module để con số luôn tra ra được.
          // Đơn mang cờ khác KHÔNG bị bỏ im lặng: đếm riêng vào otherFlaggedCount
          // để hiển thị rõ, tránh giấu mất đơn thật sự cần xử lý.
          if (lostToday) {
            if (lostToday.toLowerCase().indexOf('today') >= 0) summary.overdueCount++;
            else summary.otherFlaggedCount++;
          }
        }
      }
    }

    // --- ĐỌC FILE LOST ---
    const ssLost   = _DS.ss('1vvOZG80Rz5PTNPFsbHzmUMPkPaAkGOY70nDHBwfzjQE');
    const lostSheet = ssLost.getSheetByName('Raw');
    if (lostSheet) {
      const lastRow = lostSheet.getLastRow();
      if (lastRow >= 2) {
        // [SỬA] Cột mã đơn + trạm theo TIÊU ĐỀ đã ghim (cùng bộ dò với _aging_getLostDataFromSS).
        let _LC = null;
        try { _LC = _aging_lostCols_(lostSheet); } catch (eLc2) { _LC = null; }
        const values = _LC ? lostSheet.getRange(2, 1, lastRow - 1, Math.min(lostSheet.getMaxColumns(), Math.max(_LC.ship, _LC.hub) + 1)).getValues() : [];
        for (let i = 0; i < values.length; i++) {
          const shipmentId = values[i][_LC.ship] ? values[i][_LC.ship].toString().trim() : "";
          if (!shipmentId || ['spx_shipment_id', 'ma don hang', 'mã đơn hàng', 'spx tracking'].includes(shipmentId.toLowerCase())) continue;
          const rowHub = values[i][_LC.hub] ? values[i][_LC.hub].toString().trim() : "";
          if (!_isAdmin && !_allowedNormHubs.has(_normStationKey_(rowHub))) continue;
          if (rowHub) hubSet.add(rowHub);
          if (!_scope.has(rowHub)) continue;
          summary.closedLostCount++;
        }
      }
    }

    summary.hubs      = Array.from(hubSet).sort();
    summary.elapsedMs = Date.now() - t0;

    const result = JSON.stringify(summary);

    // Lưu cache 60 giây — đủ để giảm tải Sheets API
    // mà vẫn đảm bảo data cũ tối đa 1 phút trong giờ vận hành ca
    // [SỬA — chẩn đoán Tổng quan chậm: phần này chiếm 23,6 giây] 60 giây -> 15
    // phút. Nguồn chính là sheet Backlog monitor, chỉ CẬP NHẬT 8:00 và 14:00
    // mỗi ngày — trước đây đọc lại ~37.000 dòng MỖI PHÚT cho dữ liệu 2 lần/ngày
    // mới đổi. Module Kiểm soát Giao hàng vẫn đọc dữ liệu mới khi mở trực tiếp.
    try { cache.put(cacheKey, result, 900); } catch(ce) {}

    return result;

  } catch (e) {

    // Sheets lỗi hoặc timeout → trả cache cũ nếu có, tránh màn hình trắng
    if (cachedStr) {
      try {
        const old = JSON.parse(cachedStr);
        old.fromCache = true;
        old.cacheError = e.message;
        return JSON.stringify(old);
      } catch(pe) {}
    }

    return JSON.stringify({ success: false, error: e.message, timestamp: Date.now() });
  }

}

// ============================================================

// --- NOTES CRM (AGING) ---

// ============================================================

function aging_syncNotes(activeIdsStr) {

  try {

    // [SECURITY FIX 2026-08] Trước đây không kiểm tra quyền — bất kỳ ai gọi được
    // cũng đọc/dọn được toàn bộ note quá hạn của mọi trạm. Sheet App_Notes hiện
    // không có cột hub/trạm nên chưa thể lọc chi tiết theo hub ngay tại đây (cần
    // đổi schema sheet mới làm được) — trước mắt chặn tối thiểu ở mức "đã được
    // duyệt dùng hệ thống" để không còn public hoàn toàn.
    _requireApproved_();

    const ss = _DS.ss(ADMIN_DB_ID);

    let sheet = ss.getSheetByName('App_Notes');

    if (!sheet) {

      sheet = ss.insertSheet('App_Notes');

      sheet.appendRow(['Tracking ID','Nội Dung Note','Người Note','Thời Gian']);

    }

    let data = sheet.getDataRange().getDisplayValues();

    if (!data || data.length === 0) return JSON.stringify({ success: true, notes: {} });

    let activeIds  = JSON.parse(activeIdsStr) || [];

    let activeSet  = new Set(activeIds);

    let newData    = []; let notesDict = {};

    for (let i = 0; i < data.length; i++) {

      if (!data[i] || !data[i][0]) continue;

      let id = data[i][0].toString().trim();

      if (!id) continue;

      if (id.toUpperCase() === 'TRACKING ID' || id.toUpperCase() === 'MÃ ĐƠN HÀNG') { newData.push(data[i]); continue; }

      if (activeIds.length === 0 || activeSet.has(id)) {

        newData.push(data[i]);

        notesDict[id] = { text: data[i][1], user: data[i][2], time: data[i][3] };

      }

    }

    if (activeIds.length > 0 && newData.length < data.length) {

      sheet.clearContents();

      if (newData.length > 0) sheet.getRange(1, 1, newData.length, newData[0].length).setValues(newData);

    }

    return JSON.stringify({ success: true, notes: notesDict });

  } catch (e) { return JSON.stringify({ error: e.message }); }

}

// Xóa cache aging_getMasterData của user đang gọi — gọi sau mỗi write operation
// (saveNote, syncNotes) để lần đọc tiếp theo của user đó thấy dữ liệu mới ngay.
// [FIX 2026-07] Trước đây hàm này xoá key 'aging_master_v1_*' — key đời CŨ mà
// aging_getMasterData() không còn ghi vào từ khi chuyển sang cache theo user (v3).
// Tức là gọi hàm này sau khi lưu note KHÔNG hề xoá cache thật đang dùng — user vừa
// lưu note vẫn có thể thấy dữ liệu cũ tới hết TTL (5 phút). Sửa lại để xoá đúng key
// v3 theo user hiện tại, đồng bộ với key mà aging_getMasterData()/aging_clearCache()
// đang dùng (qua CacheMgr — xem CacheMgr ở đầu file).
// [FIX 2026-07-28] Trỏ lại sang cache CHUNG 'raw_v1' (thay vì key theo từng user
// đã bỏ — xem aging_getMasterData()). Không còn được gọi từ aging_saveNote() nữa
// (xem giải thích ở đó) — giờ chỉ dùng cho aging_clearCache() khi cần ép đọc lại
// dữ liệu Core/Lost/FM thật sự (hiếm khi cần, vì cache chung tự làm mới mỗi 5
// phút qua aging_prewarmCache()).
function _aging_invalidateMasterCache() {
  try {
    CacheMgr.invalidateChunked('AGING', 'raw_v1');
  } catch(e) {}
}

function aging_getNotesOnly() {

  try {

    // [SECURITY FIX 2026-08] Xem chú thích ở aging_syncNotes() — cùng lớp lỗi.
    _requireApproved_();

    const ss    = _DS.ss(ADMIN_DB_ID);

    let sheet   = ss.getSheetByName('App_Notes');

    if (!sheet) return JSON.stringify({ success: true, notes: {} });

    const data  = sheet.getDataRange().getDisplayValues();

    let notesDict = {};

    for (let i = 0; i < data.length; i++) {

      let id = data[i][0].toString().trim();

      if (id && id.toUpperCase() !== 'TRACKING ID' && id.toUpperCase() !== 'MÃ ĐƠN HÀNG') {

        notesDict[id] = { text: data[i][1], user: data[i][2], time: data[i][3] };

      }

    }

    return JSON.stringify({ success: true, notes: notesDict });

  } catch (e) { return JSON.stringify({ error: e.message }); }

}

// Tra cứu hub theo Tracking ID — dùng cho ALERT HOOK trong aging_saveNote().
// Tái dùng aging_getMasterData() (đã có cache CacheMgr 300s theo user) nên hầu hết
// các lần gọi là cache-hit, không tốn thêm chi phí đọc sheet Core/Lost.
// Trả về '' nếu không tìm thấy hoặc có lỗi — caller phải tự kiểm tra rỗng, không throw.
function _aging_findHubById_(cleanId) {
  try {
    var raw = _aging_getMasterDataCore_();
    var data = JSON.parse(raw);
    if (!data || !data.success) return '';
    var lists = [data.coreData || [], data.lostData || []];
    for (var li = 0; li < lists.length; li++) {
      var arr = lists[li];
      for (var i = 0; i < arr.length; i++) {
        if (arr[i].shipmentId === cleanId) {
          return arr[i].hubName || arr[i].hub || arr[i].Hub || '';
        }
      }
    }
  } catch (e) {}
  return '';
}

function aging_saveNote(id, noteText, hubName) {

  // [FIX NGHẼN LOCK 2026-07-24] TRƯỚC ĐÂY dùng thẳng LockService.getScriptLock() —
  // đây là hàm lưu note Quá Hạn, dùng THƯỜNG XUYÊN NHẤT trong cả app (mọi trạm, mọi
  // ca, liên tục cả ngày) nên gần như chắc chắn góp phần vào tình trạng nghẽn chung
  // (cùng nhóm bệnh với saveRiderPlan/Admin Access — xem giải thích đầy đủ ở đó).
  // Đổi sang named lock riêng cho App_Notes qua _anaAcquireNamedLock() (đã có sẵn).
  var cleanId, shortUser, timestamp, hubForAlert = (hubName||'').toString().trim();

  // [FIX BẢO MẬT NGHIÊM TRỌNG — phát hiện qua rà soát chủ động theo yêu cầu quét
  // IDOR toàn diện] Hàm này TRƯỚC ĐÂY hoàn toàn KHÔNG kiểm tra quyền — bất kỳ ai
  // đăng nhập được (kể cả Staff cấp thấp nhất) đều có thể ghi ĐÈ ghi chú của BẤT
  // KỲ đơn hàng nào tại BẤT KỲ trạm nào, không giới hạn theo quyền hub thật của họ
  // (Session.getActiveUser() ở dòng dưới CHỈ dùng để hiển thị tên người ghi, KHÔNG
  // dùng để kiểm tra quyền — dễ nhầm là "đã có kiểm tra" khi quét tự động, phải đọc
  // kỹ mới phát hiện). Sửa: chuyển bước tra cứu hub LÊN TRƯỚC (để luôn có đúng hub
  // thật của đơn hàng dù client cũ có gửi hubName hay không), rồi kiểm tra hub đó
  // có thuộc quyền người gọi (getModuleAccess(), cache 120s — không ảnh hưởng hiệu
  // năng hàm dùng thường xuyên nhất app) hay không TRƯỚC KHI cho phép ghi. Nếu
  // KHÔNG xác định được hub (trường hợp hiếm — đơn chưa có trong hệ Quá Hạn), vẫn
  // cho ghi (tránh chặn nhầm use case hợp lệ chưa lường hết) nhưng ghi log cảnh báo.
  if (!hubForAlert) {
    try { hubForAlert = _aging_findHubById_((id||'').toString().trim().toUpperCase()); } catch (eHubEarly) {}
  }
  try {
    var _noteAccess = getModuleAccess();
    if (_noteAccess.role === 'denied') {
      return JSON.stringify({ success: false, error: 'Bạn không có quyền ghi chú.' });
    }
    // [CẬP NHẬT — theo quy tắc nghiệp vụ đã xác nhận: "Ghi chú Quá Hạn chỉ dành
    // cho Lead/Staff, các cấp cao (ROM/AOM/SUP) KHÔNG ghi chú tới nó"] Chỉ kiểm
    // tra hub-membership KHÔNG đủ — 1 AOM/SUP về lý thuyết "quản lý" hub đó
    // (hub nằm trong access.hubs của họ) vẫn KHÔNG được phép ghi chú, vì đây là
    // hành động cấp vận hành (station-level), không phải cấp quản lý. Admin vẫn
    // giữ toàn quyền bypass — nhất quán với nguyên tắc "chỉ admin là 1 và duy
    // nhất" đã xác lập (phục vụ xử lý khẩn cấp/hỗ trợ khi cần).
    if (_noteAccess.role !== 'admin' && _noteAccess.levelCode !== 'lead' && _noteAccess.levelCode !== 'staff') {
      return JSON.stringify({ success: false, error: 'Chỉ cấp Lead/Staff mới được ghi chú Quá Hạn — cấp ' + (_noteAccess.levelLabel || _noteAccess.levelCode) + ' không có quyền này.' });
    }
    if (_noteAccess.role !== 'admin' && hubForAlert) {
      var _noteHasHub = (_noteAccess.hubs || []).some(function(h){
        return (typeof cleanHubString === 'function' ? cleanHubString(h) === cleanHubString(hubForAlert) : h.trim().toLowerCase() === hubForAlert.trim().toLowerCase());
      });
      if (!_noteHasHub) {
        return JSON.stringify({ success: false, error: 'Không có quyền ghi chú cho trạm: ' + hubForAlert });
      }
    } else if (_noteAccess.role !== 'admin' && !hubForAlert) {
      Logger.log('[aging_saveNote CẢNH BÁO] Không xác định được hub cho đơn ' + id + ' — cho phép ghi (không chặn), user=' + _noteAccess.email);
    }
  } catch (eNotePerm) {
    return JSON.stringify({ success: false, error: 'Lỗi kiểm tra quyền: ' + eNotePerm.message });
  }

  if (!_anaAcquireNamedLock('aging_notes_write_lock_v1', 10000, 15000)) {
    return JSON.stringify({ success: false, error: 'Hệ thống đang bận lưu note, vui lòng thử lại sau ít giây.' });
  }

  try {

    const ss = _DS.ss(ADMIN_DB_ID);

    let sheet = ss.getSheetByName('App_Notes');

    if (!sheet) {

      sheet = ss.insertSheet('App_Notes');

      sheet.appendRow(['Tracking ID','Nội Dung Note','Người Note','Thời Gian']);

    }

    const data     = sheet.getDataRange().getDisplayValues();

    let rowIndexes = [];

    cleanId = id.toString().trim().toUpperCase();

    for (let i = 0; i < data.length; i++) {

      if (data[i][0].toString().trim().toUpperCase() === cleanId) rowIndexes.push(i + 1);

    }

    timestamp  = Utilities.formatDate(new Date(), "GMT+7", "dd/MM HH:mm");

    let userEmail  = Session.getActiveUser().getEmail() || "";

    shortUser  = userEmail ? userEmail.split('@')[0].toUpperCase() : "ADMIN";

    // [DỌN — đã chuyển lên đầu hàm, xem đoạn kiểm tra quyền phía trên] Việc tra
    // cứu hubForAlert (khi client cũ chưa gửi hubName) giờ chạy SỚM HƠN, TRƯỚC
    // bước kiểm tra quyền — không cần lặp lại ở đây nữa.

    if (rowIndexes.length > 0) {

      sheet.getRange(rowIndexes[0], 2).setValue(noteText);

      sheet.getRange(rowIndexes[0], 3).setValue(shortUser);

      sheet.getRange(rowIndexes[0], 4).setValue(timestamp);

      for (let j = rowIndexes.length - 1; j >= 1; j--) sheet.deleteRow(rowIndexes[j]);

    } else {

      sheet.appendRow([cleanId, noteText, shortUser, timestamp]);

    }

    // [FIX 2026-07-28] KHÔNG còn gọi _aging_invalidateMasterCache() ở đây nữa —
    // trước đây mỗi lần lưu note (hành động dùng thường xuyên nhất cả app) đều
    // xoá luôn cache Core/Lost/FM (giờ đã tách thành cache CHUNG, dùng chung cho
    // mọi user — xem aging_getMasterData()), ép TẤT CẢ user đọc cold ngay sau đó
    // dù dữ liệu Core/Lost/FM chẳng thay đổi gì khi lưu note. Notes đã có cache
    // riêng, invalidate đúng lúc ngay dưới đây — không cần đụng tới cache dữ liệu thô.
    _aging_invalidateNotesCache();  // Xóa cache notes riêng → lần đọc tiếp lấy note mới

  } catch (e) { return JSON.stringify({ success: false, error: e.message }); }

  finally { _anaReleaseNamedLock('aging_notes_write_lock_v1'); }

  // ── ALERT HOOK: đẩy RA NGOÀI lock ghi note (giống hệt kpifail_saveNote) ──
  // Chạy sau khi lock đã release — dù _aging_findHubById_ ở trên hiếm khi chậm (cache
  // thường nóng sẵn), việc push alert vẫn không được phép giữ khóa ghi note của các
  // user khác, và không được phép làm hỏng kết quả lưu note (đã thành công ở trên)
  // nếu Alert_Aggregate có vấn đề gì đó — nên bọc try/catch im lặng riêng.
  try {
    if (hubForAlert) {
      _pushAlert_({
        stationName: hubForAlert,
        source:      'aging',
        severity:    2,
        entityRef:   id,
        message:     'Quá hạn note: ' + noteText.substring(0, 80)
      });
    }
  } catch (eAlert) {}

  return JSON.stringify({ success: true, user: shortUser, time: timestamp });

}

// ============================================================
// MODULE 8: KPI FAIL HUB ANALYTICS (FM Late / LM Late / Wrong SOP)
// ============================================================
// Nguồn dữ liệu: 3 sheet thật, KHÔNG suy diễn dữ liệu không tồn tại.
// Quy ước: mỗi dòng trong 3 sheet này là 1 đơn ĐÃ FAIL (đã lọc sẵn ở nguồn),
// nên Total = số dòng trong khoảng thời gian lọc. Không có cột nào dùng để
// tính lại "tổng đơn" hay "tỷ lệ %" trên tổng số đơn toàn hệ thống — sheet
// gốc không chứa số liệu đó.
// ============================================================

// [CHUYỂN NGUỒN DỮ LIỆU — theo yêu cầu trực tiếp] Đổi sang spreadsheet mới,
// tên sheet rút gọn. Cấu trúc cột BÊN TRONG KHÔNG ĐỔI — chỉ đổi nơi đọc, nên
// toàn bộ logic phân tích (_kpifail_buildRecords, vị trí cột, cách tính độ
// trễ...) giữ nguyên, không cần sửa gì thêm.
//   Nguồn cũ: 1YCCH_ua39S0jU0y5FHbICf-IPi88qLkY0gKcrq5tS4I
//     'FM Late Orders'      -> 'FM'
//     'LM Late Orders'      -> 'LM'
//     'Wrong SOP PU Orders' -> 'SOP'
//
// ⚠️ SAU KHI DEPLOY, PHẢI LÀM 2 VIỆC (chạy trong Apps Script Editor):
//   1. kpifail_clearCache()  — hệ thống đọc dữ liệu kiểu "chỉ lấy phần mới từ
//      dòng X trở đi" và ghi nhớ mốc dòng đã đọc của nguồn CŨ. Mốc đó vô nghĩa
//      với nguồn mới. Có sẵn cơ chế tự phát hiện khi số dòng GIẢM, nhưng nếu
//      nguồn mới nhiều dòng hơn nguồn cũ thì nó KHÔNG kích hoạt và số liệu sẽ
//      sai âm thầm — nên phải xoá cache thủ công 1 lần cho chắc.
//   2. kpifail_setupSourceChangeWatcher() — trigger theo dõi thay đổi gắn CỨNG
//      vào 1 spreadsheet cụ thể, hiện vẫn đang trỏ vào nguồn CŨ (xem ghi chú
//      đầy đủ tại chính hàm đó).
var KPIFAIL_SS_ID    = '1pcQJB_-ZxGQQwg20GreeLhMovocfs6u1sIqrjQHsJQ0';
var KPIFAIL_SHEET_FM  = 'FM';
var KPIFAIL_SHEET_LM  = 'LM';
var KPIFAIL_SHEET_SOP = 'SOP';

function _kpifail_readSheet(ss, sheetName) {
  var sheet = ss.getSheetByName(sheetName);
  if (!sheet || sheet.getLastRow() < 2) return [];
  var lastRow = sheet.getLastRow();
  var lastCol = sheet.getLastColumn();
  return sheet.getRange(2, 1, lastRow - 1, lastCol).getValues();
}

// Chuẩn hóa 3 sheet thô thành 1 mảng "Fail Record" duy nhất.
// date luôn là string 'yyyy-MM-dd' (không dùng Date object) để tránh lệch
// timezone khi serialize JSON qua client — so sánh chuỗi ISO vẫn đúng thứ tự thời gian.
function _kpifail_buildRecords(ss) {
  var tz = SPX_TZ;

  // [FIX] Root cause: LM Late và Wrong SOP luôn ra 0 dù sheet có data vì
  // fmtDate() cũ CHỈ nhận "instanceof Date" — nếu cột ngày gốc (cột A) bị để
  // trống, dán dạng text, hoặc lệch định dạng thì dateStr = null và TOÀN BỘ
  // dòng bị âm thầm loại khỏi record (record.date là field bắt buộc để lọc
  // theo khoảng thời gian ở kpifail_getMasterDataLite). FM Late không bị lộ
  // lỗi này vì cột A của sheet đó vẫn đang có Date hợp lệ.
  // parseAnyDate() giờ chấp nhận thêm: chuỗi 'yyyy-MM-dd', 'dd/MM/yyyy',
  // datetime kèm giờ, và serial number ngày của Sheets — không chỉ Date object.
  var parseAnyDate = function(v) {
    if (v instanceof Date && !isNaN(v.getTime())) return v;
    if (typeof v === 'string' && v.trim()) {
      var s = v.trim();
      var m = s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
      if (m) {
        var d1 = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
        if (!isNaN(d1.getTime())) return d1;
      }
      m = s.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{4})/);
      if (m) {
        var d2 = new Date(Number(m[3]), Number(m[2]) - 1, Number(m[1]));
        if (!isNaN(d2.getTime())) return d2;
      }
      var d3 = new Date(s);
      if (!isNaN(d3.getTime())) return d3;
    }
    if (typeof v === 'number' && v > 0) {
      // [FIX-TZ] Dùng epoch neo theo giờ local của Apps Script (= project
      // Time Zone) thay vì UTC cứng, để khớp với cách toàn bộ code còn lại
      // đang quy đổi ngày theo Asia/Ho_Chi_Minh — tránh lệch ngày gần mốc
      // nửa đêm nếu nhánh fallback số serial này từng bị kích hoạt.
      var epochLocal = new Date(1899, 11, 30);
      var d4 = new Date(epochLocal.getTime() + Math.round(v * 86400000));
      if (!isNaN(d4.getTime())) return d4;
    }
    return null;
  };
  var fmtDate = function(d) {
    var dd = parseAnyDate(d);
    return dd ? Utilities.formatDate(dd, tz, 'yyyy-MM-dd') : null;
  };
  var fmtDateTime = function(d) {
    var dd = parseAnyDate(d);
    return dd ? Utilities.formatDate(dd, tz, 'yyyy-MM-dd HH:mm') : null;
  };

  // [FIX 2026-07-29] NGÂN SÁCH THỜI GIAN — trước đây hàm này đọc TOÀN BỘ 3 sheet
  // (_kpifail_readSheet, mỗi sheet 1 lệnh getRange().getValues() duy nhất, có
  // thể ~100-200k dòng) rồi mới build record, không có điểm dừng nào — log
  // Executions xác nhận lượt build toàn bộ (trigger đêm, hoặc lần đầu chưa có
  // snapshot) từng CHẠM TRẦN CỨNG 30 phút (Timed Out), có lúc lặp lại nhiều lần
  // liên tiếp. Giờ dùng _kpifail_readRowsBudgeted_() qua từng sheet, dừng SỚM
  // (mặc định KPIFAIL_TIME_BUDGET_MS ~4.5 phút) tại sheet đang xử lý nếu vượt
  // ngân sách — trả về {records, rowCounts, complete:false} với rowCounts ghi
  // đúng vị trí đã đọc tới. Người gọi lưu rowCounts này vào snapshot, và ở CHU
  // KỲ REFRESH INCREMENTAL kế tiếp (_kpifail_readSourceRowsSince_, dùng CHUNG
  // đúng cơ chế ngân sách này), phần còn lại sẽ tự được đọc tiếp — không cần
  // logic "tiếp tục" riêng, không bao giờ có 1 lượt vượt quá ngân sách.
  // startRowCounts cho phép TIẾP TỤC đúng từ vị trí lần build trước dừng lại
  // (mặc định {FM:0,LM:0,SOP:0} = build từ đầu hoàn toàn).
  var startRowCounts = arguments.length > 1 ? arguments[1] : { FM: 0, LM: 0, SOP: 0 };
  var _startTime = Date.now();
  var records = [];
  // [FIX] Đếm số dòng bị loại vì không có bất kỳ ngày nào dùng được (kể cả
  // sau fallback) — phục vụ kpifail_debugDateIssues() để soát nguồn dữ liệu.
  var skipped = { FM: 0, LM: 0, SOP: 0 };
  var fps = {};          // [MỚI] vân tay dòng đầu/dòng mốc đã đọc của từng sheet
  var dupDropped = 0;    // [MỚI] số dòng trùng bị bỏ
  var _seenKeys = {};

  function buildFromRows(values, buildRecord, catKey) {
    for (var i = 0; i < values.length; i++) {
      var rec = buildRecord(values[i]);
      if (rec) {
        // [MỚI] Khử trùng cùng khoá với _kpifail_mergeRecords_ (category|date|id|hub) — trước đây đường đọc đầy
        // đủ KHÔNG khử trùng nên cùng 1 đơn xuất hiện 2 lần trong nguồn bị đếm 2 lần (đường đọc dòng mới thì có).
        var _k = [rec.category || '', rec.date || '', rec.id || '', rec.hub || ''].join('|');
        if (_seenKeys[_k]) { dupDropped++; } else { _seenKeys[_k] = 1; records.push(rec); }
      } else skipped[catKey]++;
    }
  }

  // FM Late Orders: A Date, B Pickup Station, C KPI Station, D Shipment ID, E Bulky,
  // F DTS, G To SOC, H Picked Time, I Inbound Time, J Packed Time, K LH Onsite Reg Time,
  // L LH Arrived Time, M LH Arrived Time Finalized for KPI, N LHPacked Time, O FM ETA,
  // P # COT Late, Q Type, R FM Late Reason
  var fmSheet = ss.getSheetByName(KPIFAIL_SHEET_FM);
  var CF = fmSheet ? _kpifail_cols_(fmSheet, 'FM') : null; // [SỬA] dò cột theo TIÊU ĐỀ
  var _sharedRowCounter = { n: 0 }; // dùng chung cho cả 3 sheet — chặn TỔNG dòng, không phải từng sheet riêng
  var fmChunk = _kpifail_readRowsBudgeted_(fmSheet, Math.max(2, (startRowCounts.FM || 0) + 1), _startTime, _sharedRowCounter);
  fps.FM = _kpifail_fpOfChunk_(fmChunk, Math.max(2, (startRowCounts.FM || 0) + 1), CF);
  buildFromRows(fmChunk.values, function(r) {
    var g = function(k) { return _kpi_g_(r, CF, k); };
    // [FIX] fallback: nếu cột Date trống, dùng LH Arrived Time Finalized rồi LH Arrived Time
    var dateStr = fmtDate(g('date')) || fmtDate(g('lhArrivedFinal')) || fmtDate(g('lhArrived'));
    if (!dateStr) return null;
    var arrived = g('lhArrivedFinal') instanceof Date ? g('lhArrivedFinal') : (g('lhArrived') instanceof Date ? g('lhArrived') : null);
    var eta     = g('eta') instanceof Date ? g('eta') : null;
    var delayH  = (arrived && eta) ? Math.round(((arrived - eta) / 3600000) * 10) / 10 : null;
    return {
      id: String(g('id') || ''), date: dateStr, hub: String(g('hub') || g('pickup') || ''), category: 'FM',
      type: String(g('type') || ''), reason: String(g('reason') || ''), delayHours: delayH,
      raw: {
        pickupStation: g('pickup'), bulky: g('bulky'), dts: g('dts'), toSoc: g('toSoc'),
        pickedTime: fmtDateTime(g('picked')), inboundTime: fmtDateTime(g('inbound')), packedTime: fmtDateTime(g('packed')),
        lhArrivedTime: fmtDateTime(g('lhArrived')), lhArrivedTimeFinal: fmtDateTime(g('lhArrivedFinal')),
        lhPackedTime: fmtDateTime(g('lhPacked')), fmEta: fmtDateTime(g('eta')), cotLate: g('cotLate')
      }
    };
  }, 'FM');

  if (!fmChunk.complete) {
    _LOG.d('[KPIFail buildRecords] Hết ngân sách thời gian khi đang đọc FM (tới dòng ' + fmChunk.reachedRow + ') — dừng lại, phần còn lại sẽ đọc tiếp ở chu kỳ refresh kế tiếp.');
    return { records: records, rowCounts: { FM: fmChunk.reachedRow, LM: startRowCounts.LM || 0, SOP: startRowCounts.SOP || 0 }, fingerprints: fps, complete: false };
  }

  // LM Late Orders: A ctime_date, B Station Name, C Shipment ID, D Arrived Time,
  // E First Attempt Time, F LM ETA, G Type, H lm_inbound, I rider_id
  var lmSheet = ss.getSheetByName(KPIFAIL_SHEET_LM);
  var CL = lmSheet ? _kpifail_cols_(lmSheet, 'LM') : null; // [SỬA] dò cột theo TIÊU ĐỀ
  var lmChunk = _kpifail_readRowsBudgeted_(lmSheet, Math.max(2, (startRowCounts.LM || 0) + 1), _startTime, _sharedRowCounter);
  fps.LM = _kpifail_fpOfChunk_(lmChunk, Math.max(2, (startRowCounts.LM || 0) + 1), CL);
  buildFromRows(lmChunk.values, function(r) {
    var g = function(k) { return _kpi_g_(r, CL, k); };
    // [FIX] fallback: nếu ctime_date trống -> Arrived Time rồi First Attempt Time (nguyên nhân chính khiến LM Late = 0)
    var dateStr = fmtDate(g('date')) || fmtDate(g('arrived')) || fmtDate(g('attempt'));
    if (!dateStr) return null;
    var attempt = g('attempt') instanceof Date ? g('attempt') : null;
    var eta     = g('eta') instanceof Date ? g('eta') : null;
    var delayH  = (attempt && eta) ? Math.round(((attempt - eta) / 3600000) * 10) / 10 : null;
    return {
      id: String(g('id') || ''), date: dateStr, hub: String(g('hub') || ''), category: 'LM',
      type: String(g('type') || ''), reason: '', delayHours: delayH,
      raw: {
        arrivedTime: fmtDateTime(g('arrived')), firstAttemptTime: fmtDateTime(g('attempt')), lmEta: fmtDateTime(g('eta')),
        lmInbound: fmtDateTime(g('inbound')), riderId: g('rider') || null
      }
    };
  }, 'LM');

  if (!lmChunk.complete) {
    _LOG.d('[KPIFail buildRecords] Hết ngân sách thời gian khi đang đọc LM (tới dòng ' + lmChunk.reachedRow + ') — dừng lại, phần còn lại sẽ đọc tiếp ở chu kỳ refresh kế tiếp.');
    return { records: records, rowCounts: { FM: fmChunk.reachedRow, LM: lmChunk.reachedRow, SOP: startRowCounts.SOP || 0 }, fingerprints: fps, complete: false };
  }

  // Wrong SOP - PU Orders: A Date, B Station Name, C Shipment ID, D Type, E Pickup ETA
  var sopSheet = ss.getSheetByName(KPIFAIL_SHEET_SOP);
  var CS = sopSheet ? _kpifail_cols_(sopSheet, 'SOP') : null; // [SỬA] dò cột theo TIÊU ĐỀ
  var sopChunk = _kpifail_readRowsBudgeted_(sopSheet, Math.max(2, (startRowCounts.SOP || 0) + 1), _startTime, _sharedRowCounter);
  fps.SOP = _kpifail_fpOfChunk_(sopChunk, Math.max(2, (startRowCounts.SOP || 0) + 1), CS);
  buildFromRows(sopChunk.values, function(r) {
    var g = function(k) { return _kpi_g_(r, CS, k); };
    // [FIX] fallback: nếu Date trống -> Pickup ETA (nguyên nhân chính khiến Wrong SOP = 0)
    var dateStr = fmtDate(g('date')) || fmtDate(g('pickupEta'));
    if (!dateStr) return null;
    return {
      id: String(g('id') || ''), date: dateStr, hub: String(g('hub') || ''), category: 'SOP',
      type: String(g('type') || ''), reason: '', delayHours: null,
      raw: { pickupEta: fmtDateTime(g('pickupEta')) }
    };
  }, 'SOP');

  if (dupDropped) _LOG.d('[KPIFail buildRecords] Bỏ ' + dupDropped + ' dòng TRÙNG (cùng loại+ngày+mã đơn+trạm).');
  if (skipped.FM || skipped.LM || skipped.SOP) {
    _LOG.d('[KPIFail buildRecords] Dòng bị loại vì không xác định được ngày: ' + JSON.stringify(skipped));
  }

  return { records: records, rowCounts: { FM: fmChunk.reachedRow, LM: lmChunk.reachedRow, SOP: sopChunk.reachedRow }, fingerprints: fps,
    // [FIX LỖI THẬT — phát hiện khi thêm giới hạn số lượng] Trước đây chỉ lấy
    // sopChunk.complete — nếu FM/LM bị dừng sớm (hết ngân sách thời gian HOẶC
    // giới hạn số lượng mới thêm) nhưng SOP (thường ít dòng, đọc xong nhanh)
    // complete=true, cờ tổng thể SẼ BÁO SAI "đã xong toàn bộ" trong khi FM/LM
    // còn dở dang — hệ thống tưởng build xong, KHÔNG BAO GIỜ đọc tiếp phần còn
    // thiếu của FM/LM nữa -> MẤT DỮ LIỆU VĨNH VIỄN. Phải là AND của cả 3.
    complete: fmChunk.complete && lmChunk.complete && sopChunk.complete };
}

// Bản nhẹ cho card trang chủ — chỉ 4 số tổng + badge risk, cache 5 phút.
// Mặc định "Theo tháng hiện tại": từ ngày 01 của tháng đến NGÀY DỮ LIỆU MỚI NHẤT
// (không dùng ngày hệ thống — vì FM/LM/SOP có độ trễ báo cáo khác nhau).
// [PERF v2] Dùng kpifail_getMasterDataLite(hubName, 62) thay vì kpifail_getMasterData(180):
// - Lọc theo hub + 62 ngày NGAY TRONG vòng for đọc sheet → payload nhỏ hơn ~10-20x
// - 62 ngày = tháng này + tháng trước, đủ để tính trendPct (không cần 180 ngày)
// - Cache per (user × hub × 62d) riêng của IndexSummary, không xung đột dashboard cache
// [FIX] Helper cho cache version của kpifail_getIndexSummary — xem giải thích
// chi tiết trong comment bên trong hàm kpifail_getIndexSummary bên dưới.
function _kpifail_getIdxCacheVersion_() {
  try {
    var v = PropertiesService.getScriptProperties().getProperty('kpifail_idx_cache_ver');
    return v || '1';
  } catch (e) { return '1'; }
}
function _kpifail_bumpIdxCacheVersion_() {
  try {
    PropertiesService.getScriptProperties().setProperty('kpifail_idx_cache_ver', String(Date.now()));
  } catch (e) {}
}

function kpifail_getIndexSummary(hubName, overrideHub) {
  var sc = CacheService.getScriptCache();

  // [SECURITY FIX 2026-08] kpifail_getMasterDataLite() bên dưới ĐÃ lọc đúng theo
  // quyền người gọi (per-user), nhưng CACHE_KEY ở TẦNG NGOÀI của chính hàm này lại
  // chỉ dựa theo hubName — không có thành phần quyền/user. Hệ quả: nếu admin gọi
  // trước (hubName rỗng) và kết quả tổng hợp toàn hệ thống được cache 300s dưới key
  // 'kpifail_idx_v1_..._ALL', thì bất kỳ AOM/SUP nào gọi cùng key trong 300s đó sẽ
  // nhận thẳng data admin đã cache — bỏ qua hoàn toàn bước lọc hub bên trong
  // kpifail_getMasterDataLite() (vì cache trả sớm ở dòng "if (cached) return cached"
  // trước khi kịp gọi hàm đó). Thêm scope quyền vào cache key để triệt tiêu rò rỉ.
  var _accessForCacheScope = getModuleAccess();
  if (_accessForCacheScope.role === 'denied') {
    return JSON.stringify({ success: false, error: 'Không có quyền truy cập.' });
  }
  var _isAdminKpi = (_accessForCacheScope.role === 'admin');
  // [MỚI — theo yêu cầu trực tiếp "Tổng quan không đổi theo level"] Cùng cơ
  // chế overrideHub như aging_getIndexSummary — chỉ Admin mới dùng được.
  // [SỬA — cùng lỗi với aging_getIndexSummary] Cho người dùng thường lọc theo
  // trạm đang chọn nếu trạm nằm trong quyền; khoá cache gồm cả trạm đó.
  var _kpiAllowed = (_accessForCacheScope.hubs || []).map(function(h){ return _kpifail_normHubBase_(h); });
  // [SỬA — hỗ trợ NHIỀU TRẠM cho Xem thử cấp SUP/AOM/ROM]
  var _kpiScope = _spxScopeHubs_(overrideHub);
  var _kpiOvOk = !_kpiScope.empty && (_isAdminKpi || _kpiScope.list.every(function (h) {
    return _kpiAllowed.indexOf(_kpifail_normHubBase_(h)) >= 0;
  }));
  var _effectiveHubKpi = _kpiOvOk ? overrideHub : hubName;
  var _idxScopeKey = _isAdminKpi
    ? ('ADMIN' + (overrideHub ? '_PV_' + _kpifail_normHubBase_(overrideHub) : ''))
    : (_kpiAllowed.slice().sort().join('~') + (_kpiOvOk ? '_PV_' + _kpiScope.cacheKey() : ''));

  // [FIX] Cache key động theo trạm KHÔNG thể bị xóa bởi kpifail_clearCache() vì
  // hàm đó remove() đúng 1 key cố định 'kpifail_idx_v1' — không khớp với key thật
  // sự đang dùng ở đây ('kpifail_idx_v1_' + tên trạm). Hệ quả: card luôn trả về
  // số liệu cache cũ tới 5 phút (kể cả sau khi bấm force refresh / clear cache).
  // Thêm "version" vào key: clearCache() chỉ cần bump version để toàn bộ cache
  // theo mọi trạm (dù chưa biết tên) lập tức bị vô hiệu hóa.
  var cacheVer = _kpifail_getIdxCacheVersion_();

  // Động hóa Cache Key theo tên trạm để tránh đè dữ liệu cache giữa các bưu cục
  var cleanKey = _effectiveHubKpi ? _effectiveHubKpi.toString().replace(/[^a-zA-Z0-9]/g, '_') : 'ALL';
  // [MỚI 2026-10-24] Thêm phiên bản cache "lite" (tăng ngay khi dữ liệu KPI đổi) — trước đây khoá chỉ có phiên bản "idx"
  // (chỉ tăng khi bấm Làm mới) nên số tổng hợp có thể cũ tới hết TTL dù dữ liệu gốc đã mới.
  var CACHE_KEY = _spxSafeCacheKey_('kpifail_idx_v1_' + cacheVer + '_L' + _kpifail_getLiteCacheVersion_() + '_' + cleanKey + '_' + _idxScopeKey);
  
  try {
    var cached = _SPX_OV_FORCE_ ? null : sc.get(CACHE_KEY);
    if (cached) return cached;
  } catch (ce) {}

  try {
    // [PERF] Dùng kpifail_getMasterDataLite thay vì kpifail_getMasterData:
    // - Lọc theo hubName VÀ theo 62 ngày ngay trong vòng for khi đọc sheet
    //   (tháng này + tháng trước = đủ cho trendPct, không cần 180 ngày)
    // - Với station/SUP: payload nhỏ hơn ~10-20x so với load toàn bộ 180 ngày all hubs
    // - Cache riêng per (user × hub × 62d) — không ảnh hưởng cache của dashboard chính
    var IDX_WINDOW_DAYS = 62; // đủ tháng này + tháng trước để tính trend
    // Nhiều trạm: KHÔNG xin 'ALL' rồi lọc, vì 'ALL' với Admin là toàn hệ thống — gói
  // dữ liệu khổng lồ và có thể chạm ngưỡng chặn kích thước. Thay vào đó lấy theo
  // TỪNG TRẠM rồi gộp: mỗi trạm có bộ đệm riêng nên lượt sau rất nhanh.
  // Danh sách quá dài (AOM/ROM nhiều trạm) thì mới xin 'ALL' và lọc, vì khi đó số
  // lượt gọi nội bộ mới là thứ tốn kém hơn.
  var masterRaw;
  if (_kpiOvOk && _kpiScope.list.length > 1 && _kpiScope.list.length <= 15) {
    var _mergedRec = [], _okAll = true, _errFirst = '';
    for (var _hi = 0; _hi < _kpiScope.list.length; _hi++) {
      var _one = JSON.parse(kpifail_getMasterDataLite(_kpiScope.list[_hi], IDX_WINDOW_DAYS));
      if (!_one.success) { _okAll = false; _errFirst = _one.error || 'Lỗi đọc dữ liệu KPI.'; break; }
      _mergedRec = _mergedRec.concat(_one.records || []);
    }
    masterRaw = _okAll ? { success: true, records: _mergedRec } : { success: false, error: _errFirst };
  } else if (_kpiOvOk && _kpiScope.list.length > 15) {
    masterRaw = JSON.parse(kpifail_getMasterDataLite('ALL', IDX_WINDOW_DAYS));
    if (masterRaw.success) {
      masterRaw.records = (masterRaw.records || []).filter(function (r) { return _kpiScope.has(r.hub || ''); });
    }
  } else {
    masterRaw = JSON.parse(kpifail_getMasterDataLite(_effectiveHubKpi || 'ALL', IDX_WINDOW_DAYS));
  }
    if (!masterRaw.success) return JSON.stringify({ success: false, error: masterRaw.error });
    var records = masterRaw.records || [];
    // Không cần filter hub lại — kpifail_getMasterDataLite đã lọc server-side

    if (records.length === 0) {
      var emptyRes = JSON.stringify({
        success: true, totalFM: 0, totalLM: 0, totalSOP: 0, totalFail: 0,
        periodLabel: 'Không có dữ liệu', riskLevel: 'green', trendPct: null,
        deltaFM: 0, deltaLM: 0, deltaSOP: 0, deltaTotal: 0, latestDate: ''
      });
      sc.put(CACHE_KEY, emptyRes, 300);
      return emptyRes;
    }

    // [FIX 2026-07] Card tóm tắt ở trang chủ ghi nhãn "Tháng này" — nên PHẢI bám
    // theo ngày thực tế của hệ thống (không phải maxDate của dataset như trước).
    // Trước đây khi dữ liệu tháng mới chưa được đồng bộ, hàm này lấy maxDateStr
    // (ngày có data mới nhất, có thể vẫn thuộc tháng trước) làm mốc "tháng này"
    // → card hiển thị nguyên số liệu tháng trước nhưng gắn nhãn "Tháng này (...)",
    // khiến người dùng hiểu lầm là KPI Fail tháng hiện tại vẫn còn tồn đọng cũ.
    // Nay: nếu tháng hiện tại (theo ngày thật) chưa có bản ghi nào → trả đúng 0,
    // không fallback về tháng cũ nữa.
    var todayStr   = _kpifail_todayDateStr_();
    var monthStart = todayStr.slice(0, 7) + '-01';

    var curYear  = parseInt(todayStr.slice(0, 4), 10);
    var curMonth = parseInt(todayStr.slice(5, 7), 10);
    var dayNum   = parseInt(todayStr.slice(8, 10), 10);

    var prevMonth = curMonth - 1, prevYear = curYear;
    if (prevMonth < 1) { prevMonth = 12; prevYear -= 1; }
    var prevMonthPrefix   = prevYear + '-' + String(prevMonth).padStart(2, '0');
    var prevMonthStart    = prevMonthPrefix + '-01';
    var lastDayPrevMonth  = new Date(prevYear, prevMonth, 0).getDate();
    var prevEndDay        = Math.min(dayNum, lastDayPrevMonth);
    var prevMonthEnd      = prevMonthPrefix + '-' + String(prevEndDay).padStart(2, '0');

    var curr = records.filter(function(r) { return r.date >= monthStart && r.date <= todayStr; });
    var prev = records.filter(function(r) { return r.date >= prevMonthStart && r.date <= prevMonthEnd; });

    var totalFM   = curr.filter(function(r) { return r.category === 'FM'; }).length;
    var totalLM   = curr.filter(function(r) { return r.category === 'LM'; }).length;
    var totalSOP  = curr.filter(function(r) { return r.category === 'SOP'; }).length;
    var totalFail = totalFM + totalLM + totalSOP;
    var prevTotal = prev.length;

    var trendPct = prevTotal > 0 ? Math.round(((totalFail - prevTotal) / prevTotal) * 1000) / 10 : null;

    var riskLevel = 'green';
    if (trendPct === null) riskLevel = totalFail > 0 ? 'yellow' : 'green';
    else if (trendPct > 15) riskLevel = 'red';
    else if (trendPct > 0)  riskLevel = 'yellow';

    // ── DELTA: đơn mới CHƯA GIẢI TRÌNH — lấy đúng ngày MỚI NHẤT có dữ liệu
    // NẰM TRONG THÁNG HIỆN TẠI (curr), không dùng maxDate của toàn dataset nữa —
    // nếu tháng này chưa có data (curr rỗng) thì không có ngày nào để tính delta,
    // tránh lấy nhầm ngày của tháng trước rồi gắn nhãn "mới" sai be bét.
    var maxDateInMonth = curr.reduce(function(m, r) { return r.date > m ? r.date : m; }, '');

    var notesRes = {};
    try {
      var notesRaw = kpifail_getNotes();
      var notesParsed = typeof notesRaw === 'string' ? JSON.parse(notesRaw) : notesRaw;
      notesRes = (notesParsed && notesParsed.notes) ? notesParsed.notes : {};
    } catch(ne) {}

    // Chỉ lấy records đúng ngày maxDateInMonth (nếu có), chưa note
    var onMaxDate = maxDateInMonth ? curr.filter(function(r) {
      return r.date === maxDateInMonth && r.id && !notesRes[r.id];
    }) : [];

    var deltaFM    = onMaxDate.filter(function(r){ return r.category === 'FM';  }).length;
    var deltaLM    = onMaxDate.filter(function(r){ return r.category === 'LM';  }).length;
    var deltaSOP   = onMaxDate.filter(function(r){ return r.category === 'SOP'; }).length;
    var deltaTotal = deltaFM + deltaLM + deltaSOP;

    var fmtShort = function(s) { return s.slice(8, 10) + '/' + s.slice(5, 7); };

    // latestDate = ngày mới nhất có data TRONG tháng hiện tại — rỗng nếu tháng
    // này chưa có bản ghi nào (khi đó cũng không có delta để hiện badge "mới").
    var latestDateFM  = maxDateInMonth;
    var latestDateLM  = maxDateInMonth;
    var latestDateSOP = maxDateInMonth;

    var res = JSON.stringify({
      success: true, totalFM: totalFM, totalLM: totalLM, totalSOP: totalSOP, totalFail: totalFail,
      periodLabel: fmtShort(monthStart) + ' - ' + fmtShort(todayStr),
      riskLevel: riskLevel, trendPct: trendPct,
      deltaFM: deltaFM, deltaLM: deltaLM, deltaSOP: deltaSOP, deltaTotal: deltaTotal,
      latestDate: maxDateInMonth,
      latestDateFM: latestDateFM, latestDateLM: latestDateLM, latestDateSOP: latestDateSOP
    });
    sc.put(CACHE_KEY, res, 300);
    return res;
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

// Bản đầy đủ cho Module 8 dashboard — Fail Record trong cửa sổ thời gian gần đây,
// client tự lọc/aggregate theo Hub, khoảng ngày, loại lỗi để vẽ Ranking/Trend/
// Breakdown/Heatmap/Drill-down.
//
// GIỚI HẠN CỬA SỔ THỜI GIAN (quan trọng khi data tăng 2-3k/ngày):
// Dashboard (Trend tháng này vs tháng trước, Ranking, Heatmap...) không cần và
// không nên tải TOÀN BỘ lịch sử fail từ trước đến nay — càng nhiều dữ liệu lịch sử
// tích lũy, payload trả về client / kích thước cache càng phình to vô ích, khiến
// việc load ngày càng chậm dần theo THỜI GIAN VẬN HÀNH chứ không phải theo nhu cầu
// xem dữ liệu thực tế. Mặc định chỉ lấy 180 ngày gần nhất (đủ để so sánh tháng
// hiện tại với tháng trước + có biên độ dư). Cần xem xa hơn thì truyền daysBack lớn
// hơn (ví dụ kpifail_getMasterData(365)); truyền 0 để lấy toàn bộ (không khuyến khích
// khi data đã lớn).
var KPIFAIL_DEFAULT_WINDOW_DAYS = 180;
var KPIFAIL_PERSIST_SNAPSHOT_SHEET = 'KPIFail_Snapshot_Data';
var KPIFAIL_PERSIST_META_SHEET = 'KPIFail_Snapshot_Meta';
var KPIFAIL_PERSIST_REFRESH_LOCK_KEY = 'kpifail_snapshot_refresh_lock';
var KPIFAIL_PERSIST_REFRESH_SECONDS = 300;

// [FIX 2026-07-29] "NGÂN SÁCH THỜI GIAN" cho mọi lượt đọc sheet lớn trong KPI
// Fail — xem lý do đầy đủ ở _kpifail_readRowsBudgeted_(). Log Executions từng
// ghi nhận build toàn bộ / refresh incremental tồn đọng nhiều CHẠM TRẦN CỨNG
// 30 phút của Apps Script (Timed Out) — không có cách nào "xin thêm giờ" khi
// đã ở trong 1 execution, CHỈ có cách chủ động dừng SỚM HƠN nhiều và tiếp tục
// ở lượt sau. 270s (4.5 phút) chọn để có biên an toàn rộng so với cả trần 30
// phút (Workspace) VÀ trần 6 phút (tài khoản cá nhân) — không phụ thuộc loại
// tài khoản đang chạy trigger.
var KPIFAIL_TIME_BUDGET_MS   = 270000; // 4.5 phút/lượt — ngân sách an toàn cho MỌI loại tài khoản
var KPIFAIL_READ_BATCH_ROWS  = 20000;  // đọc theo lô, không đọc hết 1 lần để có điểm dừng giữa chừng
// [MỚI — SỬA LỖI THẬT: đo được lượt kpifail_prewarmCache chạy tới 1.711 giây
// (28.5 phút), vượt xa trần cứng 360s] Nguyên nhân: ngân sách 4.5 phút chỉ chặn
// bước ĐỌC — nếu Sheets API đọc nhanh (mạng tốt), 4.5 phút có thể đọc được RẤT
// NHIỀU dòng, và bước GHI snapshot sau đó (chunked vào Google Sheet, xem
// _kpifail_writePersistentSnapshot_) KHÔNG CÓ ngân sách gì — ghi càng nhiều
// dòng càng lâu, không kiểm soát được. Thêm trần CỨNG theo SỐ LƯỢNG (không chỉ
// thời gian) để bước ghi sau đó luôn nhận một khối lượng dự đoán được, dù
// Sheets API có đọc nhanh bất thường tới đâu.
var KPIFAIL_MAX_ROWS_PER_BUILD = 80000;

// Đọc 1 sheet theo LÔ (KPIFAIL_READ_BATCH_ROWS dòng/lô) từ startRow tới hết,
// dừng SỚM nếu vượt ngân sách thời gian còn lại — trả về đúng vị trí đã đọc
// tới (reachedRow) để lần gọi sau tiếp tục đúng từ đó, không đọc lại, không bỏ sót.
// KHÔNG BAO GIỜ đọc hết 1 sheet ~100-200k dòng trong 1 lệnh getRange() duy nhất
// nữa — đây là điểm khác biệt so với _kpifail_readSheet() (dùng cho code cũ,
// vẫn giữ nguyên cho các nơi khác không cần ngân sách thời gian).
// [MỚI] Tham số thứ 4 sharedRowCounter (object {n:0}, TÙY CHỌN) — nếu truyền
// vào, dùng CHUNG 1 bộ đếm giữa nhiều lần gọi hàm này (VD 3 sheet FM/LM/SOP
// trong 1 lượt build) để chặn TỔNG số dòng, không chỉ từng sheet riêng lẻ.
// ---- KPI Fail: đặc tả cột theo TIÊU ĐỀ (dòng 1 của mỗi sheet FM/LM/SOP, đối chiếu file export) ----
var _SPX_KPI_SPEC_ = {
  FM:  { spec: { date: ['date'], pickup: ['pickup station'], hub: ['kpi station'], id: ['shipment id', 'shipment_id'],
                 bulky: ['bulky'], dts: ['dts'], toSoc: ['to soc'], picked: ['picked time'], inbound: ['inbound time'],
                 packed: ['packed time'], lhArrived: ['lh arrived time'], lhArrivedFinal: [/^lh arrived time finali[sz]e/],
                 lhPacked: [/^lh\s*packed time/], eta: ['fm eta'], cotLate: ['# cot late'], type: ['type'], reason: ['fm late reason'] },
         req: ['date', 'hub', 'id', 'type', 'reason', 'lhArrived', 'lhArrivedFinal', 'eta'] },
  LM:  { spec: { date: ['ctime_date', 'date'], hub: ['station name'], id: ['shipment id', 'shipment_id'], arrived: ['arrived time'],
                 attempt: ['first attempt time'], eta: ['lm eta'], type: ['type'], inbound: ['lm_inbound'], rider: ['rider_id'] },
         req: ['date', 'hub', 'id', 'arrived', 'attempt', 'eta', 'type'] },
  SOP: { spec: { date: ['date'], hub: ['station name'], id: ['shipment id', 'shipment_id'], type: ['type'], pickupEta: ['pickup eta'] },
         req: ['date', 'hub', 'id', 'type', 'pickupEta'] }
};
/**
 * _kpifail_cols_(sheet, key) — dò cột sheet KPI Fail theo TIÊU ĐỀ (thay cho r[0], r[12]... cố định).
 * Thiếu cột bắt buộc -> ném lỗi rõ + ghi cảnh báo; các lượt refresh đã có try/catch nên bản
 * persistent snapshot cũ vẫn được giữ nguyên (cũ nhưng ĐÚNG, không đọc nhầm cột).
 */
function _kpifail_cols_(sheet, key) {
  var def = _SPX_KPI_SPEC_[key];
  var hdr = sheet.getRange(1, 1, 1, Math.max(sheet.getLastColumn(), 1)).getValues()[0];
  var C = _spx_findCols_(hdr, def.spec);
  try { _spx_requireCols_("Sheet KPI Fail '" + key + "'", C, def.req, hdr); }
  catch (e) { _spx_setColWarn_('kpifail:' + key, e.message); throw e; }
  _spx_setColWarn_('kpifail:' + key, null);
  return C;
}
function _kpi_g_(r, C, k) { return (C && C[k] !== undefined) ? r[C[k]] : undefined; }

// [MỚI — "KPI Fail có thể bỏ sót dòng khi nguồn ghi lại từ đầu mà số dòng không giảm"]
// Trước đây chỉ phát hiện "nguồn bị ghi lại" khi SỐ DÒNG GIẢM. Nguồn là cửa sổ trượt (mỗi ngày bỏ ngày cũ,
// thêm ngày mới) nên số dòng có thể TĂNG hoặc giữ nguyên sau khi trượt — khi đó đọc "phần sau mốc cũ" sẽ
// bỏ sót một phần dữ liệu mới mà KHÔNG AI HAY. Nay lưu thêm "VÂN TAY" (mã đơn + ngày) của dòng ĐẦU (dòng 2)
// và dòng MỐC (dòng cuối đã đọc); lượt sau đọc lại đúng 2 dòng đó, khác đi = nguồn đã đổi vị trí dòng.
function _kpifail_rowKey_(r, C) {
  if (!r || !C || C.id === undefined || C.date === undefined) return '';
  var d = r[C.date];
  var ds = (d instanceof Date) ? String(d.getTime()) : String(d == null ? '' : d);
  return String(r[C.id] == null ? '' : r[C.id]) + '~' + ds;
}
function _kpifail_fpOfChunk_(chunk, startRow, C) {
  var v = (chunk && chunk.values) || [];
  return {
    head: (startRow === 2 && v.length) ? _kpifail_rowKey_(v[0], C) : null,
    tail: v.length ? _kpifail_rowKey_(v[v.length - 1], C) : null
  };
}
var KPIFAIL_FP_NAMES_ = ['FM', 'LM', 'SOP'];
/** So vân tay đã lưu với nguồn hiện tại. Trả {rewritten, why}. Thiếu vân tay (lần đầu sau nâng cấp) = coi như cần đối soát. */
function _kpifail_sourceRewritten_(ss, snapshot, prevRowCounts) {
  var names = { FM: KPIFAIL_SHEET_FM, LM: KPIFAIL_SHEET_LM, SOP: KPIFAIL_SHEET_SOP };
  if (!snapshot || !snapshot.fp) return { rewritten: true, why: 'chưa có vân tay (lần đầu sau khi nâng cấp)' };
  for (var i = 0; i < KPIFAIL_FP_NAMES_.length; i++) {
    var k = KPIFAIL_FP_NAMES_[i];
    var prev = prevRowCounts[k] || 0;
    if (prev < 2) continue;                         // chưa đọc dòng dữ liệu nào của sheet này
    var sheet = ss.getSheetByName(names[k]);
    if (!sheet) continue;
    var fp = snapshot.fp[k];
    if (!fp || !fp.head || !fp.tail) return { rewritten: true, why: k + ': thiếu vân tay' };
    var lastRow = sheet.getLastRow();
    if (prev > lastRow) return { rewritten: true, why: k + ': dòng mốc vượt quá số dòng hiện có' };
    var C = _kpifail_cols_(sheet, k);
    var lc = Math.max(sheet.getLastColumn(), 1);
    var head = sheet.getRange(2, 1, 1, lc).getValues()[0];
    var tail = prev === 2 ? head : sheet.getRange(prev, 1, 1, lc).getValues()[0];
    if (_kpifail_rowKey_(head, C) !== fp.head) return { rewritten: true, why: k + ': dòng đầu (dòng 2) đã đổi' };
    if (_kpifail_rowKey_(tail, C) !== fp.tail) return { rewritten: true, why: k + ': dòng mốc (dòng ' + prev + ') đã đổi' };
  }
  return { rewritten: false };
}
/** Mốc PHIÊN BẢN DỮ LIỆU của snapshot (đổi khi có dòng mới / nguồn ghi lại / ngày mới nhất đổi) — KHÔNG đổi chỉ vì "chạm" lại thời gian lưu. */
function _kpifail_dataVersionOf_(m) {
  return [m.lastrow_fm, m.lastrow_lm, m.lastrow_sop, m.snapshot_max_date, m.fp_fm_head, m.fp_lm_head, m.fp_sop_head].join('|');
}
function _kpifail_dataVersionString_() {
  var sc = null, hit = null;
  try { sc = CacheService.getScriptCache(); hit = sc.get('kpifail_dataver_v1'); } catch (e0) {}
  if (hit) return hit;
  var m = _kpifail_getMetaMap_(_kpifail_getSnapshotMetaSheet_(_DS.ss(ADMIN_DB_ID))) || {};
  var v = _kpifail_dataVersionOf_(m);
  try { if (sc) sc.put('kpifail_dataver_v1', v, 30); } catch (e1) {}
  return v;
}
/**
 * kpifail_getDataVersion() — RPC THĂM DÒ NHẸ: giao diện KPI Fail hỏi định kỳ "đã có dữ liệu mới chưa?" thay vì
 * tải lại cả gói nhiều MB. Chỉ trả mốc phiên bản (1 chuỗi), cache 30 giây dùng chung.
 */
function kpifail_getDataVersion() {
  try {
    var access = getModuleAccess();
    if (!access || access.role === 'denied') return JSON.stringify({ success: false, error: 'Bạn không có quyền truy cập module này.' });
    var _flmV = 0; try { _flmV = (typeof flm_kpi_version_ === 'function') ? flm_kpi_version_() : 0; } catch (eFlm) {}
    return JSON.stringify({ success: true, version: _kpifail_dataVersionString_(), flm: _flmV });
  } catch (e) { return JSON.stringify({ success: false, error: e.message }); }
}

function _kpifail_readRowsBudgeted_(sheet, startRow, startTime, sharedRowCounter) {
  if (!sheet) return { values: [], reachedRow: startRow - 1, complete: true };
  var lastRow = sheet.getLastRow();
  var lastCol = sheet.getLastColumn();
  if (startRow > lastRow) return { values: [], reachedRow: lastRow, complete: true };

  var values = [];
  var row = startRow;
  while (row <= lastRow) {
    if (Date.now() - startTime > KPIFAIL_TIME_BUDGET_MS) {
      return { values: values, reachedRow: row - 1, complete: false };
    }
    if (sharedRowCounter && sharedRowCounter.n >= KPIFAIL_MAX_ROWS_PER_BUILD) {
      return { values: values, reachedRow: row - 1, complete: false };
    }
    var batchSize = Math.min(KPIFAIL_READ_BATCH_ROWS, lastRow - row + 1);
    var batch = sheet.getRange(row, 1, batchSize, lastCol).getValues();
    for (var i = 0; i < batch.length; i++) values.push(batch[i]);
    if (sharedRowCounter) sharedRowCounter.n += batch.length;
    row += batchSize;
  }
  return { values: values, reachedRow: lastRow, complete: true };
}
var KPIFAIL_PERSIST_OVERLAP_DAYS = 2;


// ============================================================
// PATCH: kpifail_getMasterData() + kpifail_getIndexSummary()
// Thêm phân quyền — filter records theo hub được phép
// Cache chuyển sang per-user (key theo email) — v2
// ============================================================

// ── kpifail_getMasterDataLite: lọc theo hub + date NGAY TRONG vòng for ──────
// Nhanh hơn kpifail_getMasterData khi chỉ cần 1 hub hoặc 1 khoảng ngày ngắn.
// Schema records trả về GIỐNG HỆT getMasterData → backward-compatible.
var KPIFAIL_LITE_CACHE_VERSION_KEY = 'kpifail_lite_cache_version';

function _kpifail_getLiteCacheVersion_() {
  try {
    var props = PropertiesService.getScriptProperties();
    var v = parseInt(props.getProperty(KPIFAIL_LITE_CACHE_VERSION_KEY) || '1', 10);
    return isNaN(v) ? 1 : v;
  } catch (e) {
    return 1;
  }
}

function _kpifail_bumpLiteCacheVersion_() {
  try {
    var props = PropertiesService.getScriptProperties();
    var next = _kpifail_getLiteCacheVersion_() + 1;
    props.setProperty(KPIFAIL_LITE_CACHE_VERSION_KEY, String(next));
    return next;
  } catch (e) {
    return 1;
  }
}

// ============================================================
// CHUẨN HOÁ KHOÁ TRẠM DÙNG CHUNG (single source of truth)
// ------------------------------------------------------------
// Trước đây mỗi module tự viết 1 hàm chuẩn hoá tên trạm riêng
// (Quá hạn, FMS, KPI Fail, Analytics) → cùng tên trạm có thể bị
// hiểu khác nhau giữa các module, gây lệch số liệu khi gộp dữ
// liệu theo trạm. Toàn bộ logic chuẩn hoá nay quy về một hàm
// duy nhất _normStationKey_(); các hàm cũ vẫn giữ tên gọi để
// không phải sửa hàng trăm điểm gọi, nhưng bên trong chỉ là
// wrapper gọi lại hàm chung này.
//
// opts.pakFix      (default true)  : đổi "pak" -> "pac" (đồng bộ
//                                     cách viết "Pắk"/"Pak" của Krông Pắk)
// opts.stripSuffix (default true)  : bỏ hậu tố lmhub/fmhub/hub/soc/
//                                     station/lm/fm ở cuối tên trạm
// ============================================================
function _normStationKey_(raw, opts) {
  opts = opts || {};
  if (!raw) return '';
  var s = raw.toString().toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/\u0111/g, 'd');
  if (opts.pakFix !== false) s = s.replace(/pak/g, 'pac');
  s = s.replace(/[^a-z0-9]/g, '');
  if (opts.stripSuffix !== false) {
    s = s.replace(/(lmhub|fmhub|hub|soc|station|lm|fm)$/g, '');
  }
  return s;
}

function _kpifail_normHubBase_(s) {
  // Giữ nguyên hành vi cũ: KHÔNG pakFix, KHÔNG strip hậu tố — dùng cho so khớp nghiêm ngặt.
  return _normStationKey_(s, { pakFix: false, stripSuffix: false });
}

function _kpifail_normHubUI_(s) {
  // Giữ nguyên hành vi cũ: có pakFix + strip hậu tố — dùng cho so khớp lỏng (input người dùng gõ).
  return _normStationKey_(s, { pakFix: true, stripSuffix: true });
}

function _kpifail_matchHub_(recordHub, hubName, hubTargetNorm) {
  if (!hubName) return true;
  var rHub = _kpifail_normHubBase_(recordHub);
  var rHubUI = _kpifail_normHubUI_(recordHub);
  for (var i = 0; i < hubTargetNorm.length; i++) {
    if (rHub === hubTargetNorm[i] || rHubUI === hubTargetNorm[i]) return true;
  }
  return false;
}

// [FIX 2026-07-28] Đổi 1 sheet snapshot thành 2 sheet luân phiên (ping-pong, hậu tố
// _A / _B) — xem lý do đầy đủ ở _kpifail_writePersistentSnapshot_ bên dưới.
function _kpifail_getSnapshotSheet_(ss, slot) {
  var name = KPIFAIL_PERSIST_SNAPSHOT_SHEET + '_' + (slot === 'B' ? 'B' : 'A');
  var sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
    sheet.appendRow(['Key', 'ChunkIndex', 'ChunkData']);
    sheet.setFrozenRows(1);
    sheet.getRange(1, 1, 1, 3).setFontWeight('bold');
  }
  return sheet;
}

function _kpifail_getSnapshotMetaSheet_(ss) {
  var sheet = ss.getSheetByName(KPIFAIL_PERSIST_META_SHEET);
  if (!sheet) {
    sheet = ss.insertSheet(KPIFAIL_PERSIST_META_SHEET);
    sheet.appendRow(['Key', 'Value']);
    sheet.setFrozenRows(1);
    sheet.getRange(1, 1, 1, 2).setFontWeight('bold');
  }
  return sheet;
}

function _kpifail_getMetaMap_(sheet) {
  var map = {};
  if (!sheet || sheet.getLastRow() < 2) return map;
  var values = sheet.getRange(2, 1, sheet.getLastRow() - 1, 2).getDisplayValues();
  for (var i = 0; i < values.length; i++) {
    var key = String(values[i][0] || '').trim();
    if (key) map[key] = values[i][1];
  }
  return map;
}

function _kpifail_setMetaMap_(sheet, map) {
  var rows = [['Key', 'Value']];
  var keys = Object.keys(map || {}).sort();
  for (var i = 0; i < keys.length; i++) rows.push([keys[i], map[keys[i]]]);
  sheet.clearContents();
  sheet.getRange(1, 1, rows.length, 2).setValues(rows);
  sheet.getRange(1, 1, 1, 2).setFontWeight('bold');
}

function _kpifail_readPersistentSnapshot_() {
  try {
    var ss = _DS.ss(ADMIN_DB_ID);
    var metaSheet = _kpifail_getSnapshotMetaSheet_(ss);
    var metaMap = _kpifail_getMetaMap_(metaSheet);
    if (!metaMap.snapshot_version) return null;
    // [FIX 2026-07-28] Đọc đúng slot đang ACTIVE (đã ghi xong hoàn chỉnh) — không
    // đọc slot đang được ghi dở (nếu có) — xem giải thích ở hàm ghi bên dưới.
    var activeSlot = metaMap.snapshot_active_slot === 'B' ? 'B' : 'A';
    var dataSheet = _kpifail_getSnapshotSheet_(ss, activeSlot);
    if (dataSheet.getLastRow() < 2) return null;
    var rows = dataSheet.getRange(2, 1, dataSheet.getLastRow() - 1, 3).getDisplayValues();
    var chunks = [];
    for (var i = 0; i < rows.length; i++) {
      if (rows[i][0] !== 'snapshot') continue;
      chunks.push({ idx: Number(rows[i][1]) || 0, data: rows[i][2] || '' });
    }
    if (!chunks.length) return null;
    chunks.sort(function(a, b) { return a.idx - b.idx; });
    var json = chunks.map(function(c) { return c.data; }).join('');
    var parsed = JSON.parse(json);
    if (!parsed || !Array.isArray(parsed.records)) return null;
    return {
      records: parsed.records,
      version: metaMap.snapshot_version || '',
      maxDate: metaMap.snapshot_max_date || '',
      savedAt: metaMap.snapshot_saved_at || '',
      count: Number(metaMap.snapshot_count) || parsed.records.length,
      // [FIX 2026-07-28] Mốc số dòng đã đọc tới lần trước cho từng sheet nguồn — dùng
      // để lần refresh sau chỉ đọc DÒNG MỚI THÊM VÀO thay vì quét lại toàn bộ sheet.
      lastRowFM:  Number(metaMap.lastrow_fm)  || 0,
      lastRowLM:  Number(metaMap.lastrow_lm)  || 0,
      lastRowSOP: Number(metaMap.lastrow_sop) || 0,
      // [MỚI] Vân tay dòng đầu/dòng mốc đã đọc — để phát hiện nguồn ghi lại mà số dòng không giảm
      fp: (metaMap.fp_fm_head || metaMap.fp_lm_head || metaMap.fp_sop_head) ? {
        FM:  { head: metaMap.fp_fm_head  || '', tail: metaMap.fp_fm_tail  || '' },
        LM:  { head: metaMap.fp_lm_head  || '', tail: metaMap.fp_lm_tail  || '' },
        SOP: { head: metaMap.fp_sop_head || '', tail: metaMap.fp_sop_tail || '' }
      } : null
    };
  } catch (e) {
    return null;
  }
}

function _kpifail_writePersistentSnapshot_(records, maxDate, rowCounts, fps) {
  var ss = _DS.ss(ADMIN_DB_ID);
  var metaSheet = _kpifail_getSnapshotMetaSheet_(ss);
  // [FIX 2026-07-28] "GHI AN TOÀN" kiểu ping-pong: đọc slot đang active TRƯỚC,
  // rồi ghi bản mới vào SLOT CÒN LẠI (không đụng gì tới slot đang active) — chỉ
  // sau khi ghi xong HOÀN TOÀN mới đổi con trỏ snapshot_active_slot sang slot
  // mới (1 lệnh ghi nhỏ, nhanh, gần như tức thời). Lý do: log Executions thực tế
  // cho thấy khi build toàn bộ chạm trần 30 phút và bị Apps Script giết giữa
  // chừng, nếu vẫn ghi kiểu "xoá sheet cũ rồi ghi mới" (1 sheet duy nhất), sheet
  // có thể bị bỏ trống dở dang đúng lúc bị giết -> snapshot hỏng -> lần đọc kế
  // tiếp tưởng chưa từng build -> build lại toàn bộ lần nữa -> lại có nguy cơ
  // timeout -> lặp lại nhiều lần (đã thấy đúng chuỗi 3 lượt Timed Out liên tiếp
  // sau lượt build đêm lúc 02:23:55 bị Timed Out). Với ping-pong: bị giết giữa
  // chừng lúc nào cũng chỉ làm hỏng slot ĐANG GHI (chưa ai đọc) — slot active cũ
  // vẫn nguyên vẹn, người đọc không hề bị ảnh hưởng.
  var oldMeta = _kpifail_getMetaMap_(metaSheet);
  var oldActiveSlot = oldMeta.snapshot_active_slot === 'B' ? 'B' : 'A';
  var newSlot = oldActiveSlot === 'A' ? 'B' : 'A';
  var dataSheet = _kpifail_getSnapshotSheet_(ss, newSlot);

  var json = JSON.stringify({ records: records || [] });
  var chunkSize = 45000;
  var rows = [['Key', 'ChunkIndex', 'ChunkData']];
  var idx = 0;
  for (var pos = 0; pos < json.length; pos += chunkSize) {
    rows.push(['snapshot', idx++, json.slice(pos, pos + chunkSize)]);
  }
  dataSheet.clearContents();
  dataSheet.getRange(1, 1, rows.length, 3).setValues(rows);
  dataSheet.getRange(1, 1, 1, 3).setFontWeight('bold');

  var nowIso = Utilities.formatDate(new Date(), SPX_TZ, "yyyy-MM-dd'T'HH:mm:ss");
  var metaUpdate = {
    snapshot_version: String(Date.now()),
    snapshot_max_date: maxDate || '',
    snapshot_saved_at: nowIso,
    snapshot_count: String((records || []).length),
    // Ghi xong hẳn rồi mới tới đây -> an toàn để đổi con trỏ sang slot mới.
    snapshot_active_slot: newSlot
  };
  // [FIX 2026-07-28] Mốc số dòng nguồn (đọc theo VỊ TRÍ DÒNG thay vì theo ngày —
  // xem _kpifail_readSourceRowsSince_). Nếu lượt này có đọc thật (rowCounts được
  // truyền vào) -> lưu mốc mới. Nếu chỉ "chạm" lại timestamp (vd bỏ qua vì nguồn
  // không ổn định) -> GIỮ NGUYÊN mốc cũ, không được ghi đè bằng rowCounts thiếu/0,
  // nếu không lần refresh kế tiếp sẽ tưởng chưa từng đọc gì và đọc lại từ đầu.
  if (rowCounts) {
    metaUpdate.lastrow_fm  = String(rowCounts.FM  || 0);
    metaUpdate.lastrow_lm  = String(rowCounts.LM  || 0);
    metaUpdate.lastrow_sop = String(rowCounts.SOP || 0);
  } else {
    if (oldMeta.lastrow_fm  !== undefined) metaUpdate.lastrow_fm  = oldMeta.lastrow_fm;
    if (oldMeta.lastrow_lm  !== undefined) metaUpdate.lastrow_lm  = oldMeta.lastrow_lm;
    if (oldMeta.lastrow_sop !== undefined) metaUpdate.lastrow_sop = oldMeta.lastrow_sop;
  }
  // [MỚI] Vân tay: lượt này có đọc dòng nào của sheet nào thì ghi vân tay mới của sheet đó; không đọc gì thì GIỮ
  // vân tay cũ (mốc không đổi). Người gọi truyền rowCounts mà quên fps -> bỏ vân tay (lượt sau sẽ đối soát lại).
  if (!(rowCounts && !fps)) {
    ['FM', 'LM', 'SOP'].forEach(function (k) {
      var lk = k.toLowerCase();
      var n = (rowCounts && fps && fps[k]) ? fps[k] : null;
      var head = (n && n.head) ? n.head : oldMeta['fp_' + lk + '_head'];
      var tail = (n && n.tail) ? n.tail : oldMeta['fp_' + lk + '_tail'];
      if (head) metaUpdate['fp_' + lk + '_head'] = head;
      if (tail) metaUpdate['fp_' + lk + '_tail'] = tail;
    });
  }
  _kpifail_setMetaMap_(metaSheet, metaUpdate);
  // [MỚI] Dữ liệu thật sự đổi -> bỏ cache gói tổng hợp (khoá gắn số phiên bản) và cache mốc phiên bản, để mọi
  // người dùng nhận bản mới ngay lượt kế thay vì chờ hết TTL 10 phút; khớp với mốc kpifail_getDataVersion().
  if (_kpifail_dataVersionOf_(oldMeta) !== _kpifail_dataVersionOf_(metaUpdate)) {
    _kpifail_bumpLiteCacheVersion_();
    try { CacheService.getScriptCache().remove('kpifail_dataver_v1'); } catch (eRm) {}
  }
}

function _kpifail_resetPersistentSnapshot_() {
  try {
    var ss = _DS.ss(ADMIN_DB_ID);
    // [FIX 2026-07-28] Dọn CẢ HAI slot (A và B) — reset kiểu cũ chỉ dọn 1 sheet là
    // đủ vì trước đây chỉ có 1 sheet; giờ có 2 slot ping-pong nên phải dọn cả 2,
    // nếu không dữ liệu cũ ở slot còn lại có thể bị đọc nhầm là "active" sau khi
    // metaSheet bị xoá (mặc định activeSlot='A' khi thiếu key snapshot_active_slot).
    _kpifail_getSnapshotSheet_(ss, 'A').clearContents();
    _kpifail_getSnapshotSheet_(ss, 'A').getRange(1, 1, 1, 3).setValues([['Key', 'ChunkIndex', 'ChunkData']]).setFontWeight('bold');
    _kpifail_getSnapshotSheet_(ss, 'B').clearContents();
    _kpifail_getSnapshotSheet_(ss, 'B').getRange(1, 1, 1, 3).setValues([['Key', 'ChunkIndex', 'ChunkData']]).setFontWeight('bold');
    var metaSheet = _kpifail_getSnapshotMetaSheet_(ss);
    metaSheet.clearContents();
    metaSheet.getRange(1, 1, 1, 2).setValues([['Key', 'Value']]).setFontWeight('bold');
  } catch (e) {}
}

function _kpifail_canUseRefreshLock_() {
  try {
    var props = PropertiesService.getScriptProperties();
    var now = Date.now();
    var raw = props.getProperty(KPIFAIL_PERSIST_REFRESH_LOCK_KEY) || '';
    if (raw) {
      var until = Number(raw);
      if (!isNaN(until) && until > now) return false;
    }
    props.setProperty(KPIFAIL_PERSIST_REFRESH_LOCK_KEY, String(now + KPIFAIL_PERSIST_REFRESH_SECONDS * 1000));
    return true;
  } catch (e) {
    return true;
  }
}

function _kpifail_releaseRefreshLock_() {
  try {
    PropertiesService.getScriptProperties().deleteProperty(KPIFAIL_PERSIST_REFRESH_LOCK_KEY);
  } catch (e) {}
}

function _kpifail_subtractDays_(dateStr, days) {
  if (!dateStr) return '';
  var p = String(dateStr).split('-');
  if (p.length !== 3) return '';
  // [SỬA] Toán LỊCH THUẦN trên chuỗi ngày (qua UTC) — kết quả không phụ thuộc múi giờ nào.
  var d = new Date(Date.UTC(Number(p[0]), Number(p[1]) - 1, Number(p[2])));
  d.setUTCDate(d.getUTCDate() - Number(days || 0));
  return d.toISOString().slice(0, 10);
}

function _kpifail_mergeRecords_(baseRecords, deltaRecords, refreshFromDate) {
  var merged = [];
  var map = {};
  var cutoff = refreshFromDate || '';
  var makeKey = function(rec) {
    return [rec.category || '', rec.date || '', rec.id || '', rec.hub || ''].join('|');
  };

  for (var i = 0; i < (baseRecords || []).length; i++) {
    var rec = baseRecords[i];
    if (!rec || !rec.id || !rec.date) continue;
    if (cutoff && rec.date >= cutoff) continue;
    var oldKey = makeKey(rec);
    if (map[oldKey]) continue;
    map[oldKey] = 1;
    merged.push(rec);
  }

  for (var j = 0; j < (deltaRecords || []).length; j++) {
    var dRec = deltaRecords[j];
    if (!dRec || !dRec.id || !dRec.date) continue;
    var key = makeKey(dRec);
    if (map[key]) continue;
    map[key] = 1;
    merged.push(dRec);
  }

  merged.sort(function(a, b) {
    if ((a.date || '') === (b.date || '')) return String(b.id || '').localeCompare(String(a.id || ''));
    return String(b.date || '').localeCompare(String(a.date || ''));
  });
  return merged;
}

// [FIX 2026-07-28] Đọc số dòng HIỆN TẠI của 3 sheet nguồn — chỉ gọi getLastRow()
// (rẻ, không tải dữ liệu), dùng để so với mốc đã lưu lần trước nhằm phát hiện
// dòng mới thêm HOẶC phát hiện sheet bị ghi lại từ đầu (số dòng giảm đột ngột).
function _kpifail_getSourceRowCounts_(ss) {
  var names = { FM: KPIFAIL_SHEET_FM, LM: KPIFAIL_SHEET_LM, SOP: KPIFAIL_SHEET_SOP };
  var out = { FM: 0, LM: 0, SOP: 0 };
  for (var k in names) {
    var sh = ss.getSheetByName(names[k]);
    out[k] = sh ? sh.getLastRow() : 0;
  }
  return out;
}

// [FIX 2026-07-28] THAY THẾ _kpifail_readSourceDeltaSince_ (đọc theo NGÀY, phải
// quét toàn bộ sheet mỗi lần vì không dám "break" sớm — xem log Executions: có
// sheet ~200k dòng, mỗi lượt "delta" vẫn mất 500-1800s vì thực chất là full scan).
//
// Hàm mới đọc theo VỊ TRÍ DÒNG: chỉ lấy phần dòng nằm SAU mốc đã đọc lần trước
// (prevRowCounts.FM/LM/SOP, lưu trong snapshot metadata). Giả định duy nhất cần
// có: dữ liệu ghi vào sheet luôn NỐI THÊM Ở CUỐI theo thời điểm ghi — đây là
// giả định VỀ VỊ TRÍ LƯU TRỮ (luôn đúng với append/batch-update qua Sheets API),
// khác hẳn giả định cũ đã gây bug là "cột ngày bên trong luôn tăng dần" (không
// đúng, vì nhiều hub ghi xen kẽ). Nhờ vậy có thể "break" an toàn: chỉ đọc đúng
// (curRow - prevRow) dòng mới, không cần quét lại lịch sử.
//
// Rủi ro còn lại (đã biết, chấp nhận có chủ đích): nếu hệ thống nguồn SỬA LẠI
// dữ liệu Ở GIỮA sheet (backfill dòng cũ) thay vì chỉ nối thêm, cách này sẽ
// không thấy được thay đổi đó cho tới lần full-rebuild định kỳ tiếp theo (xem
// kpifail_forceFullRebuild + trigger hằng ngày mới thêm). Đánh đổi có chủ đích:
// đổi 1 ngày trễ tối đa cho các bản sửa dữ liệu cũ, lấy lại tốc độ cho >99% chu
// kỳ refresh (chỉ còn tỉ lệ với số dòng MỚI trong 5 phút, không phải toàn bộ lịch sử).
function _kpifail_readSourceRowsSince_(ss, prevRowCounts) {
  var tz = SPX_TZ;
  // [FIX] Dùng cùng parseAnyDate() với _kpifail_buildRecords() để 2 đường đọc
  // (full rebuild và delta refresh) luôn cho ra cùng kết quả — tránh trường
  // hợp full rebuild thấy record (nhờ fallback) nhưng delta refresh lại không.
  var parseAnyDate = function(v) {
    if (v instanceof Date && !isNaN(v.getTime())) return v;
    if (typeof v === 'string' && v.trim()) {
      var s = v.trim();
      var m = s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
      if (m) {
        var d1 = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
        if (!isNaN(d1.getTime())) return d1;
      }
      m = s.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{4})/);
      if (m) {
        var d2 = new Date(Number(m[3]), Number(m[2]) - 1, Number(m[1]));
        if (!isNaN(d2.getTime())) return d2;
      }
      var d3 = new Date(s);
      if (!isNaN(d3.getTime())) return d3;
    }
    if (typeof v === 'number' && v > 0) {
      // [FIX-TZ] Dùng epoch neo theo giờ local của Apps Script (= project
      // Time Zone) thay vì UTC cứng, để khớp với cách toàn bộ code còn lại
      // đang quy đổi ngày theo Asia/Ho_Chi_Minh — tránh lệch ngày gần mốc
      // nửa đêm nếu nhánh fallback số serial này từng bị kích hoạt.
      var epochLocal = new Date(1899, 11, 30);
      var d4 = new Date(epochLocal.getTime() + Math.round(v * 86400000));
      if (!isNaN(d4.getTime())) return d4;
    }
    return null;
  };
  var fmtDate = function(d) {
    var dd = parseAnyDate(d);
    return dd ? Utilities.formatDate(dd, tz, 'yyyy-MM-dd') : null;
  };
  var fmtDateTime = function(d) {
    var dd = parseAnyDate(d);
    return dd ? Utilities.formatDate(dd, tz, 'yyyy-MM-dd HH:mm') : null;
  };

  var _startTime = Date.now();

  function readNewRows(sheetName, prevCount, buildRecord, key) {
    var sheet = ss.getSheetByName(sheetName);
    if (!sheet) return { records: [], reachedRow: prevCount || 0, complete: true };
    var C = _kpifail_cols_(sheet, key); // [SỬA] dò cột theo TIÊU ĐỀ (thay r[0], r[12]... cố định)
    var startRow = Math.max(2, (prevCount || 0) + 1);
    var chunk = _kpifail_readRowsBudgeted_(sheet, startRow, _startTime);
    var out = [];
    for (var i = 0; i < chunk.values.length; i++) {
      var r = chunk.values[i];
      var sortDateStr = fmtDate(C.date !== undefined ? r[C.date] : undefined);
      var rec = buildRecord(r, sortDateStr, fmtDate, fmtDateTime, C);
      if (rec) out.push(rec);
    }
    // reachedRow có thể < startRow-1 khi hoàn toàn không đọc được gì (hết ngân
    // sách ngay từ đầu) — giữ nguyên prevCount trong trường hợp đó, không lùi mốc.
    var reached = Math.max(chunk.reachedRow, (prevCount || 0));
    return { records: out, reachedRow: reached, complete: chunk.complete, fp: _kpifail_fpOfChunk_(chunk, startRow, C) };
  }

  // [FIX 2026-07-29] Xử lý TUẦN TỰ FM → LM → SOP, dùng CHUNG 1 ngân sách thời
  // gian (_startTime) cho cả 3 — dừng lại NGAY tại sheet đầu tiên hết ngân sách,
  // KHÔNG đụng tới các sheet sau (giữ nguyên mốc cũ của chúng, chưa đọc gì thêm
  // ở lượt này — sẽ đọc bù ở lượt kế tiếp). Không bao giờ để 1 lượt gọi vượt
  // quá KPIFAIL_TIME_BUDGET_MS, dù tồn đọng bao nhiêu dòng.
  var fmResult = readNewRows(KPIFAIL_SHEET_FM, prevRowCounts.FM, function(r, sortDateStr, fd, fmt, C) {
    var g = function(k) { return _kpi_g_(r, C, k); };
    // [FIX] fallback: nếu cột Date trống, dùng LH Arrived Time Finalized rồi LH Arrived Time
    var dateStr = sortDateStr || fd(g('lhArrivedFinal')) || fd(g('lhArrived'));
    if (!dateStr) return null;
    var arrived = g('lhArrivedFinal') instanceof Date ? g('lhArrivedFinal') : (g('lhArrived') instanceof Date ? g('lhArrived') : null);
    var eta = g('eta') instanceof Date ? g('eta') : null;
    var delayH = (arrived && eta) ? Math.round(((arrived - eta) / 3600000) * 10) / 10 : null;
    return {
      id: String(g('id') || ''), date: dateStr, hub: String(g('hub') || g('pickup') || ''), category: 'FM',
      type: String(g('type') || ''), reason: String(g('reason') || ''), delayHours: delayH,
      raw: {
        pickupStation: g('pickup'), bulky: g('bulky'), dts: g('dts'), toSoc: g('toSoc'),
        pickedTime: fmt(g('picked')), inboundTime: fmt(g('inbound')), packedTime: fmt(g('packed')),
        lhArrivedTime: fmt(g('lhArrived')), lhArrivedTimeFinal: fmt(g('lhArrivedFinal')),
        lhPackedTime: fmt(g('lhPacked')), fmEta: fmt(g('eta')), cotLate: g('cotLate')
      }
    };
  }, 'FM');

  if (!fmResult.complete) {
    return {
      records: fmResult.records,
      rowCounts: { FM: fmResult.reachedRow, LM: prevRowCounts.LM, SOP: prevRowCounts.SOP },
      fingerprints: { FM: fmResult.fp },
      complete: false
    };
  }

  var lmResult = readNewRows(KPIFAIL_SHEET_LM, prevRowCounts.LM, function(r, sortDateStr, fd, fmt, C) {
    var g = function(k) { return _kpi_g_(r, C, k); };
    // [FIX] fallback ctime_date trống -> Arrived Time -> First Attempt Time
    var dateStr = sortDateStr || fd(g('arrived')) || fd(g('attempt'));
    if (!dateStr) return null;
    var attempt = g('attempt') instanceof Date ? g('attempt') : null;
    var eta = g('eta') instanceof Date ? g('eta') : null;
    var delayH = (attempt && eta) ? Math.round(((attempt - eta) / 3600000) * 10) / 10 : null;
    return {
      id: String(g('id') || ''), date: dateStr, hub: String(g('hub') || ''), category: 'LM',
      type: String(g('type') || ''), reason: '', delayHours: delayH,
      raw: {
        arrivedTime: fmt(g('arrived')), firstAttemptTime: fmt(g('attempt')), lmEta: fmt(g('eta')),
        lmInbound: fmt(g('inbound')), riderId: g('rider') || null
      }
    };
  }, 'LM');

  if (!lmResult.complete) {
    return {
      records: fmResult.records.concat(lmResult.records),
      rowCounts: { FM: fmResult.reachedRow, LM: lmResult.reachedRow, SOP: prevRowCounts.SOP },
      fingerprints: { FM: fmResult.fp, LM: lmResult.fp },
      complete: false
    };
  }

  var sopResult = readNewRows(KPIFAIL_SHEET_SOP, prevRowCounts.SOP, function(r, sortDateStr, fd, fmt, C) {
    var g = function(k) { return _kpi_g_(r, C, k); };
    // [FIX] fallback Date trống -> Pickup ETA
    var dateStr = sortDateStr || fd(g('pickupEta'));
    if (!dateStr) return null;
    return {
      id: String(g('id') || ''), date: dateStr, hub: String(g('hub') || ''), category: 'SOP',
      type: String(g('type') || ''), reason: '', delayHours: null,
      raw: { pickupEta: fmt(g('pickupEta')) }
    };
  }, 'SOP');

  return {
    records: fmResult.records.concat(lmResult.records).concat(sopResult.records),
    rowCounts: { FM: fmResult.reachedRow, LM: lmResult.reachedRow, SOP: sopResult.reachedRow },
    fingerprints: { FM: fmResult.fp, LM: lmResult.fp, SOP: sopResult.fp },
    complete: sopResult.complete
  };
}

// [MỚI] Tín hiệu "vừa có thay đổi" từ onChange trigger (xem
// kpifail_setupSourceChangeWatcher() / _kpifail_onSourceChanged_ bên dưới).
// Mỗi lần sheet nguồn bị sửa (dù bởi UI hay service account ghi qua API),
// trigger tự cập nhật property này — không cần đoán bằng cách đọc lặp lại.
var KPIFAIL_SOURCE_CHANGE_TS_PROP = 'kpifail_source_last_change_ts';
// Khoảng "im lặng" tối thiểu sau lần đổi gần nhất mới coi là an toàn để đọc.
// [FIX] Tăng từ 8s -> 15s: dữ liệu có ngày lên tới ~200k dòng, một lần ghi như
// vậy khó mà "hiện ra 1 phát" — thực tế thường được chia thành nhiều batch, có
// thể có khoảng nghỉ NGẮN giữa các batch (vài giây) trong lúc bên ghi xử lý dữ
// liệu. Nếu quiet-period quá ngắn, ta có thể lầm tưởng "đã ghi xong" ngay giữa
// 2 batch rồi đọc trúng phần chưa ghi tới. 15s là mức đánh đổi an toàn hơn,
// chấp nhận dashboard có thể "cũ" thêm vài giây trong những ngày ghi nhiều, để
// đổi lại gần như chắc chắn không đọc trúng lúc đang ghi. Có thể tăng thêm nếu
// vẫn còn gặp trường hợp mất dữ liệu giữa ngày sau khi áp fix này.
var KPIFAIL_SOURCE_QUIET_MS = 15000;

// Handler của onChange trigger — CHỈ ghi timestamp, không làm gì nặng, để mỗi
// lần trigger nổ (có thể nổ nhiều lần liên tiếp nếu bên ghi làm nhiều bước)
// không tốn quota/tài nguyên. Không tự gọi hàm này trực tiếp — do trigger gọi.
function _kpifail_onSourceChanged_(e) {
  try {
    PropertiesService.getScriptProperties().setProperty(KPIFAIL_SOURCE_CHANGE_TS_PROP, String(Date.now()));
  } catch (err) {}
}

// [MỚI] Chạy 1 LẦN DUY NHẤT (trong Apps Script Editor) để bật theo dõi thay đổi
// trên spreadsheet NGUỒN (KPIFAIL_SS_ID) — LƯU Ý: đây là 1 spreadsheet KHÁC với
// spreadsheet đang chứa script này, nên cần tài khoản chạy hàm này có QUYỀN CHỈNH
// SỬA (không chỉ xem) trên KPIFAIL_SS_ID, nếu không ScriptApp.newTrigger() sẽ báo
// lỗi quyền. Nếu không có quyền chỉnh sửa, nhờ người có quyền (vd chủ sở hữu
// service account data-dashboard hoặc admin sheet đó) chạy hộ 1 lần.
//
// ⚠️ [BẮT BUỘC CHẠY LẠI SAU KHI ĐỔI NGUỒN DỮ LIỆU] Trigger onChange gắn CỨNG vào
// ĐÚNG 1 spreadsheet cụ thể tại thời điểm tạo. Khi KPIFAIL_SS_ID đổi sang
// spreadsheet mới, trigger cũ VẪN theo dõi spreadsheet CŨ — tức là không còn tác
// dụng, mà cũng không báo lỗi gì (im lặng sai). Hàm này tự xoá trigger cũ trước
// khi tạo mới nên chỉ cần chạy lại 1 lần là xong.
function kpifail_setupSourceChangeWatcher() {
  // [SECURITY FIX 2026-08] Hàm tạo/xoá Trigger cấp project — trước đây không kiểm
  // tra quyền, ai gọi cũng chỉnh được trigger hệ thống. Chỉ admin mới được chạy.
  _requireAdmin_(1);
  ScriptApp.getProjectTriggers().forEach(function(t) {
    if (t.getHandlerFunction() === '_kpifail_onSourceChanged_') ScriptApp.deleteTrigger(t);
  });
  var ssSrc = _DS.ss(KPIFAIL_SS_ID);
  ScriptApp.newTrigger('_kpifail_onSourceChanged_')
    .forSpreadsheet(ssSrc)
    .onChange()
    .create();
  _LOG.d('✅ Trigger onChange cho KPIFAIL_SS_ID đã được tạo — mọi lần sheet nguồn bị sửa (dù qua UI hay API) sẽ tự cập nhật mốc thời gian để _kpifail_waitForStableSource_() dùng.');
}

// Kiểm tra nhanh trigger có đang tồn tại + hoạt động không — chạy trong Editor
// để xác nhận sau khi setup, hoặc để soát khi nghi trigger bị mất/hỏng.
function kpifail_checkSourceChangeWatcherStatus() {
  var found = ScriptApp.getProjectTriggers().some(function(t) {
    return t.getHandlerFunction() === '_kpifail_onSourceChanged_';
  });
  var lastTs = PropertiesService.getScriptProperties().getProperty(KPIFAIL_SOURCE_CHANGE_TS_PROP);
  var result = {
    triggerInstalled: found,
    lastChangeDetected: lastTs ? new Date(Number(lastTs)).toString() : '(chưa ghi nhận lần nào)'
  };
  _LOG.d(JSON.stringify(result));
  return JSON.stringify(result);
}

// [MỚI] Kiểm tra chủ động: nguồn (3 sheet FM/LM/SOP) có đang bị ghi/cập nhật
// ngay lúc này không — trước khi đọc để build/refresh. 2 lớp, theo thứ tự:
//
// LỚP 1 — tín hiệu onChange (nếu đã setup qua kpifail_setupSourceChangeWatcher()):
// nếu sheet nguồn vừa bị sửa trong vòng KPIFAIL_SOURCE_QUIET_MS gần nhất -> coi
// là KHÔNG ổn định NGAY, không cần đọc gì cả (rẻ, và bắt được cả trường hợp ghi
// KHÔNG đổi getLastRow() — ví dụ ghi đè giá trị các dòng đã có mà không thêm/xoá
// dòng — vốn là điểm mù của cách đọc-lặp-lại ở Lớp 2).
//
// LỚP 2 — đọc-lặp-lại getLastRow() (cách cũ, luôn chạy dù Lớp 1 có hay không):
// đọc getLastRow() của cả 3 sheet, đợi 1.5s, đọc lại — số dòng đổi giữa 2 lần
// đọc nghĩa là đang có ghi. Đây là lớp AN TOÀN ĐỘC LẬP — vẫn hoạt động dù trigger
// onChange ở Lớp 1 chưa từng setup, bị lỗi quyền, hoặc âm thầm bị xoá/hỏng sau
// này mà không ai để ý (không phụ thuộc "trigger còn sống hay không").
//
// Chỉ coi là ổn định khi CẢ HAI lớp đều xác nhận.
function _kpifail_waitForStableSource_(ss, maxAttempts) {
  // Lớp 1: tín hiệu onChange (best-effort — property có thể chưa từng tồn tại
  // nếu chưa setup trigger, khi đó bỏ qua lớp này, không chặn oan).
  try {
    var lastChangeTs = PropertiesService.getScriptProperties().getProperty(KPIFAIL_SOURCE_CHANGE_TS_PROP);
    if (lastChangeTs) {
      var elapsedMs = Date.now() - Number(lastChangeTs);
      if (elapsedMs < KPIFAIL_SOURCE_QUIET_MS) return false;
    }
  } catch (e) {}

  // Lớp 2: đọc-lặp-lại getLastRow() — luôn chạy, không phụ thuộc Lớp 1.
  maxAttempts = maxAttempts || 2;
  var sheetNames = [KPIFAIL_SHEET_FM, KPIFAIL_SHEET_LM, KPIFAIL_SHEET_SOP];
  var snap = function() {
    return sheetNames.map(function(name) {
      var sh = ss.getSheetByName(name);
      return sh ? sh.getLastRow() : -1;
    }).join(',');
  };
  for (var attempt = 0; attempt < maxAttempts; attempt++) {
    var before = snap();
    Utilities.sleep(1500);
    var after = snap();
    if (before === after) return true;
  }
  return false;
}

/**
 * _kpifail_scopeKey_(access)
 * [MỚI — tối ưu quy mô 2k user] Sinh khoá cache theo PHẠM VI QUYỀN thay vì
 * theo từng email. Hai người CÙNG quyền -> CÙNG khoá -> dùng chung 1 bản cache
 * (nội dung vốn đã y hệt nhau), thay vì mỗi người 1 bản trùng lặp.
 * Có chốt độ dài: với tài khoản phạm vi rộng (tới ~1.000 trạm), danh sách hub
 * nối chuỗi sẽ rất dài — vượt giới hạn độ dài khoá cache. Khi đó rút gọn bằng
 * hash ổn định (cùng danh sách luôn ra cùng hash) + kèm số lượng hub để giảm
 * tối đa khả năng trùng khoá giữa 2 phạm vi khác nhau.
 */
function _kpifail_scopeKey_(access) {
  if (!access || access.role === 'admin') return 'admin';
  var hubs = (access.hubs && access.hubs.length) ? access.hubs.slice() : [];
  var norm = [];
  var seen = {};
  for (var i = 0; i < hubs.length; i++) {
    var h = _kpifail_normHubBase_(hubs[i]);
    if (h && !seen[h]) { seen[h] = 1; norm.push(h); }
  }
  norm.sort();
  var joined = norm.join('|');
  if (joined.length <= 120) return 'sc_' + joined.replace(/[^a-z0-9|]/gi, '_');
  var hash = 0;
  for (var j = 0; j < joined.length; j++) { hash = ((hash << 5) - hash + joined.charCodeAt(j)) | 0; }
  return 'sc' + norm.length + '_' + (hash >>> 0).toString(36);
}

function _kpifail_getPersistentMasterRecords_() {
  var ss = _DS.ss(KPIFAIL_SS_ID);
  var snapshot = _kpifail_readPersistentSnapshot_();
  var needFullBuild = !snapshot || !Array.isArray(snapshot.records) || !snapshot.records.length;
  if (needFullBuild) {
    // [FIX] Chờ nguồn ổn định trước khi build TOÀN BỘ — đây là lần xây snapshot
    // gốc, không có bản cũ nào để "giữ lại" nếu đọc trúng lúc nguồn đang bị xoá
    // để ghi lại, nên càng cần cẩn trọng ở bước này. Nếu sau các lần thử vẫn
    // không ổn định, vẫn build (còn hơn không có gì) nhưng ghi log cảnh báo rõ
    // để biết kết quả lần này có thể không đầy đủ, cần build lại sau.
    var stableFull = _kpifail_waitForStableSource_(ss);
    if (!stableFull) {
      _LOG.d('[KPIFail buildFull] CẢNH BÁO: nguồn có vẻ đang được ghi liên tục lúc build — kết quả lần này có thể thiếu, nên build lại (kpifail_forceFullRebuild) sau khi chắc chắn nguồn đã ghi xong.');
    }
    var buildResult = _kpifail_buildRecords(ss);
    var fullRecords = buildResult.records;
    var maxDate = '';
    for (var i = 0; i < fullRecords.length; i++) if (fullRecords[i] && fullRecords[i].date > maxDate) maxDate = fullRecords[i].date;
    // [FIX 2026-07-29] Lưu rowCounts THỰC TẾ đã đọc tới (buildResult.rowCounts) —
    // có thể chỉ là MỘT PHẦN nếu hết ngân sách thời gian giữa chừng
    // (buildResult.complete === false). Không sao — vì snapshot.records giờ đã
    // > 0, lần gọi kế tiếp sẽ không còn needFullBuild nữa mà đi theo đường
    // refresh incremental bình thường (_kpifail_readSourceRowsSince_), tự động
    // đọc tiếp đúng từ rowCounts này — không cần logic "tiếp tục" riêng ở đây.
    if (!buildResult.complete) {
      _LOG.d('[KPIFail buildFull] Build lần đầu chưa xong hết trong ngân sách thời gian — đã lưu ' + fullRecords.length + ' record, phần còn lại sẽ tự đọc tiếp ở các chu kỳ refresh 5 phút kế tiếp.');
    }
    _kpifail_writePersistentSnapshot_(fullRecords, maxDate, buildResult.rowCounts, buildResult.fingerprints);
    return { records: fullRecords, maxDate: maxDate, fromPersistent: false, rebuilt: true, sourceStable: stableFull, buildComplete: buildResult.complete };
  }

  var savedAtTs = snapshot.savedAt ? new Date(snapshot.savedAt).getTime() : 0;
  if (savedAtTs && (Date.now() - savedAtTs) < (KPIFAIL_PERSIST_REFRESH_SECONDS * 1000)) {
    return { records: snapshot.records, maxDate: snapshot.maxDate || '', fromPersistent: true, rebuilt: false };
  }

  if (!_kpifail_canUseRefreshLock_()) {
    return { records: snapshot.records, maxDate: snapshot.maxDate || '', fromPersistent: true, rebuilt: false, refreshSkipped: true };
  }

  try {
    // [FIX] Lớp bảo vệ CHỦ ĐỘNG (trước khi đọc): nếu nguồn đang bị ghi/cập nhật
    // ngay lúc này, bỏ qua refresh lần này luôn — không tốn công đọc + merge rồi
    // mới phát hiện bất thường ở lớp bảo vệ phản ứng bên dưới.
    var stable = _kpifail_waitForStableSource_(ss);
    if (!stable) {
      _LOG.d('[KPIFail refresh] Bỏ qua vì nguồn đang được ghi liên tục (getLastRow thay đổi giữa các lần đọc cách nhau 1.5s). Giữ snapshot cũ, thử lại ở lần refresh kế tiếp.');
      _kpifail_writePersistentSnapshot_(snapshot.records, snapshot.maxDate || '');
      return { records: snapshot.records, maxDate: snapshot.maxDate || '', fromPersistent: true, rebuilt: false, refreshSkippedUnstableSource: true };
    }

    // [FIX 2026-07-28] "ĐỌC THEO SỐ DÒNG" thay cho "đọc theo cửa sổ ngày" —
    // xem comment đầy đủ ở _kpifail_readSourceRowsSince_. Đổi KPIFAIL_PERSIST_OVERLAP_DAYS
    // + _kpifail_readSourceDeltaSince_ (quét lại TOÀN BỘ sheet mỗi 5 phút, đã xác
    // nhận qua log Executions là nguyên nhân chính gây các lượt 500-1800s) lấy
    // _kpifail_readSourceRowsSince_ (chỉ đọc đúng số dòng MỚI THÊM VÀO).
    var prevRowCounts = { FM: snapshot.lastRowFM || 0, LM: snapshot.lastRowLM || 0, SOP: snapshot.lastRowSOP || 0 };
    var curRowCounts = _kpifail_getSourceRowCounts_(ss);

    // [FIX] Phát hiện sheet bị GHI LẠI TỪ ĐẦU (clearContents rồi append lại —
    // đã xác nhận qua Version History là pattern có thật của 2 service account
    // ghi vào nguồn): nếu số dòng HIỆN TẠI < mốc đã đọc lần trước, "phần sau mốc
    // cũ là dòng mới" không còn đúng nữa (vì mốc cũ giờ đã vượt quá số dòng thật
    // có) — không thể tin incremental được nữa, phải build lại toàn bộ 1 lần.
    // Đây là tín hiệu TRỰC TIẾP (đếm dòng), thay thế hoàn toàn cơ chế cũ suy
    // đoán gián tiếp qua % sụt giảm record theo cửa sổ ngày (kém chính xác hơn
    // và chỉ hợp với cách đọc-theo-ngày cũ, không còn cần thiết với cách mới).
    var rewritten = (curRowCounts.FM < prevRowCounts.FM) || (curRowCounts.LM < prevRowCounts.LM) || (curRowCounts.SOP < prevRowCounts.SOP);

    // [MỚI] Đối soát VÂN TAY dòng đầu + dòng mốc: bắt trường hợp nguồn ghi lại/trượt cửa sổ mà SỐ DÒNG KHÔNG GIẢM
    // (khi đó đọc "sau mốc cũ" sẽ bỏ sót một phần dữ liệu mới). Khác với nhánh "số dòng giảm" bên dưới (thay hẳn
    // toàn bộ), nhánh này GỘP phần đọc lại đầy đủ vào snapshot đang có -> KHÔNG mất lịch sử đã tích luỹ.
    // Chặn tối đa 1 lần / 20 phút để nguồn có đổi liên tục cũng không kéo theo đọc toàn bộ liên tục.
    if (!rewritten) {
      var _fpc = { rewritten: false };
      try { _fpc = _kpifail_sourceRewritten_(ss, snapshot, prevRowCounts); } catch (eFp) { _LOG.d('[KPIFail refresh] Không đối soát được vân tay: ' + eFp.message); }
      if (_fpc.rewritten) {
        var _props = PropertiesService.getScriptProperties();
        var _lastFpAt = Number(_props.getProperty('kpifail_fp_rebuild_at') || 0);
        if (Date.now() - _lastFpAt >= 20 * 60 * 1000) {
          _props.setProperty('kpifail_fp_rebuild_at', String(Date.now()));
          _LOG.d('[KPIFail refresh] Vân tay nguồn đổi (' + _fpc.why + ') — đọc lại đầy đủ và GỘP vào snapshot.');
          var bF = _kpifail_buildRecords(ss);
          var mergedF = _kpifail_mergeRecords_(snapshot.records, bF.records, '');
          var maxDateF = snapshot.maxDate || '';
          for (var iF = 0; iF < mergedF.length; iF++) if (mergedF[iF] && mergedF[iF].date > maxDateF) maxDateF = mergedF[iF].date;
          _kpifail_writePersistentSnapshot_(mergedF, maxDateF, bF.rowCounts, bF.fingerprints);
          return { records: mergedF, maxDate: maxDateF, fromPersistent: true, rebuilt: true, rebuiltReason: 'source_fingerprint_changed: ' + _fpc.why, buildComplete: bF.complete };
        }
        _LOG.d('[KPIFail refresh] Vân tay đổi (' + _fpc.why + ') nhưng vừa đối soát <20 phút trước — bỏ qua lượt này.');
      }
    }

    // [SỬA — đo thật: job này ngốn 90 phút/ngày, 33% toàn bộ ngân sách nền]
    // Nguồn KPI chỉ đổi VÀI LẦN MỖI NGÀY, nhưng trước đây cứ 5 phút là làm mới:
    // đọc và ghi lại toàn bộ snapshot (~37 giây/lượt, ~145 lượt/ngày) chỉ để phát
    // hiện ra "không có gì mới".
    // Nay kiểm tra RẺ trước: đếm số dòng 3 sheet nguồn (3 lần getLastRow, ~1 giây).
    // Không dòng nào thêm và không bị ghi lại từ đầu -> nghỉ ngay, giữ nguyên snapshot.
    // KHÔNG cập nhật mốc thời gian snapshot: lượt sau vẫn kiểm tra lại, nên nguồn
    // vừa đổi là bắt được ngay, không phải chờ hết chu kỳ.
    if (!rewritten &&
        curRowCounts.FM === prevRowCounts.FM &&
        curRowCounts.LM === prevRowCounts.LM &&
        curRowCounts.SOP === prevRowCounts.SOP) {
      _LOG.d('[KPIFail refresh] Nguồn chưa có dòng mới (FM ' + curRowCounts.FM + ', LM ' + curRowCounts.LM +
             ', SOP ' + curRowCounts.SOP + ') — bỏ qua làm mới, dùng lại snapshot sẵn có.');
      return { records: snapshot.records, maxDate: snapshot.maxDate || '', fromPersistent: true,
               rebuilt: false, refreshSkipped: 'nguon_chua_doi' };
    }
    if (rewritten) {
      _LOG.d('[KPIFail refresh] Số dòng sheet nguồn GIẢM so với mốc đã đọc (FM ' + prevRowCounts.FM + '->' + curRowCounts.FM +
        ', LM ' + prevRowCounts.LM + '->' + curRowCounts.LM + ', SOP ' + prevRowCounts.SOP + '->' + curRowCounts.SOP +
        ') — nghi bị ghi lại từ đầu, build lại toàn bộ thay vì đọc incremental.');
      var buildResult2 = _kpifail_buildRecords(ss);
      var fullRecords2 = buildResult2.records;
      var maxDate2 = '';
      for (var i2 = 0; i2 < fullRecords2.length; i2++) if (fullRecords2[i2] && fullRecords2[i2].date > maxDate2) maxDate2 = fullRecords2[i2].date;
      // [FIX 2026-07-29] Lưu rowCounts THỰC TẾ đọc tới (có thể chỉ 1 phần nếu hết
      // ngân sách thời gian) — không dùng _kpifail_getSourceRowCounts_(ss) (số dòng
      // TUYỆT ĐỐI của sheet) nữa, nếu không sẽ đánh dấu nhầm là "đã đọc hết" trong
      // khi thực ra mới đọc 1 phần, làm lần refresh sau BỎ SÓT phần chưa đọc.
      _kpifail_writePersistentSnapshot_(fullRecords2, maxDate2, buildResult2.rowCounts, buildResult2.fingerprints);
      return { records: fullRecords2, maxDate: maxDate2, fromPersistent: false, rebuilt: true, rebuiltReason: 'source_row_count_decreased', buildComplete: buildResult2.complete };
    }

    var deltaResult = _kpifail_readSourceRowsSince_(ss, prevRowCounts);
    var deltaRecords = deltaResult.records;
    if (!deltaRecords.length) {
      // Không có dòng mới nào thật sự tạo ra record hợp lệ (có thể do dòng mới
      // thiếu ngày, hoặc hết ngân sách thời gian ngay từ dòng đầu tiên...) — vẫn
      // cập nhật mốc số dòng THỰC TẾ đã đọc tới (deltaResult.rowCounts, không
      // phải curRowCounts tuyệt đối) để không bỏ sót nếu lượt này chưa đọc hết.
      _kpifail_writePersistentSnapshot_(snapshot.records, snapshot.maxDate || '', deltaResult.rowCounts, deltaResult.fingerprints);
      return { records: snapshot.records, maxDate: snapshot.maxDate || '', fromPersistent: true, rebuilt: false };
    }

    // [FIX] Chỉ có DÒNG MỚI (chưa từng đọc, không trùng với bất kỳ dòng nào đã có
    // trong snapshot) — không cần "xoá vùng ngày gần đây rồi thế delta vào" như
    // cách cũ (refreshFromDate rỗng = giữ nguyên toàn bộ base, chỉ thêm mới,
    // dedupe theo category+date+id+hub qua _kpifail_mergeRecords_ sẵn có).
    var merged = _kpifail_mergeRecords_(snapshot.records, deltaRecords, '');

    var maxDate = snapshot.maxDate || '';
    for (var j = 0; j < merged.length; j++) if (merged[j] && merged[j].date > maxDate) maxDate = merged[j].date;
    // [FIX 2026-07-29] rowCounts thực tế (deltaResult.rowCounts) — nếu
    // deltaResult.complete === false (hết ngân sách giữa chừng), mốc lưu chỉ tới
    // đúng vị trí đã đọc, chu kỳ 5 phút sau sẽ tự đọc tiếp phần còn lại, không
    // cần chờ user hay admin làm gì thêm.
    _kpifail_writePersistentSnapshot_(merged, maxDate, deltaResult.rowCounts, deltaResult.fingerprints);
    if (!deltaResult.complete) {
      _LOG.d('[KPIFail refresh] Hết ngân sách thời gian, còn tồn đọng — đã đọc thêm ' + deltaRecords.length + ' record, phần còn lại sẽ đọc tiếp ở chu kỳ 5 phút kế tiếp.');
    }
    return { records: merged, maxDate: maxDate, fromPersistent: true, rebuilt: false, refreshed: true, newRowsRead: deltaRecords.length, refreshComplete: deltaResult.complete };
  } catch (e) {
    return { records: snapshot.records, maxDate: snapshot.maxDate || '', fromPersistent: true, rebuilt: false, refreshError: e.message };
  } finally {
    _kpifail_releaseRefreshLock_();
  }
}

/**
 * kpifail_getMasterDataLite(hubName, daysBack) — vỏ bọc MỎNG quanh bản gốc (_kpifail_getMasterDataLiteCore_).
 * [MỚI] Khi sheet nguồn KPI Fail thiếu cột bắt buộc (xem _kpifail_cols_), gắn thêm trường "canhBao" vào
 * kết quả để giao diện báo rõ "số liệu có thể cũ vì cột nguồn đổi". Bản gốc có thể trả chuỗi JSON lấy thẳng
 * từ cache nhiều MB nên KHÔNG parse lại — chỉ nối thêm 1 trường vào cuối chuỗi, và chỉ khi có cảnh báo
 * (lúc bình thường trả nguyên văn, không tốn gì). Cảnh báo không bao giờ bị lưu vào cache.
 */
function kpifail_getMasterDataLite(hubName, daysBack) {
  var res = _kpifail_getMasterDataLiteCore_(hubName, daysBack);
  try {
    if (typeof res === 'string' && res.charAt(res.length - 1) === '}' && res.slice(0, 60).indexOf('"success":true') >= 0) {
      var w = _spx_getColWarn_('kpifail:');
      var extra = '';
      if (w) extra += ',"canhBao":' + JSON.stringify(w);
      // [MỚI] Mốc phiên bản dữ liệu đi kèm: giao diện so với kpifail_getDataVersion() để biết khi nào cần tải lại.
      // Khoá cache gói tổng hợp gắn số phiên bản (được tăng ngay khi dữ liệu đổi) nên mốc này khớp nội dung gói.
      try { extra += ',"dataVersion":' + JSON.stringify(_kpifail_dataVersionString_()); } catch (eV) {}
      if (extra) return res.slice(0, -1) + extra + '}';
    }
  } catch (eW) {}
  return res;
}

function _kpifail_getMasterDataLiteCore_(hubName, daysBack) {
  daysBack = (daysBack === 0) ? 0 : (Number(daysBack) || KPIFAIL_DEFAULT_WINDOW_DAYS);
  hubName  = (hubName && hubName !== 'ALL') ? String(hubName).trim() : '';

  var access = getModuleAccess();
  // [MỚI — theo quyết định trực tiếp "chỉ tính khi thực sự tải dữ liệu"] Track
  // usage TẠI ĐÂY (điểm tải dữ liệu thật của KPI Fail), không phải lúc mở
  // module — nhất quán với cách Quá Hạn/Pick/FMS đã làm từ trước.
  if (access.role === 'denied') {
    return JSON.stringify({ success: false, error: 'Bạn không có quyền truy cập module này.' });
  }

  // [FIX-PERF] Tang TTL tu 360 -> 600s: giam tan suat doc Sheets khi nhieu user
  // mo module trong cung 1 khung gio. Cache per-hub nen TTL dai hon la an toan.
  var CACHE_TTL  = 600;
  // [SỬA LỖI THẬT] Ô bộ đệm Apps Script giới hạn 100KB, mà tiếng Việt tốn 2-3 byte/
  // ký tự -> khúc 90.000 ký tự VƯỢT giới hạn, bộ đệm im lặng không lưu được, mỗi
  // lượt tải lại phải dựng từ đầu (nguyên nhân KPI nặng và treo). 45.000 an toàn.
  var CHUNK_SIZE = 45000;
  var sc = CacheService.getScriptCache();
  var cacheVer = _kpifail_getLiteCacheVersion_();
  // [SỬA — TỐI ƯU QUY MÔ, theo yêu cầu trực tiếp "có thể lên tới 2k user và 1k
  // trạm, phải tính phương án tối ưu nhất mà KHÔNG giảm trải nghiệm"]
  // TRƯỚC ĐÂY khoá cache gắn theo EMAIL từng người (access.email) — nghĩa là
  // 2.000 user = 2.000 bản cache RIÊNG BIỆT của CÙNG một nội dung. Hệ quả ở quy
  // mô lớn: (1) prewarm chỉ hâm nóng đúng bản 'admin', 1.999 người còn lại vẫn
  // phải tự dựng lại từ đầu ở lần mở đầu tiên sau mỗi TTL, (2) mỗi lần dựng lại
  // là 1 lượt JSON.stringify toàn bộ (~327k record theo số thật trên hệ thống),
  // (3) cache GAS có hạn dung lượng — 2.000 bản trùng nội dung sẽ đẩy nhau ra,
  // làm tỉ lệ trúng cache tụt thảm hại đúng lúc đông người dùng nhất.
  // NAY khoá theo PHẠM VI QUYỀN (vai trò + danh sách hub đã chuẩn hoá, sắp xếp)
  // — mọi user có CÙNG quyền dùng CHUNG 1 bản. Kết quả hoàn toàn giống nhau về
  // mặt dữ liệu (cùng quyền thì nội dung trả về vốn đã y hệt), nên KHÔNG hề đổi
  // những gì người dùng nhìn thấy, chỉ giảm số bản trùng lặp từ ~2.000 xuống
  // còn đúng số nhóm quyền khác nhau (thực tế thường vài chục).
  // AN TOÀN: cache lite được xoá bằng cách TĂNG SỐ PHIÊN BẢN nhúng trong khoá
  // (_kpifail_bumpLiteCacheVersion_), không phải bằng cách dựng lại chuỗi khoá
  // cũ — nên đổi cấu trúc khoá không làm hỏng cơ chế xoá cache hiện có.
  var userKey  = _kpifail_scopeKey_(access);
  var hubKey   = hubName ? hubName.replace(/[^a-z0-9]/gi, '_') : 'ALL';
  var CACHE_KEY = 'kpifail_lite_v' + cacheVer + '_' + userKey + '_' + hubKey + '_' + daysBack;
  var useClusterCache = access.role !== 'admin' && access.hubs && access.hubs.length > 1;
  var clusterHubKey = '';
  var CLUSTER_KEY = '';
  if (useClusterCache) {
    var hubSet = {};
    for (var hk = 0; hk < access.hubs.length; hk++) {
      var nHub = _kpifail_normHubBase_(access.hubs[hk]);
      if (nHub) hubSet[nHub] = 1;
    }
    clusterHubKey = Object.keys(hubSet).sort().join('__');
    CLUSTER_KEY = 'kpifail_lite_cluster_v' + cacheVer + '_' + userKey + '_' + clusterHubKey + '_' + daysBack;
  }

  // [PERF 2026-07] Nội dung 2 hàm dưới đây trước đây tự viết lại thuật toán chunk-JSON
  // (giống hệt logic ở aging/rider-plan) — nay chỉ còn là lớp mỏng gọi CacheMgr.getChunked/
  // setChunked (API chunk dùng chung, xem CacheMgr ở đầu file). GIỮ NGUYÊN tên hàm +
  // chữ ký (prefix, jsonStr) → mọi nơi gọi (CACHE_KEY/CLUSTER_KEY/_allKey ở trên và dưới)
  // không cần đổi gì. CacheMgr tự stringify/parse, nên truyền thẳng jsonStr (string) vào
  // vẫn round-trip đúng nguyên văn (tương tự cách aging_getMasterData() đã dùng).
  function _kpifail_readChunkedJson_(prefix) {
    return CacheMgr.getChunked('KPIFAIL', prefix);
  }

  function _kpifail_writeChunkedJson_(prefix, jsonStr) {
    CacheMgr.setChunked('KPIFAIL', prefix, jsonStr, CACHE_TTL);
  }

  function _kpifail_filterRecordsByHub_(records, filterHubName) {
    if (!filterHubName || filterHubName === 'ALL') return records;
    var targetNorm = [_kpifail_normHubBase_(filterHubName), _kpifail_normHubUI_(filterHubName)];
    var filtered = [];
    for (var i = 0; i < records.length; i++) {
      var rec = records[i];
      if (_kpifail_matchHub_(rec.hub || '', filterHubName, targetNorm)) filtered.push(rec);
    }
    return filtered;
  }

  try {
    if (CLUSTER_KEY) {
      var clusterFull = _kpifail_readChunkedJson_(CLUSTER_KEY);
      if (clusterFull) {
        var clusterParsed = JSON.parse(clusterFull);
        if (clusterParsed && clusterParsed.success && clusterParsed.records) {
          var clusteredRecords = hubName ? _kpifail_filterRecordsByHub_(clusterParsed.records, hubName) : clusterParsed.records;
          var clusterResult = JSON.stringify({
            success: true,
            records: clusteredRecords,
            hubs: clusterParsed.hubs || [],
            windowDays: daysBack,
            access: { role: access.role, hubs: access.hubs },
            _lite: true,
            _fromClusterCache: true
          });
          _kpifail_writeChunkedJson_(CACHE_KEY, clusterResult);
          return clusterResult;
        }
      }
    }

    var full = _kpifail_readChunkedJson_(CACHE_KEY);
    if (full) return full;
  } catch(ce) {}

  // [FIX-PERF] Fallback: neu dang load 1 hub cu the ma cache ALL con fresh
  // -> filter tu cache ALL thay vi doc Sheets lai. Tiet kiem 2-4 giay GAS exec
  // cho moi lan doi tram. Chi ap dung khi hubName co gia tri (khong phai ALL).
  if (hubName) {
    try {
      var _allKey = 'kpifail_lite_v' + cacheVer + '_' + userKey + '_ALL_' + daysBack;
      var _allFull = _kpifail_readChunkedJson_(_allKey);
      if (_allFull) {
        var _allParsed = JSON.parse(_allFull);
        if (_allParsed && _allParsed.success && _allParsed.records) {
          var _filtered = _kpifail_filterRecordsByHub_(_allParsed.records, hubName);
          var _hubSet = {};
          _filtered.forEach(function(r) { if (r.hub) _hubSet[r.hub] = 1; });
          var _filteredResult = JSON.stringify({
            success: true, records: _filtered,
            hubs: Object.keys(_hubSet).sort(),
            windowDays: daysBack,
            access: { role: access.role, hubs: access.hubs },
            _lite: true, _fromAllCache: true
          });
          _kpifail_writeChunkedJson_(CACHE_KEY, _filteredResult);
          return _filteredResult;
        }
      }
    } catch(_fe) {}
  }

  // [FIX 2026-07-28] "CACHE STAMPEDE": log Executions cho thấy 3 lượt hàm này chạy
  // CHỒNG THẬT SỰ cùng lúc (10:36:15, 10:37:31, 10:38:50 — mỗi lượt 500-900s) — vì
  // khóa thêm ở kpifail_prewarmCache() chỉ chặn CHÍNH NÓ tự chồng lên mình, không hề
  // chặn được đường gọi thẳng từ kpifail_getIndexSummary() (mỗi user mở trang chủ gọi
  // 1 lần) — khi cache hết hạn, N user mở app cùng lúc = N lượt tính lại độc lập, y hệt
  // lỗi ban đầu nhưng ở tầng sâu hơn (hàm dùng chung, không phải chỉ riêng trigger).
  //
  // [FIX 2026-07-28 — bản 2] Log sau khi vá bản 1 vẫn còn chồng lấn (vd 10:37:31 và
  // 10:38:50 chạy chồng gần hết 500-700s) — vì khi lượt đang giữ khóa chạy LÂU HƠN 45s
  // (rất thường xuyên, do _kpifail_getPersistentMasterRecords_() có thể rơi vào nhánh
  // "needFullBuild" build lại toàn bộ từ Sheets, không có khóa riêng, tốn 500-1800s),
  // lượt chờ hết giờ sẽ TỰ TÍNH ĐỘC LẬP — đúng như thiết kế nhưng vẫn gây chồng lấn
  // nặng vì bản tính độc lập đó CŨNG đi vào đúng nhánh nặng đó lần nữa. Sửa lại: khi
  // không giành được khóa kịp, KHÔNG tính độc lập nữa — đọc thẳng bản "persistent
  // snapshot" đã lưu sẵn (_kpifail_readPersistentSnapshot_, chỉ 1-2 lượt đọc Sheet,
  // không kích hoạt build/refresh) để trả dữ liệu gần như ngay lập tức, dù có thể hơi
  // cũ vài phút — còn hơn tính lại toàn bộ và chồng thêm 1 lượt 500-1800s nữa.
  var _kpfColdLockKey = 'kpifail_masterdata_cold_lock_v1';
  var _kpfGotColdLock = _anaAcquireNamedLock(_kpfColdLockKey, 45000, 300000);
  if (_kpfGotColdLock) {
    try {
      // Double-check: trong lúc mình chờ lock, có thể lượt khác đã tính xong và ghi
      // cache rồi — nếu vậy dùng luôn, khỏi tính lại lần nữa.
      try {
        var _kpfRecheck = _kpifail_readChunkedJson_(CACHE_KEY);
        if (_kpfRecheck) return _kpfRecheck;
      } catch (_kpfRe) {}
      return _kpifail_computeMasterDataLiteCold_();
    } finally {
      _anaReleaseNamedLock(_kpfColdLockKey);
    }
  }
  // Không giành được khóa (lượt khác đang tính, chạy lâu hơn 45s) — dùng bản snapshot
  // đã lưu sẵn thay vì tính độc lập lần nữa. Nếu vì lý do gì đó chưa từng có snapshot
  // (rất hiếm — chỉ xảy ra ở lần khởi tạo đầu tiên), mới bắt buộc tính đầy đủ.
  try {
    var _kpfStaleSnap = _kpifail_readPersistentSnapshot_();
    if (_kpfStaleSnap && Array.isArray(_kpfStaleSnap.records)) {
      return _kpifail_buildLiteResultFrom_(_kpfStaleSnap.records, _kpfStaleSnap.maxDate, { _staleFallback: true });
    }
  } catch (_kpfSe) {}
  return _kpifail_computeMasterDataLiteCold_();

  // Tách phần lọc/định dạng kết quả ra hàm dùng chung — vừa cho đường tính đầy đủ
  // (_kpifail_computeMasterDataLiteCold_, có thể build/refresh trước khi gọi) vừa
  // cho đường dự phòng nhanh ở trên (đọc thẳng snapshot, bỏ qua build/refresh).
  function _kpifail_buildLiteResultFrom_(masterRecords, persistMaxDate, extraFlags) {
    var tz = SPX_TZ;
    var cutoffStr = '';
    if (daysBack > 0) {
      var anchorDateStr = persistMaxDate || '';
      if (!anchorDateStr) {
        for (var mi = 0; mi < masterRecords.length; mi++) {
          if (masterRecords[mi] && masterRecords[mi].date > anchorDateStr) anchorDateStr = masterRecords[mi].date;
        }
      }
      if (anchorDateStr) {
        cutoffStr = _kpifail_subtractDays_(anchorDateStr, daysBack);
      } else {
        cutoffStr = _spxVnDateStr_(-daysBack); // [SỬA] ngày theo GIỜ VIỆT NAM
      }
    }
    var targetHubNorm = hubName ? [_kpifail_normHubBase_(hubName), _kpifail_normHubUI_(hubName)] : [];
    var allowedHubNorm = (access.role !== 'admin' && access.hubs && access.hubs.length)
      ? access.hubs.map(_kpifail_normHubBase_)
      : [];

    var clusterRecords = [];
    for (var ri = 0; ri < masterRecords.length; ri++) {
      var rec = masterRecords[ri];
      if (!rec || !rec.date) continue;
      if (cutoffStr && rec.date < cutoffStr) continue;
      if (access.role !== 'admin' && allowedHubNorm.length) {
        var allowed = false;
        for (var ai = 0; ai < allowedHubNorm.length; ai++) {
          if (_kpifail_matchHub_(rec.hub || '', access.hubs[ai], [allowedHubNorm[ai], _kpifail_normHubUI_(access.hubs[ai])])) {
            allowed = true;
            break;
          }
        }
        if (!allowed) continue;
      }
      clusterRecords.push(rec);
    }

    var records = clusterRecords;
    if (hubName && hubName !== 'ALL') {
      records = clusterRecords.filter(function(r) {
        return _kpifail_matchHub_(r.hub || '', hubName, targetHubNorm);
      });
    }

    var hubSet = {};
    records.forEach(function(rec) { if (rec.hub) hubSet[rec.hub] = 1; });
    var hubs = Object.keys(hubSet).sort();
    var baseFields = {
      success: true,
      records: records,
      hubs: hubs,
      windowDays: daysBack,
      access: { role: access.role, hubs: access.hubs },
      _lite: true,
      _persisted: true,
      _persistMaxDate: persistMaxDate || ''
    };
    for (var fk in extraFlags) baseFields[fk] = extraFlags[fk];

    // [SỬA LỖI THẬT — báo cáo: "data KPI load vào là bị đứng/crash"]
    // Module luôn xin phạm vi 'ALL'. Với Admin, 'ALL' là TOÀN HỆ THỐNG (đo thật trên
    // thẻ Tổng quan: 27.745 đơn KPI Fail) -> gói JSON hàng chục MB, trình duyệt phải
    // nhận + phân tích + dựng bảng trong một nhịp -> đứng hình, có máy thì sập tab.
    // Đây KHÔNG phải lỗi dữ liệu mà là lỗi thiết kế tải: không ai xem 27.745 dòng
    // cùng lúc. Nay chặn ở ngưỡng an toàn và nói rõ phải làm gì, kèm SỐ TỔNG để
    // người dùng vẫn nắm được quy mô mà không phải tải hết.
    // [SỬA LỖI THẬT — báo cáo: "1 trạm ở cấp Lead cũng báo Cần thu hẹp phạm vi;
    // trước đây load cả tháng vẫn được, giờ 2 tuần lại không"]
    // Chốt chặn cứng em đặt lượt trước (8MB) là SAI HƯỚNG: nó chặn cả trường hợp
    // trước nay vẫn chạy. Đo dữ liệu thật: toàn hệ thống ~27.800 dòng -> gói rơi
    // đúng quanh ngưỡng đó, nên chặn gần như mọi lượt xem toàn cảnh.
    // Cách đúng là LÀM GÓI NHẸ ĐI, không phải cấm người dùng xem:
    // mỗi bản ghi mang thêm khối 'raw' (các mốc thời gian) chỉ phục vụ BẢNG CHI TIẾT,
    // mà bảng chi tiết lấy dữ liệu từ endpoint riêng (kpifail_getDrilldownPage).
    // Bỏ 'raw' khỏi gói tổng cắt được phần lớn dung lượng mà không mất chức năng nào.
    var _slim = new Array(records.length);
    for (var _si = 0; _si < records.length; _si++) {
      var _r = records[_si];
      _slim[_si] = {
        id: _r.id, date: _r.date, hub: _r.hub, category: _r.category,
        type: _r.type, reason: _r.reason, delayHours: _r.delayHours
      };
    }
    baseFields.records = _slim;
    var result = JSON.stringify(baseFields);

    // Gửi kèm số đo để chẩn đoán khi người dùng báo chậm — xem log [KPI Payload].
    baseFields._payloadInfo = { soDong: records.length, soTram: hubs.length, kyTu: result.length };
    result = JSON.stringify(baseFields);

    // Bản dự phòng nhanh (_staleFallback) không ghi đè lên cache chính thức —
    // tránh khả năng 1 bản hơi cũ đè lên bản mới hơn nếu lượt đang tính (giữ khóa)
    // vừa ghi xong ngay sau đó.
    if (!extraFlags || !extraFlags._staleFallback) {
      _kpifail_writeChunkedJson_(CACHE_KEY, result);
      if (useClusterCache) {
        var clusterHubSet = {};
        clusterRecords.forEach(function(rec) { if (rec.hub) clusterHubSet[rec.hub] = 1; });
        var clusterFields = {
          success: true,
          records: clusterRecords,
          hubs: Object.keys(clusterHubSet).sort(),
          windowDays: daysBack,
          access: { role: access.role, hubs: access.hubs },
          _lite: true,
          _cluster: true,
          _persisted: true,
          _persistMaxDate: persistMaxDate || ''
        };
        _kpifail_writeChunkedJson_(CLUSTER_KEY, JSON.stringify(clusterFields));
      }
    }
    return result;
  }

  function _kpifail_computeMasterDataLiteCold_() {
  try {
    var persisted = _kpifail_getPersistentMasterRecords_();
    var masterRecords = (persisted && persisted.records) ? persisted.records : [];
    return _kpifail_buildLiteResultFrom_(masterRecords, persisted ? (persisted.maxDate || '') : '', {});
  } catch(e) {
    return JSON.stringify({ success:false, error:e.message });
  }
  } // end _kpifail_computeMasterDataLiteCold_
}

function kpifail_getMasterData(daysBack) {
  daysBack = (daysBack === 0) ? 0 : (Number(daysBack) || KPIFAIL_DEFAULT_WINDOW_DAYS);

  // ── LẤY ACCESS ──
  var access = getModuleAccess();
  if (access.role === 'denied') {
    return JSON.stringify({ success: false, error: 'Bạn không có quyền truy cập module này.' });
  }

  // ── CACHE KEY per-user ──
  // [PERF 2026-07] Dùng CacheMgr.getChunked/setChunked thay cho thuật toán chunk viết
  // tay riêng (xem CacheMgr ở đầu file). Lưu ý: cache của hàm này hiện KHÔNG còn được
  // đọc lại bởi bất kỳ nơi nào khác trong hệ thống — dashboard đã chuyển hẳn sang
  // kpifail_getMasterDataLite() từ lâu (xem ghi chú ở kpifail_prewarmCache()) — nhưng
  // vẫn gộp cho nhất quán, phòng trường hợp hàm này còn được gọi trực tiếp từ nơi khác.
  var userKey = (access.role === 'admin') ? 'admin' : access.email.replace(/[^a-z0-9]/g, '_');
  var cacheKey = 'master_v3_' + userKey + '_' + daysBack;

  // ── THỬ CACHE ──
  var cachedResult2 = CacheMgr.getChunked('KPIFAIL', cacheKey);
  if (cachedResult2) return cachedResult2;

  // ── ĐỌC SHEETS ──
  try {
    var ss = _DS.ss(KPIFAIL_SS_ID);
    var records = _kpifail_buildRecords(ss).records;

    // [FIX] Cùng bug với kpifail_getMasterDataLite: neo cửa sổ theo NGÀY DỮ
    // LIỆU MỚI NHẤT thay vì ngày hệ thống thật, để tránh dashboard tụt về 0
    // khi độ trễ báo cáo của nguồn tiến gần/ vượt qua daysBack.
    if (daysBack > 0) {
      var anchorDateStr2 = '';
      for (var mi2 = 0; mi2 < records.length; mi2++) {
        if (records[mi2] && records[mi2].date > anchorDateStr2) anchorDateStr2 = records[mi2].date;
      }
      var cutoffStr;
      if (anchorDateStr2) {
        cutoffStr = _kpifail_subtractDays_(anchorDateStr2, daysBack);
      } else {
        cutoffStr = _spxVnDateStr_(-daysBack); // [SỬA] ngày theo GIỜ VIỆT NAM
      }
      records = records.filter(function(r) { return r.date >= cutoffStr; });
    }

    // ── LỌC THEO QUYỀN ──
    if (access.role !== 'admin' && access.hubs.length > 0) {
      // Dùng chung _normStationKey_() — không strip suffix để tránh mismatch
      var allowedNorm = access.hubs.map(function(s) { return _normStationKey_(s, { pakFix: false, stripSuffix: false }); });
      records = records.filter(function(r) {
        var h = _normStationKey_(r.hub || '', { pakFix: false, stripSuffix: false });
        return h && allowedNorm.indexOf(h) >= 0;
      });
    }

    var hubs = Array.from(new Set(records.map(function(r) { return r.hub; }).filter(Boolean))).sort();

    var result = JSON.stringify({
      success: true,
      records: records,
      hubs: hubs,
      windowDays: daysBack,
      access: { role: access.role, hubs: access.hubs }
    });

    // ── LƯU CACHE ──
    CacheMgr.setChunked('KPIFAIL', cacheKey, result, 360);

    return result;
  } catch(e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

function _kpifail_tagOfNote_(note) {
  var n = (note || '').toString();
  if (n.indexOf('[VẬN HÀNH]') === 0 || n.indexOf('[Váº¬N HÃ€NH]') === 0) return 'VAN_HANH';
  if (n.indexOf('[TÀI XẾ]') === 0 || n.indexOf('[TÃ€I Xáº¾]') === 0) return 'TAI_XE';
  if (n.indexOf('[HỆ THỐNG]') === 0 || n.indexOf('[Há»† THá»NG]') === 0) return 'HE_THONG';
  return null;
}

function _kpifail_parseJson_(val, fallback) {
  try {
    if (typeof val === 'string') return JSON.parse(val);
    if (val && typeof val === 'object') return val;
  } catch (e) {}
  return fallback;
}

// Trả riêng 1 trang drilldown đã được lọc sẵn trên server để bảng chi tiết không phải
// cắt/sort toàn bộ mảng records ở client mỗi lần đổi trang hoặc đổi bộ lọc.
// Dùng cùng nguồn dữ liệu cache của kpifail_getMasterDataLite() + kpifail_getNotes(),
// nên vẫn đảm bảo đúng phân quyền và đúng note/status hiện tại.
function kpifail_getDrilldownPage(payloadJson) {
  try {
    var req = _kpifail_parseJson_(payloadJson, {});
    var hubName = (req.hubName && req.hubName !== 'ALL') ? String(req.hubName).trim() : '';
    var daysBack = (req.daysBack === 0) ? 0 : (Number(req.daysBack) || KPIFAIL_DEFAULT_WINDOW_DAYS);
    var filterRange = req.filterRange || 'month';
    var drillCategory = req.drillCategory || 'ALL';
    var drillDateFrom = req.drillDateFrom || '';
    var drillDateTo = req.drillDateTo || '';
    var drillSearch = (req.drillSearch || '').toString().trim().toLowerCase();
    var drillRootCause = req.drillRootCause || 'ALL';
    var drillStatus = req.drillStatus || 'ALL';
    var pageSize = Math.max(1, Math.min(200, Number(req.pageSize) || 25));
    var page = Math.max(1, Number(req.page) || 1);

    var liteRaw = kpifail_getMasterDataLite(hubName, daysBack);
    var lite = _kpifail_parseJson_(liteRaw, null);
    if (!lite || !lite.success) {
      return JSON.stringify({ success: false, error: (lite && lite.error) || 'Không lấy được dữ liệu KPI Fail' });
    }

    var records = lite.records || [];
    var notesRaw = kpifail_getNotes();
    var notesObj = _kpifail_parseJson_(notesRaw, {});
    var notes = (notesObj && notesObj.notes) ? notesObj.notes : {};

    var maxDate = '';
    for (var i = 0; i < records.length; i++) {
      if (records[i] && records[i].date && records[i].date > maxDate) maxDate = records[i].date;
    }

    function fmtDateStr(dt) {
      return (dt instanceof Date && !isNaN(dt.getTime()))
        ? Utilities.formatDate(dt, SPX_TZ, 'yyyy-MM-dd')
        : '';
    }

    function addDaysStr(dateStr, days) {
      if (!dateStr) return '';
      var parts = dateStr.split('-');
      if (parts.length !== 3) return '';
      // [SỬA] Toán LỊCH THUẦN qua UTC — không phụ thuộc múi giờ dự án.
      var d = new Date(Date.UTC(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2])));
      d.setUTCDate(d.getUTCDate() + days);
      return d.toISOString().slice(0, 10);
    }

    function getRangeBounds() {
      if (!maxDate) return { start: '0000-01-01', end: '9999-12-31', prevStart: null, prevEnd: null };
      if (filterRange === 'all') return { start: '0000-01-01', end: maxDate, prevStart: null, prevEnd: null };
      if (filterRange === '30d') {
        var start30 = addDaysStr(maxDate, -29);
        var prevEnd30 = addDaysStr(start30, -1);
        var prevStart30 = addDaysStr(prevEnd30, -29);
        return { start: start30, end: maxDate, prevStart: prevStart30, prevEnd: prevEnd30 };
      }

      var parts = maxDate.split('-').map(function(v) { return Number(v); });
      var y = parts[0], m = parts[1], d = parts[2];
      if (filterRange === 'lastmonth') { m -= 1; if (m < 1) { m = 12; y -= 1; } }
      var start = y + '-' + String(m).padStart(2, '0') + '-01';
      var lastDayOfMonth = new Date(y, m, 0).getDate();
      var endDay = (filterRange === 'lastmonth') ? lastDayOfMonth : d;
      var end = y + '-' + String(m).padStart(2, '0') + '-' + String(Math.min(endDay, lastDayOfMonth)).padStart(2, '0');
      var py = y, pm = m - 1; if (pm < 1) { pm = 12; py -= 1; }
      var prevStart = py + '-' + String(pm).padStart(2, '0') + '-01';
      var elapsedDays = Math.round((new Date(y, m - 1, Math.min(endDay, lastDayOfMonth)) - new Date(y, m - 1, 1)) / 86400000) + 1;
      var prevLastDay = new Date(py, pm, 0).getDate();
      var prevEndDay = Math.min(elapsedDays, prevLastDay);
      var prevEnd = py + '-' + String(pm).padStart(2, '0') + '-' + String(prevEndDay).padStart(2, '0');
      return { start: start, end: end, prevStart: prevStart, prevEnd: prevEnd };
    }

    var bounds = getRangeBounds();
    var currentRange = records.filter(function(r) {
      return r && r.date && r.date >= bounds.start && r.date <= bounds.end;
    });

    var currentRangeTotal = currentRange.length;
    var currentRangeNoted = 0;
    for (var j = 0; j < currentRange.length; j++) {
      var noteNow = notes[currentRange[j].id];
      if (noteNow && noteNow.note && noteNow.note.toString().trim()) currentRangeNoted++;
    }

    var drillRows = currentRange.slice();
    if (drillCategory !== 'ALL') drillRows = drillRows.filter(function(r) { return r.category === drillCategory; });
    if (drillDateFrom) drillRows = drillRows.filter(function(r) { return r.date >= drillDateFrom; });
    if (drillDateTo) drillRows = drillRows.filter(function(r) { return r.date <= drillDateTo; });
    if (drillSearch) {
      drillRows = drillRows.filter(function(r) {
        var id = (r.id || '').toString().toLowerCase();
        var hub = (r.hub || '').toString().toLowerCase();
        return id.indexOf(drillSearch) !== -1 || hub.indexOf(drillSearch) !== -1;
      });
    }
    if (drillRootCause !== 'ALL') {
      drillRows = drillRows.filter(function(r) {
        var tag = _kpifail_tagOfNote_(notes[r.id] && notes[r.id].note);
        if (drillRootCause === 'UNKNOWN') return !tag;
        return tag === drillRootCause;
      });
    }

    var rowsBeforeStatus = drillRows.slice();
    if (drillStatus === 'PENDING') {
      drillRows = drillRows.filter(function(r) {
        var n = notes[r.id];
        return !(n && n.note && n.note.toString().trim());
      });
    } else if (drillStatus === 'DONE') {
      drillRows = drillRows.filter(function(r) {
        var n = notes[r.id];
        return !!(n && n.note && n.note.toString().trim());
      });
    }

    drillRows.sort(function(a, b) {
      if (a.date === b.date) return (b.id || '').localeCompare(a.id || '');
      return (b.date || '').localeCompare(a.date || '');
    });

    var totalRows = drillRows.length;
    var totalPages = Math.max(1, Math.ceil(totalRows / pageSize));
    if (page > totalPages) page = totalPages;
    var startIdx = (page - 1) * pageSize;
    var pageRows = drillRows.slice(startIdx, startIdx + pageSize);

    var rowsBeforeStatusNoted = 0;
    for (var k = 0; k < rowsBeforeStatus.length; k++) {
      var noteBefore = notes[rowsBeforeStatus[k].id];
      if (noteBefore && noteBefore.note && noteBefore.note.toString().trim()) rowsBeforeStatusNoted++;
    }

    return JSON.stringify({
      success: true,
      page: page,
      pageSize: pageSize,
      totalRows: totalRows,
      totalPages: totalPages,
      rows: pageRows,
      rowsBeforeStatusTotal: rowsBeforeStatus.length,
      rowsBeforeStatusNoted: rowsBeforeStatusNoted,
      rowsBeforeStatusPct: rowsBeforeStatus.length > 0 ? Math.round((rowsBeforeStatusNoted / rowsBeforeStatus.length) * 100) : 0,
      currentRangeTotal: currentRangeTotal,
      currentRangeNoted: currentRangeNoted,
      currentRangePct: currentRangeTotal > 0 ? Math.round((currentRangeNoted / currentRangeTotal) * 100) : 0,
      maxDate: maxDate,
      bounds: bounds,
      access: { role: lite.access ? lite.access.role : '', hubs: lite.access ? lite.access.hubs : [] },
      windowDays: daysBack
    });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

// ── kpifail_clearCache() — xóa v1 (global cũ) + v2 của user hiện tại ──────
function kpifail_clearCache() {
  try {
    var sc = CacheService.getScriptCache();

    // [MỚI 2026-10-24] Log Executions: có lúc 5 lượt clearCache trong CÙNG 1 giây (mỗi lượt ~3,5 giây + 1 lượt treo 30 phút).
    // Gộp lượt gọi dồn của CÙNG người dùng trong 5 giây — lượt đầu đã xoá cache, các lượt sau không còn gì để xoá.
    // Chỉ gộp trong 5 giây và theo từng người nên không làm người khác giữ cache cũ.
    try {
      var _clrA = getModuleAccess();
      var _clrKey = 'kpifail_clr_' + String((_clrA && _clrA.email) || 'anon').replace(/[^a-zA-Z0-9]/g, '_').slice(0, 80);
      if (sc.get(_clrKey)) return JSON.stringify({ success: true, debounced: true });
      sc.put(_clrKey, '1', 5);
    } catch (eDb) {}

    // Xóa cache v1 cũ (global, nhiều daysBack variants)
    var candidates = [KPIFAIL_DEFAULT_WINDOW_DAYS, 0, 30, 60, 90, 365];
    candidates.forEach(function(days) {
      var prefix = 'kpifail_master_v1_' + days;
      try {
        var metaStr = sc.get(prefix + '_meta');
        if (metaStr) {
          var meta = JSON.parse(metaStr);
          var keys = [prefix + '_meta'];
          for (var i = 0; i < meta.chunks; i++) keys.push(prefix + '_c' + i);
          sc.removeAll(keys);
        }
      } catch(ie) {}
    });

    // Xóa cache v2 của user đang gọi (định dạng key CŨ, trước khi gộp vào CacheMgr —
    // giữ lại để dọn nốt các entry còn sót từ trước lúc deploy bản gộp, vô hại nếu
    // không tìm thấy gì)
    var access = getModuleAccess();
    var userKey = (access.role === 'admin') ? 'admin' : access.email.replace(/[^a-z0-9]/g, '_');
    candidates.forEach(function(days) {
      var prefix = 'kpifail_master_v3_' + userKey + '_' + days;
      try {
        var metaStr = sc.get(prefix + '_meta');
        if (metaStr) {
          var meta = JSON.parse(metaStr);
          var keys = [prefix + '_meta'];
          for (var i = 0; i < meta.chunks; i++) keys.push(prefix + '_c' + i);
          sc.removeAll(keys);
        }
      } catch(ie) {}
    });
    // [PERF 2026-07] Dọn theo định dạng key MỚI (qua CacheMgr, kể từ khi gộp
    // kpifail_getMasterData() — xem hàm đó) — để đúng và nhất quán, dù cache này
    // hiện không còn ai đọc lại trong thực tế.
    candidates.forEach(function(days) {
      CacheMgr.invalidateChunked('KPIFAIL', 'master_v3_' + userKey + '_' + days);
    });

    // Bump index cache version (invalidate kpifail_getIndexSummary toàn bộ)
    _kpifail_bumpIdxCacheVersion_();
    _kpifail_bumpLiteCacheVersion_();
    _kpifail_invalidateNotesCache_();
    // [FIX 2026-07-28] BỎ _kpifail_resetPersistentSnapshot_() khỏi đây — đây là
    // nguyên nhân chính gây cảm giác "KPI Fail load chậm hẳn đi, trước đây đâu
    // thế". Hàm kpifail_clearCache() này được gọi từ 3 nơi rất hay dùng: nút
    // "làm mới" trong module KPI Fail, nút làm mới Ở TRANG CHỦ
    // (runBackgroundSync forceServer), và hàm "xoá toàn bộ cache" của admin —
    // TẤT CẢ đều chỉ có ý định xoá cache NHẸ (ScriptCache, TTL vài phút) để lấy
    // dữ liệu mới hơn, KHÔNG có ý định xoá luôn persistent snapshot (nguồn tốn
    // 500-1800s+ để build lại từ đầu, đôi khi Timed Out — xem log Executions).
    // Trước bản sửa này, MỖI LẦN ai đó bấm 1 trong 3 nút trên, snapshot bị xoá
    // sạch → lần đọc kế tiếp (của TẤT CẢ mọi user, không chỉ người vừa bấm) rơi
    // vào nhánh needFullBuild → build lại toàn bộ → chậm hẳn, có khi timeout.
    // Bump 2 version cache ở trên đã đủ để user thấy dữ liệu MỚI HƠN (bỏ qua
    // ScriptCache 10 phút, đọc thẳng persistent snapshot — snapshot tự làm mới
    // theo chu kỳ 5 phút của riêng nó, không cần ai "ép" xoá sạch mới có mới).
    // Muốn build lại TOÀN BỘ persistent snapshot thật sự (hiếm khi cần) → dùng
    // riêng kpifail_forceFullRebuild(), không lồng vào hàm clearCache dùng chung.

    return JSON.stringify({ success: true });
  } catch(e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

// [MỚI] Công cụ chẩn đoán: soát 3 sheet nguồn (FM/LM/SOP) để biết chính xác
// bao nhiêu dòng có/không có ngày hợp lệ ở cột A, và cột nào đang cứu được
// (fallback) hay vẫn chịu mất (không có ngày nào dùng được). Chạy trực tiếp
// từ Apps Script Editor (chọn hàm này > Run), xem kết quả ở View > Logs.
// Không tự sửa dữ liệu — chỉ đọc và báo cáo.
function kpifail_debugDateIssues() {
  // [SECURITY FIX 2026-08] Hàm debug đọc/tổng hợp dữ liệu thô KPIFail toàn hệ
  // thống để soát lỗi ngày tháng — trước đây không kiểm tra quyền. Chỉ admin mới
  // cần và được dùng công cụ debug này.
  _requireAdmin_(2);
  var ss = _DS.ss(KPIFAIL_SS_ID);
  var tz = SPX_TZ;
  var parseAnyDate = function(v) {
    if (v instanceof Date && !isNaN(v.getTime())) return v;
    if (typeof v === 'string' && v.trim()) {
      var s = v.trim();
      var m = s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
      if (m) { var d1 = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])); if (!isNaN(d1.getTime())) return d1; }
      m = s.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{4})/);
      if (m) { var d2 = new Date(Number(m[3]), Number(m[2]) - 1, Number(m[1])); if (!isNaN(d2.getTime())) return d2; }
      var d3 = new Date(s);
      if (!isNaN(d3.getTime())) return d3;
    }
    if (typeof v === 'number' && v > 0) {
      // [FIX-TZ] Dùng epoch neo theo giờ local của Apps Script (= project
      // Time Zone) thay vì UTC cứng, để khớp với cách toàn bộ code còn lại
      // đang quy đổi ngày theo Asia/Ho_Chi_Minh — tránh lệch ngày gần mốc
      // nửa đêm nếu nhánh fallback số serial này từng bị kích hoạt.
      var epochLocal = new Date(1899, 11, 30);
      var d4 = new Date(epochLocal.getTime() + Math.round(v * 86400000));
      if (!isNaN(d4.getTime())) return d4;
    }
    return null;
  };
  var describe = function(v) {
    if (v instanceof Date) return isNaN(v.getTime()) ? 'Date(invalid)' : 'Date(' + Utilities.formatDate(v, tz, 'yyyy-MM-dd HH:mm') + ')';
    if (v === '' || v === null || v === undefined) return '(trống)';
    return typeof v + '("' + String(v) + '")';
  };

  function inspect(sheetName, key, fallbackKeys, fallbackLabels) {
    var sheet = ss.getSheetByName(sheetName);
    if (!sheet || sheet.getLastRow() < 2) {
      _LOG.d('[' + sheetName + '] Không có dữ liệu hoặc không tìm thấy sheet.');
      return;
    }
    var lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
    // [SỬA] Cột ngày + cột dự phòng dò theo TIÊU ĐỀ (xem _kpifail_cols_)
    var _KC = _kpifail_cols_(sheet, key);
    var dateColIdx = _KC.date;
    var fallbackColIdxs = fallbackKeys.map(function(k) { return _KC[k]; });
    var values = sheet.getRange(2, 1, lastRow - 1, lastCol).getValues();
    var okColA = 0, okFallback = 0, lostTotal = 0;
    var sampleColA = [], sampleFallback = [], sampleLost = [];
    for (var i = 0; i < values.length; i++) {
      var r = values[i];
      var dA = parseAnyDate(r[dateColIdx]);
      if (dA) { okColA++; continue; }
      var found = null;
      for (var f = 0; f < fallbackColIdxs.length; f++) {
        found = parseAnyDate(r[fallbackColIdxs[f]]);
        if (found) break;
      }
      if (found) {
        okFallback++;
        if (sampleFallback.length < 3) sampleFallback.push('row ' + (i + 2) + ': cột A = ' + describe(r[dateColIdx]) + ' -> dùng ' + fallbackLabels[f] + ' = ' + describe(found));
      } else {
        lostTotal++;
        if (sampleLost.length < 3) sampleLost.push('row ' + (i + 2) + ': cột A = ' + describe(r[dateColIdx]) + ', các cột fallback cũng trống/không hợp lệ');
      }
    }
    _LOG.d('===== ' + sheetName + ' (tổng ' + values.length + ' dòng) =====');
    _LOG.d('  Cột A hợp lệ sẵn: ' + okColA);
    _LOG.d('  Cứu được nhờ fallback: ' + okFallback + (sampleFallback.length ? ('\n    ' + sampleFallback.join('\n    ')) : ''));
    _LOG.d('  VẪN MẤT (không có ngày nào dùng được): ' + lostTotal + (sampleLost.length ? ('\n    ' + sampleLost.join('\n    ')) : ''));
  }

  inspect(KPIFAIL_SHEET_FM,  'FM',  ['lhArrivedFinal', 'lhArrived'], ['LH Arrived Time Finalize', 'LH Arrived Time']);
  inspect(KPIFAIL_SHEET_LM,  'LM',  ['arrived', 'attempt'],          ['Arrived Time', 'First Attempt Time']);
  inspect(KPIFAIL_SHEET_SOP, 'SOP', ['pickupEta'],                   ['Pickup ETA']);
}

// [MỚI] Chạy 1 LẦN ngay sau khi deploy bản fix fallback ngày ở trên.
// Lý do cần hàm riêng: snapshot cũ (đã lưu trong ADMIN_DB_ID) được build bằng
// logic CŨ nên các record LM/SOP thiếu cột A đã bị loại vĩnh viễn khỏi
// snapshot — hàm này gộp thêm bước build lại ngay và trả về số liệu trước/sau
// để xác nhận fix có hiệu lực, không cần đợi người dùng mở app mới kích hoạt rebuild.
function kpifail_forceFullRebuild() {
  // [SECURITY FIX 2026-08] Hàm build lại toàn bộ snapshot KPIFail (chi phí Sheets
  // API rất lớn, ~100k+ dòng) — trước đây không kiểm tra quyền, có thể bị spam gọi
  // liên tục qua console gây tốn quota/làm chậm hệ thống cho mọi người (DoS). Chỉ
  // admin mới được chạy thao tác "chạy tay" này.
  _requireAdmin_(2);
  var ss = _DS.ss(KPIFAIL_SS_ID);

  // [FIX] Kiểm tra nguồn ổn định TRƯỚC KHI build — nếu đọc trúng lúc nguồn
  // đang ghi (thực tế có ngày ~200k dòng, 1 lần ghi có thể kéo dài nhiều phút
  // chứ không "hiện ra 1 lần"), bản build ra sẽ thiếu dữ liệu. Dùng
  // maxAttempts=3 (thay vì 2 như đường tự động) vì đây là hàm chạy TAY, không
  // thường xuyên, chấp nhận chờ thêm vài giây để chắc chắn hơn.
  var stable = _kpifail_waitForStableSource_(ss, 3);
  if (!stable) {
    var msg = 'Nguồn (FM/LM/SOP) có vẻ đang được ghi/cập nhật ngay lúc này — KHÔNG build lại để tránh có bản thiếu. Đợi vài phút cho chắc chắn lần ghi hiện tại đã xong (kiểm tra Version History của sheet nguồn nếu cần), rồi chạy lại kpifail_forceFullRebuild() lần nữa. Snapshot hiện có KHÔNG bị thay đổi gì.';
    _LOG.d('[KPIFail forceFullRebuild] BỊ HOÃN: ' + msg);
    return JSON.stringify({ success: false, aborted: true, reason: msg });
  }

  var before = _kpifail_readPersistentSnapshot_();
  var beforeCount = before && before.records ? before.records.length : 0;
  var beforeByCat = { FM: 0, LM: 0, SOP: 0 };
  if (before && before.records) {
    before.records.forEach(function(r) { if (beforeByCat[r.category] !== undefined) beforeByCat[r.category]++; });
  }

  // [FIX 2026-07-28] KHÔNG còn gọi kpifail_clearCache() TRƯỚC khi build nữa —
  // trước đây hàm đó xoá sạch persistent snapshot ngay tại đây, nên nếu bước
  // build bên dưới timeout (đã thấy xảy ra thật, log 02:23:55 Timed Out 30
  // phút), snapshot bị mất trắng, không còn gì để phục hồi. Giờ chỉ build +
  // ghi (_kpifail_writePersistentSnapshot_ đã tự an toàn kiểu ping-pong: ghi
  // vào slot KHÔNG active, chỉ đổi con trỏ sau khi ghi xong hẳn) — nếu build
  // timeout, snapshot CŨ vẫn còn nguyên, không bị mất gì. Gọi kpifail_clearCache()
  // ở CUỐI (sau khi build+ghi xong) chỉ để bump cache version, cho user thấy
  // bản mới ngay thay vì đợi ScriptCache 10 phút tự hết hạn.

  var buildResultForce = _kpifail_buildRecords(ss);
  var freshRecords = buildResultForce.records;
  var maxDate = '';
  for (var i = 0; i < freshRecords.length; i++) if (freshRecords[i].date > maxDate) maxDate = freshRecords[i].date;
  // [FIX 2026-07-29] Lưu rowCounts THỰC TẾ đọc tới (có thể chỉ 1 phần nếu hết
  // ngân sách thời gian giữa chừng — buildResultForce.complete === false) — nếu
  // vậy, các chu kỳ refresh 5 phút TIẾP THEO sẽ tự đọc bù phần còn lại, không
  // cần chạy lại forceFullRebuild thủ công.
  _kpifail_writePersistentSnapshot_(freshRecords, maxDate, buildResultForce.rowCounts, buildResultForce.fingerprints);
  // Ghi xong hẳn rồi mới bump version cache — user thấy bản mới ngay, không
  // đụng gì tới snapshot vừa ghi (kpifail_clearCache() giờ chỉ bump cache, xem fix ở đó).
  try { kpifail_clearCache(); } catch (eCc) {}

  var afterByCat = { FM: 0, LM: 0, SOP: 0 };
  freshRecords.forEach(function(r) { if (afterByCat[r.category] !== undefined) afterByCat[r.category]++; });

  var summary = {
    success: true,
    before: { total: beforeCount, byCategory: beforeByCat },
    after: { total: freshRecords.length, byCategory: afterByCat },
    maxDate: maxDate,
    complete: buildResultForce.complete
  };
  _LOG.d('[KPIFail forceFullRebuild] ' + JSON.stringify(summary));
  return JSON.stringify(summary);
}


// ──────────────── KPI FAIL — NOTE & ĐỒNG BỘ SHEET LƯU TRỮ ────────────────
// Mục đích: 3 sheet nguồn (FM/LM/SOP) là dữ liệu thô, không có chỗ để note.
// Ta lưu Note/User Note vào 1 sheet riêng trong ADMIN_DB_ID (cùng spreadsheet
// đang chứa App_Notes của module Aging). Mỗi lần "Đồng bộ Sheet" sẽ ghi đè
// toàn bộ dữ liệu hiện có (đã chuẩn hóa từ _kpifail_buildRecords) vào sheet
// này, giữ lại Note/User Note cũ theo Shipment ID — Shipment ID nào không còn
// trong dữ liệu nguồn sẽ tự động biến mất khỏi sheet lưu trữ (không cần xóa tay).
var KPIFAIL_NOTES_SHEET = 'KPIFail_Notes';
var KPIFAIL_NOTES_COLS  = 11; // ID, Ngày, Hub, Loại, Type, Lý Do, Trễ(h), Ghi Chú, User Note, Thời Gian Note, _LastEditTS(ẩn)
var KPIFAIL_NOTES_COL_LASTEDIT_TS = 11; // cột Date object đầy đủ — chỉ dùng để tính tuổi chính xác, không hiển thị

// [TỐI ƯU] Xóa nhiều dòng cùng lúc theo range liên tiếp thay vì gọi sheet.deleteRow()
// từng dòng một trong vòng lặp — mỗi lần deleteRow() làm dịch chuyển toàn bộ phần còn
// lại của sheet, nên xóa N dòng rời rạc kiểu cũ tốn O(N) lần dịch chuyển. Hàm này gom
// các số dòng liên tiếp (vd 50,51,52 → 1 range) thành ít lệnh deleteRows() hơn, xóa từ
// range có start lớn nhất xuống dưới để không làm lệch chỉ số các range chưa xử lý.
// rows: mảng số dòng (1-indexed), không cần sắp xếp sẵn.
function _kpifail_batchDeleteRows_(sheet, rows) {
  if (!rows || rows.length === 0) return 0;
  var sorted = rows.slice().sort(function(a, b) { return a - b; });
  var ranges = [];
  var start = sorted[0], prev = sorted[0];
  for (var i = 1; i < sorted.length; i++) {
    if (sorted[i] === prev + 1) {
      prev = sorted[i];
    } else {
      ranges.push([start, prev]);
      start = sorted[i]; prev = sorted[i];
    }
  }
  ranges.push([start, prev]);
  // Xóa từ range có dòng bắt đầu lớn nhất xuống nhỏ nhất — range nhỏ hơn (ở trên)
  // không bị lệch chỉ số vì các range lớn hơn (ở dưới) đã bị xóa trước.
  ranges.sort(function(a, b) { return b[0] - a[0]; });
  ranges.forEach(function(r) { sheet.deleteRows(r[0], r[1] - r[0] + 1); });
  return sorted.length;
}

// [FIX] Fallback ngày khi không tìm thấy record gốc (_kpifail_findRecordById_ trả về
// null) — trước đây ghi '' vào cột Ngày, khiến dòng đó KHÔNG BAO GIỜ bị 2 lớp dọn dẹp
// (_kpifail_pruneOldNotes_ và orphan-cleanup) động tới vì cả 2 đều yêu cầu có Ngày mới
// xét xóa. Hệ quả là note "mồ côi ngày" tồn tại vĩnh viễn, đi ngược chính sách lưu trữ
// 180 ngày. Dùng ngày hôm nay làm fallback để dòng vẫn có "tuổi" tính được — không
// chính xác bằng ngày đơn fail thật, nhưng đảm bảo dòng vẫn nằm trong vòng đời dọn dẹp.
// [AN TOÀN] Kiểm tra chuỗi đúng định dạng yyyy-MM-dd trước khi so sánh lexicographic
// với cutoff. So sánh chuỗi kiểu "d < cutoffStr" chỉ đúng khi cả 2 cùng định dạng
// yyyy-MM-dd — nếu vì lý do nào đó cột Ngày bị ghi sai định dạng (vd dd/MM/yyyy do
// thao tác tay hoặc import lỗi), so sánh sẽ sai lệch ÂM THẦM (không báo lỗi) và có
// thể xóa nhầm note còn mới hoặc giữ lại note đã quá hạn. Dòng không đúng định dạng
// sẽ bị BỎ QUA khỏi việc dọn dẹp (an toàn hơn xóa nhầm), không làm crash cleanup.
function _kpifail_isValidIsoDate_(str) {
  return /^\d{4}-\d{2}-\d{2}$/.test(str);
}

function _kpifail_todayDateStr_() {
  var tz = SPX_TZ;
  return Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
}

function _kpifail_getNotesSheet_() {
  var ss = _DS.ss(ADMIN_DB_ID);
  var sheet = ss.getSheetByName(KPIFAIL_NOTES_SHEET);
  if (!sheet) {
    sheet = ss.insertSheet(KPIFAIL_NOTES_SHEET);
    sheet.appendRow(['Shipment ID','Ngày','Hub','Loại','Type','Lý Do','Trễ (giờ)','Ghi Chú','User Note','Thời Gian Note','_LastEditTS']);
    sheet.setFrozenRows(1);
    sheet.getRange(1,1,1,KPIFAIL_NOTES_COLS).setFontWeight('bold');
    sheet.hideColumns(KPIFAIL_NOTES_COL_LASTEDIT_TS);
  } else if (sheet.getLastColumn() < KPIFAIL_NOTES_COL_LASTEDIT_TS) {
    // [MIGRATION TỰ ĐỘNG] Sheet đã tồn tại từ trước khi có cột _LastEditTS — tự thêm
    // header cột 11 + ẩn đi, không cần chạy hàm migrate riêng. Các dòng note cũ sẽ có
    // cột này rỗng cho tới khi được sửa lần kế tiếp (xem ghi chú ở kpifail_saveNote).
    sheet.getRange(1, KPIFAIL_NOTES_COL_LASTEDIT_TS).setValue('_LastEditTS').setFontWeight('bold');
    sheet.hideColumns(KPIFAIL_NOTES_COL_LASTEDIT_TS);
  }
  return sheet;
}

// ── [NÂNG CẤP] AUDIT TRAIL — lịch sử thay đổi note (ai sửa gì lúc nào) ──
// kpifail_saveNote/kpifail_saveNotesBulk GHI ĐÈ note cũ, không giữ lại nội dung
// trước đó. Sheet này lưu append-only mọi lần thay đổi (kể cả sửa nhiều lần cho
// cùng 1 đơn) để tra cứu khi cần biết "ai đổi note gì, lúc nào, nội dung cũ là gì".
var KPIFAIL_HISTORY_SHEET = 'KPIFail_Notes_History';

function _kpifail_getHistorySheet_() {
  var ss = _DS.ss(ADMIN_DB_ID);
  var sheet = ss.getSheetByName(KPIFAIL_HISTORY_SHEET);
  if (!sheet) {
    sheet = ss.insertSheet(KPIFAIL_HISTORY_SHEET);
    // Cột 6 (_TS) lưu Date object đầy đủ — CHỈ để tính tuổi khi prune, không hiển thị
    // trên UI (kpifail_getNoteHistory không trả field này). Cột "Thời Gian" (dd/MM HH:mm)
    // không có năm nên không đủ để tính tuổi chính xác qua nhiều năm vận hành.
    sheet.appendRow(['Shipment ID','Note Cũ','Note Mới','User','Thời Gian','_TS']);
    sheet.setFrozenRows(1);
    sheet.getRange(1,1,1,6).setFontWeight('bold');
    sheet.hideColumns(6);
  }
  return sheet;
}

// Ghi 1 dòng lịch sử — gọi sau khi save note thành công. Không throw lỗi ra ngoài
// (audit trail là phụ, không được phép làm hỏng luồng save note chính).
function _kpifail_logNoteHistory_(shipmentId, oldNote, newNote, user, timestamp) {
  if (oldNote === newNote) return; // không đổi gì thì khỏi log
  try {
    var sheet = _kpifail_getHistorySheet_();
    sheet.appendRow([shipmentId, oldNote || '', newNote || '', user, timestamp, new Date()]);
  } catch (e) { /* không để lỗi log chặn luồng save chính */ }
}

// Lấy lịch sử thay đổi của 1 Shipment ID — dùng cho UI hiển thị "Xem lịch sử sửa".
// Lấy lịch sử thay đổi của 1 Shipment ID — dùng TextFinder.findAll() (tìm phía server
// của Sheets) thay vì đọc toàn bộ sheet về rồi lọc bằng JS. Sheet này là append-only
// (mỗi lần sửa note đều thêm dòng mới), nên theo thời gian sẽ có rất nhiều dòng —
// đọc toàn bộ mỗi lần xem lịch sử 1 đơn là lặp lại đúng lỗi đã sửa ở kpifail_saveNote
// trước đây (quét tuyến tính thay vì tìm trực tiếp).
function kpifail_getNoteHistory(shipmentId) {
  // [SECURITY FIX 2026-08] Trước đây không kiểm tra quyền. Sheet lịch sử note không
  // có cột hub nên chưa lọc chi tiết theo hub được ở đây — chặn tối thiểu ở mức đã
  // được duyệt dùng hệ thống (đồng bộ với aging_syncNotes/getNotesOnly).
  try { _requireApproved_(); } catch (eAuth) { return JSON.stringify({ success: false, error: eAuth.message }); }
  var cleanId = (shipmentId || '').toString().trim();
  if (!cleanId) return JSON.stringify({ success: false, error: 'Thiếu Shipment ID' });
  try {
    var sheet = _kpifail_getHistorySheet_();
    var lastRow = sheet.getLastRow();
    if (lastRow < 2) return JSON.stringify({ success: true, history: [] });

    var idRange = sheet.getRange(2, 1, lastRow - 1, 1);
    var matches = idRange.createTextFinder(cleanId).matchEntireCell(true).findAll();
    var history = matches.map(function(cell) {
      var rowVals = sheet.getRange(cell.getRow(), 2, 1, 4).getDisplayValues()[0];
      return { oldNote: rowVals[0], newNote: rowVals[1], user: rowVals[2], time: rowVals[3] };
    });
    history.reverse(); // mới nhất lên đầu (findAll trả theo thứ tự dòng tăng dần)
    return JSON.stringify({ success: true, history: history });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

// Trả về dict { shipmentId: {note, user, time} } — dùng để merge vào bảng Chi Tiết Đơn Fail ở client,
// không cần đọc lại toàn bộ record gốc nên nhẹ và nhanh.
// Cache ngắn hạn 25s: vì sheet KPIFail_Notes chứa TOÀN BỘ record (do syncFullData
// ghi đè cả nguồn vào đây, không chỉ dòng có note), nên ở quy mô 100k dòng việc đọc
// 10 cột mỗi lần FE poll (30s/lần/user) là chi phí I/O đáng kể nếu có nhiều user
// đang mở dashboard cùng lúc. Cache được xoá ngay khi saveNote thành công nên dữ
// liệu vẫn coi như gần-thời-gian-thực (chỉ "trễ" tối đa với chính người vừa lưu,
// và họ đã có optimistic update ở client nên không ảnh hưởng trải nghiệm).
var KPIFAIL_NOTES_CACHE_KEY = 'kpifail_notes_v1';
var KPIFAIL_NOTES_CACHE_TTL = 25;

function kpifail_getNotes() {
  // [SECURITY FIX 2026-08] Xem chú thích ở kpifail_getNoteHistory() — cùng lớp lỗi.
  try { _requireApproved_(); } catch (eAuth) { return JSON.stringify({ success: false, error: eAuth.message }); }
  var sc = CacheService.getScriptCache();
  try {
    var cached = sc.get(KPIFAIL_NOTES_CACHE_KEY);
    if (cached) return cached;
  } catch (ce) {}

  try {
    var sheet = _kpifail_getNotesSheet_();
    var lastRow = sheet.getLastRow();
    var result;
    if (lastRow < 2) {
      result = JSON.stringify({ success: true, notes: {} });
    } else {
      // Chỉ cần đọc 4 cột (ID, Note, User, Time) thay vì cả 10 cột — giảm ~60% dữ liệu kéo về.
      var idCol   = sheet.getRange(2, 1, lastRow - 1, 1).getDisplayValues();
      var noteCol = sheet.getRange(2, 8, lastRow - 1, 3).getDisplayValues();
      var notes = {};
      for (var i = 0; i < idCol.length; i++) {
        var id = (idCol[i][0] || '').toString().trim();
        // Bỏ qua dòng không có note để dict trả về client luôn nhỏ gọn,
        // dù sheet nguồn có 100k dòng record nhưng số dòng có note thực tế luôn ít hơn nhiều.
        var noteText = noteCol[i][0] || '';
        if (!id || !noteText) continue;
        notes[id] = { note: noteText, user: noteCol[i][1] || '', time: noteCol[i][2] || '' };
      }
      result = JSON.stringify({ success: true, notes: notes });
    }
    try { sc.put(KPIFAIL_NOTES_CACHE_KEY, result, KPIFAIL_NOTES_CACHE_TTL); } catch (ce2) {}
    return result;
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  }
}

function _kpifail_invalidateNotesCache_() {
  try { CacheService.getScriptCache().remove(KPIFAIL_NOTES_CACHE_KEY); } catch (e) {}
}

// Tìm dòng theo Shipment ID bằng TextFinder (tìm phía server của Sheets),
// thay vì kéo cả cột ID về runtime rồi quét tuyến tính trong JS — quan trọng
// khi sheet lưu trữ có hàng chục/trăm nghìn dòng (vì syncFullData ghi cả
// toàn bộ dữ liệu nguồn vào đây, không chỉ các dòng có note).
function _kpifail_findNoteRow_(sheet, cleanId) {
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return -1;
  var range = sheet.getRange(2, 1, lastRow - 1, 1);
  var found = range.createTextFinder(cleanId).matchEntireCell(true).findNext();
  return found ? found.getRow() : -1;
}

// Tìm 1 record gốc theo ID — ưu tiên đọc từ cache của kpifail_getMasterData()
// (vài chunk, rẻ) thay vì rebuild lại toàn bộ 3 sheet nguồn (đắt, O(100k)).
// Chỉ rebuild full khi cache miss thật sự (trường hợp hiếm: chưa ai mở dashboard
// trong vòng 90s gần nhất).
function _kpifail_findRecordById_(cleanId) {
  try {
    var fastRaw = kpifail_getMasterDataLite('ALL', KPIFAIL_DEFAULT_WINDOW_DAYS);
    var fastData = JSON.parse(fastRaw);
    if (fastData && fastData.success && fastData.records) {
      for (var f = 0; f < fastData.records.length; f++) {
        if (fastData.records[f].id === cleanId) return fastData.records[f];
      }
    }
  } catch (e) {}

  // Fallback hiếm gặp: cache miss → rebuild trực tiếp từ 3 sheet nguồn.
  try {
    var ssSrc = _DS.ss(KPIFAIL_SS_ID);
    var all = _kpifail_buildRecords(ssSrc).records;
    for (var k = 0; k < all.length; k++) { if (all[k].id === cleanId) return all[k]; }
  } catch (eSrc) {}
  return null;
}

// ── [FIX NGHẼN LOCK] NAMED LOCK RIÊNG CHO GHI KPIFail_Notes ──
// TRƯỚC ĐÂY: kpifail_saveNote / kpifail_saveNotesBulk / kpifail_autoCleanupNotes đều
// dùng chung LockService.getScriptLock() — đây là khóa TOÀN CỤC của CẢ script, cũng
// đang được Analytics saveSnapshot()/savePickup() (chờ tới 45s) và trendNightlyPurge()
// (chờ tới 60s) sử dụng. Hệ quả: chỉ cần 1 trạm bất kỳ đang lưu snapshot Analytics
// hoặc job dọn note tự động (autoCleanup, chạy 6h/lần) đang giữ khóa, thì lệnh lưu
// note (chỉ chờ 10s) rất dễ bị waitLock() ném timeout → trả success:false → user thấy
// "bấm lưu note mãi không được", dù thực ra chẳng liên quan gì tới chính module note.
//
// FIX: dùng "named lock" riêng cho KPIFail_Notes qua PropertiesService (cùng kỹ thuật
// đã áp dụng ở _anaAcquireNamedLock cho Analytics) — chỉ chặn LẪN NHAU giữa các thao
// tác ghi KPIFail_Notes (saveNote/saveNotesBulk/autoCleanup) với nhau, HOÀN TOÀN tách
// biệt khỏi Analytics/Trend/mọi module khác trong hệ thống. Bước check-and-set vẫn
// bọc trong ScriptLock NGẮN (2s) để tránh race 2 request cùng đọc "trống" đồng thời.
var KPIFAIL_NOTES_LOCK_KEY = 'kpifail_notes_write_lock_v1';

function _kpifail_acquireNoteLock_(maxWaitMs, staleMs) {
  maxWaitMs = maxWaitMs || 15000;
  staleMs   = staleMs   || 30000;
  var props = PropertiesService.getScriptProperties();
  var waitStart = Date.now();
  while (Date.now() - waitStart < maxWaitMs) {
    var acquireLock = LockService.getScriptLock();
    var gotIt = false;
    try {
      acquireLock.waitLock(2000);
      var existing = props.getProperty(KPIFAIL_NOTES_LOCK_KEY);
      if (!existing || (Date.now() - parseInt(existing, 10)) > staleMs) {
        // Lock trống, hoặc lock cũ đã quá staleMs (process trước đó crash/timeout mà
        // không kịp release) → chiếm lock.
        props.setProperty(KPIFAIL_NOTES_LOCK_KEY, String(Date.now()));
        gotIt = true;
      }
    } catch (eAcquire) {
      // ScriptLock ngắn (2s) bị timeout — hiếm, coi như chưa lấy được, thử lại vòng sau.
    } finally {
      try { acquireLock.releaseLock(); } catch (e2) {}
    }
    if (gotIt) return true;
    Utilities.sleep(200);
  }
  return false;
}

function _kpifail_releaseNoteLock_() {
  try { PropertiesService.getScriptProperties().deleteProperty(KPIFAIL_NOTES_LOCK_KEY); } catch (e) {}
}

// ── LƯU NOTE HÀNG LOẠT (Bulk Action) — 1 LẦN LOCK DUY NHẤT CHO CẢ BATCH ──
// kpifail_saveNote (ở trên) thiết kế cho 1 note/lần gọi — đúng cho thao tác note đơn
// lẻ hằng ngày, nhưng nếu gọi N lần riêng biệt cho Bulk Action (gán Root Cause hàng
// loạt, có thể 50-200+ đơn) thì tốn N lần network round-trip + N lần waitLock/
// releaseLock, dễ nghẽn khi nhiều user thao tác cùng lúc. Hàm này nhận 1 mảng ID +
// 1 nội dung note chung, xử lý TOÀN BỘ trong đúng 1 lần lock — nhanh hơn nhiều và
// giảm hẳn áp lực lên LockService so với gọi lặp lại kpifail_saveNote.
// [FIX BẢO MẬT NGHIÊM TRỌNG — phát hiện qua rà soát IDOR chủ động, CÙNG LỖI đã
// tìm và vá ở aging_saveNote()] kpifail_saveNote()/kpifail_saveNotesBulk() TRƯỚC
// ĐÂY hoàn toàn KHÔNG kiểm tra quyền — Session.getActiveUser() chỉ dùng để hiển
// thị tên người ghi, không kiểm tra gì cả. Viết 1 hàm dùng CHUNG cho cả 2 (đúng
// nguyên tắc "1 logic — 1 nơi chịu trách nhiệm") thay vì lặp lại logic 2 lần.
// LƯU Ý: KHÔNG thêm giới hạn "chỉ Lead/Staff" như đã làm ở Quá Hạn — quy tắc đó
// chỉ được xác nhận cho riêng Quá Hạn, chưa xác nhận áp dụng cho KPI Fail. Vá
// này CHỈ đóng đúng lỗ hổng đã xác nhận chắc chắn: hub phải thuộc quyền người
// gọi (nhất quán với mọi hàm khác đã vá), không tự ý mở rộng thêm giới hạn cấp
// bậc chưa được yêu cầu.
function _kpifail_checkNotePermission_(hub) {
  try {
    var access = getModuleAccess();
    if (access.role === 'denied') {
      return { allowed: false, error: 'Bạn không có quyền ghi chú KPI Fail.' };
    }
    if (access.role === 'admin') return { allowed: true };
    if (!hub) {
      Logger.log('[kpifail note CẢNH BÁO] Không xác định được hub — cho phép ghi (không chặn), user=' + access.email);
      return { allowed: true };
    }
    var hasHub = (access.hubs || []).some(function (h) {
      return (typeof cleanHubString === 'function' ? cleanHubString(h) === cleanHubString(hub) : h.trim().toLowerCase() === hub.trim().toLowerCase());
    });
    if (!hasHub) return { allowed: false, error: 'Không có quyền ghi chú cho trạm: ' + hub };
    return { allowed: true };
  } catch (e) {
    return { allowed: false, error: 'Lỗi kiểm tra quyền: ' + e.message };
  }
}

function kpifail_saveNotesBulk(idsJson, noteText) {
  var ids;
  try { ids = JSON.parse(idsJson); } catch (e) { ids = []; }
  if (!Array.isArray(ids) || ids.length === 0) {
    return JSON.stringify({ success: false, error: 'Danh sách ID rỗng' });
  }

  var userEmail = Session.getActiveUser().getEmail() || '';
  var shortUser = userEmail ? userEmail.split('@')[0].toUpperCase() : 'ADMIN';
  var timestamp = Utilities.formatDate(new Date(), 'GMT+7', 'dd/MM HH:mm');
  var nowTs = new Date(); // [BẢO VỆ] Date object đầy đủ — ghi vào cột 11 để tính tuổi
                          // chính xác, bảo vệ note vừa sửa khỏi bị auto-cleanup xóa sớm.

  var gotLock = _kpifail_acquireNoteLock_(20000, 30000);
  if (!gotLock) {
    return JSON.stringify({
      success: false, lockBusy: true,
      error: 'Hệ thống đang bận ghi note khác (đơn khác/user khác), vui lòng thử lại sau vài giây.'
    });
  }
  try {
    var sheet = _kpifail_getNotesSheet_();
    var ok = 0, failed = [], blocked = [];

    for (var i = 0; i < ids.length; i++) {
      var cleanId = (ids[i] || '').toString().trim();
      if (!cleanId) continue;
      try {
        var rowIdx = _kpifail_findNoteRow_(sheet, cleanId);
        var oldNoteText = '';
        if (rowIdx > -1) {
          // Đã có dòng sẵn trong sheet — đọc thẳng hub từ cột 3 (index 2), không
          // cần tra lại _kpifail_findRecordById_() (tốn kém hơn).
          var _hubFromSheet = sheet.getRange(rowIdx, 3, 1, 1).getDisplayValues()[0][0] || '';
          var _permCheck = _kpifail_checkNotePermission_(_hubFromSheet);
          if (!_permCheck.allowed) { blocked.push(cleanId); continue; }
          oldNoteText = sheet.getRange(rowIdx, 8, 1, 1).getDisplayValues()[0][0] || '';
          sheet.getRange(rowIdx, 8, 1, 3).setValues([[noteText, shortUser, timestamp]]);
          sheet.getRange(rowIdx, KPIFAIL_NOTES_COL_LASTEDIT_TS).setValue(nowTs);
        } else {
          var rec = _kpifail_findRecordById_(cleanId);
          var _permCheck2 = _kpifail_checkNotePermission_(rec ? rec.hub : '');
          if (!_permCheck2.allowed) { blocked.push(cleanId); continue; }
          sheet.appendRow([
            cleanId,
            rec ? rec.date : _kpifail_todayDateStr_(),
            rec ? rec.hub : '',
            rec ? rec.category : '',
            rec ? rec.type : '',
            rec ? rec.reason : '',
            (rec && rec.delayHours != null) ? rec.delayHours : '',
            noteText, shortUser, timestamp, nowTs
          ]);
        }
        _kpifail_logNoteHistory_(cleanId, oldNoteText, noteText, shortUser, timestamp);
        ok++;
      } catch (eRow) {
        failed.push(cleanId);
      }
    }

    _kpifail_invalidateNotesCache_();
    _kpifail_bumpIdxCacheVersion_();       // xóa cache getIndexSummary → card index refresh đúng
    return JSON.stringify({
      success: true, total: ids.length, ok: ok, failed: failed, blocked: blocked,
      user: shortUser, time: timestamp
    });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  } finally {
    _kpifail_releaseNoteLock_();
  }
}

// Lưu/sửa Note cho 1 Shipment ID. Nếu Shipment ID chưa có dòng trong sheet lưu trữ
// (chưa "Đồng bộ Sheet" lần nào) thì tự tìm dữ liệu gốc để điền đủ cột trước khi
// thêm dòng mới, tránh dòng note bị thiếu Ngày/Hub/Loại.
// Lưu ý hiệu năng: bước tìm kiếm (TextFinder / cache lookup) được thực hiện TRƯỚC
// khi lock, chỉ lock đúng bước ghi giá trị → giảm thời gian giữ lock, giảm nghẽn
// khi nhiều user note cùng lúc.
//
// [NÂNG CẤP] CHỐNG GHI ĐÈ KHI 2 NGƯỜI CÙNG SỬA: tham số `expectedOldNote` (optional)
// là nội dung note mà client ĐANG THẤY lúc mở modal sửa. Nếu nội dung thật trong
// sheet đã khác (ai đó vừa sửa trong lúc mình đang gõ) → trả về conflict, KHÔNG ghi
// đè, để frontend cảnh báo user trước khi quyết định ghi đè hay không.
function kpifail_saveNote(shipmentId, noteText, expectedOldNote) {
  var cleanId = (shipmentId || '').toString().trim();
  if (!cleanId) return JSON.stringify({ success: false, error: 'Thiếu Shipment ID' });

  var sheet = _kpifail_getNotesSheet_();
  var rowIdx = _kpifail_findNoteRow_(sheet, cleanId);
  var rec = (rowIdx === -1) ? _kpifail_findRecordById_(cleanId) : null;

  // [FIX BẢO MẬT — xem giải thích đầy đủ tại _kpifail_checkNotePermission_() và
  // kpifail_saveNotesBulk() phía trên] Xác định hub TRƯỚC khi ghi — đọc thẳng từ
  // sheet nếu dòng đã tồn tại (rẻ hơn), tra lại record nếu là dòng mới.
  var _hubForPermCheck = (rowIdx > -1)
    ? (sheet.getRange(rowIdx, 3, 1, 1).getDisplayValues()[0][0] || '')
    : (rec ? rec.hub : '');
  var _permCheck = _kpifail_checkNotePermission_(_hubForPermCheck);
  if (!_permCheck.allowed) {
    return JSON.stringify({ success: false, error: _permCheck.error });
  }

  var userEmail = Session.getActiveUser().getEmail() || '';
  var shortUser = userEmail ? userEmail.split('@')[0].toUpperCase() : 'ADMIN';
  var timestamp = Utilities.formatDate(new Date(), 'GMT+7', 'dd/MM HH:mm');
  var nowTs = new Date(); // [BẢO VỆ] Date object đầy đủ — ghi vào cột 11 để bảo vệ note
                          // vừa sửa khỏi bị auto-cleanup xóa sớm (xem kpifail_autoCleanupNotes).

  // [FIX NGHẼN LOCK] Named lock riêng cho KPIFail_Notes thay vì LockService.getScriptLock()
  // toàn cục — trước đây bị Analytics saveSnapshot/savePickup (giữ tới 45s) và
  // trendNightlyPurge (giữ tới 60s) chiếm mất, khiến lưu note (chỉ chờ 10s) rất dễ
  // timeout dù chẳng liên quan gì tới các module đó. Xem chi tiết ở _kpifail_acquireNoteLock_.
  var gotLock = _kpifail_acquireNoteLock_(15000, 30000);
  if (!gotLock) {
    return JSON.stringify({
      success: false, lockBusy: true,
      error: 'Hệ thống đang bận ghi note khác, vui lòng thử lại sau vài giây.'
    });
  }

  var oldNoteText = '';
  var shouldPushAlert = false;
  try {
    // Re-check trong lock: phòng trường hợp 2 request cùng tạo dòng mới cho
    // cùng 1 ID trong lúc tìm kiếm (trước khi vào lock) diễn ra song song.
    if (rowIdx === -1) {
      rowIdx = _kpifail_findNoteRow_(sheet, cleanId);
    }

    var oldUser = '', oldTime = '';
    if (rowIdx > -1) {
      var oldVals = sheet.getRange(rowIdx, 8, 1, 3).getDisplayValues()[0];
      oldNoteText = oldVals[0] || ''; oldUser = oldVals[1] || ''; oldTime = oldVals[2] || '';
    }

    // Chỉ kiểm tra conflict khi client CÓ gửi expectedOldNote (tương thích ngược —
    // nếu không truyền, hành vi y hệt bản cũ, không chặn gì cả).
    if (expectedOldNote !== undefined && expectedOldNote !== null && oldNoteText !== expectedOldNote) {
      return JSON.stringify({
        success: false, conflict: true,
        error: 'Note đã bị thay đổi bởi người khác trong lúc bạn đang sửa.',
        currentNote: oldNoteText, currentUser: oldUser, currentTime: oldTime
      });
    }

    if (rowIdx > -1) {
      sheet.getRange(rowIdx, 8, 1, 3).setValues([[noteText, shortUser, timestamp]]);
      sheet.getRange(rowIdx, KPIFAIL_NOTES_COL_LASTEDIT_TS).setValue(nowTs);
    } else {
      sheet.appendRow([
        cleanId,
        rec ? rec.date : _kpifail_todayDateStr_(),
        rec ? rec.hub : '',
        rec ? rec.category : '',
        rec ? rec.type : '',
        rec ? rec.reason : '',
        (rec && rec.delayHours != null) ? rec.delayHours : '',
        noteText, shortUser, timestamp, nowTs
      ]);
    }

    _kpifail_logNoteHistory_(cleanId, oldNoteText, noteText, shortUser, timestamp);
    _kpifail_invalidateNotesCache_();
    shouldPushAlert = true;
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  } finally {
    _kpifail_releaseNoteLock_();
  }

  // ── ALERT HOOK: đẩy RA NGOÀI lock ghi note ──
  // Chỉ push khi vừa ghi note thành công — đây là dấu hiệu "đơn cần xử lý được ghi
  // nhận". Severity 3 (khẩn) nếu đơn đã quá 24h chưa có note, 2 (cần xử lý) cho note
  // mới. Trước đây nằm TRONG lock: nếu Alert_Aggregate vượt ngưỡng và phải prune
  // (xóa từng dòng), thời gian giữ khóa ghi note bị kéo dài theo, khiến các user
  // khác đang chờ lưu note dễ bị timeout hơn. Không throw nếu lỗi — không liên quan
  // tới việc note đã lưu thành công hay chưa.
  if (shouldPushAlert && rec && rec.hub) {
    _pushAlert_({
      stationName: rec.hub,
      source:      'kpifail',
      severity:    (!oldNoteText) ? 3 : 2,
      entityRef:   cleanId,
      message:     'KPI Fail note ' + ((!oldNoteText) ? 'mới' : 'cập nhật') + ' — ' + (rec.category || '') + ' / ' + (rec.type || '')
    });
  }

  return JSON.stringify({ success: true, user: shortUser, time: timestamp });
}

// ── DỌN 1 LẦN: xoá các dòng note RỖNG còn sót lại từ cơ chế syncFullData CŨ ──
// Cơ chế cũ từng ghi TOÀN BỘ record nguồn vào KPIFail_Notes (kể cả không có note),
// nên trước khi đổi sang cơ chế mới, sheet có thể đang tồn đọng rất nhiều dòng mà
// cột Ghi Chú (H) và User Note (I) đều trống. Hàm này chỉ cần chạy 1 LẦN DUY NHẤT
// sau khi deploy bản backend mới — để đưa sheet về đúng trạng thái "chỉ chứa note
// thật". Sau lần chạy này, kpifail_saveNote (chỉ thêm dòng có note) và
// kpifail_syncFullData (chỉ xoá dòng orphan) sẽ tự giữ sheet luôn gọn, không cần
// chạy lại hàm này nữa trừ khi nghi ngờ có rác phát sinh lại.
function kpifail_migrateCleanEmptyNotes() {
  // [SECURITY FIX 2026-08] Hàm dọn/ghi lại sheet Notes toàn hệ thống — trước đây
  // không kiểm tra quyền. Chỉ admin mới được chạy công cụ dọn dẹp/di trú này.
  _requireAdmin_(2);
  // [FIX NGHẼN LOCK] Dùng chung named lock của KPIFail_Notes để nhất quán với
  // saveNote/saveNotesBulk/autoCleanup — tránh đụng độ ghi/xóa cùng sheet, đồng thời
  // không còn phụ thuộc/ảnh hưởng LockService.getScriptLock() toàn cục.
  var gotLock = _kpifail_acquireNoteLock_(20000, 30000);
  if (!gotLock) {
    return JSON.stringify({ success: false, lockBusy: true, error: 'Không lấy được lock, thử lại sau.' });
  }
  try {
    var sheet = _kpifail_getNotesSheet_();
    var lastRow = sheet.getLastRow();
    if (lastRow < 2) return JSON.stringify({ success: true, removed: 0, remaining: 0 });

    // Chỉ cần đọc 2 cột Ghi Chú (H) + User Note (I) để xét rỗng — nhẹ hơn đọc cả 10 cột.
    var noteData = sheet.getRange(2, 8, lastRow - 1, 2).getDisplayValues();
    var deleteRows = [];
    for (var i = 0; i < noteData.length; i++) {
      var ghiChu   = (noteData[i][0] || '').toString().trim();
      var userNote = (noteData[i][1] || '').toString().trim();
      if (!ghiChu && !userNote) deleteRows.push(i + 2);
    }

    // Xoá từ dưới lên để không lệch chỉ số dòng.
    deleteRows.sort(function(a, b) { return b - a; });
    deleteRows.forEach(function(r) { sheet.deleteRow(r); });

    _kpifail_invalidateNotesCache_();
    return JSON.stringify({
      success: true,
      removed: deleteRows.length,
      remaining: Math.max(sheet.getLastRow() - 1, 0)
    });
  } catch (e) {
    return JSON.stringify({ success: false, error: e.message });
  } finally {
    _kpifail_releaseNoteLock_();
  }
}

// Đọc CHỈ cột Shipment ID từ 1 sheet nguồn (không parse Date, không build object raw
// như _kpifail_buildRecords) — dùng để kiểm tra "ID này còn đang fail hay không",
// rẻ hơn nhiều so với việc build full record khi chỉ cần biết có tồn tại hay không.
function _kpifail_readIdColumnOnly_(ss, sheetName, idColIdx) {
  var sheet = ss.getSheetByName(sheetName);
  if (!sheet || sheet.getLastRow() < 2) return [];
  var lastRow = sheet.getLastRow();
  // [SỬA] idColIdx là KHOÁ ('FM'|'LM'|'SOP') -> dò theo TIÊU ĐỀ; vẫn nhận số cũ để tương thích.
  if (typeof idColIdx === 'string') idColIdx = _kpifail_cols_(sheet, idColIdx).id;
  var vals = sheet.getRange(2, idColIdx + 1, lastRow - 1, 1).getValues();
  var out = [];
  for (var i = 0; i < vals.length; i++) {
    var id = String(vals[i][0] || '').trim();
    if (id) out.push(id);
  }
  return out;
}

function _kpifail_getActiveIdSet_() {
  var ssSrc = _DS.ss(KPIFAIL_SS_ID);
  var ids = {};
  // [SỬA] Cột Shipment ID dò theo TIÊU ĐỀ (không còn cột D/C/C cố định)
  _kpifail_readIdColumnOnly_(ssSrc, KPIFAIL_SHEET_FM, 'FM').forEach(function(id) { ids[id] = true; });
  _kpifail_readIdColumnOnly_(ssSrc, KPIFAIL_SHEET_LM, 'LM').forEach(function(id) { ids[id] = true; });
  _kpifail_readIdColumnOnly_(ssSrc, KPIFAIL_SHEET_SOP, 'SOP').forEach(function(id) { ids[id] = true; });
  return ids;
}

// "Đồng bộ Sheet" — ĐÃ THIẾT KẾ LẠI (xem ghi chú đầu file phần KPIFAIL_NOTES_SHEET).
// KPIFail_Notes giờ CHỈ chứa các dòng có note thật (kpifail_saveNote tự thêm dòng khi
// user note lần đầu) — không còn là bản sao toàn bộ dữ liệu nguồn nữa.
// Vì vậy "đồng bộ" không cần đọc + ghi lại toàn bộ record nguồn (vốn rất tốn kém khi
// nguồn có hàng trăm nghìn dòng), chỉ cần làm 1 việc: DỌN NOTE RÁC — note nào có
// Shipment ID không còn xuất hiện trong 3 sheet nguồn nữa (đơn đã fix / hết fail)
// thì xoá khỏi sheet lưu trữ. Đây chính là cơ chế "xoá dữ liệu" để KPIFail_Notes
// không bao giờ phình to vô hạn theo lưu lượng fail hàng ngày — kích thước của nó
// luôn tỉ lệ với SỐ NOTE ĐANG CÒN HIỆU LỰC, không tỉ lệ với tổng số đơn fail.
function kpifail_syncFullData() {
  // Giờ chỉ là lối tắt để user chủ động kích hoạt sớm — logic dọn dẹp thật sự nằm ở
  // kpifail_autoCleanupNotes() (chạy tự động mỗi 6 tiếng qua trigger, xem bên dưới).
  var res = JSON.parse(kpifail_autoCleanupNotes());
  if (!res.success) return JSON.stringify(res);
  return JSON.stringify({
    success: true,
    removed: res.removedOrphan + res.removedOld,
    remaining: res.remaining,
    time: res.time
  });
}

// ── LỚP BẢO VỆ THỨ 2: dọn theo TUỔI NOTE (retention), độc lập với orphan-cleanup ──
// Orphan-cleanup (ở trên) chỉ xoá note khi ID *biến mất khỏi nguồn*. Nhưng nếu nguồn
// (FM/LM/SOP) giữ lại lịch sử lâu dài (không tự dọn), ID vẫn "active" mãi mãi dù đơn
// đã xử lý xong từ lâu → note KHÔNG BAO GIỜ bị orphan-cleanup động tới. Đây là kẽ hở
// thực sự nguy hiểm ở quy mô 500 hub. Hàm này thêm lớp chặn độc lập: note nào có
// Ngày (cột B, ngày của đơn fail) cũ hơn maxAgeDays thì xoá luôn, BẤT KỂ ID còn
// active trong nguồn hay không — vì sau X ngày, note đã hoàn thành nhiệm vụ ghi nhận/
// theo dõi, không cần giữ vĩnh viễn.
// Mặc định 180 ngày — có thể chỉnh theo nhu cầu vận hành thực tế.
var KPIFAIL_NOTES_MAX_AGE_DAYS = 180;
var KPIFAIL_HISTORY_MAX_AGE_DAYS = 365;

// Thời gian ân hạn cho orphan-cleanup: khi đơn đã biến mất khỏi 3 sheet nguồn
// (FM/LM/SOP — nghĩa là đơn đã fix/hết fail), note KHÔNG bị xóa ngay lập tức nữa.
// Chỉ xóa khi đơn đã vắng mặt khỏi nguồn VÀ note cũng đã đủ "tuổi" (tính theo Ngày
// của đơn ở cột B) ít nhất KPIFAIL_ORPHAN_GRACE_DAYS. Tránh tình trạng note vừa ghi
// 1-5 ngày trước bị xóa oan chỉ vì đơn được xử lý xong rất nhanh sau khi note.
var KPIFAIL_ORPHAN_GRACE_DAYS = 30;

function _kpifail_pruneOldNotes_(maxAgeDays) {
  maxAgeDays = maxAgeDays || KPIFAIL_NOTES_MAX_AGE_DAYS;
  var sheet = _kpifail_getNotesSheet_();
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return 0;

  var tz = SPX_TZ;
  var cutoff = new Date();
  cutoff.setDate(cutoff.getDate() - maxAgeDays);
  var cutoffStr = Utilities.formatDate(cutoff, tz, 'yyyy-MM-dd');

  // Chỉ cần đọc cột B (Ngày) — nhẹ, không cần đọc cả 10 cột.
  var dateCol = sheet.getRange(2, 2, lastRow - 1, 1).getDisplayValues();
  var deleteRows = [];
  for (var i = 0; i < dateCol.length; i++) {
    var d = (dateCol[i][0] || '').toString().trim();
    // Bỏ qua nếu sai định dạng — tránh so sánh chuỗi sai lệch âm thầm (xem _kpifail_isValidIsoDate_).
    if (d && _kpifail_isValidIsoDate_(d) && d < cutoffStr) deleteRows.push(i + 2);
  }
  _kpifail_batchDeleteRows_(sheet, deleteRows);
  return deleteRows.length;
}

// Dọn KPIFail_Notes_History theo tuổi — dùng cột _TS (cột 6, Date object đầy đủ) để
// tính tuổi chính xác, KHÔNG dùng cột "Thời Gian" hiển thị (dd/MM HH:mm, thiếu năm).
function _kpifail_pruneOldHistory_(maxAgeDays) {
  maxAgeDays = maxAgeDays || KPIFAIL_HISTORY_MAX_AGE_DAYS;
  var sheet = _kpifail_getHistorySheet_();
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return 0;

  var cutoffMs = Date.now() - maxAgeDays * 24 * 60 * 60 * 1000;
  var tsCol = sheet.getRange(2, 6, lastRow - 1, 1).getValues();
  var deleteRows = [];
  for (var i = 0; i < tsCol.length; i++) {
    var ts = tsCol[i][0];
    if (ts instanceof Date && ts.getTime() < cutoffMs) deleteRows.push(i + 2);
  }
  _kpifail_batchDeleteRows_(sheet, deleteRows);
  return deleteRows.length;
}

// [BẢO VỆ TỐI THIỂU] Không bao giờ xóa note nào đã được tạo/sửa trong vòng X ngày gần
// nhất, BẤT KỂ thuộc lớp dọn nào (tuổi 180 ngày hay orphan+ân hạn). Đây là "sàn" cứng
// đảm bảo mọi note luôn được lưu tối thiểu 30 ngày kể từ lần ghi/sửa cuối — kể cả note
// ghi cho 1 đơn đã rất cũ (đơn fail từ 200 ngày trước nhưng user vừa note hôm nay vẫn
// được giữ đủ 30 ngày, không bị dọn ngay ở lần cleanup kế tiếp dù "Ngày" đơn đã quá hạn).
// Dựa vào cột _LastEditTS (Date object đầy đủ, không phải "Thời Gian Note" hiển thị
// dd/MM HH:mm vì thiếu năm, không đủ tính tuổi chính xác qua nhiều năm vận hành).
var KPIFAIL_MIN_RETENTION_SINCE_EDIT_DAYS = 30;

// ── GỘP 2 LỚP DỌN + CHẠY TỰ ĐỘNG QUA TRIGGER (không phụ thuộc ai bấm nút) ──
// Đây là hàm thật sự đảm bảo KPIFail_Notes không phình vô hạn: chạy định kỳ, KHÔNG
// cần user thao tác. Nút "Đồng bộ Sheet" trên UI giờ chỉ là cách user CHỦ ĐỘNG kích
// hoạt sớm hơn lịch trigger, không phải là cơ chế dọn rác chính.
// [CẬP NHẬT] Orphan-cleanup giờ có thời gian ân hạn (KPIFAIL_ORPHAN_GRACE_DAYS) —
// không xóa ngay khi đơn biến mất khỏi nguồn nữa, tránh xóa oan note vừa ghi gần đây.
// Đảm bảo mọi note đều được lưu tối thiểu đúng theo chính sách 180 ngày
// (KPIFAIL_NOTES_MAX_AGE_DAYS) như đã thống nhất, bất kể đơn đã fix nhanh hay chậm.
// [FIX RACE CONDITION] Trước đây tính toán danh sách dòng cần xóa TRƯỚC khi vào lock,
// rồi xóa theo SỐ THỨ TỰ DÒNG đã chốt sẵn — nếu có user sửa đúng dòng đó trong lúc chờ
// lock, dòng vẫn bị xóa theo quyết định cũ, làm mất nội dung vừa sửa. Giờ chỉ tính toán
// "trước" với bước ĐẮT (activeIds — quét 3 sheet nguồn ~100k dòng), còn việc đọc dữ liệu
// của CHÍNH sheet KPIFail_Notes (rẻ, vì sheet này chỉ chứa các dòng có note thật) được
// dời vào BÊN TRONG lock, ngay trước khi xóa — đảm bảo quyết định xóa luôn dựa trên dữ
// liệu mới nhất, không còn khoảng hở race condition.
function kpifail_autoCleanupNotes() {
  // [SECURITY FIX 2026-08] Hàm XOÁ VĨNH VIỄN note "orphan" (đơn đã hết fail) —
  // trước đây không kiểm tra quyền, gọi trực tiếp bất cứ lúc nào cũng xoá được,
  // bỏ qua các điều kiện an toàn (đợi nguồn ổn định) mà trigger tự động vẫn tôn
  // trọng. Chỉ admin (hoặc trigger 6 giờ/lần chạy dưới danh nghĩa tài khoản admin
  // đã cài) mới được gọi.
  _requireAdmin_(2);
  // [TỐI ƯU] Đọc activeIds TRƯỚC khi vào lock — đây là bước đắt nhất (quét cả 3 sheet
  // nguồn FM/LM/SOP, có thể tới ~100k dòng), không liên quan trực tiếp tới việc ghi/sửa
  // note nên an toàn khi đọc ngoài lock (dữ liệu nguồn hiếm khi đổi trong vài giây).
  //
  // [FIX] BẢO VỆ CHỐNG XOÁ NHẦM DO ĐỌC TRÚNG LÚC NGUỒN ĐANG GHI: activeIds quyết
  // định note nào bị coi là "orphan" (đơn đã hết fail) để XOÁ VĨNH VIỄN. Nếu đọc
  // trúng lúc pipeline ngoài đang clear+ghi lại sheet (đã xác nhận qua Version
  // History — 2 service account ghi liên tục, không theo lịch cố định), activeIds
  // sẽ THIẾU nhiều ID đang active thật -> note của các đơn đó bị hiểu lầm là orphan
  // và bị xoá oan, không thể khôi phục. Hậu quả nặng hơn hẳn so với dashboard hiển
  // thị sai tạm thời, nên cần chặn TRƯỚC khi tính activeIds: nếu nguồn không ổn
  // định, bỏ qua HẲN lượt dọn orphan lần này (vẫn chạy dọn theo tuổi note — không
  // phụ thuộc activeIds nên an toàn — và dọn lịch sử), rồi thử lại ở lượt kế tiếp
  // (trigger chạy mỗi 6 giờ, không mất mát gì khi lùi 1 chu kỳ).
  var ssSrc = _DS.ss(KPIFAIL_SS_ID);
  var sourceStableForOrphan = _kpifail_waitForStableSource_(ssSrc);
  var activeIds = sourceStableForOrphan ? _kpifail_getActiveIdSet_() : null;
  if (!sourceStableForOrphan) {
    _LOG.d('[KPIFail AutoCleanup] Bỏ qua lượt dọn ORPHAN lần này vì nguồn có vẻ đang được ghi liên tục — vẫn dọn theo tuổi note (không phụ thuộc nguồn). Thử lại orphan ở lượt kế tiếp (6 giờ sau).');
  }

  var tz = SPX_TZ;
  var graceCutoff = new Date();
  graceCutoff.setDate(graceCutoff.getDate() - KPIFAIL_ORPHAN_GRACE_DAYS);
  var graceCutoffStr = Utilities.formatDate(graceCutoff, tz, 'yyyy-MM-dd');
  var ageCutoff = new Date();
  ageCutoff.setDate(ageCutoff.getDate() - KPIFAIL_NOTES_MAX_AGE_DAYS);
  var ageCutoffStr = Utilities.formatDate(ageCutoff, tz, 'yyyy-MM-dd');
  var minRetentionMs = KPIFAIL_MIN_RETENTION_SINCE_EDIT_DAYS * 24 * 60 * 60 * 1000;

  var removedOrphan = 0, removedOld = 0, removedHistory = 0;
  var sheet = _kpifail_getNotesSheet_();
  // [FIX NGHẼN LOCK] Dùng named lock riêng cho KPIFail_Notes (giống saveNote/saveNotesBulk)
  // thay vì LockService.getScriptLock() toàn cục — job dọn dẹp này chỉ cần tránh đụng
  // với chính các thao tác ghi note, không cần (và không nên) chặn Analytics/Trend.
  var gotLock = _kpifail_acquireNoteLock_(20000, 30000);
  if (!gotLock) {
    _LOG.d('[KPIFail AutoCleanup] Không lấy được lock ghi note, bỏ qua lượt dọn này (thử lại lượt sau).');
    return JSON.stringify({ success: false, lockBusy: true, error: 'Không lấy được lock, thử lại lượt sau.' });
  }
  try {
    // Đọc lại NGAY TRONG LOCK — dữ liệu luôn mới nhất tại thời điểm quyết định xóa,
    // không dùng lại bất kỳ giá trị nào đã đọc từ trước khi vào lock.
    var lastRow = sheet.getLastRow();
    var orphanRows = [], oldRows = [];
    var nowMs = Date.now();

    if (lastRow >= 2) {
      var idCol      = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
      var dateCol    = sheet.getRange(2, 2, lastRow - 1, 1).getDisplayValues();
      var lastEditTs = sheet.getRange(2, KPIFAIL_NOTES_COL_LASTEDIT_TS, lastRow - 1, 1).getValues();

      for (var i = 0; i < idCol.length; i++) {
        var id = String(idCol[i][0] || '').trim();
        var orderDate = (dateCol[i][0] || '').toString().trim();
        var validDate = orderDate && _kpifail_isValidIsoDate_(orderDate);
        var rowNum = i + 2;

        // [SÀN BẢO VỆ] Note đã sửa trong vòng KPIFAIL_MIN_RETENTION_SINCE_EDIT_DAYS
        // ngày gần nhất → KHÔNG xóa, bất kể thuộc lớp nào. Dòng cũ (tạo trước khi có
        // cột _LastEditTS) sẽ có ô này rỗng → bỏ qua sàn bảo vệ này, áp dụng luật cũ.
        var ts = lastEditTs[i][0];
        if (ts instanceof Date && (nowMs - ts.getTime()) < minRetentionMs) continue;

        // Lớp 1 — tuổi note: bất kể ID còn active trong nguồn hay không, quá hạn
        // KPIFAIL_NOTES_MAX_AGE_DAYS thì xóa. Ưu tiên kiểm tra trước vì áp dụng chung.
        if (validDate && orderDate < ageCutoffStr) {
          oldRows.push(rowNum);
          continue; // đã chắc chắn xóa, khỏi cần xét orphan nữa
        }

        // Lớp 2 — orphan + ân hạn: ID không còn active trong nguồn VÀ đã đủ
        // KPIFAIL_ORPHAN_GRACE_DAYS kể từ ngày đơn. Ngày không xác định (rỗng/sai định
        // dạng) → KHÔNG xóa, an toàn hơn xóa nhầm note còn mới.
        // [FIX] activeIds === null nghĩa là nguồn không ổn định lúc đọc (xem trên) —
        // KHÔNG coi bất kỳ ID nào là orphan trong trường hợp này (an toàn hơn xoá nhầm).
        if (activeIds && id && !activeIds[id] && validDate && orderDate < graceCutoffStr) {
          orphanRows.push(rowNum);
        }
      }
    }

    // Gộp 2 danh sách lại xóa 1 lần (tránh batchDelete gọi 2 lần làm lệch chỉ số
    // nếu 2 danh sách có dòng trùng nhau — đã loại trùng bằng "continue" ở trên rồi,
    // nhưng gộp vẫn an toàn hơn và ít lệnh deleteRows hơn).
    var allDeleteRows = oldRows.concat(orphanRows);
    _kpifail_batchDeleteRows_(sheet, allDeleteRows);
    removedOld = oldRows.length;
    removedOrphan = orphanRows.length;

    // [FIX] KPIFail_Notes_History là append-only, KHÔNG có cơ chế dọn nào trước đây —
    // đúng lỗi tích lũy vô hạn mình đã dày công sửa cho KPIFail_Notes. Giữ lịch sử lâu
    // hơn note thường (365 ngày) vì đây là log audit, không cần dọn gấp như note đang
    // hoạt động — nhưng vẫn phải có trần, không giữ mãi mãi.
    removedHistory = _kpifail_pruneOldHistory_(KPIFAIL_HISTORY_MAX_AGE_DAYS);

    _kpifail_invalidateNotesCache_();
    _LOG.d('[KPIFail AutoCleanup] orphan=' + removedOrphan + ' old=' + removedOld +
      ' history=' + removedHistory + ' remaining=' + Math.max(sheet.getLastRow() - 1, 0));

    return JSON.stringify({
      success: true,
      removedOrphan: removedOrphan,
      removedOld: removedOld,
      removedHistory: removedHistory,
      remaining: Math.max(sheet.getLastRow() - 1, 0),
      time: Utilities.formatDate(new Date(), 'GMT+7', 'dd/MM HH:mm')
    });
  } catch (e) {
    _LOG.d('[KPIFail AutoCleanup] ERROR: ' + e.message);
    return JSON.stringify({ success: false, error: e.message });
  } finally {
    _kpifail_releaseNoteLock_();
  }
}

// ── Trigger setup: gọi 1 LẦN DUY NHẤT để bật lịch tự động dọn note ──
// Chạy mỗi 6 tiếng/lần — đủ thường xuyên để note rác không kịp tích lũy lớn (kể cả
// ở quy mô 5k note/ngày), mà không tốn quota trigger quá mức.
// [DEPRECATED 2026-07-29] Đã gộp vào setupNightlyMaintenanceTrigger() (chạy 1
// lần/đêm thay vì mỗi 6 tiếng) — KHÔNG chạy lại hàm này, sẽ tạo trùng trigger.
// Giữ lại code chỉ để tham khảo lịch sử.
function setupKPIFailCleanupTrigger() {
  ScriptApp.getProjectTriggers().forEach(function(t) {
    if (t.getHandlerFunction() === 'kpifail_autoCleanupNotes') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('kpifail_autoCleanupNotes')
    .timeBased().everyHours(6).create();
  _LOG.d('✅ Trigger kpifail_autoCleanupNotes đã được tạo — chạy mỗi 6 tiếng.');
}

// [FIX 2026-07-28] Trigger CHẠY TAY 1 LẦN để bật lưới an toàn cho phương án đọc
// theo số dòng (_kpifail_readSourceRowsSince_): cách đọc mới chỉ bắt được dòng
// MỚI THÊM VÀO CUỐI sheet, không bắt được trường hợp hệ thống nguồn SỬA LẠI dữ
// liệu cũ ở giữa sheet (backfill). Chạy kpifail_forceFullRebuild() 1 lần/ngày vào
// giờ vắng (2h sáng) để đối chiếu lại toàn bộ — chấp nhận trễ tối đa 1 ngày cho
// các bản sửa dữ liệu cũ, đổi lại giữ tốc độ nhanh cho toàn bộ các chu kỳ 5 phút
// còn lại trong ngày. CHẠY 1 LẦN function này trong GAS editor để kích hoạt.
function setupKPIFailNightlyRebuildTrigger() {
  ScriptApp.getProjectTriggers().forEach(function(t) {
    if (t.getHandlerFunction() === 'kpifail_nightlyFullRebuildRunner') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('kpifail_nightlyFullRebuildRunner')
    .timeBased().inTimezone(SPX_TZ).atHour(2).everyDays(1).create();
  _LOG.d('✅ Trigger kpifail_nightlyFullRebuildRunner đã được tạo — chạy 2h sáng hằng ngày (giờ VN).');
  return 'Đã tạo trigger kpifail_nightlyFullRebuildRunner — chạy 2h sáng hằng ngày (giờ VN).';
}

function kpifail_nightlyFullRebuildRunner() {
  try {
    var res = kpifail_forceFullRebuild();
    _LOG.d('[KPIFail nightly rebuild] ' + res);
  } catch (e) {
    _LOG.d('[KPIFail nightly rebuild] ERROR: ' + e.message);
  }
}

// ── [NÂNG CẤP] PREWARM CACHE — chạy nền để dashboard hầu như luôn load từ cache ──
// Cache TTL 300s nghĩa là nếu không ai mở dashboard trong 5 phút, lượt mở tiếp theo
// sẽ rơi vào cold path (mở 3 sheet ngoài qua mạng — chậm, đã phân tích ở các lần
// trước).
// [FIX] Hàm này TRƯỚC ĐÂY gọi kpifail_getMasterData() — đọc THẲNG 3 sheet nguồn,
// KHÔNG qua persisted snapshot, KHÔNG có stability-check chống race condition.
// Vì dashboard đã chuyển sang dùng kpifail_getMasterDataLite() (qua
// _kpifail_getPersistentMasterRecords_ — có snapshot + stability-check) từ lâu,
// cache mà kpifail_getMasterData() tạo ra (key 'kpifail_master_v3_...') KHÔNG còn
// được bất kỳ nơi nào khác đọc lại — nghĩa là trigger 5 phút/lần này chỉ đang tốn
// quota Sheets API + tự đặt mình vào rủi ro đọc trúng lúc nguồn đang bị ghi, mà
// không mang lại lợi ích thực tế nào. Đổi sang gọi kpifail_getMasterDataLite('ALL', ...)
// — vừa đúng cache mà dashboard thật sự dùng, vừa tự động kế thừa mọi lớp bảo vệ
// (persisted snapshot, stability-check, anomaly-guard) đã thêm ở trên.
function kpifail_prewarmCache() {
  if (_spxIsPrewarmQuietHours_()) { _LOG.d('[KPIFail Prewarm] Bỏ qua — khung giờ vắng user (23h-5h).'); return; }
  // [FIX 2026-08-13] Job KHÔNG QUAN TRỌNG (chỉ giữ cache nóng, mất 1 lượt không hỏng
  // dữ liệu) — tự nhường quota runtime/ngày cho traffic user thật khi ngân sách hôm
  // nay đã cao. Xem giải thích đầy đủ ở _spxShouldSkipForBudget_().
  if (_spxShouldSkipForBudget_()) { _LOG.d('[KPIFail Prewarm] Bỏ qua — ngân sách runtime hôm nay đã cao, nhường quota cho user.'); return; }
  // [FIX 2026-07-28] Log Executions thực tế cho thấy hàm này (trigger 5 phút) thỉnh
  // thoảng chạy rất lâu (có lượt tới 30 phút, bị Timed Out) — vì KHÔNG có khóa chống
  // chồng lấn, các trigger 5 phút tiếp theo vẫn cứ bắn thêm trong khi lượt trước còn
  // chạy → nhiều bản chạy song song tranh nhau tài nguyên, càng chồng càng chậm, kéo
  // theo cả kpifail_getIndexSummary (card trang chủ) bị kẹt hàng trăm giây do xếp hàng
  // phía sau. Áp dụng ĐÚNG pattern _anaAcquireNamedLock() đã dùng cho
  // pick_live_prewarmCache (fix 2026-07-24) — nếu đang có 1 lượt chạy dở, bỏ qua chu
  // kỳ này ngay (không chờ), cache cũ vẫn còn dùng tạm được, chu kỳ 5 phút sau sẽ thử lại.
  // [FIX 2026-07-31] Thêm staleMs tường minh (trước dùng mặc định 90s) — đồng bộ
  // với chu kỳ trigger mới (10 phút, trước 5 phút). Đây là lớp khóa NGOÀI, lớp
  // chống chồng lấn thật đã có ở khóa TRONG (kpifail_masterdata_cold_lock_v1,
  // staleMs 300s) nên rủi ro không lớn, nhưng vẫn nâng cho đồng bộ.
  var gotLock = _anaAcquireNamedLock('kpifail_prewarm_lock_v1', 10000, 600000);
  if (!gotLock) { _LOG.d('[KPIFail Prewarm] Bỏ qua — lượt trước còn đang chạy.'); return; }
  var _t0 = Date.now();
  try {
    // [TỐI ƯU QUAN TRỌNG — đo thật: hàm này từng có lượt chạy 1.439 giây (24
    // phút), tốn ~7% ngân sách 360 phút/ngày chỉ trong MỘT lượt]
    // TRƯỚC ĐÂY gọi kpifail_getMasterDataLite('ALL', ...) — hàm đó làm 3 việc:
    //   (1) làm mới snapshot dùng CHUNG cho mọi user  <- việc DUY NHẤT prewarm cần
    //   (2) dựng kết quả "lite" cho riêng phạm vi quyền admin
    //   (3) JSON.stringify + ghi cache phân mảnh ~327k bản ghi  <- TỐN NHẤT
    // Sau khi khoá cache đã đổi sang theo PHẠM VI QUYỀN, phần (2)+(3) chỉ phục
    // vụ đúng nhóm admin (vài người), trong khi chi phí thì cả hệ thống gánh mỗi
    // 10 phút. Nay prewarm CHỈ làm (1) — phần thật sự dùng chung cho 2.000 user.
    // KHÔNG giảm trải nghiệm: (2)+(3) vẫn chạy khi user mở module, nhưng lúc đó
    // snapshot đã nóng sẵn nên KHÔNG phải đọc lại Sheets (phần chậm nhất) —
    // đúng cách mà 1.999 user không-phải-admin vốn đã luôn chạy từ trước tới nay.
    _kpifail_getPersistentMasterRecords_();
    _LOG.d('[KPIFail Prewarm] Snapshot dùng chung đã được làm mới lúc ' + new Date());
  } catch (e) {
    _LOG.d('[KPIFail Prewarm] ERROR: ' + e.message);
  } finally {
    _anaReleaseNamedLock('kpifail_prewarm_lock_v1');
    var _elapsedMin = (Date.now() - _t0) / 60000;
    _spxTrackExecMinutes_(_elapsedMin);
    // [CẢNH BÁO SỚM] Ghi log rõ ràng khi 1 lượt chạy đã tốn quá NỬA ngân sách còn
    // lại của 1 chu kỳ (10 phút = 1/36 ngày) — để phát hiện xu hướng chậm dần TRƯỚC
    // khi nó lặp lại đúng sự cố "30 phút, Timed Out" đã từng xảy ra, thay vì chỉ biết
    // sau khi đã sập. Ngưỡng 3 phút = 50% của chu kỳ trigger 10 phút và cũng là 50%
    // của trần cứng 6 phút/lần chạy Apps Script.
    if (_elapsedMin >= 3) {
      _LOG.d('[KPIFail Prewarm] ⚠️ CẢNH BÁO: lượt này chạy ' + _elapsedMin.toFixed(1) +
        ' phút (>50% trần 6 phút/lần) — dữ liệu đang tăng, cân nhắc chia lô trước khi lặp lại sự cố Timed Out cũ.');
    }
  }
}

// [FIX 2026-07-31] Đổi 5 phút -> 10 phút — 1 trong 5 trigger được cân bằng lại để
// tổng thời gian chạy/ngày của TẤT CẢ trigger nền không vượt quota 360 phút/ngày
// (tài khoản Workspace). An toàn để giảm tần suất vì kpifail_getMasterDataLite()
// luôn có đường tự build dự phòng khi cache/snapshot chưa kịp làm mới (không có
// rủi ro lỗi cứng như fms_live/pick_live).
function setupKPIFailPrewarmTrigger() {
  // [CẢNH BÁO — theo yêu cầu trực tiếp "gộp trigger tương đồng"] Trigger 10-phút riêng lẻ này ĐÃ ĐƯỢC GỘP vào spxDispatcher10Min() — chỉ chạy hàm này nếu THẬT SỰ muốn tách nó ra khỏi nhóm gộp trở lại (sẽ tạo lại đúng trigger đã gộp, làm mất tác dụng gộp). Bình thường KHÔNG cần chạy nữa —
  // dùng spxInstallDispatcher10Min() thay thế.
  ScriptApp.getProjectTriggers().forEach(function(t) {
    if (t.getHandlerFunction() === 'kpifail_prewarmCache') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('kpifail_prewarmCache')
    .timeBased().everyMinutes(10).create();
  _LOG.d('✅ Trigger kpifail_prewarmCache đã được tạo — chạy mỗi 10 phút.');
}

// ============================================================
// AGING — PRE-WARM CACHE & ORPHAN CLEANUP TRIGGER
// ============================================================
// [OPT] Hàm prewarm giữ aging_getMasterData() luôn có cache nóng.
// Chạy setupAgingPrewarmTrigger() MỘT LẦN trong Apps Script Editor để bật.
function aging_prewarmCache() {
  if (_spxIsPrewarmQuietHours_()) { _LOG.d('[Aging Prewarm] Bỏ qua — khung giờ vắng user (23h-5h).'); return; }

  // [VIẾT LẠI — theo yêu cầu: "tận dụng nhịp cập nhật nguồn để user luôn thấy số mới nhất"]
  // Nguồn cập nhật MỖI GIỜ trong khung 7:00-18:00. Cách cũ: mỗi lượt trigger chỉ chạy
  // ĐÚNG 1 trong 4 giai đoạn (core/lost/fm/finalize) -> phải 4 lượt mới xong 1 bản chụp,
  // và chạy lại vô điều kiện kể cả khi nguồn CHƯA đổi (tốn ngân sách vô ích).
  // Cách mới, 2 nguyên tắc:
  //   1) CHỈ DỰNG KHI NGUỒN ĐÃ ĐỔI — so dấu phiên bản nguồn (đọc đúng 1 ô) với dấu đã
  //      lưu trong bản chụp. Nguồn chưa đổi thì không làm gì, để dành ngân sách.
  //   2) KHI ĐÃ DỰNG THÌ DỰNG TRỌN trong 1 lượt (đo thật: 4 giai đoạn xong dưới 6 phút),
  //      thay vì rải ra 4 lượt. Nhờ vậy số mới của nguồn đến tay người dùng trong vòng
  //      1 nhịp trigger, không phải chờ cả tiếng.
  // [SỬA — theo phản hồi: nguồn KHÔNG ghi xong trong 1 nhịp mà đồng bộ dần]
  // Nguồn có thể ghi từ 10:00 tới 10:10. Nếu bắt gặp lúc đang ghi dở, bản chụp sẽ
  // dựng từ DỮ LIỆU THIẾU và người dùng thấy số thấp hơn thực tế mà không biết.
  // Quy tắc: chỉ dựng khi nguồn ĐÃ NGỪNG THAY ĐỔI — đọc dấu phiên bản 2 lần cách
  // nhau 8 giây; còn nhảy số nghĩa là đang ghi dở -> để lượt sau (10 phút nữa).
  var srcVer = '';
  try {
    srcVer = _aging_getSourceVersion_();
    Utilities.sleep(8000);
    var srcVer2 = _aging_getSourceVersion_();
    if (srcVer && srcVer2 && srcVer !== srcVer2) {
      _LOG.d('[Aging Prewarm] Nguồn ĐANG GHI DỞ (' + srcVer + ' -> ' + srcVer2 + ') — hoãn dựng, giữ bản chụp hoàn chỉnh trước đó.');
      return;
    }
    srcVer = srcVer2 || srcVer;
  } catch (eSv) {}
  var meta = {};
  try { meta = _kpifail_getMetaMap_(_aging_getSnapshotMetaSheet_(_DS.ss(ADMIN_DB_ID))) || {}; } catch (eM) {}
  var snapAgeMin = meta.snapshot_version ? Math.round((Date.now() - Number(meta.snapshot_version)) / 60000) : 99999;
  var stage = '';
  try { stage = PropertiesService.getScriptProperties().getProperty(AGING_BUILD_STAGE_KEY) || 'core'; } catch (eSt) {}

  // [SỬA — theo phản hồi: nguồn GHI ĐÈ TOÀN BỘ, đẩy dần, không rõ tiến độ]
  // Giữa chừng sheet có thể mất bớt dòng (xoá rồi ghi lại). Chỉ dựa vào "số dòng
  // ngừng nhảy trong 8 giây" là chưa đủ — rơi đúng khoảng nghỉ giữa hai đợt ghi sẽ
  // tưởng nhầm đã xong và dựng ra bản THIẾU DÒNG.
  // Chốt khối lượng: bản ghi đè hoàn chỉnh không thể ít hơn 80% lần hoàn chỉnh trước.
  // Nếu thấp hơn -> coi như đang ghi dở, hoãn. Nhưng KHÔNG hoãn vô hạn: dữ liệu có
  // thể giảm thật (đợt dọn lớn), nên sau 3 lượt liên tiếp vẫn thấp thì chấp nhận.
  try {
    // [SỬA] So SỐ ĐƠN THẬT (không phải lastRow, vốn gồm hàng chục nghìn dòng trống). Chỉ đọc khi thật sự
    // sắp dựng (nguồn đổi / chu kỳ dở / bản chụp quá hạn) để không tốn 1 lượt đọc cột mỗi 10 phút.
    var _wouldBuild = !(srcVer && meta.snapshot_source_version === srcVer && snapAgeMin <= 180 && stage === 'core' && meta.snapshot_schema === AGING_SNAPSHOT_SCHEMA);
    var _srcRows  = 0;
    if (_wouldBuild) { try { _srcRows = _aging_countSourceOrders_(); } catch (eCo) { _srcRows = 0; } }
    var _prevRows = Number(meta.snapshot_core_count || 0);
    var _props    = PropertiesService.getScriptProperties();
    var _streak   = Number(_props.getProperty('aging_low_rows_streak') || 0);
    if (_prevRows > 0 && _srcRows > 0 && _srcRows < _prevRows * 0.8) {
      _streak++;
      _props.setProperty('aging_low_rows_streak', String(_streak));
      if (_streak < 3) {
        _LOG.d('[Aging Prewarm] Nguồn mới chỉ có ' + _srcRows + '/' + _prevRows + ' dòng (' +
               Math.round(_srcRows / _prevRows * 100) + '%) — nhiều khả năng đang ghi dở, hoãn (lượt ' + _streak + '/3).');
        return;
      }
      _LOG.d('[Aging Prewarm] Vẫn thấp sau ' + _streak + ' lượt — chấp nhận là dữ liệu giảm thật, dựng bình thường.');
    }
    _props.deleteProperty('aging_low_rows_streak');
  } catch (eRows) {}

  // Nguồn chưa đổi + bản chụp còn trong hạn + không có chu kỳ dựng dở -> nghỉ.
  if (srcVer && meta.snapshot_source_version === srcVer && snapAgeMin <= 180 && stage === 'core' && meta.snapshot_schema === AGING_SNAPSHOT_SCHEMA) {
    _LOG.d('[Aging Prewarm] Nguồn chưa đổi (' + srcVer + '), bản chụp mới ' + snapAgeMin + ' phút — không cần dựng lại.');
    return;
  }

  // Dựng trọn 1 chu kỳ trong lượt này, dừng khi đã ghi bản chụp mới hoặc gần hết giờ.
  var t0 = Date.now(), verBefore = Number(meta.snapshot_version) || 0, lastStage = '';
  for (var n = 0; n < 12; n++) {
    // [MỚI] Lượt trigger gộp (spxDispatcher10Min) chạy NHIỀU job trong 1 lần thực thi 6 phút: tính cả
    // thời gian đã trôi từ lúc dispatcher bắt đầu, không chỉ từ lúc hàm này bắt đầu.
    if (Date.now() - t0 > 4.5 * 60 * 1000 || (_SPX_DISPATCH_T0 && Date.now() - _SPX_DISPATCH_T0 > 4.0 * 60 * 1000)) {
      _LOG.d('[Aging Prewarm] Hết thời lượng 1 lượt — lượt trigger sau chạy tiếp từ giai đoạn đang dở.');
      break;
    }
    var before = PropertiesService.getScriptProperties().getProperty(AGING_BUILD_STAGE_KEY) || 'core';
    aging_stagedBuildRunner();
    var after = PropertiesService.getScriptProperties().getProperty(AGING_BUILD_STAGE_KEY) || 'core';
    var verNow = 0;
    try { verNow = Number(_kpifail_getMetaMap_(_aging_getSnapshotMetaSheet_(_DS.ss(ADMIN_DB_ID))).snapshot_version) || 0; } catch (eV) {}
    if (verNow !== verBefore) {
      // Kiểm tra lại: nguồn có đổi TRONG LÚC đang dựng không? Nếu có, bản chụp vừa
      // ghi có thể dính dữ liệu nửa chừng -> đánh dấu để lượt sau dựng lại, thay vì
      // tin tưởng nhầm rồi phục vụ số thiếu suốt cả giờ.
      var srcAfter = '', _stamped = '';
      try { srcAfter = _aging_getSourceVersion_(); } catch (eSa) {}
      try { _stamped = String(_kpifail_getMetaMap_(_aging_getSnapshotMetaSheet_(_DS.ss(ADMIN_DB_ID))).snapshot_source_version || ''); } catch (eSt2) {}
      // [SỬA] So với dấu ĐÃ ĐÓNG vào bản chụp (= phiên bản lúc đọc core), không phải srcVer đầu lượt:
      // chu kỳ nối từ lượt trước vẫn bị bắt. Cũng bỏ việc ghi đè 'DANG_GHI_DO' — nó xoá cả bản đồ
      // meta (mất snapshot_version/ô đang dùng) khiến người dùng phải chờ dựng trực tiếp; dấu đóng
      // đúng đã đủ để lượt sau tự nhận ra bản chụp lệch nguồn.
      if (srcAfter && _stamped && srcAfter !== _stamped) {
        _LOG.d('[Aging Prewarm] Nguồn đã đổi từ lúc đọc (' + _stamped + ' -> ' + srcAfter + ') — bản vừa dựng có thể CŨ/THIẾU DÒNG, dựng lại NGAY trong lượt này.');
        // [SỬA] Trước đây chỉ đánh dấu rồi dừng -> người dùng thấy số thiếu tới 10
        // phút (đo bằng mô phỏng kịch bản job rơi đúng khoảng nghỉ giữa 2 đợt ghi).
        // Nay dựng lại ngay nếu còn thời lượng, rút thời gian phơi nhiễm xuống ~1 phút.
        verBefore = verNow;      // mốc mới để vòng lặp nhận ra lần ghi kế tiếp
        srcVer    = srcAfter;
        lastStage = '';
        continue;
      } else {
        _LOG.d('[Aging Prewarm] Đã dựng xong bản chụp mới theo nguồn ' + srcVer + '.');
      }
      break;
    }
    if (before === after && lastStage === before) {
      _LOG.d('[Aging Prewarm] Giai đoạn ' + after + ' không tiến triển 2 lượt — dừng, chờ lượt sau.');
      break;
    }
    lastStage = before;
  }
}

// [FIX 2026-07-31] Đổi 5 phút -> 10 phút — cùng đợt cân bằng lại tổng quota
// 360 phút/ngày. An toàn vì aging_getMasterData() có khóa chống chồng lấn + tự
// build dự phòng khi cache trống (đã vá 2026-07-30), không có rủi ro lỗi cứng.
function setupAgingPrewarmTrigger() {
  // [CẢNH BÁO — theo yêu cầu trực tiếp "gộp trigger tương đồng"] Trigger 10-phút riêng lẻ này ĐÃ ĐƯỢC GỘP vào spxDispatcher10Min() — chỉ chạy hàm này nếu THẬT SỰ muốn tách nó ra khỏi nhóm gộp trở lại (sẽ tạo lại đúng trigger đã gộp, làm mất tác dụng gộp). Bình thường KHÔNG cần chạy nữa —
  // dùng spxInstallDispatcher10Min() thay thế.
  ScriptApp.getProjectTriggers().forEach(function(t) {
    if (t.getHandlerFunction() === 'aging_prewarmCache') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('aging_prewarmCache')
    .timeBased().everyMinutes(10).create();
  _LOG.d('✅ Trigger aging_prewarmCache — chạy mỗi 10 phút.');
}

// [OPT] Dọn orphan notes định kỳ (tách khỏi cold path aging_getMasterData).
// Chỉ chạy 1 lần/6h thay vì mỗi lần load data → không ảnh hưởng response time.
// Chạy setupAgingOrphanCleanupTrigger() MỘT LẦN để bật.
function aging_orphanCleanup() {
  // [SECURITY FIX 2026-08] Hàm XOÁ note "orphan" trong App_Notes trên toàn hệ
  // thống — trước đây không kiểm tra quyền. Chỉ admin (hoặc trigger 6h/lần chạy
  // dưới danh nghĩa admin đã cài) mới được gọi.
  _requireAdmin_(2);
  try {
    const ssCore = _DS.ss('1V2Tpun2-4d6_iBVBKgFSe9GWGGIsgEmLdCPmpunYTcA');
    const ssLost = _DS.ss('1vvOZG80Rz5PTNPFsbHzmUMPkPaAkGOY70nDHBwfzjQE');
    const ssNote = _DS.ss(ADMIN_DB_ID);

    const coreRes = JSON.parse(_aging_getCoreDataFromSS(ssCore));
    const lostRes = JSON.parse(_aging_getLostDataFromSS(ssLost));

    const activeIds = new Set(
      (coreRes.data || []).map(function(r){ return r.shipmentId; })
      .concat((lostRes.data || []).map(function(r){ return r.shipmentId; }))
      .filter(Boolean)
    );

    // Dọn orphan thật sự (truyền activeIds để clearContents nếu cần)
    _aging_getNotesFromSS(ssNote, activeIds);
    // Sau khi dọn, invalidate notes cache để lần đọc tiếp lấy data sạch
    _aging_invalidateNotesCache();
    _LOG.d('[Aging OrphanCleanup] Hoàn thành lúc ' + new Date());
  } catch(e) {
    _LOG.d('[Aging OrphanCleanup] ERROR: ' + e.message);
  }
}

// [DEPRECATED 2026-07-29] Đã gộp vào setupNightlyMaintenanceTrigger() (chạy 1
// lần/đêm thay vì mỗi 6 tiếng) — KHÔNG chạy lại hàm này, sẽ tạo trùng trigger.
// Giữ lại code chỉ để tham khảo lịch sử.
function setupAgingOrphanCleanupTrigger() {
  ScriptApp.getProjectTriggers().forEach(function(t) {
    if (t.getHandlerFunction() === 'aging_orphanCleanup') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('aging_orphanCleanup')
    .timeBased().everyHours(6).create();
  _LOG.d('✅ Trigger aging_orphanCleanup — chạy mỗi 6 tiếng.');
}

// [FIX 2026-07-29] GỘP 2 việc bảo trì (dọn note orphan KPI Fail + Aging) — trước
// đây mỗi việc có trigger RIÊNG chạy mỗi 6 tiếng (4 lần/ngày), không phục vụ user
// real-time (chỉ dọn dữ liệu cũ/orphan), không cần thiết phải chạy dày. Gộp về 1
// trigger DUY NHẤT chạy 1 lần/đêm (3h sáng — lệch giờ với kpifail_nightlyFullRebuildRunner
// và trendNightlyPurgeRunner đang chạy 2h sáng, tránh dồn nhiều job nặng cùng lúc).
// CHẠY setupNightlyMaintenanceTrigger() MỘT LẦN để chuyển đổi — hàm này tự xoá 2
// trigger 6-tiếng cũ (kpifail_autoCleanupNotes, aging_orphanCleanup) trước khi tạo
// trigger mới, không để sót trigger cũ chạy song song.
function setupNightlyMaintenanceTrigger() {
  ScriptApp.getProjectTriggers().forEach(function(t) {
    var fn = t.getHandlerFunction();
    if (fn === 'kpifail_autoCleanupNotes' || fn === 'aging_orphanCleanup' || fn === 'spx_nightlyMaintenanceRunner') {
      ScriptApp.deleteTrigger(t);
    }
  });
  ScriptApp.newTrigger('spx_nightlyMaintenanceRunner')
    .timeBased().inTimezone(SPX_TZ).atHour(3).everyDays(1).create();
  _LOG.d('✅ Trigger spx_nightlyMaintenanceRunner đã được tạo — chạy 3h sáng hằng ngày, thay cho 2 trigger 6-tiếng cũ.');
  return 'Đã tạo trigger spx_nightlyMaintenanceRunner (3h sáng hằng ngày) và xoá 2 trigger 6-tiếng cũ (kpifail_autoCleanupNotes, aging_orphanCleanup).';
}

function spx_nightlyMaintenanceRunner() {
  // Mỗi việc bọc try/catch RIÊNG — 1 việc lỗi không được phép chặn việc còn lại.
  try {
    kpifail_autoCleanupNotes();
    _LOG.d('[Nightly Maintenance] kpifail_autoCleanupNotes xong.');
  } catch (e1) {
    _LOG.d('[Nightly Maintenance] kpifail_autoCleanupNotes ERROR: ' + e1.message);
  }
  try {
    aging_orphanCleanup();
    _LOG.d('[Nightly Maintenance] aging_orphanCleanup xong.');
  } catch (e2) {
    _LOG.d('[Nightly Maintenance] aging_orphanCleanup ERROR: ' + e2.message);
  }

  // [MỚI — khép khoảng trống "người dùng bỏ dở đồng bộ BI"] Mỗi đêm đối chiếu
  // Station_Daily với Rider Plan: ngày nào máy chủ ĐÃ CÓ số mà Rider Plan chưa có
  // thì bù vào. Nhờ vậy dù người dùng đóng tab, đổi máy hay xoá dữ liệu trình duyệt,
  // số vẫn về đúng chỗ mà không ai phải nhớ chạy tay.
  // An toàn: hàm bù dùng đúng quy tắc của rp_upsertDayFromBI -> KHÔNG đè số người
  // dùng tự nhập tay, và ghi đúng NGÀY CỦA DỮ LIỆU, không phải ngày chạy job.
  try {
    var _rc = JSON.parse(rp_reconcileFromStationDaily(null, null));
    _LOG.d('[Nightly Maintenance] Đối chiếu BI->Rider Plan: xét ' + (_rc.soNgayXet || 0) +
           ' ngày, bù ' + (_rc.buSung || 0) + ', bỏ qua ' + (_rc.boQua || 0) + '.');
  } catch (e3) {
    _LOG.d('[Nightly Maintenance] Đối chiếu BI->Rider Plan ERROR: ' + e3.message);
  }
}

var _WM = 'https://docs.google.com/spreadsheets/d/1Nl-XWrF29uUG3DKxD8CtpGOj9FkI1XChpkjN2AqclMA/edit';
var _WD = 'https://docs.google.com/spreadsheets/d/1n7qiYKs3b08P4KzMOEFPt2c1VI1XnZBf44TJl4KmehA/edit';

var _TAIL_TEAMS = [
  'Roadmap Lead', 'Roadmap Staff', 'Detail Cong Viec',
  'Plan Dao Tao Staff->Lead', 'Quy Doi Ranking',
  'Thuat Ngu & Tu Viet Tat', 'Trang Thai Don Hang', 'Phong Ban & Chuc Nang'
];

var _WN = {
  'opex':'OPEX', 'fin':'Fin', 'risk':'Risk Management', 'rs':'Rider', 'proc':'Procurement',
  'quy trinh nhan su':'HR', 'gia tri cot loi':'Gia Tri Cot Loi', 'cac chuong trinh':'Cac Chuong Trinh',
  'l&d':'L&D', 'wfa':'WFA', 'admin':'Admin', 'c&b':'C&B', 'cs':'CS', 'claim':'Claim',
  'hse':'HSE', 'it':'IT', 'olm':'OLM', 'product':'Product', 'hr':'HR'
};

// ---------- PUBLIC ----------
function wiki_getDocumentData_v2(forceRefresh) {
  // [SECURITY FIX 2026-08] Hàm này parse tới 10 sheet từ 2 Google Sheets — theo
  // chính log Executions ghi nhận trong code, có thể mất tới ~184s/lượt khi bỏ qua
  // cache (forceRefresh=true). Trước đây KHÔNG kiểm tra quyền — ai gọi qua console
  // cũng được, và có thể spam forceRefresh=true liên tục để gây quá tải/hết quota
  // Apps Script cho toàn hệ thống (DoS). Thêm chặn: phải là user đã duyệt mới đọc
  // được (kể cả bản cache), và CHỈ ADMIN mới được ép refresh bỏ qua cache.
  // [FIX] Hàm này luôn trả về OBJECT thô (không JSON.stringify — xem return result ở
  // dưới) — dùng JSON.stringify ở đây từng làm sai hợp đồng, khiến JS_TaiLieu.html
  // nhận về string thay vì object, hiện sai thông báo lỗi (r.success luôn undefined).
  try { _requireApproved_(); } catch (eAuth) { return { success: false, version: 'v2-row-wide-real-links', error: eAuth.message }; }
  // [MỚI — theo quyết định trực tiếp "chỉ tính khi thực sự tải dữ liệu"]
  if (forceRefresh) {
    try { _requireAdmin_(2); } catch (eAdmin) { forceRefresh = false; } // không phải admin → âm thầm dùng bản cache thay vì lỗi cứng
  }
  var t0 = Date.now();
  // [FIX 2026-07-29] THÊM CACHE — trước đây hàm này parse lại 10 sheet từ 2 file
  // Google Sheets MỖI LẦN gọi, không có cache nào cả (log Executions ghi nhận
  // avg 54.6s, max 184.6s/lượt). Nội dung Tài Liệu/Roadmap ít khi đổi trong ngày
  // nên cache 30 phút là hợp lý — vẫn giữ đường "Tải lại" (nút wRb, gọi
  // wLoad(true) ở client) bỏ qua cache để admin thấy ngay nội dung vừa sửa.
  var WIKI_CACHE_KEY = 'doc_data_v2';
  var WIKI_CACHE_TTL = 1800; // 30 phút
  if (!forceRefresh) {
    var cached = CacheMgr.getChunked('WIKI', WIKI_CACHE_KEY);
    if (cached) return cached;
  }
  try {
    var ss1 = SpreadsheetApp.openByUrl(_WM);
    var ss2 = SpreadsheetApp.openByUrl(_WD);

    var raw = [];
    raw = raw.concat(_sopParse(ss1));
    raw = raw.concat(_rmParse(ss1, 'Roadmap Ob Lead', 'Roadmap Lead'));
    raw = raw.concat(_rmParse(ss1, 'Roadmap Ob Staff', 'Roadmap Staff'));
    raw = raw.concat(_dcParse(ss1));
    raw = raw.concat(_planParse(ss1));
    raw = raw.concat(_rankParse(ss1));
    raw = raw.concat(_tnParse(ss1));
    raw = raw.concat(_ttParse(ss1));
    raw = raw.concat(_pbParse(ss1));
    raw = raw.concat(_dlkParse(ss2));

    var out = _dedup(raw).map(function(it) {
      return {
        team: _normalizeTeam(it.team || 'Khac'),
        category: (it.category || 'Khac').toString().trim(),
        title: (it.title || '').toString().trim(),
        description: (it.description || '').toString(),
        links: _dedupLinks(it.links || []),
        sourceUrl: '',
        sourceName: ''
      };
    });

    var result = {
      success: true,
      version: 'v2-row-wide-real-links',
      total: out.length,
      data: out,
      tailTeams: _TAIL_TEAMS,
      debug: {
        ms: Date.now() - t0,
        withLinks: out.filter(function(x){ return x.links && x.links.length; }).length
      }
    };
    try { CacheMgr.setChunked('WIKI', WIKI_CACHE_KEY, result, WIKI_CACHE_TTL); } catch (eWc) {}
    return result;
  } catch (e) {
    return {
      success: false,
      version: 'v2-row-wide-real-links',
      error: e && e.stack ? e.stack : String(e),
      debug: { ms: Date.now() - t0 }
    };
  }
}

// ---------- ROW-WIDE LINK EXTRACTOR ----------
function _collectRowLinks(sheet, rowIndex, lastCol) {
  var out = [];
  if (!sheet || rowIndex < 1 || lastCol < 1) return out;

  var rg = sheet.getRange(rowIndex, 1, 1, lastCol);
  var rich = rg.getRichTextValues()[0];
  var formulas = rg.getFormulas()[0];
  var display = rg.getDisplayValues()[0];

  function add(url, name) {
    if (!url) return;
    url = String(url).trim();
    if (!/^https?:\/\//i.test(url)) return;
    if (out.some(function(x){ return x.url === url; })) return;
    out.push({ url: url, name: (name || _gn(url) || 'Xem tai lieu').trim() });
  }

  for (var c = 0; c < lastCol; c++) {
    var f = formulas[c] || '';
    var rt = rich[c];
    var txt = (display[c] || '').toString().trim();

    if (f && /^=HYPERLINK\(/i.test(f)) {
      var m = f.match(/=HYPERLINK\s*\(\s*"([^"]+)"\s*[;,]\s*"([^"]*)"\s*\)/i);
      if (m && m[1]) add(m[1], m[2]);
    }

    if (rt) {
      try {
        var u = rt.getLinkUrl();
        if (u) add(u, (rt.getText() || '').trim());
      } catch(e) {}

      try {
        var runs = rt.getRuns ? rt.getRuns() : [];
        for (var j = 0; j < runs.length; j++) {
          var ru = runs[j].getLinkUrl();
          if (ru) add(ru, (runs[j].getText() || '').trim());
        }
      } catch(e) {}
    }

    if (txt) {
      var urls = txt.match(/https?:\/\/[^\s)\]]+/gi) || [];
      for (var k = 0; k < urls.length; k++) add(urls[k], _gn(urls[k]));
    }
  }

  return out;
}

function _ensureLinkFromRow(item, sheet, row, lastCol, carryLinks) {
  var links = _collectRowLinks(sheet, row, lastCol);
  if (!links.length && carryLinks && carryLinks.length) links = carryLinks.slice();
  item.links = _dedupLinks((item.links || []).concat(links));
  return item;
}

// ---------- PARSERS ----------
function _sopParse(ss) {
  var res = [], sh = ss.getSheetByName('SOP ( All FTE )');
  if (!sh) return res;
  var lr = sh.getLastRow();
  if (lr < 4) return res;
  var lc = sh.getLastColumn();
  var data = sh.getRange(1, 1, lr, Math.min(lc, 10)).getDisplayValues();

  var lastTeam = '', lastCat = '', carry = [];
  for (var i = 3; i < lr; i++) {
    var row = data[i];
    var team = row[1] ? row[1].trim() : lastTeam;
    var cat  = row[2] ? row[2].trim() : lastCat;
    var title = row[4] ? row[4].trim() : '';
    var access = row[6] ? row[6].trim() : '';
    var date = row[7] ? row[7].trim() : '';
    if (team) lastTeam = team;
    if (cat) lastCat = cat;
    if (!title) continue;

    var desc = [];
    if (access && access.length < 80) desc.push('🔒 ' + access);
    if (date && date !== '0') desc.push('📅 ' + date);

    var it = {
      team: team || 'OPS',
      category: cat || 'Khac',
      title: title,
      description: desc.join('  '),
      links: [],
      _src: 'SOP'
    };

    it = _ensureLinkFromRow(it, sh, i + 1, lc, carry);
    if (it.links.length) carry = it.links.slice();
    res.push(it);
  }
  return res;
}

function _rmParse(ss, sheetName, targetTeam) {
  var res = [], sh = ss.getSheetByName(sheetName);
  if (!sh) return res;
  var lr = sh.getLastRow();
  if (lr < 6) return res;
  var lc = sh.getLastColumn();
  var data = sh.getRange(1, 1, lr, Math.min(lc, 12)).getDisplayValues();

  var lastCat = '', carry = [];
  for (var i = 5; i < lr; i++) {
    var row = data[i];
    var cat = row[1] ? row[1].trim() : lastCat;
    var title = row[2] ? row[2].trim() : '';
    var outcome = row[8] ? row[8].trim() : '';
    if (!title) continue;

    var upper = title.toUpperCase();
    if (upper.includes('WEEK') && upper.includes('ACTIVIT')) continue;
    if (upper === 'CONTENTS' || upper === 'TOPIC') continue;
    if (cat) lastCat = cat;

    var it = {
      team: targetTeam,
      category: cat || 'General',
      title: title,
      description: outcome,
      links: [],
      _src: 'RM'
    };

    it = _ensureLinkFromRow(it, sh, i + 1, lc, carry);
    if (it.links.length) carry = it.links.slice();
    res.push(it);
  }
  return res;
}

function _dcParse(ss) {
  var SKIP = {'link':1,'tai lieu tham khao':1,'lien ket':1};
  var res = [], sh = ss.getSheetByName('Detail công việc hàng ngày') || ss.getSheetByName('Detail cÃ´ng viá»‡c hÃ ng ngÃ y');
  if (!sh) return res;
  var lr = sh.getLastRow();
  if (lr < 3) return res;
  var lc = sh.getLastColumn();
  var data = sh.getRange(1, 1, lr, Math.min(lc, 9)).getDisplayValues();

  var lastTopic = '', lastCat = '', carry = [];
  for (var i = 2; i < lr; i++) {
    var row = data[i];
    var topic = row[0] ? row[0].trim() : lastTopic;
    var cat   = row[3] ? row[3].trim() : lastCat;
    var title = row[4] ? row[4].trim() : '';
    var outcome = row[6] ? row[6].trim() : '';
    if (topic) lastTopic = topic;
    if (cat) lastCat = cat;
    if (!title || title === '-') continue;
    if (SKIP[(title || '').toLowerCase()]) continue;

    var it = {
      team: 'Detail Cong Viec',
      category: cat || topic || 'Khac',
      title: title,
      description: outcome,
      links: [],
      _src: 'DC'
    };

    it = _ensureLinkFromRow(it, sh, i + 1, lc, carry);
    if (it.links.length) carry = it.links.slice();
    res.push(it);
  }
  return res;
}

function _dlkParse(ss) {
  var res = [], sh = ss.getSheetByName('Nội dung') || ss.getSheetByName('Ná»™i dung');
  if (!sh) return res;
  var lr = sh.getLastRow();
  if (lr < 2) return res;
  var lc = sh.getLastColumn();
  var data = sh.getRange(1, 1, lr, Math.min(lc, 6)).getDisplayValues();

  var lastTeam = '', lastCat = '', carry = [];
  for (var i = 1; i < lr; i++) {
    var row = data[i];
    var team = row[0] ? row[0].trim() : lastTeam;
    var cat = row[1] ? row[1].trim() : lastCat;
    var title = row[2] ? row[2].trim() : '';
    var desc = row[3] ? row[3].toString().replace(/\r\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim() : '';
    if (team) lastTeam = team;
    if (cat) lastCat = cat;

    if (title) {
      var it = {
        team: team || 'Khac',
        category: cat || 'Khac',
        title: title,
        description: desc,
        links: [],
        _src: 'DLK'
      };

      it = _ensureLinkFromRow(it, sh, i + 1, lc, carry);
      if (it.links.length) carry = it.links.slice();
      res.push(it);
    } else if (res.length > 0 && desc) {
      var prev = res[res.length - 1];
      if (!prev.description.includes(desc.slice(0, 20))) {
        prev.description = prev.description ? prev.description + '\n' + desc : desc;
      }
    }
  }
  return res;
}

// ---------- INFO SHEETS ----------
function _planParse(ss) {
  var res = [], sh = ss.getSheetByName('Plan đào tạo Staff->Lead') || ss.getSheetByName('Plan Ä‘Ã o táº¡o Staff->Lead');
  if (!sh) return res;
  var lr = sh.getLastRow();
  if (lr < 2) return res;
  var data = sh.getRange(2, 1, lr - 1, 8).getDisplayValues();

  var lastWeek = '';
  for (var i = 0; i < data.length; i++) {
    var row = data[i];
    var week = row[0] ? row[0].trim() : lastWeek;
    var phase = row[1] ? row[1].trim() : '';
    var focus = row[2] ? row[2].trim() : '';
    var goal = row[3] ? row[3].trim() : '';
    var content = row[4] ? row[4].trim() : '';
    var reviewer = row[7] ? row[7].trim() : '';
    if (week) lastWeek = week;
    if (!focus) continue;

    var desc = [];
    if (phase) desc.push('📌 ' + phase);
    if (goal) desc.push('🎯 ' + goal);
    if (content) desc.push(content.slice(0, 120));
    if (reviewer) desc.push('Reviewer: ' + reviewer);

    res.push({ team:'Plan Dao Tao Staff->Lead', category:week || 'General', title:focus, description:desc.join('  ·  '), links:[], _src:'PLAN' });
  }
  return res;
}

function _rankParse(ss) {
  var res = [], sh = ss.getSheetByName('Quy đổi ranking') || ss.getSheetByName('Quy Ä‘á»•i ranking');
  if (!sh) return res;
  var lr = sh.getLastRow();
  if (lr < 3) return res;
  var data = sh.getRange(3, 1, lr - 2, 7).getDisplayValues();

  for (var i = 0; i < data.length; i++) {
    var row = data[i];
    var rank = row[0] ? row[0].trim() : '';
    var score = row[1] ? row[1].trim() : '';
    if (rank && score) res.push({ team:'Quy Doi Ranking', category:'KPI Ranking', title:rank, description:'Diem: ' + score, links:[], _src:'RANK' });

    var prank = row[2] ? row[2].trim() : '';
    var pscore = row[3] ? row[3].trim() : '';
    if (prank && pscore) res.push({ team:'Quy Doi Ranking', category:'Performance Ranking', title:prank, description:'Diem: ' + pscore, links:[], _src:'RANK' });

    var result = row[5] ? row[5].trim() : '';
    var scard = row[6] ? row[6].trim() : '';
    if (result && scard) res.push({ team:'Quy Doi Ranking', category:'Scorecard', title:result, description:'Scorecard: ' + scard, links:[], _src:'RANK' });
  }
  return res;
}

function _tnParse(ss) {
  var res = [], sh = ss.getSheetByName('Thuật ngữ/Từ viết tắt') || ss.getSheetByName('Thuáº­t ngá»¯/Tá»« viáº¿t táº¯t') || ss.getSheetByName('Thuáº­t ngá»¯Tá»« viáº¿t táº¯t');
  if (!sh) return res;
  var lr = sh.getLastRow();
  if (lr < 2) return res;
  var data = sh.getRange(2, 2, lr - 1, 2).getDisplayValues();

  for (var i = 0; i < data.length; i++) {
    var word = data[i][0] ? data[i][0].trim() : '';
    var meaning = data[i][1] ? data[i][1].trim() : '';
    if (!word || word.toLowerCase() === 'word') continue;
    res.push({ team:'Thuat Ngu & Tu Viet Tat', category:'Glossary', title:word, description:meaning, links:[], _src:'TN' });
  }
  return res;
}

function _ttParse(ss) {
  var res = [], sh = ss.getSheetByName('Ý nghĩa các trạng thái đơn hàng') || ss.getSheetByName('Ã nghÄ©a cÃ¡c tráº¡ng thÃ¡i Ä‘Æ¡n hÃ ng');
  if (!sh) return res;
  var lr = sh.getLastRow();
  if (lr < 3) return res;
  var data = sh.getRange(3, 1, lr - 2, 3).getDisplayValues();

  for (var i = 0; i < data.length; i++) {
    var status = data[i][0] ? data[i][0].trim() : '';
    var pic = data[i][1] ? data[i][1].trim() : '';
    var desc = data[i][2] ? data[i][2].trim() : '';
    if (!status || status === 'STATUS') continue;
    res.push({ team:'Trang Thai Don Hang', category:pic || 'General', title:status, description:desc, links:[], _src:'TT' });
  }
  return res;
}

function _pbParse(ss) {
  var res = [], sh = ss.getSheetByName('Các phòng ban và chức năng') || ss.getSheetByName('CÃ¡c phÃ²ng ban vÃ  chá»©c nÄƒng');
  if (!sh) return res;
  var lr = sh.getLastRow();
  if (lr < 2) return res;
  var data = sh.getRange(2, 1, lr - 1, 5).getDisplayValues();

  for (var i = 0; i < data.length; i++) {
    var row = data[i];
    var dept = row[0] ? row[0].trim() : '';
    var func = row[1] ? row[1].trim() : '';
    var groups = row[2] ? row[2].toString().replace(/[\r\n]+/g, ', ').trim() : '';
    var lead = row[3] ? row[3].trim() : '';
    var pic = row[4] ? row[4].toString().replace(/[\r\n]+/g, ', ').trim() : '';
    if (!dept || dept === 'Phong ban') continue;

    var parts = [];
    if (groups && groups !== '-') parts.push(groups);
    if (lead) parts.push('Lead: ' + lead);
    if (pic) parts.push('PIC: ' + pic);

    res.push({ team:'Phong Ban & Chuc Nang', category:dept, title:func || dept, description:parts.join(' | '), links:[], _src:'PB' });
  }
  return res;
}

// ---------- DEDUP / NORMALIZE ----------
function _mergeLinks(target, source) {
  (source || []).forEach(function(l) {
    if (!l || !l.url) return;
    if (!target.some(function(ex) { return ex.url === l.url; })) target.push(l);
  });
}

function _dedup(items) {
  var seen = {}, res = [];
  (items || []).forEach(function(it) {
    var team = _normalizeTeam(it.team || 'Khac');
    var title = (it.title || '').toLowerCase().trim();
    if (!title) return;
    var key = team.toLowerCase() + '|||' + title;

    if (seen[key] !== undefined) {
      var ex = res[seen[key]];
      if (it.description && !ex.description) ex.description = it.description;
      else if (it.description && ex.description && ex.description.indexOf(it.description.slice(0, 25)) < 0) ex.description += ' | ' + it.description;
      _mergeLinks(ex.links, it.links);
      if (it.category && ex.category === 'Khac') ex.category = it.category;
    } else {
      seen[key] = res.length;
      res.push({
        team: team,
        category: it.category || 'Khac',
        title: it.title || '',
        description: it.description || '',
        links: _dedupLinks(it.links || []),
        _src: it._src || ''
      });
    }
  });
  return res;
}

function _dedupLinks(links) {
  var byUrl = {};
  (links || []).forEach(function(l) {
    if (!l || !l.url) return;
    var u = String(l.url).trim();
    if (!/^https?:\/\//i.test(u)) return;
    if (!byUrl[u]) byUrl[u] = { url: u, name: l.name || _gn(u) };
  });
  return Object.keys(byUrl).map(function(k){ return byUrl[k]; });
}

function _normalizeTeam(raw) {
  if (!raw) return 'Khac';
  var k = raw.toLowerCase().trim();
  return _WN[k] || raw.trim();
}

function _gn(url) {
  if (!url) return 'Xem tai lieu';
  var u = String(url).toLowerCase();
  if (u.indexOf('spreadsheets') >= 0) return 'Google Sheet';
  if (u.indexOf('/document') >= 0) return 'Google Doc';
  if (u.indexOf('presentation') >= 0) return 'Google Slides';
  if (u.indexOf('/forms') >= 0) return 'Google Form';
  if (u.indexOf('drive.google') >= 0) return 'Google Drive';
  if (u.indexOf('youtube') >= 0 || u.indexOf('youtu.be') >= 0) return 'Video';
  if (u.indexOf('.pdf') >= 0) return 'PDF';
  try { return url.split('/')[2].replace('www.', '') || 'Xem'; }
  catch(e) { return 'Xem tai lieu'; }
}
// ============================================================

// --- MODULE 6: MA TRẬN GIÁ (LƯƠNG) ---

// ============================================================

function normalizeKey(str) {

  if (!str) return "";

  var m = str.toString().match(/\d+/g);

  return m ? m.join('-') : str.toString().replace(/[\s'"]/g,"").toLowerCase();

}

function getFeeMatrix() {

  try {

    // [SECURITY FIX 2026-08] Bảng hệ số/điểm tính lương là dữ liệu nhạy cảm riêng
    // của module Lương — trước đây hàm này KHÔNG kiểm tra spx_checkLuongAccess(),
    // nên bất kỳ user "Duyệt" chung (chưa chắc được cấp quyền Lương) cũng gọi thẳng
    // được qua console và lấy toàn bộ bảng phí, bỏ qua hẳn cổng phân quyền riêng
    // mà JS_Luong.html chỉ đang enforce ở phía giao diện.
    if (spx_checkLuongAccess() !== 'granted') {
      return { success: false, error: 'Không có quyền truy cập dữ liệu Lương.' };
    }

    var ss      = SpreadsheetApp.openByUrl(DB_FEE_URL);

    var matrix  = { "deli":{}, "pickup":{}, "return":{} };

    var mapping = { "Data Giao":"deli", "Data Lấy":"pickup", "Data Trả":"return" };

    for (var tab in mapping) {

      var sheet = ss.getSheetByName(tab); if (!sheet) continue;

      var data  = sheet.getDataRange().getValues();

      var dataStart = -1;

      for (var r = 0; r < Math.min(10, data.length); r++) {

        if (!isNaN(parseFloat(data[r][0])) && data[r][0] !== "") { dataStart = r; break; }

      }

      if (dataStart < 1) continue;

      var headers = data[dataStart-1];

      for (var i = dataStart; i < data.length; i++) {

        var min = parseFloat(data[i][0]); var max = parseFloat(data[i][1]);

        if (isNaN(max) || data[i][1] === "") max = 999999;

        for (var j = 2; j < headers.length; j++) {

          var weightKey = normalizeKey(headers[j]); var points = parseFloat(data[i][j]);

          if (!weightKey || isNaN(points)) continue;

          var code = mapping[tab];

          if (!matrix[code][weightKey]) matrix[code][weightKey] = [];

          matrix[code][weightKey].push({ min, max, points });

        }

      }

    }

    return { success: true, data: matrix };

  } catch (e) { return { success: false, error: e.message }; }

}

